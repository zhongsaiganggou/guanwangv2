# Dependencies
node_modules/

# Build output
dist/
.astro/

# Cloudflare Wrangler
.wrangler/

# Environment variables & secrets
.env
.env.*
!.env.example

# Python one-off helper scripts (not required for Astro build)
*.py
__pycache__/
*.pyc

# Auto-publisher system (required for GitHub Actions)
!tools/auto-publisher/**/*.py
!tools/auto-publisher/*.py

# Image-audit regenerable scan caches & thumbnail dumps
/_img_meta.json
/_img_refs.json
/_thumbs_map.json
tools/image-audit/thumbs/
tools/image-audit/source-thumbs/

# Old website snapshots & scrape artifacts (local reference only)
old_project_html/
old_projects_page.html
project_images_map.json

# OS files
Thumbs.db
.DS_Store
Desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Auto-publisher local config (contains secrets, never commit)
tools/auto-publisher/config.local.json
