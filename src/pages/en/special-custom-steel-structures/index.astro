---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const title = 'Special & Custom Steel Structures | Custom Fabrication per Drawings | ZhongSai';
const description = 'ZhongSai Steel Structure provides special and custom steel structure fabrication, including irregular and double-curved structures, spiral staircases, LED display support frames, canopies, mezzanines, steel platforms and curtain wall support frames, fabricated per confirmed drawings and BOQ.';
const lang = 'en';
const canonical = 'https://zhongsai-steelstructure.com/en/special-custom-steel-structures/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/products/app-special-custom.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">Special · Custom Steel Structure</span>
      <h1>Special & Custom Steel Structures</h1>
      <p class="lead">ZhongSai Steel Structure provides special and custom steel structure fabrication for non-standard and complex projects — including irregular and double-curved structures, spiral staircases, LED display support frames, canopy structures, mezzanines, steel platforms and curtain wall support frames. Fabricated per your confirmed drawings and BOQ, with precision manufacturing, component marking and containerized export delivery.</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Send Your Custom Steel Structure Requirements</a>
        <a href="/en/products/" class="btn btn-outline">View All Products</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/products/">Products</a>
      <span class="sep">/</span>
      <span class="current">Special & Custom Steel Structures</span>
    </div>
  </nav>

  <!-- 01 / Custom Project Requirements -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">01 / Custom Project Requirements</p>
        <h2>What Information Is Needed for Custom Steel Structures</h2>
        <p>Custom and special steel structures require detailed engineering information for precision fabrication. The following information directly influences manufacturing feasibility, production planning and quality control.</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>Structure Type</h3>
          <p>Irregular structure, spiral staircase, LED support frame, canopy, mezzanine, steel platform or curtain wall support — different types require different fabrication approaches.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>Engineering Drawings</h3>
          <p>Structural drawings, fabrication drawings, 3D models and connection details are essential for custom fabrication.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>Material Specifications</h3>
          <p>Steel grade, section type, thickness and special material requirements determined per project design.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>Surface Treatment</h3>
          <p>Painting, galvanizing, powder coating or special finish requirements specified per project and environmental conditions.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>Tolerance & Precision</h3>
          <p>Dimensional tolerance, fit-up requirements and inspection level determined per project specifications.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>Delivery Requirements</h3>
          <p>Component grouping, packing method and delivery sequence determined per site installation plan.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / Complex & Irregular Structures -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">02 / Complex & Irregular Structures</p>
        <h2>Complex and Irregular Steel Structure Fabrication</h2>
        <p>Irregular, double-curved and architecturally complex steel structures require advanced fabrication capability, precise template work and skilled welding. ZhongSai handles these special structures with documented quality control.</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/app-special-custom.jpg" alt="Special custom steel structure irregular" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Precision Fabrication for Complex Forms</h3>
          <ul>
            <li>Irregular and double-curved steel members fabricated per engineering drawings and 3D models</li>
            <li>Complex connection nodes and custom brackets manufactured per design</li>
            <li>Template and jig work for accurate fit-up of complex geometries</li>
            <li>Welding procedures qualified for special joint configurations</li>
            <li>Dimensional verification at critical fabrication stages</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / Common Custom Applications -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">03 / Common Custom Applications</p>
        <h2>Common Custom Steel Structure Applications</h2>
        <p>Custom steel structures cover a wide range of non-standard applications, from architectural features to functional support structures.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/products/detail-spiral-staircase.jpg');"></div>
          <div class="feature-body">
            <h3>Spiral Staircases & Canopies</h3>
            <p>Custom-fabricated spiral staircases, canopy structures and architectural steel features, manufactured per design drawings.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/06-custom-engineering.jpg');"></div>
          <div class="feature-body">
            <h3>Platforms & Mezzanines</h3>
            <p>Steel platforms, mezzanine floors and equipment support structures, designed for specific load requirements and spatial constraints.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 / LED Display & Facade Support -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">04 / LED Display & Facade Support</p>
        <h2>LED Display Support and Facade Steel Frames</h2>
        <p>LED display screens and modern facade systems require precisely fabricated steel support frames that can accommodate panel mounting, maintenance access and structural loads.</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/03-commercial-public.jpg" alt="LED display support steel frame facade" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Precision Frames for Display and Facade Systems</h3>
          <ul>
            <li>LED display support frames fabricated with precise mounting hole positioning</li>
            <li>Curtain wall and facade support frames manufactured per architectural drawings</li>
            <li>Maintenance access and structural load requirements incorporated into frame design</li>
            <li>Connection details coordinated with panel system suppliers</li>
            <li>Surface treatment specified for outdoor exposure and durability requirements</li>
          </ul>
          <div style="margin-top: 20px;">
            <a href="/en/products/custom-engineering/" class="btn btn-outline">View Custom Engineering</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 / Fabrication & Export Delivery -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">05 / Fabrication & Export Delivery</p>
        <h2>From Drawings to Containerized Delivery for Custom Projects</h2>
        <p>ZhongSai operates its own production base, fabricating custom steel structures per confirmed drawings and BOQ, with organized component marking, packing and container loading for international delivery.</p>
      </div>
      <div class="process-flow">
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">01</div>
          <h4>Drawings Confirmation</h4>
          <p>Confirmed drawings, BOQ and technical requirements reviewed</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">02</div>
          <h4>Detailing & Planning</h4>
          <p>Fabrication detailing, production planning and inspection planning</p>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">03</div>
          <h4>Custom Fabrication</h4>
          <p>Cutting, forming, assembly, welding and surface treatment per drawings</p>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">04</div>
          <h4>Quality Inspection</h4>
          <p>Dimensional check, welding inspection and fit-up verification</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>Marking & Packing</h4>
          <p>Component marking, packing and loading plan organization</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">06</div>
          <h4>Container Loading</h4>
          <p>Container loading coordination and export documentation support</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">06 / Related</p>
        <h2>Related Capabilities</h2>
        <p>Explore related ZhongSai capabilities and services for your project.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3><a href="/en/products/custom-engineering/" style="color: inherit; text-decoration: none;">Custom Engineering</a></h3>
            <p>Custom steel structure fabrication per drawings</p>
            <a href="/en/products/custom-engineering/" style="color: #2563eb; font-size: 14px; font-weight: 600;">Learn more →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3><a href="/en/components/" style="color: inherit; text-decoration: none;">Components</a></h3>
            <p>Fabricated steel components and cladding</p>
            <a href="/en/components/" style="color: #2563eb; font-size: 14px; font-weight: 600;">Learn more →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3><a href="/en/manufacturing-quality/" style="color: inherit; text-decoration: none;">Manufacturing Quality</a></h3>
            <p>Quality-controlled fabrication</p>
            <a href="/en/manufacturing-quality/" style="color: #2563eb; font-size: 14px; font-weight: 600;">Learn more →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-4">
          <div class="feature-body">
            <h3><a href="/en/export-delivery/" style="color: inherit; text-decoration: none;">Export Delivery</a></h3>
            <p>Packing, loading and export coordination</p>
            <a href="/en/export-delivery/" style="color: #2563eb; font-size: 14px; font-weight: 600;">Learn more →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote Form -->
  <section id="quote" class="detail-section">
    <div class="container">
      <QuoteForm />
    </div>
  </section>
</BaseLayout>
