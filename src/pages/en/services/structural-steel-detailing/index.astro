---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../../components/QuoteForm.astro';
import '../../../../styles/detail.css';

const title = 'Structural Steel Detailing Services | Shop & Fabrication Drawings | ZhongSai';
const description = 'ZhongSai Steel Structure provides structural steel detailing services for fabrication, including shop drawings, fabrication drawings and drawing review coordination based on project drawings and technical requirements.';
const lang = 'en';
const canonical = 'https://zhongsai-steelstructure.com/en/services/structural-steel-detailing/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/company/factory-steel-beam-fabrication.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">Detailing · Shop Drawings · Fabrication</span>
      <h1>Structural Steel Detailing Services for Fabrication</h1>
      <p class="lead">ZhongSai provides structural steel detailing services for fabrication and export-oriented steel structure projects based on project drawings and technical requirements. We connect structural design with fabrication through shop drawings, fabrication drawings, member details, connection details and marking information.</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Submit Drawings for Review</a>
        <a href="/en/products/custom-engineering/" class="btn btn-outline">View Custom Fabrication</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/services/">Services</a>
      <span class="sep">/</span>
      <span class="current">Structural Steel Detailing</span>
    </div>
  </nav>

  <!-- 01 What Is Structural Steel Detailing? -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">01 / What Is Detailing</p>
        <h2>What Is Structural Steel Detailing?</h2>
        <p>Structural steel detailing connects structural design with fabrication. It translates confirmed structural design information and project requirements into detailed drawings that the fabrication team can use to manufacture, mark and prepare steel components for shipment and erection.</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/components/steel-members-beams-columns.jpg" alt="Structural steel detailing for beams and columns" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Detailing Outputs for Fabrication</h3>
          <p>Detailing work develops the information required for fabrication and project coordination.</p>
          <ul>
            <li>Member details with dimensions and geometry</li>
            <li>Connection details and fabrication information</li>
            <li>Marking information for component identification</li>
            <li>Assembly and erection reference information where required</li>
            <li>Coordination with fabrication and packing requirements</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Shop Drawings for Fabrication -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">02 / Shop Drawings</p>
        <h2>Shop Drawings for Steel Fabrication</h2>
        <p>Shop drawings provide the detailed information required for steel fabrication. ZhongSai supports shop drawing preparation and coordination for beams, columns, trusses, bracing, connection details, platforms and custom steel members based on project drawings and technical specifications.</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <h3>Beams & Columns</h3>
          <p>Shop drawing coordination for fabricated beams, columns and primary structural members per project dimensions.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <h3>Trusses & Bracing</h3>
          <p>Detailing support for truss members, bracing systems and secondary structural components.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <h3>Connection Details</h3>
          <p>Connection detail coordination based on project structural requirements and fabrication specifications.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-4">
          <h3>Platforms & Custom Members</h3>
          <p>Shop drawing support for equipment platforms, custom steel members and complex fabrication components.</p>
        </div>
      </div>
      <div class="image-text-block" style="margin-top: 48px;">
        <div class="itb-image">
          <img src="/images/manufacturing/factory-cnc-cutting-welding.jpg" alt="Shop drawings support CNC cutting and welding fabrication" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>How Shop Drawings Support Manufacturing</h3>
          <p>Shop drawings translate project design into fabrication-ready information, supporting cutting, assembly, welding, surface treatment and quality control in the production base.</p>
          <ul>
            <li>Fabrication dimensions and member geometry</li>
            <li>Connection and welding information per project requirements</li>
            <li>Marking and identification for packing and erection</li>
            <li>Coordination with manufacturing and export preparation</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Fabrication Drawings -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">03 / Fabrication Drawings</p>
        <h2>Fabrication Drawings for Steel Structure Projects</h2>
        <p>Fabrication drawings provide the detailed dimensions, member geometry, connection details and fabrication information required for manufacturing. All drawing content is developed based on project drawings, technical specifications and confirmed project information.</p>
      </div>
      <div class="image-text-block">
        <div class="itb-content">
          <h3>Fabrication Drawing Information</h3>
          <p>Fabrication drawings are organized to support manufacturing, marking, packing and export preparation.</p>
          <ul>
            <li>Member dimensions and geometry per project drawings</li>
            <li>Connection details and fabrication requirements</li>
            <li>Marking references for component identification</li>
            <li>Surface treatment and coating information where specified</li>
            <li>Coordination with packing and container loading</li>
          </ul>
        </div>
        <div class="itb-image">
          <img src="/images/components/steel-members-complex-fabricated-components.jpg" alt="Fabrication drawings for complex steel components" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Drawing Review & Coordination -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">04 / Drawing Review</p>
        <h2>Drawing Review & Coordination</h2>
        <p>ZhongSai can review available project drawings, identify missing fabrication information, coordinate detailing requirements and confirm what additional information may be required before fabrication begins.</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <h3>Available Drawing Review</h3>
          <p>Review structural drawings, architectural drawings where relevant, and existing shop drawings to assess fabrication readiness.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <h3>Missing Information Identification</h3>
          <p>Identify fabrication information that may require confirmation, such as connection details, dimensions or material specifications.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <h3>Detailing Coordination</h3>
          <p>Coordinate detailing requirements with the project team and confirm information required before fabrication drawings are finalized.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-4">
          <h3>Fabrication Readiness</h3>
          <p>Review whether the available drawing information is sufficient to support fabrication, marking, packing and export preparation, and identify any information that may still require confirmation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 From Detailing to Fabrication -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">05 / Detailing to Fabrication</p>
        <h2>From Detailing to Fabrication & Export</h2>
        <p>ZhongSai connects detailing with fabrication and export preparation. Once drawing information is confirmed, fabrication can proceed through manufacturing, marking, packing and container loading for overseas delivery.</p>
      </div>
      <div class="process-flow">
        <div class="process-step reveal">
          <div class="step-num">1</div>
          <h4>Project Drawings</h4>
          <p>Submit available structural drawings, specifications and project requirements.</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">2</div>
          <h4>Drawing Review</h4>
          <p>Review available information and confirm detailing requirements.</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">3</div>
          <h4>Detailing Coordination</h4>
          <p>Develop shop and fabrication drawing information based on project requirements.</p>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">4</div>
          <h4>Fabrication</h4>
          <p>Fabrication is organized based on confirmed drawings and project requirements.</p>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">5</div>
          <h4>Marking & Packing</h4>
          <p>Component marking and packing are organized according to confirmed drawings and project requirements.</p>
        </div>
        <div class="process-step reveal reveal-delay-5">
          <div class="step-num">6</div>
          <h4>Export Preparation</h4>
          <p>Coordinate container loading and export documentation support.</p>
        </div>
      </div>
      <div class="related-links" style="margin-top: 48px;">
        <h3>Related Capabilities</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 24px;">
          <a href="/en/products/custom-engineering/" class="related-link-card reveal reveal-delay-1">
            <h4>Custom Engineering & Fabrication</h4>
            <p>Structural steel fabrication from project drawings and BOQ</p>
            <span class="rl-arrow">View Details →</span>
          </a>
          <a href="/en/manufacturing-quality/" class="related-link-card reveal reveal-delay-2">
            <h4>Manufacturing & Quality Control</h4>
            <p>8-step manufacturing process and quality control</p>
            <span class="rl-arrow">View Details →</span>
          </a>
          <a href="/en/components/" class="related-link-card reveal reveal-delay-3">
            <h4>Components & Materials</h4>
            <p>Steel beams, columns, trusses, purlins and cladding systems</p>
            <span class="rl-arrow">View Details →</span>
          </a>
          <a href="/en/components/fabricated-steel-beams-columns/" class="related-link-card reveal reveal-delay-4">
            <h4>Fabricated Beams & Columns</h4>
            <p>Custom fabricated steel beams and columns to project drawings</p>
            <span class="rl-arrow">View Details →</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 What Information Is Needed? -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">06 / Information Required</p>
        <h2>What Project Information Is Needed?</h2>
        <p>Submit the project documents currently available. ZhongSai can review the available information and confirm what additional data may be required for detailing and fabrication. Missing one item does not prevent an initial review.</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <h3>Structural Drawings</h3>
          <p>Available structural drawings, general arrangement drawings and member schedules where available.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <h3>Architectural Drawings</h3>
          <p>Architectural drawings where relevant for coordination, such as building envelope and opening information.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <h3>Project Specifications</h3>
          <p>Technical specifications, material requirements, connection requirements and surface treatment specifications.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-4">
          <h3>BOQ & Existing Drawings</h3>
          <p>Bill of Quantities if available, existing shop drawings if available, and project country information.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 What ZhongSai Can Support -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">07 / ZhongSai Support</p>
        <h2>What ZhongSai Can Support</h2>
        <p>ZhongSai provides detailing support and coordination for fabrication and export-oriented steel structure projects. Detailing work is developed based on available project drawings, technical requirements and agreed project scope.</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <h3>Drawing Review</h3>
          <p>Review available project drawings and assess fabrication information readiness.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <h3>Detailing Coordination</h3>
          <p>Coordinate detailing requirements and confirm information needed for fabrication.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <h3>Shop Drawing Support</h3>
          <p>Shop drawing preparation and support based on project drawings and technical requirements.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-4">
          <h3>Fabrication Drawing Support</h3>
          <p>Fabrication drawing preparation and support for manufacturing, marking and packing.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-5">
          <h3>Component Marking</h3>
          <p>Marking information coordination for component identification, packing and erection reference.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-6">
          <h3>Export Fabrication Support</h3>
          <p>Coordination with fabrication, packing, container loading and export-oriented project requirements.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 08 Service Boundary -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">08 / Service Boundary</p>
        <h2>Service Scope & Boundary</h2>
        <p>ZhongSai's detailing work is developed based on available project drawings, technical requirements and agreed project scope. Structural design responsibility, local approvals and construction approvals remain subject to the project contract and local project requirements. ZhongSai provides manufacturing, export supply and overseas installation technical guidance; local erection and construction are carried out by the customer's or local project team.</p>
      </div>
    </div>
  </section>

  <!-- 09 FAQ -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">09 / FAQ</p>
        <h2>Frequently Asked Questions</h2>
      </div>
      <div class="faq-list">
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-detailing-en-01">
            <span>What is the difference between structural design and steel detailing?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-detailing-en-01" hidden>
            <div class="faq-answer-inner">
              <p>Structural design determines the structural system, member sizes, loads and design criteria for a building or structure. Steel detailing translates the confirmed structural design information into detailed fabrication drawings, including member details, connection details, dimensions and marking information that the fabrication team can use to manufacture and prepare steel components.</p>
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-detailing-en-02">
            <span>Can I send existing PDF or CAD drawings for review?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-detailing-en-02" hidden>
            <div class="faq-answer-inner">
              <p>Yes. You can submit available PDF drawings, CAD files, structural drawings, specifications and existing shop drawings for initial review. ZhongSai can assess the available information and confirm what additional data may be required for detailing and fabrication.</p>
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-detailing-en-03">
            <span>Can shop drawings be coordinated with ZhongSai fabrication?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-detailing-en-03" hidden>
            <div class="faq-answer-inner">
              <p>Yes. ZhongSai can coordinate shop drawing information with its own fabrication, manufacturing, marking and packing requirements. This helps coordinate fabrication, component identification and export preparation for overseas projects.</p>
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls="faq-detailing-en-04">
            <span>What information is required before fabrication drawings are finalized?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer" id="faq-detailing-en-04" hidden>
            <div class="faq-answer-inner">
              <p>Fabrication drawings are finalized based on confirmed structural drawings, project specifications, connection requirements, material requirements and agreed project scope. If some information is not yet available, ZhongSai can review the existing documents and identify what additional information may be required before fabrication drawings are completed.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 10 Quote CTA + QuoteForm -->
  <section class="detail-section dark" id="quote">
    <div class="container">
      <div class="section-heading reveal" style="text-align: center;">
        <p class="section-index" style="justify-content: center; color: #f59e0b;">10 / Get Quotation</p>
        <h2 style="color: #fff;">Have Structural Drawings? Submit for Project Review</h2>
        <p style="margin: 0 auto; color: rgba(255,255,255,0.75);">Submit project drawings, specifications and technical requirements. ZhongSai will conduct an initial review and confirm what is needed for detailing and fabrication.</p>
      </div>
      <QuoteForm lang="en" />
    </div>
  </section>
</BaseLayout>

<script>
  // FAQ toggle
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item.classList.contains('open');
      item.classList.toggle('open');
      btn.setAttribute('aria-expanded', !isOpen);
    });
  });

  // Scroll reveal
  const revealElements = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    revealElements.forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(24px)';
      el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      observer.observe(el);
    });
  }
</script>
