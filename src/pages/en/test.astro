---
// /en/test - English test page
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import QuoteForm from '../../components/QuoteForm.astro';

const faqItems = [
  {
    question: 'Can ZhongSai fabricate from our drawings?',
    answer: 'Yes. ZhongSai Steel Structure supports engineering review and fabrication quotation based on customer-provided structural drawings, shop drawings, and BOQ/BOM. Customers can upload drawings through the inquiry form or contact our engineering team for detailed discussion.'
  },
  {
    question: 'What information is required for quotation?',
    answer: 'To provide an accurate quotation, we recommend providing: project country, building purpose, basic dimensions (L×W×H), crane requirements (if any), drawings or BOQ (if available), surface treatment requirements, delivery destination, etc. Even without complete drawings, you can submit project requirements first and we will provide preliminary solution recommendations.'
  },
  {
    question: 'Does ZhongSai undertake local construction overseas?',
    answer: 'ZhongSai Steel Structure provides overseas installation technical guidance, including erection drawings, component marking instructions, and remote technical support. Local construction and erection are performed by the customer or the customer\'s designated local construction team. We can provide detailed installation manuals and technical guidance to ensure smooth project execution.'
  }
];
---

<BaseLayout 
  title="Component Test Page | ZhongSai Steel Structure" 
  description="ZhongSai Website V2 component test page for verifying Header, Navigation, Language Switch, FAQ, Form and other public components."
  lang="en"
  noindex={true}
>
  <Breadcrumb items={[
    { label: 'Home', href: '/en/' },
    { label: 'Test Page' }
  ]} lang="en" />

  <Hero 
    title="ZhongSai Website V2 Component Test"
    subtitle="This page is used to verify the functionality, styling and responsive behavior of all public components."
    lang="en"
    primaryCta={{ label: 'Get a Quote', href: '#quote-form' }}
    secondaryCta={{ label: 'View Chinese Page', href: '/zh/test/' }}
  />

  <section class="section">
    <div class="container">
      <h2 class="section-title">Frequently Asked Questions</h2>
      <p class="section-subtitle">Testing FAQ component expand/collapse functionality, accessibility attributes and keyboard navigation.</p>
      <FAQ items={faqItems} idPrefix="test-en" lang="en" />
    </div>
  </section>

  <CTA 
    title="Ready to Start Your Project?"
    description="Contact ZhongSai Steel Structure for professional steel structure solutions and quotation."
    lang="en"
    primaryCta={{ label: 'Submit Project Requirements', href: '#quote-form' }}
    secondaryCta={{ label: 'Learn About Manufacturing', href: '/en/manufacturing-quality/' }}
  />

  <QuoteForm lang="en" id="quote-form" />
</BaseLayout>
