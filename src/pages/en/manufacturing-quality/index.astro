---
// ZhongSai V2 - English Manufacturing & Quality Page (Upgraded)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import ExportDeliveryCTA from '../../../components/ExportDeliveryCTA.astro';
import '../../../styles/hub.css';
import '../../../styles/manufacturing.css';

const lang = 'en';
const title = 'Steel Structure Manufacturing & Quality Control | ZhongSai Factory';
const description = 'Project-based steel structure fabrication for overseas projects: raw material control, CNC cutting, assembly & welding, dimensional inspection, surface...';

const manufacturingSteps = [
  {
    num: '01',
    title: 'Drawing Review & Detailing',
    desc: 'Project and shop drawings are reviewed, with key dimensions, connections and fabrication requirements confirmed before production begins.',
    img: '/images/manufacturing/process/01-drawing-review.jpg'
  },
  {
    num: '02',
    title: 'Material Preparation',
    desc: 'Steel plates, sections and supporting materials are received, identified and prepared according to project specifications and material grade requirements.',
    img: '/images/company/factory-yard-gantry-crane.jpg'
  },
  {
    num: '03',
    title: 'CNC Cutting & Drilling',
    desc: 'CNC cutting and drilling equipment processes steel plates and sections according to shop drawings, with dimensional accuracy and hole positioning controlled.',
    img: '/images/manufacturing/real/cutting-prep-9809.jpg'
  },
  {
    num: '04',
    title: 'Assembly & Welding',
    desc: 'Components are assembled and welded according to approved drawings and welding process requirements, with fit-up and welding distortion controlled.',
    img: '/images/manufacturing/real/assembly-welding-9821.jpg'
  },
  {
    num: '05',
    title: 'Dimensional Inspection',
    desc: 'Finished components are inspected for length, hole position, diagonal, straightness and connection interface accuracy against project drawings.',
    img: '/images/manufacturing/real/qc-inspection.jpg'
  },
  {
    num: '06',
    title: 'Surface Treatment',
    desc: 'Surface cleaning, shot blasting, painting or hot-dip galvanizing may be arranged where required by the project environment, corrosion category and client specification.',
    img: '/images/manufacturing/real/painting.jpg'
  },
  {
    num: '07',
    title: 'Component Marking',
    desc: 'Components are marked and numbered based on shop drawings and installation sequence requirements, facilitating overseas site identification and erection.',
    img: '/images/manufacturing/real/component-marking.jpg'
  },
  {
    num: '08',
    title: 'Packing & Container Loading',
    desc: 'Components are grouped, packed and loaded into containers according to component type, loading sequence and export transport requirements, with packing lists included.',
    img: '/images/container-loading.jpg'
  }
];

const qualityStages = [
  { stage: 'Material', control: 'Grade confirmation, mill certificate verification, material identification' },
  { stage: 'Cutting', control: 'Dimension verification, cut surface quality, hole position accuracy' },
  { stage: 'Assembly', control: 'Geometry verification, fit-up check, alignment control' },
  { stage: 'Welding', control: 'Visual inspection, welding process compliance, project-required NDT where specified' },
  { stage: 'Surface', control: 'Surface preparation quality, coating thickness, galvanizing inspection where applicable' },
  { stage: 'Final', control: 'Dimensional verification, marking check, packing list review' }
];

const evidenceImages = [
  { src: '/images/manufacturing/real/factory-overview-9819.jpg', alt: 'ZhongSai steel structure manufacturing facility overview', caption: 'Manufacturing facility overview' },
  { src: '/images/manufacturing/real/cutting-prep-9809.jpg', alt: 'CNC cutting and material preparation at ZhongSai factory', caption: 'CNC cutting and preparation' },
  { src: '/images/manufacturing/real/welding-9820.jpg', alt: 'Steel structure welding process at ZhongSai manufacturing facility', caption: 'Assembly and welding' },
  { src: '/images/manufacturing/real/assembly-welding-9821.jpg', alt: 'H-beam assembly and welding production line', caption: 'H-beam assembly line' },
  { src: '/images/company/factory-steel-beam-fabrication.jpg', alt: 'Steel beam fabrication at ZhongSai production base', caption: 'Steel beam fabrication' },
  { src: '/images/components/finished-coated-components.jpg', alt: 'Finished and coated steel structure components', caption: 'Surface treated components' },
  { src: '/images/container-loading.jpg', alt: 'Steel structure components loaded into shipping container for export', caption: 'Container loading for export' },
  { src: '/images/company/factory-yard-gantry-crane.jpg', alt: 'Factory yard with gantry crane for steel material storage', caption: 'Material yard and storage' }
];

const projectTypes = [
  { name: 'Industrial Workshops', href: '/en/steel-workshop/' },
  { name: 'Warehouses & Logistics', href: '/en/steel-warehouse/' },
  { name: 'Mining & Heavy Industry', href: '/en/steel-mining-factory/' },
  { name: 'Steel Platforms', href: '/en/components/' },
  { name: 'Conveyor Galleries', href: '/en/components/' },
  { name: 'Pipe Racks', href: '/en/components/' },
  { name: 'Public & Infrastructure', href: '/en/transportation-infrastructure-steel/' },
  { name: 'Special Steel Structures', href: '/en/special-custom-steel-structures/' }
];

const certifications = [
  { name: 'ISO 9001', desc: 'Quality management system', holder: 'Huizhou manufacturing base', img: '/images/certifications/iso-9001-quality.jpg', valid: '2025-2028' },
  { name: 'ISO 14001', desc: 'Environmental management system', holder: 'Huizhou manufacturing base', img: '/images/certifications/iso-14001-environmental.jpg', valid: '2025-2028' },
  { name: 'ISO 45001', desc: 'Occupational health & safety management', holder: 'Huizhou manufacturing base', img: '/images/certifications/iso-45001-occupational.jpg', valid: '2025-2028' },
  { name: 'ISO 3834-2', desc: 'Comprehensive quality requirements for fusion welding', holder: 'Dongguan manufacturing base', img: '/images/certifications/iso-3834-welding.jpg', valid: '2024-2027' },
  { name: 'EN 1090 EXC2', desc: 'CE/CPR for structural steel components', holder: 'Dongguan manufacturing base', img: '/images/certifications/en-1090-ce.jpg', valid: 'Since 2024' },
  { name: 'CIDB IBS', desc: 'Malaysian Industrialised Building System certification', holder: 'Malaysia partner / Huizhou factory', img: '/images/certifications/malaysia-cidb-ibs.jpg', valid: '2026-2027' },
];

const faqs = [
  {
    q: 'Can ZhongSai manufacture based on client-issued drawings?',
    a: 'Yes. ZhongSai can fabricate steel structures based on client-issued structural drawings, general arrangement drawings and shop drawings. We can also support shop detailing coordination before production where required by the project. All fabrication is based on approved drawings and project technical specifications.'
  },
  {
    q: 'Can you support shop detailing before production?',
    a: 'Yes. ZhongSai can support structural detailing and shop drawing coordination as part of the project scope, including connection detailing, member scheduling and fabrication drawing preparation. The specific scope of detailing responsibility is determined per project contract and drawing requirements.'
  },
  {
    q: 'How do you control steel fabrication quality?',
    a: 'Quality control is organized by manufacturing stage: material grade and certificate verification at incoming inspection, dimensional and hole position checks after cutting, geometry and fit-up verification during assembly, visual and project-required NDT during welding, surface preparation and coating inspection after treatment, and final dimensional and marking verification before packing. Specific inspection methods and acceptance criteria are per project technical requirements.'
  },
  {
    q: 'Can complex steel structures be trial assembled before shipment?',
    a: 'Trial assembly or partial pre-assembly can be arranged for complex trusses, platforms, special connections and infrastructure structures where required by the project. Not all projects require full trial assembly. The need and scope of trial assembly are determined based on project complexity, client requirements and contract specifications.'
  },
  {
    q: 'How are components marked for overseas installation?',
    a: 'Components are marked and numbered based on shop drawings, installation sequence requirements and project identification systems. Each component is identified with its drawing reference, member ID and packing group. This helps overseas installation teams correctly identify, locate and erect components according to the installation sequence, reducing site confusion and errors.'
  },
  {
    q: 'What corrosion protection systems are available?',
    a: 'Surface protection options include painting systems, hot-dip galvanizing where applicable, and project-specific coating systems. The specific protection system is determined based on the project environment, corrosion category, client specification, local standards and design life requirements. We do not apply a one-size-fits-all coating system to all projects.'
  },
  {
    q: 'How are steel structures packed into containers?',
    a: 'Components are grouped and packed according to component type, weight, container loading sequence and export transport requirements. Long members may be segmented to fit container dimensions where required. Packing lists are included with each shipment, and components are protected against damage during transport. Optimized container loading can reduce freight cost in suitable projects, though actual savings vary by project size and component dimensions.'
  },
  {
    q: 'Do you provide local construction?',
    a: 'ZhongSai provides design/detailing coordination, steel structure fabrication, export supply and technical installation guidance. Local civil works, foundation construction, on-site labor installation and local government approvals are normally handled by local contractors or the project owner\'s appointed construction team. Specific scope is determined per project contract.'
  }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="hub-hero">
    <div class="hub-hero-bg" style="background-image: url('/images/manufacturing/real/factory-overview-9819.jpg')"></div>
    <div class="hub-hero-overlay"></div>
    <div class="container hub-hero-content">
      <div class="hub-breadcrumb">
        <a href="/en/">Home</a><span>/</span><span>Manufacturing & Quality</span>
      </div>
      <p class="eyebrow">MANUFACTURING · From Drawings to Export Delivery</p>
      <h1>Steel Structure Manufacturing<br>and Quality Control for Overseas Projects</h1>
      <p class="lead">Project-based steel fabrication for industrial buildings, warehouses, mining, infrastructure and other overseas steel structure projects, with controlled production, inspection, marking, packing and export delivery.</p>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="stat-number">~100,000 m²</span>
          <span class="stat-label">Manufacturing Base</span>
        </div>
        <div class="hero-stat">
          <span class="stat-number">~100,000 t</span>
          <span class="stat-label">Annual Capacity</span>
        </div>
        <div class="hero-stat">
          <span class="stat-number">300+</span>
          <span class="stat-label">Frontline Workers</span>
        </div>
        <div class="hero-stat">
          <span class="stat-number">Project-Based</span>
          <span class="stat-label">Fabrication & Export</span>
        </div>
      </div>
      <div class="hero-cta-group">
        <a href="#quote" class="btn btn-primary">Send Project Drawings for Manufacturing Review</a>
        <a href="/en/projects/" class="btn btn-secondary">View Project Evidence</a>
      </div>
    </div>
  </section>

  <!-- 01 Manufacturing Overview -->
  <section class="section" style="padding: 70px 0;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">Overview</p>
          <h2>From Approved Drawings to Export-Ready Components</h2>
        </div>
        <div>
          <p>ZhongSai provides project-based steel structure fabrication services, covering drawing review, shop detailing coordination, material preparation, CNC cutting, assembly & welding, dimensional inspection, surface treatment, component marking, packing and container loading.</p>
          <p style="margin-top: 12px;">Fabrication and inspection are conducted according to approved project drawings, shop drawings, project technical specifications and applicable project requirements. Specific materials, welding procedures, surface treatment and inspection parameters are determined per project requirements and contract terms.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Eight-Step Manufacturing Process -->
  <section class="manufacturing-process-section">
    <div class="container">
      <div class="section-heading reveal" style="margin-bottom: 40px;">
        <div>
          <p class="section-index">Process</p>
          <h2>From Drawings to Fabrication: 8-Step Manufacturing Process</h2>
        </div>
        <div>
          <p>Each step is organized according to approved project drawings and technical requirements, with quality control integrated at every stage.</p>
        </div>
      </div>
      <p style="font-size:13px;color:#16a34a;margin-bottom:16px;">All manufacturing steps above are performed at ZhongSai Dongguan / Huizhou manufacturing bases</p>
      <div class="process-grid">
        {manufacturingSteps.map((step, i) => (
          <div class={`process-card reveal reveal-delay-${(i % 4) + 1}`}>
            <div class="process-card-img">
              <img src={step.img} alt={step.title} loading={i < 2 ? "eager" : "lazy"} width="400" height="250">
              <span class="process-card-num">STEP {step.num}</span>
            </div>
            <div class="process-card-body">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 Raw Material Control -->
  <section class="section" style="padding: 70px 0; background: #f8fafc;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">Material</p>
          <h2>Raw Material Inspection and Traceability</h2>
        </div>
        <div>
          <p>Material control begins at incoming inspection and continues through production, ensuring that steel grades and material properties match project requirements.</p>
        </div>
      </div>
      <div class="quality-grid">
        <div class="quality-item reveal reveal-delay-1">
          <h4>Material Grade Confirmation</h4>
          <p>Steel plates and sections are verified against project-specified material grades and standards before entering production.</p>
        </div>
        <div class="quality-item reveal reveal-delay-2">
          <h4>Mill Certificates</h4>
          <p>Mill test certificates are collected and verified for incoming materials where required by project specifications and client requirements.</p>
        </div>
        <div class="quality-item reveal reveal-delay-3">
          <h4>Material Identification</h4>
          <p>Plates and sections are identified and tracked throughout production, maintaining traceability from incoming material to finished components.</p>
        </div>
        <div class="quality-item reveal reveal-delay-4">
          <h4>Incoming Inspection</h4>
          <p>Visual and dimensional checks are conducted on incoming materials, with surface quality, section dimensions and plate thickness verified per project requirements.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Cutting, Assembly & Welding -->
  <section class="section" style="padding: 70px 0;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">Production</p>
          <h2>CNC Cutting, Assembly and Welding</h2>
        </div>
        <div>
          <p>Core production processes are organized according to approved drawings and welding process requirements, with dimensional accuracy and welding quality controlled at each stage.</p>
        </div>
      </div>
            <div class="dual-path-grid" style="grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px;">
        <div class="dual-path-card reveal reveal-delay-1" style="padding: 0; overflow: hidden;">
          <div style="width: 100%; height: 180px; overflow: hidden; background: #e2e8f0;">
            <img src="/images/manufacturing/real/cutting-prep-9809.jpg" alt="CNC cutting and material preparation" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" width="400" height="180">
          </div>
          <div style="padding: 24px 28px;">
            <div class="path-icon" style="width: 48px; height: 48px; font-size: 16px; font-weight: 700; color:#fff; margin-bottom: 16px; display:flex; align-items:center; justify-content:center; background: #1e40af; border-radius: 8px;">01</div>
            <h3 style="font-size: 20px; margin-bottom: 12px; color: #0f172a;">CNC Cutting & Drilling</h3>
            <ul style="margin: 0; padding-left: 18px; color: #475569; font-size: 14px; line-height: 1.8;">
            <li>Plate cutting per shop drawings</li>
            <li>Section cutting and end preparation</li>
            <li>CNC drilling for bolted connections</li>
            <li>Hole position accuracy control</li>
            <li>Pre-assembly preparation</li>
            </ul>
          </div>
        </div>
        <div class="dual-path-card reveal reveal-delay-2" style="padding: 0; overflow: hidden;">
          <div style="width: 100%; height: 180px; overflow: hidden; background: #e2e8f0;">
            <img src="/images/manufacturing/real/assembly-welding-9821.jpg" alt="H-beam assembly and fit-up" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" width="400" height="180">
          </div>
          <div style="padding: 24px 28px;">
            <div class="path-icon" style="width: 48px; height: 48px; font-size: 16px; font-weight: 700; color:#fff; margin-bottom: 16px; display:flex; align-items:center; justify-content:center; background: #1e40af; border-radius: 8px;">02</div>
            <h3 style="font-size: 20px; margin-bottom: 12px; color: #0f172a;">Assembly & Fit-up</h3>
            <ul style="margin: 0; padding-left: 18px; color: #475569; font-size: 14px; line-height: 1.8;">
            <li>H-beam assembly and alignment</li>
            <li>Component fit-up per drawings</li>
            <li>Connection interface verification</li>
            <li>Geometric dimension control</li>
            <li>Welding preparation and sequencing</li>
            </ul>
          </div>
        </div>
        <div class="dual-path-card reveal reveal-delay-3" style="padding: 0; overflow: hidden;">
          <div style="width: 100%; height: 180px; overflow: hidden; background: #e2e8f0;">
            <img src="/images/manufacturing/real/welding-9820.jpg" alt="Steel structure welding quality control" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" width="400" height="180">
          </div>
          <div style="padding: 24px 28px;">
            <div class="path-icon" style="width: 48px; height: 48px; font-size: 16px; font-weight: 700; color:#fff; margin-bottom: 16px; display:flex; align-items:center; justify-content:center; background: #1e40af; border-radius: 8px;">03</div>
            <h3 style="font-size: 20px; margin-bottom: 12px; color: #0f172a;">Welding Quality</h3>
            <ul style="margin: 0; padding-left: 18px; color: #475569; font-size: 14px; line-height: 1.8;">
            <li>Welding per approved WPS where applicable</li>
            <li>Welding sequence and distortion control</li>
            <li>Visual inspection of all welds</li>
            <li>Project-required NDT (UT/MT/PT)</li>
            <li>Welder qualification per project requirements</li>
            </ul>
          </div>
        </div>
      </div>
  </section>

  <!-- 05 Dimensional Inspection & Trial Assembly -->
  <section class="section" style="padding: 70px 0; background: #f8fafc;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">Inspection</p>
          <h2>Dimensional Inspection and Trial Assembly</h2>
        </div>
        <div>
          <p>Final inspection ensures that component dimensions, connection interfaces and marking match project drawings, supporting correct overseas site assembly.</p>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 40px;" class="inspection-grid">
        <div class="reveal reveal-delay-1">
          <h3 style="font-size: 22px; margin-bottom: 20px; color: #0f172a;">Dimensional Inspection</h3>
          <div class="quality-grid" style="grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="quality-item" style="padding: 20px;">
              <h4 style="font-size: 15px;">Length & Straightness</h4>
              <p style="font-size: 13px;">Member length and straightness verified against drawing tolerances.</p>
            </div>
            <div class="quality-item" style="padding: 20px;">
              <h4 style="font-size: 15px;">Hole Position</h4>
              <p style="font-size: 13px;">Bolt hole positions and spacing checked for connection compatibility.</p>
            </div>
            <div class="quality-item" style="padding: 20px;">
              <h4 style="font-size: 15px;">Diagonal & Geometry</h4>
              <p style="font-size: 13px;">Diagonal measurements and assembly geometry verified for squareness.</p>
            </div>
            <div class="quality-item" style="padding: 20px;">
              <h4 style="font-size: 15px;">Connection Interface</h4>
              <p style="font-size: 13px;">Connection plates, end plates and interface dimensions checked for site fit.</p>
            </div>
          </div>
        </div>
        <div class="reveal reveal-delay-2">
          <h3 style="font-size: 22px; margin-bottom: 20px; color: #0f172a;">Trial Assembly When Required</h3>
          <p style="color: #475569; line-height: 1.8; margin-bottom: 20px;">For complex trusses, steel platforms, special connections, infrastructure structures and other complex projects, trial assembly or partial pre-assembly can be arranged where required by the project.</p>
          <p style="color: #475569; line-height: 1.8; margin-bottom: 20px;">Not all projects require full trial assembly. The need and scope of trial assembly are determined based on:</p>
          <ul style="color: #475569; line-height: 2; padding-left: 20px;">
            <li>Project complexity and connection type</li>
            <li>Client requirements and contract specifications</li>
            <li>Overseas site assembly constraints</li>
            <li>Component size and transport segmentation</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 Surface Treatment -->
  <section class="section" style="padding: 70px 0;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">Coating</p>
          <h2>Surface Preparation and Corrosion Protection</h2>
        </div>
        <div>
          <p>Surface protection systems are selected based on project environment, corrosion category, client specification and design life requirements.</p>
        </div>
      </div>
      <div class="quality-grid" style="margin-top: 40px;">
        <div class="quality-item reveal reveal-delay-1">
          <h4>Surface Cleaning</h4>
          <p>Steel surfaces are cleaned and prepared before coating, with rust, scale and contaminants removed per project requirements.</p>
        </div>
        <div class="quality-item reveal reveal-delay-2">
          <h4>Shot Blasting</h4>
          <p>Shot blasting or abrasive blasting may be arranged where required by the project specification, achieving the required surface cleanliness and profile.</p>
        </div>
        <div class="quality-item reveal reveal-delay-3">
          <h4>Painting Systems</h4>
          <p>Primer, intermediate and topcoat painting systems can be applied per project specification, with coating thickness and adhesion verified where required.</p>
        </div>
        <div class="quality-item reveal reveal-delay-4">
          <h4>Hot-Dip Galvanizing</h4>
          <p>Hot-dip galvanizing can be arranged for suitable components where specified by the project, providing corrosion protection for appropriate applications.</p>
        </div>
      </div>
      <div style="margin-top: 32px; padding: 24px; background: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 0 8px 8px 0;" class="reveal">
        <p style="margin: 0; color: #92400e; font-size: 14px; line-height: 1.7;"><strong>Important:</strong> The specific corrosion protection system is determined based on the project environment, corrosion category, client specification, local standards and design life requirements. We do not apply a one-size-fits-all coating system to all projects, and we do not guarantee fixed corrosion protection lifetimes without project-specific engineering analysis.</p>
      </div>
    </div>
  </section>

  <!-- 07 Component Marking for Overseas Installation -->
  <section class="dual-path-section">
    <div class="container">
      <div class="section-heading reveal" style="color: white; text-align: center; display: block; margin-bottom: 36px;">
        <p class="section-index" style="color: #f59e0b;">Marking</p>
        <h2 style="color: white; margin-bottom: 10px;">Component Marking for Overseas Installation</h2>
        <p style="color: rgba(255,255,255,0.65); max-width: 750px; margin: 0 auto;">Clear component marking and numbering reduces overseas site installation confusion, helping local contractors correctly identify, locate and erect each component according to the installation sequence.</p>
      </div>
      <div class="dual-path-grid" style="grid-template-columns: repeat(3, 1fr); gap: 20px;" class="marking-grid">
        <div class="dual-path-card reveal reveal-delay-1" style="padding: 28px 24px;">
          <div class="path-icon" style="width: 44px; height: 44px; font-size: 15px; font-weight: 700; color:#fff; margin-bottom: 14px;">01</div>
          <h3 style="font-size: 18px; margin-bottom: 8px;">Component ID</h3>
          <p style="font-size: 14px; margin-bottom: 0;">Each component is marked with a unique identification number corresponding to its position in the shop drawings and erection sequence.</p>
        </div>
        <div class="dual-path-card reveal reveal-delay-2" style="padding: 28px 24px;">
          <div class="path-icon" style="width: 44px; height: 44px; font-size: 15px; font-weight: 700; color:#fff; margin-bottom: 14px;">02</div>
          <h3 style="font-size: 18px; margin-bottom: 8px;">Drawing Reference</h3>
          <p style="font-size: 14px; margin-bottom: 0;">Marking includes drawing sheet references and member marks, allowing site teams to cross-reference components with installation drawings.</p>
        </div>
        <div class="dual-path-card reveal reveal-delay-3" style="padding: 28px 24px;">
          <div class="path-icon" style="width: 44px; height: 44px; font-size: 15px; font-weight: 700; color:#fff; margin-bottom: 14px;">03</div>
          <h3 style="font-size: 18px; margin-bottom: 8px;">Packing Group</h3>
          <p style="font-size: 14px; margin-bottom: 0;">Components are grouped by packing unit and container, with packing lists identifying which components are in each package and container.</p>
        </div>
        <div class="dual-path-card reveal reveal-delay-4" style="padding: 28px 24px;">
          <div class="path-icon" style="width: 44px; height: 44px; font-size: 15px; font-weight: 700; color:#fff; margin-bottom: 14px;">04</div>
          <h3 style="font-size: 18px; margin-bottom: 8px;">Installation Sequence</h3>
          <p style="font-size: 14px; margin-bottom: 0;">Where required by the project, marking can include erection sequence references to support organized site assembly and reduce installation errors.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 08 Packing & Container Loading -->
  <section class="section" style="padding: 70px 0; background: #f8fafc;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">Export</p>
          <h2>Packing and Container Loading</h2>
        </div>
        <div>
