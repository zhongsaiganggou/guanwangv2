---
// ZhongSai V2 - English Manufacturing & Quality Page (detail system rebuild)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const lang = 'en';
const title = 'Steel Structure Manufacturing & Quality Control | ZhongSai Factory';
const description = 'Project-based steel structure fabrication for overseas projects: raw material control, CNC cutting, assembly & welding, dimensional inspection, surface treatment, component marking, packing and export delivery.';
const canonical = 'https://zhongsai-steelstructure.com/en/manufacturing-quality/';

const heroStrip = ['Drawing Review', 'Material Preparation', 'Fabrication & Welding', 'Quality Control', 'Export Delivery Preparation'];

const flowSteps = ['Approved Drawings', 'Material Preparation', 'Fabrication', 'Inspection', 'Surface Treatment', 'Packing & Delivery'];

const mfgSteps = [
  {
    num: '01',
    title: 'Material Preparation',
    desc: 'Steel plates, sections and supporting materials are received, identified and prepared according to project specifications and material grade requirements.',
    img: '/images/company/factory-yard-gantry-crane.jpg',
    alt: 'Factory yard with gantry crane for steel material storage'
  },
  {
    num: '02',
    title: 'Cutting & Drilling',
    desc: 'CNC cutting and drilling equipment processes steel plates and sections according to shop drawings, with dimensional accuracy and hole positioning controlled.',
    img: '/images/manufacturing/real/cutting-prep-9809.jpg',
    alt: 'CNC cutting and material preparation at ZhongSai factory'
  },
  {
    num: '03',
    title: 'Fit-up & Welding',
    desc: 'Components are assembled and welded according to approved drawings and applicable project process requirements, with fit-up and welding distortion controlled.',
    img: '/images/manufacturing/real/assembly-welding-9821.jpg',
    alt: 'H-beam assembly and welding production line'
  },
  {
    num: '04',
    title: 'Dimensional Inspection / Trial Assembly',
    desc: 'Finished components are inspected for length, hole position, diagonal, straightness and connection interface accuracy; trial assembly arranged for complex projects where required.',
    img: '/images/manufacturing/real/qc-inspection.jpg',
    alt: 'QC dimensional inspection at ZhongSai factory'
  },
  {
    num: '05',
    title: 'Surface Treatment',
    desc: 'Surface cleaning, shot blasting, painting or hot-dip galvanizing may be arranged where required by the project environment, corrosion category and client specification.',
    img: '/images/manufacturing/real/painting.jpg',
    alt: 'Component surface painting at ZhongSai factory'
  },
  {
    num: '06',
    title: 'Marking, Packing & Delivery Preparation',
    desc: 'Components are marked and numbered based on shop drawings and installation sequence, grouped and packed for export, with packing lists included.',
    img: '/images/manufacturing/real/component-marking.jpg',
    alt: 'Export component marking and identification'
  }
];

const evidenceGallery = [
  { src: '/images/company/factory-steel-beam-fabrication.jpg', alt: 'Steel beam fabrication at ZhongSai production base', caption: 'Steel beam fabrication' },
  { src: '/images/components/finished-coated-components.jpg', alt: 'Finished and coated steel structure components', caption: 'Surface treated components' },
  { src: '/images/container-loading.jpg', alt: 'Steel structure components loaded into shipping container for export', caption: 'Container loading for export' }
];

const qcStages = [
  { stage: 'Material Preparation', control: 'Grade confirmation, mill certificate verification, material identification and traceability' },
  { stage: 'Cutting & Drilling', control: 'Dimension verification, cut surface quality, hole position accuracy' },
  { stage: 'Fit-up', control: 'Geometry verification, fit-up check, alignment control' },
  { stage: 'Welding', control: 'Visual inspection, welding process compliance, project-required NDT where specified' },
  { stage: 'Trial Assembly (where required)', control: 'Interface dimensions, hole positions, assembly coordination' },
  { stage: 'Surface Treatment', control: 'Surface preparation quality, coating thickness, galvanizing inspection where applicable' },
  { stage: 'Marking & Packing', control: 'Dimensional verification, component marking, packing list review' }
];

const surfacePoints = [
  { name: 'Surface Cleaning', desc: 'Steel surfaces are cleaned and prepared before coating, removing rust, mill scale and contaminants per project requirements.' },
  { name: 'Shot Blasting', desc: 'Shot blasting or sand blasting may be arranged per project specification to achieve required surface cleanliness and roughness.' },
  { name: 'Painting Systems', desc: 'Primer, intermediate and topcoat systems can be applied per project specification, with coating thickness and adhesion verified where required.' },
  { name: 'Hot-Dip Galvanizing', desc: 'Hot-dip galvanizing can be arranged for applicable components per project requirements for suitable applications.' }
];

const markingPoints = [
  { name: 'Component Marking', desc: 'Each component is identified with a unique reference corresponding to its position in shop drawings and erection sequence.' },
  { name: 'Drawing Reference', desc: 'Marking includes drawing number and member ID, allowing site teams to verify components against installation drawings.' },
  { name: 'Packing Grouping', desc: 'Components are grouped by packing unit and container, with packing lists showing the components in each pack and container.' },
  { name: 'Installation Sequence', desc: 'Where required by the project, marking may include erection sequence references to support orderly site assembly.' }
];

const projectTypes = [
  { name: 'Industrial Workshops', href: '/en/steel-workshop/' },
  { name: 'Warehouses & Logistics', href: '/en/steel-warehouse/' },
  { name: 'Mining & Heavy Industry', href: '/en/steel-mining-factory/' },
  { name: 'Steel Platforms', href: '/en/components/' },
  { name: 'Conveyor Galleries', href: '/en/components/' },
  { name: 'Pipe Racks', href: '/en/components/' },
  { name: 'Public & Infrastructure', href: '/en/transportation-infrastructure-steel/' },
  { name: 'Mezzanines, Platforms & Special Structures', href: '/en/special-custom-steel-structures/' }
];

const certifications = [
  { name: 'ISO 9001', desc: 'Quality management system', holder: 'Huizhou manufacturing base', valid: '2025-2028' },
  { name: 'ISO 14001', desc: 'Environmental management system', holder: 'Huizhou manufacturing base', valid: '2025-2028' },
  { name: 'ISO 45001', desc: 'Occupational health & safety management', holder: 'Huizhou manufacturing base', valid: '2025-2028' },
  { name: 'ISO 3834-2', desc: 'Comprehensive quality requirements for fusion welding', holder: 'Dongguan manufacturing base', valid: '2024-2027' },
  { name: 'EN 1090 EXC2', desc: 'CE/CPR for structural steel components', holder: 'Dongguan manufacturing base', valid: 'Since 2024' },
  { name: 'CIDB IBS', desc: 'Malaysian Industrialised Building System certification', holder: 'Malaysia partner / Huizhou factory', valid: '2026-2027' }
];

const faqs = [
  {
    q: 'Can ZhongSai manufacture based on client-issued drawings?',
    a: 'Yes. ZhongSai can fabricate steel structures based on client-issued structural drawings, general arrangement drawings and shop drawings. We can also support shop detailing coordination before production where required by the project. All fabrication is based on approved drawings and project technical specifications.'
  },
  {
    q: 'Can you support shop detailing before production?',
    a: 'Yes. ZhongSai can support structural detailing and shop drawing coordination as part of the project scope, including connection detailing, member scheduling and fabrication drawing preparation. The specific scope of detailing responsibility is determined per project contract and drawing requirements.'
  },
  {
    q: 'How do you control steel fabrication quality?',
    a: 'Quality control is organized by manufacturing stage: material grade and certificate verification at incoming inspection, dimensional and hole position checks after cutting, geometry and fit-up verification during assembly, visual and project-required NDT during welding, surface preparation and coating inspection after treatment, and final dimensional and marking verification before packing. Specific inspection methods and acceptance criteria are per project technical requirements.'
  },
  {
    q: 'Can complex steel structures be trial assembled before shipment?',
    a: 'Trial assembly or partial pre-assembly can be arranged for complex trusses, platforms, special connections and infrastructure structures where required by the project. Not all projects require full trial assembly. The need and scope of trial assembly are determined based on project complexity, client requirements and contract specifications.'
  },
  {
    q: 'How are components marked for overseas installation?',
    a: 'Components are marked and numbered based on shop drawings, installation sequence requirements and project identification systems. Each component is identified with its drawing reference, member ID and packing group. This helps overseas installation teams correctly identify, locate and erect components according to the installation sequence, reducing site confusion and errors.'
  },
  {
    q: 'Do you provide local construction?',
    a: 'ZhongSai provides design/detailing coordination, steel structure fabrication, export supply and technical installation guidance. Local civil works, foundation construction, on-site labor installation and local government approvals are normally handled by local contractors or the project owner\'s appointed construction team. Specific scope is determined per project contract.'
  }
];

const relatedLinks = [
  { name: 'Engineering Design', href: '/en/engineering-design/', desc: 'Structural coordination, shop detailing and connection engineering supporting fabrication.' },
  { name: 'Steel Workshop', href: '/en/steel-workshop/', desc: 'Industrial workshop and factory steel structures, fabricated to project drawings.' },
  { name: 'Steel Warehouse', href: '/en/steel-warehouse/', desc: 'Logistics and storage building structures with large-span capability.' },
  { name: 'Export Delivery', href: '/en/export-delivery/', desc: 'Container loading, export documentation and logistics coordination.' },
  { name: 'Project Cases', href: '/en/projects/', desc: 'Real project evidence showing ZhongSai fabrication and export delivery.' },
  { name: 'Steel Components', href: '/en/components/', desc: 'Steel beams, columns, trusses, platforms and fabricated components.' },
  { name: 'Mining & Heavy Industry', href: '/en/steel-mining-factory/', desc: 'Heavy steel structures for mining, energy and processing applications.' },
  { name: 'Contact & Quote', href: '/en/contact/', desc: 'Submit project drawings and technical requirements for manufacturing review.' }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/manufacturing/real/factory-overview-9819.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">MANUFACTURING · From Drawings to Export Delivery</span>
      <h1>Steel Structure Manufacturing<br>and Quality Control for Overseas Projects</h1>
      <p class="lead">Based on approved engineering and shop drawings, ZhongSai completes steel structure component cutting, fit-up, welding, inspection, surface treatment, marking and export delivery preparation at its Dongguan and Huizhou manufacturing bases.</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Send Drawings for Manufacturing Review</a>
        <a href="/en/export-delivery/" class="btn btn-outline">View Export Delivery</a>
      </div>
    </div>
  </section>

  <!-- Hero Evidence Strip -->
  <section class="detail-section" style="padding-top: 0;">
    <div class="container">
      <div class="hero-strip">
        {heroStrip.map(item => <span>{item}</span>)}
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <span class="current">Manufacturing & Quality</span>
    </div>
  </nav>

  <!-- 01 / Manufacturing Overview -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Overview</p>
        <h2>From Approved Drawings to Export-Ready Components</h2>
        <p>ZhongSai provides project-based steel structure fabrication services. Fabrication and inspection are conducted according to approved project drawings, shop drawings, project technical specifications and applicable project requirements. Specific materials, welding procedures, surface treatment and inspection parameters are determined per project requirements and contract terms.</p>
      </div>
      <figure class="office-evidence reveal">
        <img src="/images/engineering/design-office/design-office-drafting-chain.webp" alt="Design office team coordinating drawings at CAD workstations before fabrication" loading="lazy" width="1000" height="750">
        <figcaption>Design office drawing coordination — approved drawings handed over to fabrication</figcaption>
      </figure>
      <div class="export-chain" style="margin-top: 28px;">
        {flowSteps.map((step, i) => (
          <>{i > 0 && <span class="chain-arrow reveal">→</span>}<span class="chain-step reveal"><span class="chain-num">0{i + 1}</span>{step}</span></>
        ))}
      </div>
      <div class="stats-row reveal">
        <div class="stat-item"><span class="stat-number">~100,000 m²</span><span class="stat-label">Manufacturing Base</span></div>
        <div class="stat-item"><span class="stat-number">~100,000 t</span><span class="stat-label">Annual Capacity</span></div>
        <div class="stat-item"><span class="stat-number">300+</span><span class="stat-label">Frontline Workers</span></div>
        <div class="stat-item"><span class="stat-number">Project-Based</span><span class="stat-label">Fabrication & Export</span></div>
      </div>
    </div>
  </section>

  <!-- 02 / Manufacturing Process -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Process</p>
        <h2>Manufacturing Process: From Material to Export Components</h2>
        <p>Fabrication is organized according to approved drawings and project technical requirements, with inspection at each stage and key processes illustrated with real production photos.</p>
      </div>
      <div class="mfg-grid">
        {mfgSteps.map((step, i) => (
          <div class={`mfg-card reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="mfg-img">
              <img src={step.img} alt={step.alt} loading={i < 2 ? "eager" : "lazy"} width="400" height="220">
              <span class="mfg-num">{step.num}</span>
            </div>
            <div class="mfg-body">
              <h4>{step.title}</h4>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 / Real Manufacturing Evidence -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Evidence</p>
        <h2>Real Manufacturing Evidence</h2>
        <p>The photos below are taken at ZhongSai manufacturing bases and production lines — real factory and production photos, not AI-generated renders.</p>
      </div>
      <div class="evidence-strip">
        {evidenceGallery.map((item, i) => (
          <figure class={`evidence-item reveal reveal-delay-${i + 1}`}>
            <img src={item.src} alt={item.alt} loading="lazy" width="400" height="220">
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 / Quality Control by Stage -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Quality Table</p>
        <h2>Quality Control by Manufacturing Stage</h2>
        <p>Quality control is integrated at every manufacturing stage, with specific inspection activities organized per project technical specifications and contract terms.</p>
      </div>
      <div class="params-table-wrapper reveal">
        <table class="params-table">
          <thead>
            <tr>
              <th>Manufacturing Stage</th>
              <th>Typical Quality Control Activities</th>
            </tr>
          </thead>
          <tbody>
            {qcStages.map(row => (
              <tr>
                <td>{row.stage}</td>
                <td>{row.control}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="params-note reveal">Specific inspection methods, acceptance criteria and testing requirements are determined per project technical specifications and contract terms. Not all listed inspection activities are required for every project.</p>
    </div>
  </section>

  <!-- 05 / Welding & Assembly Control -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Process</p>
        <h2>Welding & Assembly Control</h2>
        <p>Welding and assembly are carried out according to approved drawings, applicable project process requirements and inspection requirements. Where specified by the project, non-destructive testing (UT/MT/PT) can be arranged; welder qualifications are confirmed per project requirements.</p>
      </div>
      <div class="weld-layout">
        <figure class="weld-img reveal">
          <img src="/images/manufacturing/real/welding-9820.jpg" alt="Steel structure welding process at ZhongSai manufacturing facility" loading="lazy" width="600" height="380">
          <figcaption>Steel component welding process</figcaption>
        </figure>
        <ul class="check-list reveal reveal-delay-1">
          <li><strong>Fit-up & Alignment</strong> — H-beam assembly and alignment, member fit-up per drawings</li>
          <li><strong>Interface Dimensions</strong> — Connection interface dimension verification, geometry control</li>
          <li><strong>Welding Sequence</strong> — Welding sequence and distortion control</li>
          <li><strong>Weld Inspection</strong> — Visual inspection of all welds, project-required NDT where specified</li>
          <li><strong>Welder Qualification</strong> — Welder qualifications confirmed per project requirements</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 06 / Surface Treatment & Protection -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Protection</p>
        <h2>Surface Treatment & Corrosion Protection</h2>
        <p>Surface protection systems are selected based on project environment, corrosion category, client specification and design life requirements.</p>
      </div>
      <div class="surf-layout">
        <div class="mf-points" style="margin: 0;">
          {surfacePoints.map((point, i) => (
            <div class={`mf-point reveal reveal-delay-${(i % 4) + 1}`}>
              <h4>{point.name}</h4>
              <p>{point.desc}</p>
            </div>
          ))}
        </div>
        <figure class="surf-img reveal">
          <img src="/images/manufacturing/real/shot-blasting.jpg" alt="Shot blasting surface preparation" loading="lazy" width="600" height="340">
          <figcaption>Shot blasting surface preparation</figcaption>
        </figure>
      </div>
      <div style="margin-top: 24px; padding: 18px 20px; background: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 0 8px 8px 0;" class="reveal">
        <p style="margin: 0; color: #92400e; font-size: 13.5px; line-height: 1.7;"><strong>Important:</strong> The specific corrosion protection system is determined based on project environment, corrosion category, client specification, local standards and design life requirements. We do not apply a one-size-fits-all coating system to all projects, and do not commit to a fixed protection life without project engineering analysis.</p>
      </div>
    </div>
  </section>

  <!-- 07 / Marking & Export Delivery Preparation -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Marking</p>
        <h2>Component Marking & Export Delivery Preparation</h2>
        <p>Clear component marking and identification reduce confusion during overseas installation, helping local contractors correctly identify, locate and erect each component in the installation sequence.</p>
      </div>
      <div class="mark-layout">
        <div class="mark-grid">
          {markingPoints.map((point, i) => (
            <div class={`mf-point reveal reveal-delay-${(i % 4) + 1}`}>
              <h4>{point.name}</h4>
              <p>{point.desc}</p>
            </div>
          ))}
        </div>
        <figure class="mark-img reveal">
          <img src="/images/manufacturing/real/component-marking.jpg" alt="Export component marking and identification" loading="lazy" width="600" height="340">
          <figcaption>Component marking and identification</figcaption>
        </figure>
      </div>
      <p class="params-note reveal">Components are packed and loaded to prevent transport damage and optimize container space. Over-length members may be segmented to fit standard container dimensions where required, with bolted splice connections for site assembly. Packing lists are included with each shipment. Optimized container loading can reduce freight cost in suitable projects, though actual savings vary by project. See <a href="/en/export-delivery/" style="color: #1e3a5f; font-weight: 600;">Export Delivery →</a></p>
    </div>
  </section>

  <!-- 08 / Manufacturing Bases & Certifications -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Bases</p>
        <h2>Manufacturing Bases & Certifications</h2>
        <p>ZhongSai operates manufacturing bases in Dongguan and Huizhou for steel structure component fabrication, inspection, surface treatment, marking, packing and export delivery preparation.</p>
      </div>
      <div class="cert-grid">
        {certifications.map((cert, i) => (
          <div class={`cert-card reveal reveal-delay-${(i % 3) + 1}`}>
            <h4>{cert.name}</h4>
            <p>{cert.desc}</p>
            <span class="cert-meta">Holder: {cert.holder} · {cert.valid}</span>
          </div>
        ))}
      </div>
      <div style="margin-top: 20px; padding: 18px 20px; background: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 0 8px 8px 0;" class="reveal">
        <p style="margin: 0; color: #92400e; font-size: 13px; line-height: 1.7;"><strong>Note:</strong> Certificate holder, certificate number, validity and scope should be confirmed against the original certificate documents. Where certificates are held by related manufacturing bases or entities rather than the exporting company itself, the relationship is stated clearly. We do not claim certifications that do not apply to the relevant entity or scope.</p>
      </div>
    </div>
  </section>

  <!-- 09 / Project-Based Fabrication -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Project Types</p>
        <h2>Project-Based Steel Structure Fabrication</h2>
        <p>ZhongSai is not a standard SKU steel supplier. We fabricate steel structures according to project drawings and technical requirements, covering a wide range of project types and structural systems.</p>
      </div>
      <div class="type-chips reveal">
        {projectTypes.map(pt => (
          <a href={pt.href} class="type-chip">{pt.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- 10 / Scope & Responsibility Boundary -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Responsibility</p>
        <h2>Supply Scope & Local Responsibility Boundary</h2>
        <p>A clear supply scope helps clients understand which work ZhongSai performs and which remains with the local team.</p>
      </div>
      <div class="boundary-grid">
        <div class="reveal" style="padding: 24px 26px; background: #ecfdf5; border: 1px solid #a7f3d0;">
          <h3 style="font-size: 16px; color: #065f46; margin: 0 0 12px; display: flex; align-items: center; gap: 10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>
            ZhongSai Provides
          </h3>
          <ul style="margin: 0; padding-left: 18px; color: #065f46; font-size: 13px; line-height: 2;">
            <li>Steel structure fabrication per approved drawings</li>
            <li>Shop detailing coordination before production (per project scope)</li>
            <li>Stage-by-stage quality inspection and trial assembly where required</li>
            <li>Component marking, packing and container loading</li>
            <li>Export supply and technical installation guidance</li>
          </ul>
        </div>
        <div class="reveal reveal-delay-1" style="padding: 24px 26px; background: #fef2f2; border: 1px solid #fecaca;">
          <h3 style="font-size: 16px; color: #991b1b; margin: 0 0 12px; display: flex; align-items: center; gap: 10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
            Remains Local Responsibility
          </h3>
          <ul style="margin: 0; padding-left: 18px; color: #991b1b; font-size: 13px; line-height: 2;">
            <li>Local civil works and foundation construction</li>
            <li>Site erection and labor installation</li>
            <li>Local government approvals and permits</li>
            <li>Local code compliance and acceptance</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 11 / Related Capabilities -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Related</p>
        <h2>Related Capabilities & Project Evidence</h2>
        <p>Learn about the engineering capability, project types and export delivery services supporting ZhongSai fabrication.</p>
      </div>
      <div class="related-links related-4col">
        {relatedLinks.map((link, i) => (
          <a href={link.href} class={`related-link-card reveal reveal-delay-${(i % 4) + 1}`}>
            <h4>{link.name}</h4>
            <p>{link.desc}</p>
            <span class="rl-arrow">Learn More →</span>
          </a>
        ))}
      </div>
      <div class="section-heading reveal" style="margin-top: 52px;">
        <p class="section-index">Real Projects</p>
        <h2>Real Projects Through This Manufacturing Process</h2>
        <p>The steel components of the following projects were fabricated, inspected and delivered through ZhongSai's manufacturing process.</p>
      </div>
      <div class="rp-grid">
        <a href="/en/projects/guangzhou-high-end-equipment-base/" class="related-project-card reveal">
          <div class="rpc-image">
            <img src="/images/projects/guangzhou-gongkong-high-end-equipment-base-aerial-rendering.jpg" alt="Guangzhou High-End Equipment R&D Production Base" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">Industrial Manufacturing</span>
            <h4>Guangzhou High-End Equipment R&D Production Base</h4>
            <p class="rpc-location">Guangzhou, Guangdong</p>
            <p class="rpc-data">60m span · ~9,800 t</p>
            <p class="rpc-scope"><span>ZhongSai Scope:</span> Steel structure fabrication & supply</p>
          </div>
        </a>
        <a href="/en/projects/zhanjiang-logistics-port/" class="related-project-card reveal reveal-delay-1">
          <div class="rpc-image">
            <img src="/images/projects/shenzhen-international-zhanjiang-logistics-port-aerial-rendering.jpg" alt="Zhanjiang Integrated Logistics Port" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">Logistics & Warehousing</span>
            <h4>Zhanjiang Integrated Logistics Port</h4>
