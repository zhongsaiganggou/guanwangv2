---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const title = 'Mining & Heavy Industry Steel Structures | ZhongSai';
const description = 'Engineered steel structures for mining plants, processing facilities, conveyor systems, equipment platforms and heavy industrial applications.';
const lang = 'en';
const canonical = 'https://zhongsai-steelstructure.com/en/steel-mining-factory/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero - Complex Industrial Capability -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/products/app-mining-energy-hero.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">Mining · Energy · Heavy Industrial Steel Fabrication</span>
      <h1>Steel Structures for Mining, Energy and Heavy Industrial Projects</h1>
      <p class="lead">Engineered steel structures for mining plants, processing facilities, conveyor systems, equipment platforms and other heavy industrial applications. From complex structural detailing to heavy-duty fabrication and export packing, we deliver steel components for demanding industrial environments.</p>
      <div class="hero-capabilities">
        <div class="cap-item">
          <span class="cap-icon">📐</span>
          <span>Complex Structural Detailing</span>
        </div>
        <div class="cap-item">
          <span class="cap-icon">🏭</span>
          <span>Heavy-Duty Fabrication</span>
        </div>
        <div class="cap-item">
          <span class="cap-icon">🛡️</span>
          <span>Project-Specific Surface Protection</span>
        </div>
        <div class="cap-item">
          <span class="cap-icon">🚢</span>
          <span>Export Packing and Delivery</span>
        </div>
      </div>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Send Drawings for Technical Review</a>
        <a href="#quote-info" class="btn btn-outline">Discuss Your Industrial Project</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/products/">Products</a>
      <span class="sep">/</span>
      <span class="current">Mining & Heavy Industry</span>
    </div>
  </nav>

  <!-- 01 Typical Applications -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Applications</p>
        <h2>Typical Heavy Industrial Steel Structure Applications</h2>
        <p>Mining, energy and heavy industrial projects require specialized steel structures designed for heavy loads, equipment support, corrosive environments and complex connection details.</p>
      </div>
      <div class="app-grid">
        <div class="app-card reveal reveal-delay-1">
          <h3>Mining Processing Plants</h3>
          <p>Steel structures for mineral processing plants, crushing and screening facilities, and ore handling buildings.</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h3>Mineral Processing Facilities</h3>
          <p>Support structures for processing equipment, multi-level platforms and material handling systems.</p>
        </div>
        <div class="app-card reveal reveal-delay-3">
          <h3>Conveyor Galleries</h3>
          <p>Steel conveyor support structures, transfer towers and gallery frames for bulk material handling.</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h3>Equipment Support Platforms</h3>
          <p>Industrial steel platforms, equipment support frames and maintenance access structures.</p>
        </div>
        <div class="app-card reveal-delay-delay-2">
          <h3>Pipe Racks</h3>
          <p>Steel pipe rack structures for industrial piping, cable trays and utility support systems.</p>
        </div>
        <div class="app-card reveal reveal-delay-3">
          <h3>Crusher / Screening Structures</h3>
          <p>Heavy-duty support frames for crushers, screens and material processing equipment.</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h3>Power and Energy Facilities</h3>
          <p>Steel structures for power plants, energy facilities and industrial process buildings.</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h3>Heavy Machinery Platforms</h3>
          <p>Support structures for heavy machinery, industrial equipment and process systems.</p>
        </div>
        <div class="app-card reveal reveal-delay-3">
          <h3>Industrial Maintenance Platforms</h3>
          <p>Access platforms, stair systems and maintenance structures for industrial facilities.</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h3>Large-Span Industrial Buildings</h3>
          <p>Wide-span steel frame buildings for heavy industrial operations, maintenance and storage.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Key Engineering Considerations -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Engineering Considerations</p>
        <h2>Key Engineering Considerations for Heavy Industrial Steel Structures</h2>
        <p>Heavy industrial steel structures require careful engineering analysis across multiple load types and environmental conditions. All design parameters are project-specific and determined based on approved drawings, applicable codes and client specifications.</p>
      </div>
      <div class="engineering-grid">
        <div class="eng-card reveal reveal-delay-1">
          <h4>Concentrated Equipment Loads</h4>
          <p>Heavy equipment creates concentrated loads at specific support points, requiring reinforced connections and load distribution analysis.</p>
        </div>
        <div class="eng-card reveal reveal-delay-2">
          <h4>Dynamic Loads</h4>
          <p>Operating machinery and process equipment generate dynamic loads that require fatigue analysis and vibration consideration in structural design.</p>
        </div>
        <div class="eng-card reveal reveal-delay-3">
          <h4>Vibration</h4>
          <p>Equipment-induced vibration affects structural performance, requiring vibration analysis and appropriate connection detailing.</p>
        </div>
        <div class="eng-card reveal reveal-delay-1">
          <h4>Crane Loads</h4>
          <p>Overhead crane systems impose vertical and horizontal loads on columns and foundations, requiring reinforced structural members.</p>
        </div>
        <div class="eng-card reveal reveal-delay-2">
          <h4>Conveyor Loads</h4>
          <p>Conveyor systems impose distributed and point loads along support structures, requiring coordinated structural and equipment interface design.</p>
        </div>
        <div class="eng-card reveal reveal-delay-3">
          <h4>Wind Loads</h4>
          <p>Elevated structures, conveyor galleries and tall platforms are subject to wind loads determined by project location and applicable codes.</p>
        </div>
        <div class="eng-card reveal reveal-delay-1">
          <h4>Seismic Requirements</h4>
          <p>Seismic zone requirements influence structural configuration, connection design and member sizing per local building codes.</p>
        </div>
        <div class="eng-card reveal reveal-delay-2">
          <h4>Corrosive Environments</h4>
          <p>Mining, chemical and coastal environments require corrosion-resistant material selection and surface protection systems.</p>
        </div>
        <div class="eng-card reveal reveal-delay-3">
          <h4>Maintenance Access</h4>
          <p>Industrial structures require safe maintenance access, including platforms, stairs, handrails and equipment removal provisions.</p>
        </div>
        <div class="eng-card reveal reveal-delay-1">
          <h4>Connection Complexity</h4>
          <p>Heavy industrial structures often require complex bolted and welded connections with multiple load paths and interface requirements.</p>
        </div>
        <div class="eng-card reveal reveal-delay-2">
          <h4>Transportation Size Limits</h4>
          <p>Oversized components require modular fabrication planning to fit container or project-specific logistics constraints.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Engineering Parameters Table -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Engineering Parameters</p>
        <h2>Typical Engineering Parameters for Heavy Industrial Structures</h2>
        <p>All parameters below are project-based references. Actual values must be determined per project drawings, load calculations, equipment specifications and applicable design codes. ZhongSai fabricates per approved project drawings.</p>
      </div>
      <div class="params-table-wrapper">
        <table class="params-table">
          <thead>
            <tr>
              <th>Parameter</th>
              <th>Project Basis</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Structural Type</strong></td>
              <td>Platform / truss / frame / gallery / support structure</td>
            </tr>
            <tr>
              <td><strong>Main Steel Grade</strong></td>
              <td>According to drawings and applicable code</td>
            </tr>
            <tr>
              <td><strong>Equipment Load</strong></td>
              <td>Project specific, per equipment manufacturer data</td>
            </tr>
            <tr>
              <td><strong>Dynamic Load</strong></td>
              <td>Project specific, per operating conditions and analysis</td>
            </tr>
            <tr>
              <td><strong>Crane Requirement</strong></td>
              <td>If applicable, per crane capacity and duty class</td>
            </tr>
            <tr>
              <td><strong>Connection</strong></td>
              <td>Bolted / welded / combined, per project drawings</td>
            </tr>
            <tr>
              <td><strong>Surface Protection</strong></td>
              <td>Painting / galvanizing / project-specific coating system</td>
            </tr>
            <tr>
              <td><strong>Corrosion Category</strong></td>
              <td>According to project environment and client specification</td>
            </tr>
            <tr>
              <td><strong>Design Standard</strong></td>
              <td>Based on project country / client specification</td>
            </tr>
            <tr>
              <td><strong>Fabrication Tolerance</strong></td>
              <td>According to approved drawings and project requirements</td>
            </tr>
            <tr>
              <td><strong>Export Method</strong></td>
              <td>Container / project-specific logistics</td>
            </tr>
            <tr>
              <td><strong>Installation Support</strong></td>
              <td>Technical guidance available</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="params-note"><strong>Note:</strong> No universal standard values are provided for heavy industrial structures. Each project requires structural analysis based on actual equipment loads, operating conditions, site environment and applicable design codes. ZhongSai provides fabrication and export supply based on approved project drawings.</p>
    </div>
  </section>

  <!-- 04 Conveyor Gallery -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Conveyor Structures</p>
        <h2>Steel Conveyor Galleries and Transfer Structures</h2>
        <p>Conveyor systems are critical infrastructure in mining, ports, power plants and bulk material handling facilities. Steel conveyor galleries and transfer structures require specialized engineering for span, support, dynamic loads and equipment interface.</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/projects/cnooc-pr6-pipe-rack-frame-aerial-rendering.jpg" alt="Steel conveyor gallery and transfer structure" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Key Engineering Considerations for Conveyor Structures</h3>
          <ul>
            <li><strong>Conveyor gallery span</strong> — span determined by support spacing, conveyor loads and structural analysis</li>
            <li><strong>Support structure</strong> — columns, bracing and foundations designed for vertical and lateral loads</li>
            <li><strong>Transfer stations</strong> — multi-level structures for material transfer points with equipment support platforms</li>
            <li><strong>Maintenance access</strong> — walkways, stairs and access platforms for conveyor inspection and maintenance</li>
            <li><strong>Wind loads</strong> — elevated gallery structures subject to wind loads per project location and codes</li>
            <li><strong>Dynamic loads</strong> — conveyor operation generates dynamic loads requiring structural analysis</li>
            <li><strong>Equipment interface</strong> — coordinated connection points for conveyor supports, drives and accessories</li>
            <li><strong>Modular transportation limits</strong> — gallery sections fabricated to fit container or project logistics constraints</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Equipment Platform -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Equipment Platforms</p>
        <h2>Industrial Equipment Platforms and Support Structures</h2>
        <p>Heavy industrial equipment requires robust support platforms designed for concentrated loads, vibration, maintenance access and equipment interface. ZhongSai fabricates equipment platforms and support structures per project drawings and equipment specifications.</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/projects/cnpc-sixth-construction-cracking-furnace-equipment-detail.jpg" alt="Industrial equipment platform and support structure" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Equipment Platform Design Considerations</h3>
          <ul>
            <li><strong>Equipment support</strong> — platform designed for specific equipment weights, footprints and load distribution</li>
            <li><strong>Maintenance access</strong> — safe access for equipment inspection, maintenance and component replacement</li>
            <li><strong>Live load</strong> — platform live loads per applicable codes and operational requirements</li>
            <li><strong>Concentrated load</strong> — equipment point loads analyzed and distributed through structural framing</li>
            <li><strong>Stair and handrail</strong> — access stairs, handrails and guardrails per safety requirements</li>
            <li><strong>Equipment interface</strong> — coordinated connection points and embedments for equipment installation</li>
            <li><strong>Future maintenance</strong> — provisions for equipment removal, replacement and ongoing maintenance access</li>
          </ul>
          <div style="margin-top: 20px;">
            <a href="/en/components/steel-trusses/" class="btn btn-outline">View Steel Trusses & Platforms</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 Corrosion Protection -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Surface Protection</p>
        <h2>Surface Protection for Harsh Industrial Environments</h2>
        <p>Mining, energy and heavy industrial environments often expose steel structures to corrosive conditions including moisture, chemical exposure, salt air and abrasive materials. Appropriate surface protection is critical for long-term structural durability.</p>
      </div>
      <div class="corrosion-grid">
        <div class="corr-card reveal reveal-delay-1">
          <h4>Painting Systems</h4>
          <p>Multi-coat paint systems including primer, intermediate and topcoat layers, specified per project environment, corrosion category and client requirements. Coating thickness and quality checked before packing.</p>
        </div>
        <div class="corr-card reveal reveal-delay-2">
          <h4>Hot-Dip Galvanizing</h4>
          <p>Hot-dip galvanizing provides corrosion protection for components suitable for galvanizing bath dimensions. Galvanizing thickness and quality verified per applicable standards.</p>
        </div>
        <div class="corr-card reveal reveal-delay-3">
          <h4>Project-Specific Coating Systems</h4>
          <p>Specialized coating systems for highly corrosive environments, including chemical-resistant coatings, epoxy systems and other project-specified protection methods per client requirements and design specifications.</p>
        </div>
      </div>
      <p style="margin-top: 24px; color: #666; font-size: 0.92rem; text-align: center;">Specific corrosion protection systems are determined based on project environment category, client specification, applicable standards and design service life. No fixed corrosion lifespan guarantees are provided without project-specific engineering analysis.</p>
    </div>
  </section>

  <!-- 07 Fabrication Quality -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Fabrication Quality</p>
        <h2>Fabrication and Quality Control for Heavy Industrial Components</h2>
        <p>Heavy industrial steel components require rigorous fabrication quality control. ZhongSai operates a 100,000 m² production base with 100,000 tonnes annual capacity, implementing traceable material handling and in-process quality inspection throughout fabrication.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/manufacturing/real/cutting-9809.jpg');"></div>
          <div class="feature-body">
            <h3>Material Traceability</h3>
            <p>Steel materials tracked from procurement through fabrication with material certificates and identification marking maintained throughout production.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/manufacturing/real/welding-9820.jpg');"></div>
          <div class="feature-body">
            <h3>Cutting & Welding</h3>
            <p>CNC cutting and qualified welding processes per project specifications, with welding procedure qualification and in-process inspection.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/manufacturing/real/assembly-9821.jpg');"></div>
          <div class="feature-body">
            <h3>Dimensional Inspection</h3>
            <p>Finished components dimensionally checked against approved drawings and project tolerances before surface treatment and packing.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/manufacturing/real/assembly-9821.jpg');"></div>
          <div class="feature-body">
            <h3>Trial Assembly & Packing</h3>
            <p>Trial assembly performed if required by project specification. Components marked, packed and prepared for container loading with packing lists.</p>
          </div>
        </div>
      </div>
      <div style="margin-top: 28px; display: flex; gap: 16px; flex-wrap: wrap;">
        <a href="/en/manufacturing-quality/" class="btn btn-outline">View Manufacturing & Quality</a>
        <a href="/en/products/custom-engineering/" class="btn btn-outline">View Engineering & Detailing</a>
      </div>
    </div>
  </section>

  <!-- 08 Information Required for Quotation -->
  <section class="detail-section alt" id="quote-info">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Quotation Information</p>
        <h2>Information Required for Technical Review and Quotation</h2>
        <p>Accurate technical review and quotation for heavy industrial steel structures require complete project information. The following details directly influence structural design, member sizing, fabrication requirements, surface protection and packing/export planning.</p>
      </div>
      <div class="quote-info-grid">
        <div class="quote-info-card drawing">
          <h4>Project & Design Information</h4>
          <ul>
            <li>Project country / location</li>
            <li>General arrangement drawings</li>
            <li>Structural drawings and details</li>
            <li>Equipment layout and support points</li>
            <li>Load information (dead, live, equipment, dynamic)</li>
            <li>Design code and applicable standards</li>
            <li>Material specification and grade requirements</li>
          </ul>
        </div>
        <div class="quote-info-card no-drawing">
          <h4>Fabrication & Delivery Requirements</h4>
          <ul>
            <li>Surface treatment and coating requirements</li>
            <li>Fabrication tolerance specifications</li>
            <li>Trial assembly requirements (if any)</li>
            <li>Delivery port / destination</li>
            <li>Project schedule and delivery timeline</li>
            <li>Packing and marking requirements</li>
            <li>Inspection and documentation requirements</li>
          </ul>
        </div>
      </div>
      <div style="margin-top: 24px; text-align: center;">
        <a href="#quote" class="btn btn-primary">Upload Drawings for Review</a>
      </div>
      <p class="quote-note">* Technical review and quotation require project-specific drawings and load information. Preliminary assessment possible with basic project parameters, but accurate pricing requires complete technical documentation.</p>
    </div>
  </section>

  <!-- 09 Related Projects -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Related Projects</p>
        <h2>Heavy Industrial & Energy Project References</h2>
        <p>Selected heavy industrial and energy projects demonstrating ZhongSai's steel structure fabrication and supply capability for complex industrial applications.</p>
      </div>
      <div class="project-grid">
        <a href="/en/projects/cnooc-pr6-pipe-rack/" class="project-card reveal reveal-delay-1">
          <div class="project-img" style="background-image: url('/images/projects/cnooc-pr6-pipe-rack-frame-aerial-rendering.jpg');"></div>
          <div class="project-body">
            <span class="project-type">Energy · Pipe Rack</span>
            <h3>CNOOC PR6 Pipe Rack Structure</h3>
            <div class="project-meta">
              <span>📍 Guangdong, China</span>
            </div>
            <p class="project-scope">Industrial pipe rack steel structure fabrication and supply for CNOOC energy facility, including multi-level support framing and utility structures.</p>
          </div>
        </a>
        <a href="/en/projects/cnpc-cracking-furnace/" class="project-card reveal reveal-delay-2">
          <div class="project-img" style="background-image: url('/images/projects/cnpc-sixth-construction-cracking-furnace-aerial-view.jpg');"></div>
          <div class="project-body">
            <span class="project-type">Petrochemical · Furnace</span>
            <h3>CNPC Cracking Furnace Steel Structure</h3>
            <div class="project-meta">
              <span>📍 China</span>
            </div>
            <p class="project-scope">Large-scale petrochemical cracking furnace steel structure, including main frame, multi-level equipment platforms and support systems.</p>
          </div>
        </a>
        <a href="/en/projects/cnpc-liquid-furnace/" class="project-card reveal reveal-delay-3">
          <div class="project-img" style="background-image: url('/images/projects/cnpc-sixth-construction-liquid-furnace-aerial-view.jpg');"></div>
          <div class="project-body">
            <span class="project-type">Petrochemical · Furnace</span>
            <h3>CNPC Liquid Furnace Steel Structure</h3>
            <div class="project-meta">
              <span>📍 China</span>
            </div>
            <p class="project-scope">Petrochemical liquid furnace steel structure project with main frame, equipment platforms and multi-level support systems for industrial process facility.</p>
          </div>
        </a>
        <a href="/en/projects/guangzhou-high-end-equipment-base/" class="project-card reveal reveal-delay-1">
          <div class="project-img" style="background-image: url('/images/projects/guangzhou-gongkong-high-end-equipment-base-aerial-rendering.jpg');"></div>
          <div class="project-body">
            <span class="project-type">Industrial · Heavy Equipment</span>
            <h3>Guangzhou High-End Equipment Base</h3>
            <div class="project-meta">
              <span>📍 Guangzhou, China</span>
            </div>
            <p class="project-scope">Modern high-end equipment R&D and production base with large-span, high-height steel structure workshops suitable for heavy equipment manufacturing.</p>
          </div>
        </a>
      </div>
      <div style="margin-top: 28px; text-align: center;">
        <a href="/en/projects/" class="btn btn-outline">View All Projects</a>
      </div>
    </div>
  </section>

  <!-- Service Boundary -->
  <section class="detail-section dark">
    <div class="container">
      <div class="section-heading reveal" style="text-align: center;">
        <p class="section-index" style="justify-content: center;">Service Boundary</p>
        <h2 style="color: #fff;">What ZhongSai Provides and Does Not Provide</h2>
        <p style="margin: 0 auto;">Clear service scope for mining and heavy industrial projects.</p>
      </div>
      <div class="geo-boundary">
        <div class="geo-box include">
          <h4>ZhongSai Provides</h4>
          <ul>
            <li>Drawings review and fabrication drawing support</li>
            <li>Structural steel component fabrication per project drawings</li>
            <li>Steel beams, columns, trusses, platforms, pipe racks and custom members</li>
            <li>Complex connection fabrication per approved drawings</li>
            <li>Surface treatment (painting, galvanizing, project-specific coating)</li>
            <li>Component marking, packing and container loading</li>
            <li>Export documentation support and logistics coordination</li>
            <li>Overseas installation technical guidance</li>
          </ul>
        </div>
        <div class="geo-box exclude">
          <h4>ZhongSai Does Not Directly Undertake</h4>
          <ul>
            <li>Local construction or erection at project site</li>
            <li>Local foundation construction</li>
            <li>Mining operation or mineral processing</li>
            <li>Local general contracting / EPC</li>
            <li>Mining equipment supply or process engineering</li>
            <li>Conveyor equipment manufacturing</li>
            <li>Customs brokerage as a licensed customs broker</li>
            <li>Freight forwarding as a licensed freight forwarder</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 10 FAQ -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal" style="text-align: center;">
        <p class="section-index" style="justify-content: center;">FAQ</p>
        <h2>Frequently Asked Questions About Heavy Industrial Steel Structures</h2>
      </div>
      <div class="detail-faq">
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Can ZhongSai fabricate steel structures based on client-issued drawings?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Yes. ZhongSai fabricates steel structures based on client-issued structural drawings, fabrication drawings and project specifications. We review drawings for fabrication feasibility, provide detailing support where required, and manufacture components per approved technical documentation. Complete drawings with load information, connection details and material specifications are required for accurate fabrication.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Can you support mining conveyor and equipment platform projects?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Yes. ZhongSai has experience fabricating steel structures for conveyor galleries, transfer stations, equipment support platforms, pipe racks and industrial process buildings. We fabricate structural steel components per project drawings, including complex connections, multi-level platforms and support framing. We do not manufacture conveyor equipment itself, but provide the structural steel support systems.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
