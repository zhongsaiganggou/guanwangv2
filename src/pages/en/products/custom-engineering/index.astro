---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../../components/QuoteForm.astro';
import ExportDeliveryCTA from '../../../../components/ExportDeliveryCTA.astro';
import EngineeringServiceGuide from '../../../../components/EngineeringServiceGuide.astro';
import '../../../../styles/detail.css';

const title = 'Structural Steel Fabrication in China | Custom Fabrication | ZhongSai';
const description = 'ZhongSai Steel Structure provides structural steel fabrication in China for overseas projects. We fabricate steel beams, columns, trusses and custom...';
const lang = 'en';
const canonical = 'https://zhongsai-steelstructure.com/en/products/custom-engineering/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/company/factory-steel-beam-fabrication.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">Custom Fabrication · Drawing-Based</span>
      <h1>Structural Steel Fabrication in China for Overseas Projects</h1>
      <p class="lead">ZhongSai is a China-based structural steel fabrication and export supplier. We fabricate steel components from project drawings, shop drawings and technical specifications — from drawing review to packing and container loading — delivering custom steel fabrication for overseas contractors, engineering firms and procurement teams.</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Submit Drawings for Review</a>
        <a href="/en/manufacturing-quality/" class="btn btn-outline">View Manufacturing Capability</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/products/">Products</a>
      <span class="sep">/</span>
      <span class="current">Custom Engineering & Fabrication</span>
    </div>
  </nav>

  <EngineeringServiceGuide lang="en" current="custom-engineering" />

  <!-- 01 Custom Fabrication to Project Drawings -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Drawing-Based Fabrication</p>
        <h2>Custom Structural Steel Fabrication from Project Drawings</h2>
        <p>ZhongSai fabricates steel components based on customer-provided structural drawings, shop drawings, technical specifications and Bill of Quantities (BOQ). Specific materials, dimensions, welding requirements and surface treatment are determined per project drawings and technical requirements.</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/manufacturing/real/steel-welding-assembly-9822.jpg" alt="ZhongSai structural steel fabrication from drawings" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>From Drawings to Fabricated Components</h3>
          <p>ZhongSai operates its own production base, fabricating steel beams, columns, trusses, bracing and custom steel members per project drawings.</p>
          <ul>
            <li>Fabrication organized from structural and shop drawings</li>
            <li>Manufacturing requirements controlled per project technical specifications</li>
            <li>BOQ component list verification and quotation support</li>
            <li>Specific steel grades, welding procedures and inspection requirements per project agreement</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 What We Can Fabricate -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">What We Fabricate</p>
        <h2>What Structural Steel Components Can ZhongSai Fabricate</h2>
        <p>Based on project drawings and technical requirements, ZhongSai can fabricate the following types of steel components. Specific fabrication scope and technical requirements are confirmed per project drawings.</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>Steel Beams</h3>
          <p>H-beams, box beams, composite beams, fabricated per drawing dimensions and welding requirements.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>Steel Columns</h3>
          <p>H-columns, box columns, lattice columns, fabricated per project structural drawings.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>Steel Trusses</h3>
          <p>Pipe trusses, H-beam trusses, fabricated per connection details and welding requirements.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>Bracing & Connections</h3>
          <p>Column bracing, roof bracing, gusset plates, connection plates and other accessory members.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>Platforms & Custom Members</h3>
          <p>Equipment platforms, access platforms, stairs and custom irregular steel members.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>Secondary Steel Members</h3>
          <p>Purlins, tie rods, knee braces and other secondary members, supplied with the primary structure.</p>
        </div>
      </div>
      <div style="margin-top: 24px;">
        <a href="/en/components/" class="btn btn-outline">View Components & Materials</a>
      </div>
    </div>
  </section>

  <!-- 03 From Drawings to Fabrication -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Fabrication Process</p>
        <h2>Drawing-to-Export Fabrication Process</h2>
        <p>The following is a brief overview of the drawing-based fabrication process. For detailed manufacturing, quality control and the 8-step fabrication process, please view the manufacturing capability page.</p>
      </div>
      <div class="process-flow">
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">01</div>
          <h4>Project Submission</h4>
          <p>Drawings, BOQ, specifications and project country</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">02</div>
          <h4>Drawing Review</h4>
          <p>Structural drawing and fabrication feasibility review</p>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">03</div>
          <h4>Detailing Coordination</h4>
          <p>Shop drawing and fabrication drawing coordination</p>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">04</div>
          <h4>Material Preparation</h4>
          <p>Steel and accessory materials organized per project requirements</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>Fabrication</h4>
          <p>Cutting, assembly, welding, straightening, drilling</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">06</div>
          <h4>Surface Treatment</h4>
          <p>Shot blasting and coating arranged where required per project</p>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">07</div>
          <h4>Marking & Packing</h4>
          <p>Component marking, numbering and packing for container loading</p>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">08</div>
          <h4>Export Delivery</h4>
          <p>Export documentation support and logistics coordination</p>
        </div>
      </div>
      <div style="margin-top: 24px;">
        <a href="/en/manufacturing-quality/" class="btn btn-outline">View Detailed 8-Step Manufacturing Process</a>
      </div>
    </div>
  </section>

  <!-- 04 Drawing & BOQ Requirements -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Drawing & BOQ Requirements</p>
        <h2>What Information Is Needed for a Fabrication Quotation</h2>
        <p>The more complete the drawings and technical documentation, the more accurate the review and quotation. If documentation is incomplete, you can first submit available materials, and ZhongSai will further confirm what is needed for fabrication and quotation.</p>
      </div>
      <div class="quote-info-grid">
        <div class="quote-info-card drawing">
          <h4>Have Complete Drawings</h4>
          <ul>
            <li>Structural drawings (architectural / structural)</li>
            <li>Shop drawings (if available)</li>
            <li>Bill of Quantities (BOQ)</li>
            <li>Project technical specifications</li>
            <li>Project country</li>
            <li>Surface treatment and special requirements</li>
          </ul>
        </div>
        <div class="quote-info-card no-drawing">
          <h4>Incomplete Documentation</h4>
          <ul>
            <li>Project country</li>
            <li>Available drawings or sketches</li>
            <li>Component types and approximate quantities</li>
            <li>Project use and basic dimensions</li>
            <li>Known technical requirements</li>
            <li>Submit available materials for initial review</li>
          </ul>
        </div>
      </div>
      <p class="quote-note">* PDF drawings, BOQ or other available project documents can be submitted for initial review. Additional drawings, specifications or technical information may be required before the final fabrication scope and quotation are confirmed.</p>
    </div>
  </section>

  <!-- 05 Fabrication for Export Projects -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Export Project Fabrication</p>
        <h2>Structural Steel Fabrication for Overseas Export Projects</h2>
        <p>ZhongSai provides drawing-based steel component fabrication for overseas contractors, engineering firms and procurement teams, with export packing, container loading and delivery preparation support.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/container-loading.jpg');"></div>
          <div class="feature-body">
            <h3>Packing & Container Loading</h3>
            <p>Components may be marked and numbered based on shop drawings and project requirements. Packing is organized by component type, container loading sequence and export transport requirements, supporting container loading.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/manufacturing/real/workshop-overview-wide-9815.jpg');"></div>
          <div class="feature-body">
            <h3>Export Documentation & Logistics</h3>
            <p>Export documentation support and logistics coordination are provided. ZhongSai does not act as a customs broker or freight forwarder. Local construction and erection are performed by the customer or local construction team.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 Why Work With ZhongSai -->
  <section class="detail-section dark">
    <div class="container">
      <div class="section-heading reveal" style="text-align: center;">
        <p class="section-index" style="justify-content: center;">Why ZhongSai</p>
        <h2 style="color: #fff;">Core Capabilities for Drawing-Based Fabrication</h2>
        <p style="margin: 0 auto;">ZhongSai's manufacturing and export capabilities include:</p>
      </div>
      <div class="requirement-grid" style="grid-template-columns: repeat(3, 1fr);">
        <div class="requirement-card reveal reveal-delay-1" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15);">
          <div class="req-icon" style="background: rgba(245,158,11,0.2); color:#fff;">01</div>
          <h3 style="color: #fff;">15+ Years Export Experience</h3>
          <p style="color: rgba(255,255,255,0.7);">Steel structure and overseas project experience</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15);">
          <div class="req-icon" style="background: rgba(245,158,11,0.2); color:#fff;">02</div>
          <h3 style="color: #fff;">100,000 m² Production Base</h3>
          <p style="color: rgba(255,255,255,0.7);">Own factory covering key fabrication stages</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15);">
          <div class="req-icon" style="background: rgba(245,158,11,0.2); color:#fff;">03</div>
          <h3 style="color: #fff;">100,000 Tonnes Annual Capacity</h3>
          <p style="color: rgba(255,255,255,0.7);">Steel component annual production capability</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15);">
          <div class="req-icon" style="background: rgba(245,158,11,0.2); color:#fff;">04</div>
          <h3 style="color: #fff;">300+ Frontline Workers</h3>
          <p style="color: rgba(255,255,255,0.7);">Fabrication, welding, assembly and packing team</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15);">
          <div class="req-icon" style="background: rgba(245,158,11,0.2); color:#fff;">05</div>
          <h3 style="color: #fff;">ISO 9001</h3>
          <p style="color: rgba(255,255,255,0.7);">ZhongSai follows ISO 9001 quality management system requirements</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3" style="background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15);">
          <div class="req-icon" style="background: rgba(245,158,11,0.2); color:#fff;">06</div>
          <h3 style="color: #fff;">Export Delivery Capability</h3>
          <p style="color: rgba(255,255,255,0.7);">Packing, container loading, export documentation support and logistics coordination</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 Related Capabilities -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Related Capabilities</p>
        <h2>Related Capabilities & Pages</h2>
      </div>
      <div class="related-links">
        <a href="/en/components/" class="related-link-card reveal reveal-delay-1">

          <h4>Components & Materials</h4>
          <p>Steel beams, columns, trusses, purlins and cladding systems</p>
          <span class="rl-arrow">View Details →</span>
        </a>
        <a href="/en/manufacturing-quality/" class="related-link-card reveal reveal-delay-2">

          <h4>Manufacturing & Quality Control</h4>
          <p>8-step fabrication process, quality control and packing for export</p>
          <span class="rl-arrow">View Details →</span>
        </a>
        <a href="/en/components/fabricated-steel-beams-columns/" class="related-link-card reveal reveal-delay-3">

          <h4>Steel Beams & Columns</h4>
          <p>Custom fabricated steel beams and columns from drawings</p>
          <span class="rl-arrow">View Details →</span>
        </a>
        <a href="/en/components/roof-wall-cladding-systems/" class="related-link-card reveal reveal-delay-1">

          <h4>Roof & Wall Cladding Systems</h4>
          <p>Roof panels, wall panels and supporting cladding materials</p>
          <span class="rl-arrow">View Details →</span>
        </a>
        <a href="/en/steel-workshop/" class="related-link-card reveal reveal-delay-2">

          <h4>Industrial Workshop</h4>
          <p>Steel structure industrial workshop solutions</p>
          <span class="rl-arrow">View Details →</span>
        </a>
        <a href="/en/steel-warehouse/" class="related-link-card reveal reveal-delay-3">

          <h4>Steel Warehouse</h4>
          <p>Steel structure warehouse and logistics building solutions</p>
          <span class="rl-arrow">View Details →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 08 FAQ -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal" style="text-align: center;">
        <p class="section-index" style="justify-content: center;">FAQ</p>
        <h2>Frequently Asked Questions About Drawing-Based Fabrication</h2>
      </div>
      <div class="detail-faq">
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Can ZhongSai fabricate structural steel from customer drawings?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Yes. ZhongSai fabricates steel components based on customer-provided structural drawings, shop drawings and technical specifications. Specific materials, dimensions, welding requirements and surface treatment are determined per project drawings and technical requirements. Fabrication can be arranged after drawing review.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>What drawings are required for a fabrication quotation?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Ideally, you should provide structural drawings, shop drawings, Bill of Quantities (BOQ), project technical specifications and project country. If documentation is incomplete, you can first submit available materials, and ZhongSai will further confirm what is needed for fabrication and quotation. PDF drawings, BOQ or other available project documents can be submitted for initial review. Additional drawings, specifications or technical information may be required before the final fabrication scope and quotation are confirmed.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Can ZhongSai supply only fabricated steel components?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Yes. ZhongSai can supply steel beams, columns, trusses, bracing and custom steel components separately based on project drawings, or together with roof and wall cladding systems. The supply scope is determined per project requirements. ZhongSai provides manufacturing, export supply and overseas installation technical guidance. Local construction and erection are performed by the customer or local construction team.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Can fabricated steel be packed and prepared for export?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Yes. Components may be marked and numbered based on shop drawings and project requirements. Packing is organized by component type, container loading sequence and export transport requirements, supporting container loading. ZhongSai provides export documentation support and logistics coordination, but does not act as a customs broker or freight forwarder.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 Quote CTA + QuoteForm -->

  <ExportDeliveryCTA lang="en" />
  <section class="detail-section dark" id="quote">
    <div class="container">
      <div class="section-heading reveal" style="text-align: center;">
        <p class="section-index" style="justify-content: center; color: #f59e0b;">Get Quotation</p>
        <h2 style="color: #fff;">Have Drawings or BOQ? Submit for Project Review</h2>
        <p style="margin: 0 auto; color: rgba(255,255,255,0.75);">Submit project drawings, BOQ and technical requirements. ZhongSai will conduct an initial review and confirm what is needed for quotation.</p>
      </div>
      <QuoteForm lang="en" />
    </div>
  </section>
</BaseLayout>

<script>
  // FAQ toggle
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item.classList.contains('open');
      item.classList.toggle('open');
      btn.setAttribute('aria-expanded', !isOpen);
      const answer = item.querySelector('.faq-answer');
      if (answer) answer.hidden = !answer.hidden;
    });
  });

  // Scroll reveal
  const revealElements = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    revealElements.forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(24px)';
      el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      observer.observe(el);
    });
  }
</script>
