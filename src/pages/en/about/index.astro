      </div>
      <div class="cert-wall">
        {certifications.map(cert => (
          <div class="cert-wall-item">
            <div class="cert-wall-image">
              <img src={cert.image} alt={cert.title + ' certificate'} loading="lazy" />
            </div>
            <p class="cert-wall-label">{cert.title}</p>
          </div>
        ))}
      </div>
      <p class="cert-wall-note">Certificates shown at reduced resolution for information security. Full verification documents available for qualified project discussions.</p>
    </div>
  </section>

  <!-- Section 06b

  <!-- Section: Supplier Verification -->
  <section class="hub-section hub-section-light">
    <div class="container">
      <div class="hub-section-head">
        <h2>Supplier Verification · Buyer FAQs</h2>
        <p>Company entity and capability verification for engineering firms, contractors, EPCs and procurement teams.</p>
      </div>
      <div class="verify-grid">
        <div class="verify-item">
