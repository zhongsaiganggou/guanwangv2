---
// ZhongSai V2 - English About Us Page
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/hub.css';
import '../../../styles/detail.css';

const lang = 'en';
const title = 'About ZhongSai | Steel Structure Manufacturing & Export';
const description = 'Learn about ZhongSai Steel Structure, a China-based manufacturer and export supplier with Dongguan and Huizhou production bases, providing design detailing, fabrication, quality control, packing and container loading, export delivery and installation technical support.';

const coreFacts = [
  { num: '15+', label: 'Years Export Experience' },
  { num: '100,000 m²', label: 'Production Base' },
  { num: '100,000 Tonnes', label: 'Annual Capacity' },
  { num: '300+', label: 'Frontline Workers' }
];

const services = [
  {
    num: '01',
    title: 'Design & Detailing Support',
    desc: 'Structural design coordination and shop drawing preparation based on project requirements and confirmed drawings.'
  },
  {
    num: '02',
    title: 'Steel Fabrication',
    desc: 'Cutting, assembly, welding, straightening, drilling and custom component fabrication organized according to project drawings.'
  },
  {
    num: '03',
    title: 'Structural Steel Components',
    desc: 'Supply of fabricated steel beams, columns, trusses, bracing, secondary members and cladding systems as required.'
  },
  {
    num: '04',
    title: 'Packing & Container Loading',
    desc: 'Component marking, packing lists and container loading plans coordinated according to component type and export requirements.'
  },
  {
    num: '05',
    title: 'Export Documentation & Logistics',
    desc: 'Export documentation support and logistics coordination for overseas project delivery, organized according to project scope.'
  },
  {
    num: '06',
    title: 'Overseas Installation Guidance',
    desc: 'Installation drawings, video resources and technical guidance to support the customer or local construction team during erection.'
  }
];

const certifications = [
  {
    title: 'ISO 9001',
    desc: 'Quality management system certification for steel structure fabrication and project coordination.',
    image: '/images/certifications/iso-9001-quality.jpg',
    certNo: 'NOA2502483',
    valid: '2025 - 2028'
  },
  {
    title: 'ISO 14001',
    desc: 'Environmental management system certification for steel structure manufacturing operations.',
    image: '/images/certifications/iso-14001-environmental.jpg',
    certNo: 'NOA2502482',
    valid: '2025 - 2028'
  },
  {
    title: 'ISO 45001',
    desc: 'Occupational health and safety management system certification for production facilities.',
    image: '/images/certifications/iso-45001-occupational.jpg',
    certNo: 'NOA2502481',
    valid: '2025 - 2028'
  },
  {
    title: 'EU CE Marking (EN 1090)',
    desc: 'CE certification for structural steel components, execution class up to EXC2, compliant with EU Construction Product Regulation.',
    image: '/images/certifications/en-1090-ce.jpg',
    certNo: '1381-CPR-902',
    valid: '2024 - Ongoing'
  },
  {
    title: 'ISO 3834-2 Welding Quality',
    desc: 'Comprehensive quality requirements for fusion welding of metallic materials, certified by SGS.',
    image: '/images/certifications/iso-3834-welding.jpg',
    certNo: '24/1028-3834',
    valid: '2024 - 2027'
  },
  {
    title: 'Malaysia CIDB IBS',
    desc: 'Industrialised Building System assessment and certification for the Malaysian market, covering metal framing and structural steel components.',
    image: '/images/certifications/malaysia-cidb-ibs.jpg',
    certNo: 'IBS231/039',
    valid: '2026 - 2027'
  }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/manufacturing/real/factory-aerial-panorama.jpg')"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <div class="hub-breadcrumb">
        <a href="/en/">Home</a><span>/</span><span>About ZhongSai</span>
      </div>
      <p class="eyebrow">ABOUT ZHONGSAI</p>
      <h1>Steel Structure Manufacturing for Overseas Projects</h1>
      <p class="lead">ZhongSai Steel Structure is a China-based steel structure manufacturer and export supplier supporting overseas factories, warehouses and engineered steel building projects from detailing and fabrication to packing, export coordination and overseas installation technical guidance.</p>
    </div>
  </section>

  <!-- 01: Who We Are -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">01 · WHO WE ARE</div>
        <h2>A Steel Structure Manufacturer Built for Export Projects</h2>
      </div>
      <div class="about-intro">
        <p>ZhongSai Steel Structure supports overseas project owners, engineering companies, contractors and procurement teams with structural steel manufacturing and export supply.</p>
        <p>Our work focuses on translating confirmed project requirements and drawings into fabricated steel components prepared for export delivery.</p>
        <p>Depending on project scope, ZhongSai may support detailing, fabrication, component supply, packing, container loading, export documentation coordination and overseas installation technical guidance.</p>
        <p><strong>Local erection and construction are handled by the customer or local construction team.</strong></p>
      </div>
      <div class="about-facts">
        {coreFacts.map(fact => (
          <div class="about-fact-card">
            <div class="about-fact-num">{fact.num}</div>
            <div class="about-fact-label">{fact.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 02: Company Facts -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">02 · COMPANY FACTS</div>
        <h2>Company Information</h2>
      </div>
      <div class="company-facts-grid">
        <div class="company-fact-item">
          <span class="cf-label">Brand Name</span>
          <span class="cf-value">ZhongSai Steel Structure</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">Core Business</span>
          <span class="cf-value">Steel Structure Detailing, Fabrication & Export Supply</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">Manufacturing Base</span>
          <span class="cf-value">Dongguan / Huizhou, Guangdong, China</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">Design Team</span>
          <span class="cf-value">Structural Design & Detailing Team</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">Delivery Team</span>
          <span class="cf-value">Project Delivery & Export Coordination Team</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">Export Markets</span>
          <span class="cf-value">60+ countries: Southeast Asia, Middle East, Africa, South America</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 03: Real Manufacturing -->
  <section class="detail-section dark">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">03 · MANUFACTURING</div>
        <h2>Real Factory. Real Manufacturing.</h2>
        <p>Real photos from our production bases, covering the main processes from steel preparation to surface treatment.</p>
      </div>
      <div class="factory-main">
        <img src="/images/manufacturing/real/factory-overview-9819.jpg" alt="ZhongSai steel structure factory production floor overview" width="1320" height="420" loading="lazy">
      </div>
      <div class="factory-grid">
        <figure class="factory-tile">
          <img src="/images/manufacturing/real/cutting-prep-9809.jpg" alt="CNC cutting and steel preparation" width="400" height="300" loading="lazy">
          <figcaption>CNC Cutting</figcaption>
        </figure>
        <figure class="factory-tile">
          <img src="/images/manufacturing/real/welding-9820.jpg" alt="Steel welding and fabrication" width="400" height="300" loading="lazy">
          <figcaption>Welding</figcaption>
        </figure>
        <figure class="factory-tile">
          <img src="/images/manufacturing/real/assembly-welding-9821.jpg" alt="Steel assembly and fabrication workshop" width="400" height="300" loading="lazy">
          <figcaption>Assembly</figcaption>
        </figure>
        <figure class="factory-tile">
          <img src="/images/components/finished-coated-components.jpg" alt="Finished coated steel components and surface treatment" width="400" height="300" loading="lazy">
          <figcaption>Surface Treatment</figcaption>
        </figure>
      </div>
      <p class="factory-caption">Approximately 100,000 m² of production base covering cutting, assembly, welding, surface treatment, quality inspection, component marking and packing for export delivery.</p>
    </div>
  </section>

  <!-- 04: What We Support -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">04 · WHAT WE SUPPORT</div>
        <h2>What ZhongSai Supports</h2>
      </div>
      <div class="requirement-grid">
        {services.map(svc => (
          <div class="requirement-card">
            <div class="req-icon">{svc.num}</div>
            <h3>{svc.title}</h3>
            <p>{svc.desc}</p>
          </div>
        ))}
      </div>

      <div class="geo-boundary">
        <div class="geo-box include">
          <h4>ZhongSai Provides</h4>
          <ul>
            <li>Project requirement coordination</li>
            <li>Design / detailing support</li>
            <li>Fabrication</li>
            <li>Component and material supply</li>
            <li>Packing and container loading</li>
            <li>Export documentation and logistics coordination</li>
            <li>Overseas installation technical guidance</li>
          </ul>
        </div>
        <div class="geo-box exclude">
          <h4>Customer / Local Team Handles</h4>
          <ul>
            <li>Local civil and foundation works</li>
            <li>On-site erection and labor</li>
            <li>Local permits and statutory approvals</li>
            <li>Inland transport and lifting on site</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 05: Quality & Certifications -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">05 · QUALITY & CERTIFICATIONS</div>
        <h2>Quality & Certifications</h2>
        <p>Certificate numbers and validity periods are listed below. Please refer to each certificate for the certificate holder relationship.</p>
      </div>
      <div class="cert-grid">
        {certifications.map(cert => (
          <div class="cert-card">
            <div class="cert-card-image">
              <img src={cert.image} alt={cert.title + ' certificate'} loading="lazy">
            </div>
            <div class="cert-card-content">
              <h3>{cert.title}</h3>
              <p>{cert.desc}</p>
              <div class="cert-card-meta">
                <span>Certificate No.: {cert.certNo}</span>
                <span>Validity: {cert.valid}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="cert-note">Full verification documents can be provided during qualified project discussions.</p>
    </div>
  </section>

  <!-- 06: Representative Projects -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">06 · PROJECTS</div>
        <h2>Representative Projects</h2>
        <p>The structural steel components of the following projects were detailed, fabricated and export-delivered by ZhongSai.</p>
      </div>
      <div class="rp-grid">
        <a href="/en/projects/singapore-airport-t2-connect/" class="related-project-card">
          <div class="rpc-image">
            <img src="/images/projects/overseas/singapore-airport-t2-connect.jpg" alt="Singapore Changi Airport T2 Connect project" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">Overseas Project</span>
            <h4>Singapore Changi Airport T2 Connect</h4>
            <p class="rpc-location">Singapore</p>
            <p class="rpc-data">4,600 tonnes · 209 Kingposts</p>
            <p class="rpc-scope"><span>ZhongSai Scope:</span> Detailing, Fabrication & Export Supply</p>
          </div>
        </a>
        <a href="/en/projects/macau-londoner/" class="related-project-card">
          <div class="rpc-image">
            <img src="/images/projects/overseas/macau-londoner.jpg" alt="Macau Londoner project" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">Overseas Project</span>
            <h4>Macau Londoner</h4>
            <p class="rpc-location">Macau, China</p>
            <p class="rpc-data">8,000 tonnes · Complex structure</p>
            <p class="rpc-scope"><span>ZhongSai Scope:</span> Detailing, Fabrication & Supply</p>
          </div>
        </a>
        <a href="/en/projects/zhanjiang-logistics-port/" class="related-project-card">
          <div class="rpc-image">
            <img src="/images/projects/shenzhen-international-zhanjiang-logistics-port-aerial-rendering.jpg" alt="Zhanjiang Logistics Port project" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">Logistics & Warehousing</span>
            <h4>Zhanjiang Comprehensive Logistics Port</h4>
            <p class="rpc-location">Zhanjiang, Guangdong</p>
            <p class="rpc-data">100,000 m² · 3,160 tonnes</p>
            <p class="rpc-scope"><span>ZhongSai Scope:</span> Steel Structure Fabrication & Supply</p>
          </div>
        </a>
      </div>
      <div class="rp-more">
        <a href="/en/projects/" class="btn btn-secondary">View All Projects →</a>
      </div>
    </div>
  </section>

  <!-- 07: FAQ -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">07 · FAQ</div>
        <h2>Frequently Asked Questions About ZhongSai</h2>
      </div>
      <div class="detail-faq">
        <details class="faq-item">
          <summary>Is ZhongSai a steel structure manufacturer or trading company?</summary>
          <p>ZhongSai is a steel structure project supplier with a design/detailing team, Guangdong manufacturing bases and a project delivery team. We handle export, project management and manufacturing coordination — not a simple steel trading company.</p>
        </details>
        <details class="faq-item">
          <summary>Where is ZhongSai's manufacturing base?</summary>
          <p>ZhongSai steel components are fabricated at Dongguan and Huizhou production bases in Guangdong, China, with approximately 100,000 m² of factory area and 100,000 tonnes annual capacity.</p>
        </details>
        <details class="faq-item">
          <summary>Does ZhongSai have its own design team?</summary>
          <p>ZhongSai has a structural design and detailing team for design coordination, connection detailing, fabrication drawings and manufacturing/transport/assembly interface coordination. Design responsibility is determined by project contract and local regulations.</p>
        </details>
        <details class="faq-item">
          <summary>Who manages overseas project delivery and export?</summary>
          <p>The project delivery team coordinates production schedules, component marking, packing plans, container loading, export documentation and shipping. Our delivery capability is steel structure project delivery coordination, not international freight forwarding.</p>
        </details>
        <details class="faq-item">
          <summary>Which countries does ZhongSai export to?</summary>
          <p>ZhongSai steel structure projects are exported to 60+ countries across Southeast Asia, the Middle East, Africa and South America, including Singapore, Malaysia, Indonesia, Saudi Arabia, Nigeria, Brazil and others.</p>
        </details>
        <details class="faq-item">
          <summary>Can customers visit the factory?</summary>
          <p>Qualified project clients can arrange visits to ZhongSai's Guangdong production bases for manufacturing capability and quality control verification. Please contact our project team in advance to schedule a visit.</p>
        </details>
        <details class="faq-item">
          <summary>What certifications does ZhongSai hold?</summary>
          <p>ZhongSai and its manufacturing bases hold ISO 9001 Quality Management, ISO 14001 Environmental Management, ISO 45001 Occupational Health & Safety, EU CE (EN 1090 EXC2), ISO 3834-2 Welding Quality, and Malaysia CIDB IBS certifications. Please refer to certificate details for the certificate holder relationships.</p>
        </details>
        <details class="faq-item">
          <summary>Does ZhongSai provide local construction and installation?</summary>
          <p>ZhongSai provides design/detailing, fabrication, export supply and installation technical guidance. Local civil works, physical construction and on-site erection are normally handled by the client or local contractors. On-site technical personnel can be arranged for specific projects subject to contract scope.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- 08: Quote -->
  <section class="detail-section dark" id="quote">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">08 · SEND REQUIREMENTS</div>
        <h2>Have Drawings or a Project Requirement?</h2>
      </div>
      <div class="quote-intro">
        <p>If you have drawings or a BOQ, submit them for an initial project assessment.</p>
        <p>If drawings are not yet available, provide the project country, building type, intended use and any dimensions you have.</p>
      </div>
      <QuoteForm lang="en" />
    </div>
  </section>
</BaseLayout>

<style>
/* Intro */
.about-intro {
  max-width: 800px;
  margin: 0 auto 56px;
}
.about-intro p {
  margin-bottom: 16px;
  font-size: 16px;
  line-height: 1.8;
  color: #475569;
}

/* Core facts */
.about-facts {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  max-width: 1000px;
  margin: 0 auto;
}
.about-fact-card {
  padding-top: 14px;
  border-top: 2px solid #f59e0b;
}
.about-fact-num {
  font-size: 2.2rem;
  font-weight: 800;
  line-height: 1;
  color: #0f172a;
  margin-bottom: 10px;
}
.about-fact-label {
  font-size: 0.9rem;
  color: #64748b;
}

/* Factory gallery */
.factory-main {
  border-radius: 2px;
  overflow: hidden;
  margin-bottom: 16px;
}
.factory-main img {
  width: 100%;
  height: 420px;
  object-fit: cover;
  display: block;
}
.factory-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.factory-tile {
  position: relative;
  margin: 0;
  border-radius: 2px;
  overflow: hidden;
  background: #0b1720;
}
.factory-tile img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
.factory-tile:hover img {
  transform: scale(1.05);
}
.factory-tile figcaption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24px 12px 8px;
  font-size: 12.5px;
  color: #ffffff;
  background: linear-gradient(180deg, rgba(8,15,28,0) 0%, rgba(8,15,28,0.85) 100%);
}
.factory-caption {
  margin-top: 24px;
  font-size: 14px;
  line-height: 1.75;
  color: rgba(255,255,255,0.72);
}

/* Cert grid */
.cert-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.cert-card {
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 2px;
  overflow: hidden;
}
.cert-card-image {
  height: 200px;
  overflow: hidden;
  background: #f5f5f5;
}
.cert-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
}
.cert-card-content {
  padding: 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.cert-card-content h3 {
  font-size: 15px;
  color: #0f172a;
  margin: 0 0 8px;
}
.cert-card-content p {
  font-size: 13px;
  line-height: 1.6;
  color: #64748b;
  margin: 0 0 12px;
}
.cert-card-meta {
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid #e5e7eb;
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 12.5px;
  color: #64748b;
}
.cert-note {
  text-align: center;
  font-size: 13px;
  color: #94a3b8;
  font-style: italic;
  margin-top: 24px;
}

/* Quote intro */
.quote-intro {
  max-width: 700px;
  margin: 0 auto 36px;
  text-align: center;
}
.quote-intro p {
  margin-bottom: 8px;
  font-size: 15px;
  color: rgba(255,255,255,0.8);
}

@media (max-width: 1024px) {
  .factory-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 900px) {
  .about-facts {
    grid-template-columns: repeat(2, 1fr);
    max-width: 560px;
  }
  .cert-grid {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 600px) {
  .about-facts {
    gap: 16px;
  }
  .about-fact-num {
    font-size: 1.8rem;
  }
  .factory-main img {
    height: 240px;
  }
  .factory-grid {
    grid-template-columns: 1fr;
  }
  .factory-tile img {
    height: 200px;
  }
}
</style>
