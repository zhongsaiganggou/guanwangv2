---
// ZhongSai V2 - English About Us Page
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/hub.css';
import '../../../styles/manufacturing.css';

const lang = 'en';
const title = 'About ZhongSai | Steel Structure Manufacturing & Export';
const description = 'Learn about ZhongSai Steel Structure, a China-based steel structure manufacturer and export supplier providing detailing, fabrication, packing, export...';

const coreFacts = [
  { num: '15+', label: 'Years Export Experience' },
  { num: '100,000 m²', label: 'Production Base' },
  { num: '100,000 Tonnes', label: 'Annual Capacity' },
  { num: '300+', label: 'Frontline Workers' }
];

const services = [
  {
    num: '01',
    title: 'Design & Detailing Support',
    desc: 'Structural design coordination and shop drawing preparation based on project requirements and confirmed drawings.'
  },
  {
    num: '02',
    title: 'Steel Fabrication',
    desc: 'Cutting, assembly, welding, straightening, drilling and custom component fabrication organized according to project drawings.'
  },
  {
    num: '03',
    title: 'Structural Steel Components',
    desc: 'Supply of fabricated steel beams, columns, trusses, bracing, secondary members and cladding systems as required.'
  },
  {
    num: '04',
    title: 'Packing & Container Loading',
    desc: 'Component marking, packing lists and container loading plans coordinated according to component type and export requirements.'
  },
  {
    num: '05',
    title: 'Export Documentation & Logistics',
    desc: 'Export documentation support and logistics coordination for overseas project delivery, organized according to project scope.'
  },
  {
    num: '06',
    title: 'Overseas Installation Guidance',
    desc: 'Installation drawings, video resources and technical guidance to support the customer or local construction team during erection.'
  }
];

const supplyChain = [
  { num: '01', title: 'Project Requirements', desc: 'Project country, building use, dimensions and available drawings are reviewed.' },
  { num: '02', title: 'Design / Detailing Coordination', desc: 'Structural design and shop drawing coordination based on confirmed project scope.' },
  { num: '03', title: 'Fabrication', desc: 'Steel components fabricated according to confirmed drawings and project specifications.' },
  { num: '04', title: 'Inspection', desc: 'Manufacturing and inspection organized according to project drawings and technical requirements.' },
  { num: '05', title: 'Component Marking & Packing', desc: 'Component marking and packing organized according to confirmed drawings and export requirements.' },
  { num: '06', title: 'Container Loading', desc: 'Container loading plans coordinated to optimize space utilization and protect components during transport.' },
  { num: '07', title: 'Export Coordination', desc: 'Export documentation support and logistics coordination for overseas project delivery.' },
  { num: '08', title: 'Overseas Technical Guidance', desc: 'Installation guidance and technical support provided to the customer or local construction team.' }
];

const certifications = [
  {
    title: 'ISO 9001',
    desc: 'Quality management system certification for steel structure fabrication and project coordination.',
    image: '/images/certifications/iso-9001-quality.jpg',
    certNo: 'NOA2502483',
    valid: '2025 - 2028'
  },
  {
    title: 'ISO 14001',
    desc: 'Environmental management system certification for steel structure manufacturing operations.',
    image: '/images/certifications/iso-14001-environmental.jpg',
    certNo: 'NOA2502482',
    valid: '2025 - 2028'
  },
  {
    title: 'ISO 45001',
    desc: 'Occupational health and safety management system certification for production facilities.',
    image: '/images/certifications/iso-45001-occupational.jpg',
    certNo: 'NOA2502481',
    valid: '2025 - 2028'
  },
  {
    title: 'EU CE Marking (EN 1090)',
    desc: 'CE certification for structural steel components, execution class up to EXC2, compliant with EU Construction Product Regulation.',
    image: '/images/certifications/en-1090-ce.jpg',
    certNo: '1381-CPR-902',
    valid: '2024 - Ongoing'
  },
  {
    title: 'ISO 3834-2 Welding Quality',
    desc: 'Comprehensive quality requirements for fusion welding of metallic materials, certified by SGS.',
    image: '/images/certifications/iso-3834-welding.jpg',
    certNo: '24/1028-3834',
    valid: '2024 - 2027'
  },
  {
    title: 'Malaysia CIDB IBS',
    desc: 'Industrialised Building System assessment and certification for the Malaysian market, covering metal framing and structural steel components.',
    image: '/images/certifications/malaysia-cidb-ibs.jpg',
    certNo: 'IBS231/039',
    valid: '2026 - 2027'
  }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="hub-hero">
    <div class="hub-hero-bg" style="background-image: url('/images/manufacturing/real/factory-aerial-panorama.jpg')"></div>
    <div class="hub-hero-overlay"></div>
    <div class="container hub-hero-content">
      <div class="hub-breadcrumb">
        <a href="/en/">Home</a><span>/</span><span>About ZhongSai</span>
      </div>
      <p class="eyebrow">ABOUT ZHONGSAI</p>
      <h1>Steel Structure Manufacturing for Overseas Projects</h1>
      <p class="hub-hero-desc">ZhongSai Steel Structure is a China-based steel structure manufacturer and export supplier supporting overseas factories, warehouses and engineered steel building projects from detailing and fabrication to packing, export coordination and overseas installation technical guidance.</p>
    </div>
  </section>

  <!-- Section 02: Who We Are -->
  <section class="hub-section">
    <div class="container">
      <div class="hub-section-head">
        <h2>A Steel Structure Manufacturer Built for Export Projects</h2>
      </div>
      <div class="about-intro">
        <p>ZhongSai Steel Structure supports overseas project owners, engineering companies, contractors and procurement teams with structural steel manufacturing and export supply.</p>
        <p>Our work focuses on translating confirmed project requirements and drawings into fabricated steel components prepared for export delivery.</p>
        <p>Depending on project scope, ZhongSai may support detailing, fabrication, component supply, packing, container loading, export documentation coordination and overseas installation technical guidance.</p>
        <p><strong>Local erection and construction are handled by the customer or local construction team.</strong></p>
      </div>

      <!-- Core Facts -->
      <div class="about-facts">
        {coreFacts.map(fact => (
          <div class="about-fact-card">
            <div class="about-fact-num">{fact.num}</div>
            <div class="about-fact-label">{fact.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 03

      <!-- Company Facts Detailed -->
      <div class="company-facts-grid" style="margin-top: 40px;">
        <div class="company-fact-item">
          <span class="cf-label">Brand Name</span>
          <span class="cf-value">ZhongSai Steel Structure</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">Core Business</span>
          <span class="cf-value">Steel Structure Detailing, Fabrication & Export Supply</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">Manufacturing Base</span>
          <span class="cf-value">Dongguan / Huizhou, Guangdong, China</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">Design Team</span>
          <span class="cf-value">In-House Structural Design & Detailing Team</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">Delivery Team</span>
          <span class="cf-value">In-House Project Delivery & Export Coordination Team</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">Export Markets</span>
          <span class="cf-value">60+ countries: Southeast Asia, Middle East, Africa, South America</span>
        </div>
      </div>: Real Manufacturing Base -->
  <section class="hub-section hub-section-dark">
    <div class="container">
      <div class="hub-section-head">
        <h2>Real Factory. Real Manufacturing.</h2>
      </div>
      <div class="manufacturing-evidence">
        <div class="evidence-main">
          <img src="/images/manufacturing/real/factory-overview-9819.jpg" alt="ZhongSai steel structure factory production floor" width="800" height="600" loading="lazy">
        </div>
        <div class="evidence-grid">
          <div class="evidence-item">
            <img src="/images/manufacturing/real/cutting-prep-9809.jpg" alt="CNC cutting and steel preparation" width="400" height="300" loading="lazy">
            <span>CNC Cutting</span>
          </div>
          <div class="evidence-item">
            <img src="/images/manufacturing/real/welding-9820.jpg" alt="Steel welding and fabrication" width="400" height="300" loading="lazy">
            <span>Welding</span>
          </div>
          <div class="evidence-item">
            <img src="/images/manufacturing/real/assembly-welding-9821.jpg" alt="Steel assembly and fabrication workshop" width="400" height="300" loading="lazy">
            <span>Assembly & Fabrication</span>
          </div>
        </div>
      </div>
      <p class="evidence-caption">100,000 m² production base covering cutting, assembly, welding, surface treatment, quality inspection, component marking and packing for export delivery.</p>
    </div>
  </section>

  <!-- Section 04

  <!-- Section: In-House Teams -->
