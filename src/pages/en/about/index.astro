            <li>Fabrication drawings</li>
            <li>Manufacturability and transport segmentation</li>
            <li>Site assembly interface and bolting coordination</li>
          </ul>
          <a href="/en/engineering-design/" class="team-link">View Engineering Capability →</a>
        </div>
        <div class="team-card">
          <div class="team-icon">📦</div>
          <h3>In-House Project Delivery Team</h3>
          <ul>
            <li>Production schedule and project timeline coordination</li>
            <li>Component marking and packing plans</li>
            <li>Container loading planning and space optimization</li>
            <li>Export documentation support</li>
            <li>Shipping booking and delivery coordination</li>
            <li>Client / local contractor handover</li>
            <li>Installation documentation and technical handover</li>
          </ul>
          <a href="/en/export-delivery/" class="team-link">View Export Delivery →</a>
        </div>
      </div>
      <p class="teams-note">ZhongSai's delivery capability is steel structure project delivery coordination, not international freight forwarding. Local civil works and physical erection are normally handled by local contractors.</p>
    </div>
  </section>: What We Provide -->
  <section class="hub-section">
    <div class="container">
      <div class="hub-section-head">
        <h2>What ZhongSai Supports</h2>
      </div>
      <div class="capability-grid">
        {services.map(svc => (
          <div class="capability-card">
            <div class="capability-num">{svc.num}</div>
            <h3>{svc.title}</h3>
            <p>{svc.desc}</p>
          </div>
        ))}
      </div>

      <!-- Supply Scope Boundary -->
      <div class="boundary-section">
        <div class="boundary-col">
          <h3>ZhongSai Provides</h3>
          <ul>
            <li>Project requirement coordination</li>
            <li>Design / detailing support</li>
            <li>Fabrication</li>
            <li>Component and material supply</li>
            <li>Packing and container loading</li>
            <li>Export documentation support</li>
            <li>Logistics coordination</li>
            <li>Overseas installation technical guidance</li>
          </ul>
        </div>
        <div class="boundary-col">
          <h3>Customer / Local Team Handles</h3>
          <ul>
            <li>Local construction</li>
            <li>Local erection</li>
            <li>Site labor</li>
            <li>Local permits and statutory approvals where applicable</li>
          </ul>
        </div>
      </div>
      <p class="boundary-note">This division of responsibility helps keep manufacturing and export scope clear from the beginning of the project.</p>
    </div>
  </section>

  <!-- Section 05: Manufacturing & Export Capability -->
  <section class="hub-section hub-section-dark">
    <div class="container">
      <div class="hub-section-head">
        <h2>From Drawings to Export Preparation</h2>
      </div>
      <div class="process-grid">
        {supplyChain.map(step => (
