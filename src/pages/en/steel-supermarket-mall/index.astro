---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Steel Supermarket & Mall Buildings | ZhongSai';
const description = 'Steel supermarket and mall buildings fall under commercial & public buildings. ZhongSai provides long-span, flexible-layout commercial steel structure...';
const lang = 'en';
const canonical = 'https://zhongsai-steelstructure.com/en/commercial-public-steel-buildings/';
---

<BaseLayout title={title} description={description} lang={lang} canonical={canonical}>
  <section style="padding: 80px 0; text-align: center; background: #f8f9fa;">
    <div class="container">
      <h1 style="font-size: 1.8rem; color: #0a3d62; margin-bottom: 16px;">Steel Supermarket & Mall Buildings</h1>
      <p style="font-size: 1.05rem; color: #555; margin-bottom: 32px; max-width: 600px; margin-left: auto; margin-right: auto;">
        Steel supermarkets, shopping centers and malls fall under the commercial & public buildings category. Visit our commercial & public buildings page for complete engineering parameters, applications and project cases.
      </p>
      <a href="/en/commercial-public-steel-buildings/" class="btn btn-primary" style="display: inline-block; padding: 14px 32px; font-size: 1rem;">
        View Commercial & Public Buildings →
      </a>
    </div>
  </section>
</BaseLayout>
