---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
const title = 'Steel Structure Supplier for Malaysia Projects | ZhongSai Steel Structure';
const description = 'ZhongSai provides structural steel engineering, detailing, fabrication, export delivery and installation technical support for steel structure projects in Malaysia, including industrial buildings, warehouses and mining facilities.';
const lang = 'en';
---

<BaseLayout title={title} description={description} lang={lang}>
  <section class="about-hero">
    <div class="container">
      <p class="eyebrow">Malaysia Market</p>
      <h1>Steel Structure Solutions for Projects in Malaysia</h1>
      <p class="about-hero-desc">From engineering detailing through manufacturing, export delivery to installation technical support — ZhongSai supplies structural steel for industrial, warehouse and mining projects across Malaysia.</p>
      <div class="hero-cta-group">
        <a href="/en/contact/#quote-form" class="btn btn-primary">Send Project Drawings</a>
        <a href="https://wa.me/8613192007378?text=Hello,%20I%20have%20a%20steel%20structure%20project%20in%20Malaysia%20to%20discuss." class="btn btn-outline">Discuss Your Project</a>
      </div>
    </div>
  </section>

  {/* GEO Answer Block */}
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">ZhongSai Support for Malaysia Projects</p>
        <h2>What ZhongSai Provides for Malaysia</h2>
      </div>
      <div class="capability-grid">
        <div class="cap-card">
          <h3>Engineering & Detailing</h3>
          <p>In-house team reviews project drawings, develops shop drawings, connection details and material schedules according to project specifications.</p>
        </div>
        <div class="cap-card">
          <h3>Manufacturing & Quality</h3>
          <p>Dongguan and Huizhou manufacturing bases with approx. 100,000 tonnes annual capacity, controlled by project-specific QC requirements.</p>
        </div>
        <div class="cap-card">
          <h3>Export Delivery</h3>
          <p>Components are marked, packed and containerized for shipment to Port Klang, Penang and other Malaysian ports. Export documentation provided.</p>
        </div>
        <div class="cap-card">
          <h3>Installation Technical Support</h3>
          <p>Erection drawings, component identification and technical guidance help Malaysian local contractors install the structure correctly.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Local Project Applications */}
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Common Project Types</p>
        <h2>Steel Structure Applications in Malaysia</h2>
      </div>
      <div class="capability-grid">
        <div class="cap-card">
          <h3>Industrial & Manufacturing</h3>
          <p>Manufacturing workshops, assembly plants and heavy industrial buildings with crane requirements.</p>
          <a href="/en/steel-workshop/">View Industrial Workshop</a>
        </div>
        <div class="cap-card">
          <h3>Warehousing & Logistics</h3>
          <p>Logistics warehouses, distribution centers, cold storage and supply chain facilities.</p>
          <a href="/en/steel-warehouse/">View Warehouse Solutions</a>
        </div>
        <div class="cap-card">
          <h3>Mining & Energy</h3>
          <p>Mining structures, processing plants, power plant auxiliaries and heavy industrial steel structures.</p>
          <a href="/en/steel-mining-factory/">View Mining & Energy</a>
        </div>
        <div class="cap-card">
          <h3>Commercial & Public</h3>
          <p>Commercial buildings, stadiums, exhibition halls and public assembly facilities.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Engineering Considerations */}
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Engineering Considerations</p>
        <h2>Engineering Considerations for Projects in Malaysia</h2>
      </div>
      <div class="two-col">
        <div>
          <h3>Climate & Environmental Conditions</h3>
          <p>Malaysia's tropical climate means high temperature and humidity throughout the year. Corrosion protection and coating systems are important for long-term durability, especially in coastal or industrial environments. Wind loads are evaluated based on project location and applicable codes.</p>
        </div>
        <div>
          <h3>Design Standards</h3>
          <p>Project requirements are reviewed according to applicable local codes, client specifications and agreed design criteria. Design loads, material grades and connection details follow project drawings and technical specifications. Local permits and statutory approvals remain the responsibility of the project owner or appointed local engineer.</p>
        </div>
      </div>
    </div>
  </section>

  {/* China to Malaysia Delivery */}
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Export Delivery</p>
        <h2>How Steel Structures Are Delivered from China to Malaysia</h2>
      </div>
      <div class="two-col">
        <div>
          <h3>Delivery Process</h3>
          <p>After engineering review and detailing, steel components are fabricated in ZhongSai's Dongguan or Huizhou bases. Each component is marked according to shop drawings, inspected, packed and loaded into containers. Shipping is arranged to Port Klang, Penang or other Malaysian ports. Export documentation accompanies the shipment.</p>
        </div>
        <div>
          <h3>Local Installation Coordination</h3>
          <p>ZhongSai provides erection drawings, component marks, bolt information and technical guidance. Civil works, local permits, construction labor and physical erection are typically handled by the project's local contractor. ZhongSai does not act as a general contractor for on-site construction in Malaysia.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Procurement FAQ */}
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Frequently Asked Questions</p>
        <h2>Questions from Malaysia Project Clients</h2>
      </div>
      <div class="faq-list">
        <details>
          <summary>What drawings are needed for a quotation?</summary>
          <p>Structural drawings, architectural drawings, building dimensions, load requirements, crane requirements (if any), cladding requirements and project location help us prepare an accurate quotation. If drawings are incomplete, you can still submit what you have for an initial review.</p>
        </details>
        <details>
          <summary>Can you manufacture steel structures in China and ship to Malaysia?</summary>
          <p>Yes. ZhongSai fabricates structural steel in our Dongguan and Huizhou bases, then packs and containerizes components for sea freight to Malaysian ports. We provide export documentation and packing lists.</p>
        </details>
        <details>
          <summary>Can a local Malaysian contractor install the structure?</summary>
          <p>Yes. We provide erection drawings, component identification marks, bolt details and installation technical guidance. A local contractor familiar with steel structure erection can handle on-site assembly.</p>
        </details>
        <details>
          <summary>How are corrosion and coating handled for Malaysia's climate?</summary>
          <p>Surface preparation and coating systems are specified according to project requirements and environmental conditions. Coastal, industrial or corrosive environments may require higher coating specifications.</p>
        </details>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Start Your Malaysia Project</p>
        <h2>Planning a Steel Structure Project in Malaysia?</h2>
        <p>Send your project location, drawings or requirements for an initial engineering review.</p>
        <div class="hero-cta-group">
          <a href="/en/contact/#quote-form" class="btn btn-primary">Send Project Drawings</a>
          <a href="https://wa.me/8613192007378?text=Hello,%20I%20have%20a%20steel%20structure%20project%20in%20Malaysia%20to%20discuss." class="btn btn-outline">Discuss Your Project</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
