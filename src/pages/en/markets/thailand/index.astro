---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
const title = 'Steel Structure Supplier for Thailand Projects | ZhongSai Steel Structure';
const description = 'ZhongSai provides structural steel engineering, detailing, fabrication, export delivery and installation technical support for steel structure projects in Thailand, including industrial buildings, warehouses and agricultural facilities.';
const lang = 'en';
---

<BaseLayout title={title} description={description} lang={lang}>
  <section class="about-hero">
    <div class="container">
      <p class="eyebrow">Thailand Market</p>
      <h1>Steel Structure Solutions for Projects in Thailand</h1>
      <p class="about-hero-desc">From engineering detailing through manufacturing, export delivery to installation technical support — ZhongSai supplies structural steel for industrial, warehouse and agricultural projects across Thailand.</p>
      <div class="hero-cta-group">
        <a href="/en/contact/#quote-form" class="btn btn-primary">Send Project Drawings</a>
        <a href="https://wa.me/8613192007378?text=Hello,%20I%20have%20a%20steel%20structure%20project%20in%20Thailand%20to%20discuss." class="btn btn-outline">Discuss Your Project</a>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">ZhongSai Support for Thailand Projects</p>
        <h2>What ZhongSai Provides for Thailand</h2>
      </div>
      <div class="capability-grid">
        <div class="cap-card">
          <h3>Engineering & Detailing</h3>
          <p>In-house team reviews project drawings, develops shop drawings and material schedules according to project specifications.</p>
        </div>
        <div class="cap-card">
          <h3>Manufacturing & Quality</h3>
          <p>Dongguan and Huizhou manufacturing bases with approx. 100,000 tonnes annual capacity.</p>
        </div>
        <div class="cap-card">
          <h3>Export Delivery</h3>
          <p>Components are marked, packed and containerized for shipment to Bangkok and Laem Chabang ports.</p>
        </div>
        <div class="cap-card">
          <h3>Installation Technical Support</h3>
          <p>Erection drawings, component identification and technical guidance for local contractors.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Common Project Types</p>
        <h2>Steel Structure Applications in Thailand</h2>
      </div>
      <div class="capability-grid">
        <div class="cap-card">
          <h3>Industrial & Manufacturing</h3>
          <p>Manufacturing workshops and industrial facilities.</p>
          <a href="/en/steel-workshop/">View Industrial Workshop</a>
        </div>
        <div class="cap-card">
          <h3>Warehousing & Logistics</h3>
          <p>Logistics warehouses, distribution centers and cold storage.</p>
          <a href="/en/steel-warehouse/">View Warehouse Solutions</a>
        </div>
        <div class="cap-card">
          <h3>Agricultural & Livestock</h3>
          <p>Agricultural buildings, livestock facilities and processing plants.</p>
        </div>
        <div class="cap-card">
          <h3>Commercial & Public</h3>
          <p>Commercial buildings, stadiums and exhibition halls.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Engineering Considerations</p>
        <h2>Engineering Considerations for Projects in Thailand</h2>
      </div>
      <div class="two-col">
        <div>
          <h3>Climate & Environmental Conditions</h3>
          <p>Thailand's tropical climate brings high temperature and humidity. Corrosion protection is important for coastal or industrial environments. Wind and seismic loads are evaluated based on project location and applicable codes.</p>
        </div>
        <div>
          <h3>Design Standards</h3>
          <p>Project requirements are reviewed according to applicable local codes, client specifications and agreed design criteria. Local permits and statutory approvals remain the responsibility of the project owner or appointed local engineer.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Export Delivery</p>
        <h2>How Steel Structures Are Delivered from China to Thailand</h2>
      </div>
      <div class="two-col">
        <div>
          <h3>Delivery Process</h3>
          <p>Steel components are fabricated, marked, inspected, packed and loaded into containers for sea freight to Bangkok or Laem Chabang ports. Export documentation accompanies the shipment.</p>
        </div>
        <div>
          <h3>Local Installation Coordination</h3>
          <p>ZhongSai provides erection drawings, component marks and technical guidance. Civil works, local permits, construction labor and physical erection are handled by the project's local contractor.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Start Your Thailand Project</p>
        <h2>Planning a Steel Structure Project in Thailand?</h2>
        <p>Send your project location, drawings or requirements for an initial engineering review.</p>
        <div class="hero-cta-group">
          <a href="/en/contact/#quote-form" class="btn btn-primary">Send Project Drawings</a>
          <a href="https://wa.me/8613192007378?text=Hello,%20I%20have%20a%20steel%20structure%20project%20in%20Thailand%20to%20discuss." class="btn btn-outline">Discuss Your Project</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
