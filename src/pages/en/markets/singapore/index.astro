---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
const title = 'Steel Structure Supplier for Singapore Projects | Design, Fabrication & Export | ZhongSai';
const description = 'ZhongSai provides steel structure design, detailing, fabrication and export delivery for Singapore projects, including LTA MRT stations and Changi Airport facilities.';
const lang = 'en';
---

<BaseLayout title={title} description={description} lang={lang}>
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/projects/overseas/singapore-cr101-depot.jpg');"></div>
    <div class="container">
      <div class="detail-hero-content">
        <h1>Steel Structure Solutions for Projects in Singapore</h1>
        <p>Design, detailing, fabrication and export delivery for Singapore steel structure projects, including LTA MRT stations and Changi Airport facilities.</p>
        <div class="hero-cta-group">
          <a href="/en/contact/#quote-form" class="btn btn-primary">Send Project Drawings</a>
          <a href="https://wa.me/8613192007378?text=Hi%20ZhongSai%2C%20I%20have%20a%20Singapore%20steel%20structure%20project%20to%20discuss." class="btn btn-outline">Discuss Your Project</a>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Why ZhongSai</p>
        <h2>Steel Structure Supply Capability for Singapore Projects</h2>
      </div>
      <div class="capability-grid">
        <div class="cap-card">
          <h3>In-House Design & Detailing</h3>
          <p>Structural detailing, connection design and shop drawings coordinated with client specifications such as LTA requirements.</p>
        </div>
        <div class="cap-card">
          <h3>Project-Based Manufacturing</h3>
          <p>100,000 m² manufacturing base, approx. 100,000 tonnes annual capacity, produced to project drawings and specifications.</p>
        </div>
        <div class="cap-card">
          <h3>Export & Delivery Coordination</h3>
          <p>Component marking, optimized container loading, export documentation and port delivery coordination.</p>
        </div>
        <div class="cap-card">
          <h3>Installation Technical Support</h3>
          <p>Erection drawings, component identification and technical clarification for local installation teams.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Singapore Experience</p>
        <h2>Singapore Steel Structure Projects Delivered</h2>
        <p>ZhongSai team has supplied steel structures for multiple Singapore infrastructure and industrial projects.</p>
      </div>
      <div class="project-grid">
        <a href="/en/projects/singapore-j102-mrt-station/" class="project-card">
          <div class="project-img" style="background-image: url('/images/projects/overseas/singapore-cr101-depot.jpg');"></div>
          <div class="project-body">
            <span class="project-type">Transport Infrastructure</span>
            <h3>LTA J102 MRT Station</h3>
            <p class="project-scope">Approx. 1,900 tonnes, external flange connections, 15,000 flanges, RTO stationed at factory.</p>
          </div>
        </a>
        <a href="/en/projects/singapore-j107-mrt-station/" class="project-card">
          <div class="project-img" style="background-image: url('/images/projects/overseas/singapore-j102-station.jpg');"></div>
          <div class="project-body">
            <span class="project-type">Transport Infrastructure</span>
            <h3>LTA J107 MRT Station</h3>
            <p class="project-scope">Approx. 1,300 tonnes, passed LTA factory inspection, executed to LTA requirements.</p>
          </div>
        </a>
        <a href="/en/projects/singapore-sats-bup-centre/" class="project-card">
          <div class="project-img" style="background-image: url('/images/projects/overseas/singapore-mcc-innocentre.jpg');"></div>
          <div class="project-body">
            <span class="project-type">Industrial / Airport</span>
            <h3>Changi Airport SATS BUP Centre</h3>
            <p class="project-scope">Factory-fabricated, segmented for container shipping, dimensional precision maintained.</p>
          </div>
        </a>
        <a href="/en/projects/singapore-mcc-innocentre/" class="project-card">
          <div class="project-img" style="background-image: url('/images/projects/overseas/singapore-mcc-innocentre.jpg');"></div>
          <div class="project-body">
            <span class="project-type">Commercial / Industrial</span>
            <h3>MCC Innocentre</h3>
            <p class="project-scope">Steel structure supply for Singapore industrial and R&D building.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Engineering</p>
        <h2>Technical Considerations for Singapore Projects</h2>
      </div>
      <div class="image-text-block">
        <div class="itb-content">
          <h3>Typical Technical Requirements</h3>
          <ul>
            <li><strong>Code Compliance</strong> — Projects executed per client-specified codes (e.g., LTA, SS standards), with detailing coordinated to owner requirements</li>
            <li><strong>Complex Connections</strong> — MRT station projects involve extensive flange nodes and complex connections requiring high-precision fabrication</li>
            <li><strong>Quality Inspection</strong> — Experienced with RTO stationed inspection, third-party testing and full-process quality supervision</li>
            <li><strong>Shipping Limits</strong> — Members segmented to container dimensions for sea freight to Singapore</li>
            <li><strong>Corrosion Protection</strong> — Hot and humid marine environment; coating systems determined by project environment and owner specifications</li>
          </ul>
          <p style="margin-top: 16px; color: #666; font-size: 0.92rem;">Specific technical parameters are determined by project drawings, client specifications and applicable Singapore design requirements.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Delivery</p>
        <h2>From Factory to Singapore Project Site</h2>
      </div>
      <div class="process-steps">
        <div class="step">
          <span class="step-num">01</span>
          <h3>Project Review</h3>
          <p>Receive drawings and technical requirements, assess fabrication and delivery feasibility.</p>
        </div>
        <div class="step">
          <span class="step-num">02</span>
          <h3>Detailing</h3>
          <p>In-house design team produces connection details and shop drawings.</p>
        </div>
        <div class="step">
          <span class="step-num">03</span>
          <h3>Fabrication & Inspection</h3>
          <p>Production organized to drawings, with RTO/third-party inspection as required.</p>
        </div>
        <div class="step">
          <span class="step-num">04</span>
          <h3>Loading & Shipping</h3>
          <p>Component marking, optimized container loading, sea freight to Singapore port.</p>
        </div>
        <div class="step">
          <span class="step-num">05</span>
          <h3>Installation Support</h3>
          <p>Erection drawings and technical clarification for local installation teams.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">FAQ</p>
        <h2>Frequently Asked Questions</h2>
      </div>
      <div class="faq-list">
        <details>
          <summary>Can ZhongSai design and fabricate to Singapore project codes?</summary>
          <p>Yes. ZhongSai has participated in multiple LTA MRT station projects and can coordinate design and fabrication per client-specified codes and technical requirements.</p>
        </details>
        <details>
          <summary>How are steel structures shipped to Singapore?</summary>
          <p>Members are segmented to container dimensions, loaded and shipped by sea to Singapore port. The shipping plan depends on member dimensions and project requirements.</p>
        </details>
        <details>
          <summary>Can my local contractor install the structure in Singapore?</summary>
          <p>Yes. ZhongSai provides erection drawings, component identification and technical guidance. Local Singapore contractors handle physical installation. Remote technical support is available.</p>
        </details>
        <details>
          <summary>Can you support LTA or third-party inspection?</summary>
          <p>Yes. ZhongSai has experience with RTO stationed inspection and ITA supervision on J102 and J107 MRT station projects.</p>
        </details>
        <details>
          <summary>What documents are needed for a quotation?</summary>
          <p>Project drawings, technical specifications, material requirements and delivery port are recommended. Preliminary concept drawings can also be submitted for initial review.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="detail-section quote-cta-section">
    <div class="container" style="text-align: center;">
      <h2>Have a Steel Structure Project in Singapore?</h2>
      <p style="margin: 16px 0 24px; color: #666;">Send your project location, drawings and requirements for engineering review.</p>
      <a href="/en/contact/#quote-form" class="btn btn-primary btn-large">Send Project Drawings</a>
    </div>
  </section>
</BaseLayout>
