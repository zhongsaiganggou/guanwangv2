---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
const title = 'Steel Structure Supplier for Saudi Arabia Projects | ZhongSai Steel Structure';
const description = 'ZhongSai provides structural steel engineering detailing, manufacturing, QC, container loading and export delivery coordination for steel structure projects in Saudi Arabia.';
const lang = 'en';
---

<BaseLayout title={title} description={description} lang={lang}>
  <section class="about-hero">
    <div class="container">
      <p class="eyebrow">Saudi Arabia Market</p>
      <h1>Steel Structure Solutions for Projects in Saudi Arabia</h1>
      <p class="about-hero-desc">From engineering detailing through manufacturing, quality control, container packing and export delivery — ZhongSai supplies structural steel components for industrial, warehouse and manufacturing projects in Saudi Arabia.</p>
      <div class="hero-cta-group">
        <a href="/en/contact/#quote-form" class="btn btn-primary">Send Project Drawings</a>
        <a href="https://wa.me/8613192007378?text=Hello,%20I%20have%20a%20steel%20structure%20project%20in%20Saudi%20Arabia%20to%20discuss." class="btn btn-outline">Discuss Your Project</a>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">ZhongSai Support for Saudi Projects</p>
        <h2>What ZhongSai Provides for Saudi Arabia</h2>
      </div>
      <div class="capability-grid">
        <div class="cap-card">
          <h3>Engineering & Detailing</h3>
          <p>Our engineering team reviews project drawings, develops shop drawings and connection details according to project specifications and agreed design criteria.</p>
        </div>
        <div class="cap-card">
          <h3>Manufacturing & Quality Control</h3>
          <p>Steel components are fabricated in our Dongguan and Huizhou facilities with dimensional inspection, welding QC and surface treatment before shipment.</p>
        </div>
        <div class="cap-card">
          <h3>Export Delivery</h3>
          <p>Components are marked, packed and containerized for sea freight to Saudi ports such as Jeddah, Dammam and King Abdullah Port.</p>
        </div>
        <div class="cap-card">
          <h3>Installation Technical Support</h3>
          <p>Erection drawings, component identification and technical guidance for local installation teams. Civil works and physical erection are handled by the local contractor.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Project Types</p>
        <h2>Steel Structure Applications in Saudi Arabia</h2>
      </div>
      <div class="capability-grid">
        <div class="cap-card">
          <h3>Industrial & Manufacturing</h3>
          <p>Manufacturing workshops, production facilities and industrial plants.</p>
          <a href="/en/steel-workshop/">View Industrial Workshop</a>
        </div>
        <div class="cap-card">
          <h3>Warehousing & Logistics</h3>
          <p>Warehouses, distribution centers and cold storage facilities.</p>
          <a href="/en/steel-warehouse/">View Warehouse Solutions</a>
        </div>
        <div class="cap-card">
          <h3>Mining & Heavy Industry</h3>
          <p>Mining facilities, processing plants and heavy industrial structures.</p>
          <a href="/en/steel-mining-factory/">View Mining Applications</a>
        </div>
        <div class="cap-card">
          <h3>Commercial & Public</h3>
          <p>Commercial buildings, community facilities and public structures.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Design & Regulatory Considerations</p>
        <h2>Engineering and Code Considerations</h2>
      </div>
      <div class="two-col">
        <div>
          <h3>Design Loads and Local Codes</h3>
          <p>Saudi Arabia has specific climate and environmental conditions. Structural design must consider high temperatures, wind loads, dust exposure and seismic requirements where applicable. Project-specific design loads and applicable codes are confirmed with the project owner or local engineer before fabrication.</p>
        </div>
        <div>
          <h3>Import and Conformity Requirements</h3>
          <p>Depending on the imported product classification and applicable Saudi technical regulations, the importer may need to complete relevant SASO/SABER conformity procedures. Requirements vary by product type, HS classification and importer arrangements. We work with project teams to provide the fabrication documentation needed for clearance.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Responsibility Boundaries</p>
        <h2>Who Handles What</h2>
      </div>
      <div class="two-col">
        <div>
          <h3>ZhongSai Scope</h3>
          <ul>
            <li>Engineering coordination and shop drawings</li>
            <li>Manufacturing, welding and quality control</li>
            <li>Surface treatment and component marking</li>
            <li>Packing, container loading and export documentation</li>
            <li>Installation technical guidance for local crews</li>
          </ul>
        </div>
        <div>
          <h3>Local Party Scope</h3>
          <ul>
            <li>Building permits and local authority approvals</li>
            <li>Civil works and foundation construction</li>
            <li>Local construction labor and physical erection</li>
            <li>Local code compliance and statutory approvals</li>
            <li>Customs clearance and inland transport</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Export Delivery Process</p>
        <h2>From China Factory to Saudi Project Site</h2>
      </div>
      <div class="two-col">
        <div>
          <h3>Fabrication to Container</h3>
          <p>Steel components are fabricated, inspected, marked and packed. Long members are strapped for sea freight. A detailed packing list accompanies each container for easy identification on site.</p>
        </div>
        <div>
          <h3>Shipping to Saudi Ports</h3>
          <p>Containers ship to Jeddah Islamic Port, Dammam's King Abdulaziz Port or King Abdullah Port. Transit time varies by origin port, destination port, carrier, routing and shipping season. The shipping schedule should be confirmed for each project before dispatch. Destination customs clearance and inland transport to the project site are arranged locally.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Start Your Saudi Project</p>
        <h2>Planning a Steel Structure Project in Saudi Arabia?</h2>
        <p>Send your project location, building drawings or requirements for an initial engineering review. We can advise on feasibility, typical scope and expected timeline.</p>
        <div class="hero-cta-group">
          <a href="/en/contact/#quote-form" class="btn btn-primary">Send Project Drawings</a>
          <a href="https://wa.me/8613192007378?text=Hello,%20I%20have%20a%20steel%20structure%20project%20in%20Saudi%20Arabia%20to%20discuss." class="btn btn-outline">Discuss Your Project</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
