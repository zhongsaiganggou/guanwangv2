---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/detail.css';

const title = 'Steel Structure Supplier for UAE Projects | ZhongSai';
const description = 'ZhongSai supplies structural steel for UAE projects with engineering, detailing, fabrication, QC, packing, container loading and export-delivery support.';
const lang = 'en';
const whatsapp = 'https://wa.me/8613192007378?text=Hello,%20I%20have%20a%20steel%20structure%20project%20in%20UAE%20to%20discuss.';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- 1. Hero / Direct Answer -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/manufacturing/real/factory-aerial-panorama.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">UAE Market</span>
      <h1>Steel Structure Supplier for UAE Projects</h1>
      <p class="lead">ZhongSai is a China-based structural steel manufacturer supporting UAE projects with engineering coordination, detailing, fabrication, quality control, component marking, packing, container loading, export documentation coordination and installation technical guidance. Local permits, consultant approvals, foundations, civil works and physical erection are normally handled by the project's local parties unless otherwise agreed.</p>
      <div class="detail-hero-actions">
        <a href="/en/contact/#quote-form" class="btn btn-primary">Send Project Drawings</a>
        <a href={whatsapp} class="btn uae-btn-ghost" target="_blank" rel="noopener">Discuss Your Project</a>
      </div>
    </div>
  </section>

  <!-- 2. What ZhongSai Can Supply -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">What ZhongSai Can Supply</p>
        <h2>Engineering, Fabrication and Export Support for UAE Projects</h2>
        <p>One accountable China-based supply partner for the structural steel package — coordinated with your local consultant and contractor, not a replacement for them.</p>
      </div>
      <div class="uae-cap-list">
        <div class="uae-cap-item">
          <span class="uae-cap-num">01</span>
          <div>
            <h3>Engineering Coordination</h3>
            <p>We review project requirements, design criteria and structural intent, and coordinate the steel package with your architect, structural engineer of record and local consultant before fabrication begins.</p>
          </div>
        </div>
        <div class="uae-cap-item">
          <span class="uae-cap-num">02</span>
          <div>
            <h3>Detailing &amp; Shop Drawings</h3>
            <p>Connection design support, Tekla 3D modelling, shop drawings, erection drawings, material take-offs and bolt lists prepared for consultant review and site use.</p>
          </div>
        </div>
        <div class="uae-cap-item">
          <span class="uae-cap-num">03</span>
          <div>
            <h3>Fabrication</h3>
            <p>CNC cutting, drilling, assembly and welding of columns, beams, trusses, purlins, bracing and platework at our China manufacturing bases.</p>
          </div>
        </div>
        <div class="uae-cap-item">
          <span class="uae-cap-num">04</span>
          <div>
            <h3>Quality Control &amp; Surface Treatment</h3>
            <p>Incoming material checks, dimensional inspection, welding QC, shot blasting, coating and dry-film-thickness inspection, with mill certificates and inspection records available for consultant review.</p>
          </div>
        </div>
        <div class="uae-cap-item">
          <span class="uae-cap-num">05</span>
          <div>
            <h3>Component Marking &amp; Packing</h3>
            <p>Every member is marked to match the erection drawings, then bundled and packed to survive sea freight and to be identifiable on site by your local erection team.</p>
          </div>
        </div>
        <div class="uae-cap-item">
          <span class="uae-cap-num">06</span>
          <div>
            <h3>Container Loading &amp; Export Documentation</h3>
            <p>Container loading plans for long and heavy members, packing lists and export documentation coordination to support your importer and freight forwarder.</p>
          </div>
        </div>
        <div class="uae-cap-item">
          <span class="uae-cap-num">07</span>
          <div>
            <h3>Installation Technical Guidance</h3>
            <p>Erection drawings, bolt information and technical clarification (remote, or site guidance where separately agreed). Physical erection is carried out by the local contractor.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Typical UAE Project Applications -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Project Applications</p>
        <h2>Steel Building Types for UAE Projects</h2>
        <p>We supply by building type and application. The following are typical steel building types for UAE industrial and logistics projects.</p>
      </div>
      <div class="uae-app-grid">
        <div class="uae-app-row">
          <div>
            <h3>Industrial Workshops</h3>
            <p>Single- and multi-span production buildings, including crane-equipped workshops.</p>
          </div>
          <a class="uae-arrow" href="/en/steel-workshop/">Industrial Workshops →</a>
        </div>
        <div class="uae-app-row">
          <div>
            <h3>Warehouses &amp; Logistics</h3>
            <p>Clear-span distribution centres, storage warehouses and logistics facilities.</p>
          </div>
          <a class="uae-arrow" href="/en/steel-warehouse/">Warehouse Solutions →</a>
        </div>
        <div class="uae-app-row">
          <div>
            <h3>Manufacturing Plants</h3>
            <p>Factory buildings with equipment supports, mezzanines and heavy floor loads.</p>
          </div>
        </div>
        <div class="uae-app-row">
          <div>
            <h3>Cold-Storage &amp; Food Processing</h3>
            <p>Insulated steel envelopes suited to cold-chain and food-processing facilities.</p>
          </div>
        </div>
        <div class="uae-app-row">
          <div>
            <h3>Equipment Platforms</h3>
            <p>Steel platforms, pipe racks, access structures and industrial support steel.</p>
          </div>
        </div>
        <div class="uae-app-row">
          <div>
            <h3>Commercial &amp; Public Structures</h3>
            <p>Showrooms, sports facilities, agricultural and other engineered steel buildings.</p>
          </div>
          <a class="uae-arrow" href="/en/agricultural-steel-buildings/">Agricultural Buildings →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Engineering Considerations -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Engineering Context</p>
        <h2>Engineering Considerations for UAE Projects</h2>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/engineering/tekla-model.jpg" alt="ZhongSai Tekla 3D structural steel modelling and detailing at its engineering office" loading="lazy" width="720" height="360" />
        </div>
        <div class="itb-content">
          <h3>Project-specific inputs, confirmed before fabrication</h3>
          <p>The UAE combines very high summer temperatures, high humidity along the coast, wind and dust/sand exposure, and chloride-rich coastal environments. These conditions can influence insulation, the coating system and connection and enclosure details — but every value must be confirmed against the actual project location and the applicable design criteria.</p>
          <ul>
            <li>Design wind, seismic and other loads taken from project drawings and the code/standard specified by the local consultant</li>
            <li>Coastal chloride exposure addressed through appropriate surface treatment, coating or galvanizing</li>
            <li>Roof and wall insulation and ventilation suited to high ambient temperature</li>
            <li>Fire-protection requirements defined per the project's authority and occupancy</li>
            <li>Span, eave height and crane loads driving member sizing and connection design</li>
          </ul>
          <p style="margin-top:16px;">We do not assume fixed parameters. Loads, materials and fire/corrosion requirements are confirmed from the approved drawings and the local registered engineer before steel is released for fabrication.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Manufacturing & Quality Evidence -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Manufacturing &amp; Quality Evidence</p>
        <h2>Built and Checked at Our Manufacturing Bases</h2>
        <p>The photographs below show ZhongSai manufacturing and quality operations at our China manufacturing bases — our general fabrication and QC capability, not a specific UAE project.</p>
      </div>
      <div class="uae-evidence-grid">
        <figure class="uae-ev">
          <img src="/images/manufacturing/real/assembly-welding-9821.jpg" alt="Structural steel assembly and welding at a ZhongSai manufacturing base in China" loading="lazy" width="480" height="220" />
          <figcaption>Structural steel assembly and welding — ZhongSai manufacturing capability</figcaption>
        </figure>
        <figure class="uae-ev">
          <img src="/images/manufacturing/real/qc-inspection.jpg" alt="Dimensional quality inspection of fabricated steel members" loading="lazy" width="480" height="220" />
          <figcaption>Dimensional inspection before release — ZhongSai quality control</figcaption>
        </figure>
        <figure class="uae-ev">
          <img src="/images/manufacturing/real/coating-thickness.jpg" alt="Dry-film coating thickness measurement on fabricated steel" loading="lazy" width="480" height="220" />
          <figcaption>Dry-film thickness check after surface treatment and painting</figcaption>
        </figure>
      </div>
      <p class="uae-cert-line">Quality is managed under documented procedures aligned with ISO 9001, welding quality under ISO 3834 principles, and CE-marked structural steel fabrication to EN 1090 where the project requires. Mill certificates, welding records and inspection reports can be provided in the project document pack for your consultant.</p>
    </div>
  </section>

  <!-- 6. Packing, Loading & Export Delivery -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Packing, Loading &amp; Delivery</p>
        <h2>From Our Manufacturing Bases to UAE Ports</h2>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/export/container-loading-256_web.jpg" alt="ZhongSai loading marked and packed steel members into a shipping container for export" loading="lazy" width="720" height="360" />
        </div>
        <div class="itb-content">
          <h3>Marked, packed and containerized for sea freight</h3>
          <p>Members are marked to match the erection drawings, bundled for protection and loaded into containers under a loading plan that handles long and heavy components. We coordinate the export documentation that your importer and freight forwarder need.</p>
          <ul>
            <li>Shipments for UAE projects may be routed through major ports such as Jebel Ali (Dubai) or Khalifa Port (Abu Dhabi), depending on the project logistics plan</li>
            <li>Packing lists, container loading records and component marks for site identification</li>
            <li>Commercial and shipping documents coordinated with the buyer's freight terms</li>
            <li>Customs clearance and inland transport in the UAE are normally arranged by the buyer or local parties</li>
          </ul>
          <p style="margin-top:16px;">See the full <a href="/en/export-delivery/">export delivery process</a> and <a href="/en/manufacturing-quality/">manufacturing &amp; quality</a> workflow.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Compliance & Responsibility Boundary -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Compliance &amp; Responsibilities</p>
        <h2>Approvals, and Who Handles What</h2>
        <p>Conformity and approval requirements depend on the emirate, project type, product classification and the authority having jurisdiction.</p>
      </div>
      <p style="max-width:900px;color:#475569;line-height:1.8;font-size:15px;">At the federal level, steel products can fall within the steel regulation administered by the Ministry of Industry and Advanced Technology (MoIAT, formerly ESMA), with the ECAS mark applied to products in scope. In Dubai, building work is administered under the Dubai Building Code and Dubai Municipality processes, while final design approval in certain zones is handled by the Dubai Development Authority. Whether a given product requires registration, third-party certification or material approval is confirmed by the project owner, the importer and the local registered consultant or structural engineer. ZhongSai supplies the fabrication documentation, material certificates, welding/QC records and shop drawings to support that approval; ZhongSai is not the local licensed engineer or permit holder.</p>
      <div class="uae-note">Applicable conformity and approval requirements depend on the emirate, the project type, the product classification and local authority requirements. The project owner, importer and local registered consultant should confirm the applicable requirements before fabrication and shipment.</div>
      <div class="geo-boundary" style="margin-top:32px;">
        <div class="geo-box include">
          <h4>ZhongSai Can Provide</h4>
          <ul>
            <li>Engineering coordination</li>
            <li>Detailing, shop and connection drawings</li>
            <li>Structural steel fabrication</li>
            <li>Welding &amp; dimensional quality control</li>
            <li>Surface treatment</li>
            <li>Component marking and packing</li>
            <li>Container loading</li>
            <li>Export documentation coordination</li>
            <li>Installation technical guidance</li>
          </ul>
        </div>
        <div class="geo-box exclude">
          <h4>Local Project Parties Normally Handle</h4>
          <ul>
            <li>Local permits</li>
            <li>Registered consultant / engineer approval</li>
            <li>Authority submissions</li>
            <li>Foundation engineering &amp; civil works</li>
            <li>Customs clearance</li>
            <li>Inland transport</li>
            <li>Local labour</li>
            <li>Physical erection</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Information Needed for a Quotation -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Quotation Checklist</p>
        <h2>What We Need for an Accurate Quotation</h2>
        <p>A useful steel quotation is project-specific. The more of the following you can provide, the more accurate the engineering and price review. Complete drawings are not required to start.</p>
      </div>
      <div class="uae-table-wrap">
        <table class="uae-table">
          <thead>
            <tr><th>Information</th><th>What to provide</th></tr>
          </thead>
          <tbody>
            <tr><td>Project location / Emirate</td><td>Emirate and site location, including coastal or inland setting</td></tr>
            <tr><td>Building use</td><td>Workshop, warehouse, plant, cold storage, platform, etc.</td></tr>
            <tr><td>Length</td><td>Overall building length and number of bays</td></tr>
            <tr><td>Width</td><td>Overall width / span arrangement</td></tr>
            <tr><td>Eave height</td><td>Clear or eave height required</td></tr>
            <tr><td>Clear span</td><td>Whether interior columns are acceptable</td></tr>
            <tr><td>Crane requirements</td><td>Crane capacity, lifting height and number of cranes, if any</td></tr>
            <tr><td>Design loads</td><td>Wind, seismic and other loads per the applicable standard</td></tr>
            <tr><td>Roof / wall system</td><td>Single-skin or insulated sandwich panels, profile preference</td></tr>
            <tr><td>Fire requirements</td><td>Fire-resistance or fire-protection requirements, if specified</td></tr>
            <tr><td>Corrosion environment</td><td>Coastal/industrial exposure and expected coating life</td></tr>
            <tr><td>Applicable code / consultant requirements</td><td>Design standard, material grade and approval requirements</td></tr>
            <tr><td>Drawings</td><td>Architectural/structural drawings or sketches, if available</td></tr>
            <tr><td>Delivery schedule</td><td>Required shipment or site timing</td></tr>
            <tr><td>Destination port</td><td>e.g. Jebel Ali or Khalifa Port, and delivery terms</td></tr>
          </tbody>
        </table>
      </div>

      <div class="quote-info-grid" style="margin-top:40px;">
        <div class="quote-info-card drawing">
          <h4>Have Drawings</h4>
          <ul>
            <li>Send architectural and structural drawings</li>
            <li>Include design loads, crane and fire requirements</li>
            <li>We review tonnage, detailing scope and delivery</li>
          </ul>
        </div>
        <div class="quote-info-card no-drawing">
          <h4>No Complete Drawings</h4>
          <ul>
            <li>Send dimensions, building use and location</li>
            <li>Provide crane, enclosure and schedule needs</li>
            <li>We propose a structural scheme for review</li>
          </ul>
        </div>
      </div>
      <div style="text-align:center;">
        <a href="/en/contact/#quote-form" class="btn btn-primary">Send Project Drawings or Requirements</a>
      </div>
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading" style="text-align:center;">
        <p class="section-index" style="justify-content:center;">Frequently Asked Questions</p>
        <h2>UAE Project Questions</h2>
      </div>
      <div class="uae-faq detail-faq">
        <details>
          <summary>Are you a steel structure manufacturer or a local UAE contractor?</summary>
          <p>ZhongSai is a China-based structural steel manufacturer and export supplier. We engineer, detail, fabricate, inspect, pack and coordinate export delivery, and provide installation technical guidance. We are not a UAE-registered contractor; local permits, civil works and physical erection are handled by your local parties.</p>
        </details>
        <details>
          <summary>Can you ship steel structures to the UAE?</summary>
          <p>Yes. Fabricated steel is containerized for sea freight and, depending on your logistics plan, may be routed through ports such as Jebel Ali (Dubai) or Khalifa Port (Abu Dhabi). Customs clearance and inland transport are normally arranged by the buyer or the buyer's local agent, and delivery terms are agreed in advance.</p>
        </details>
        <details>
          <summary>What information is needed for a quotation?</summary>
          <p>Project location and emirate, building use, length, width, eave height, clear span, crane requirements, design loads, roof/wall system, fire and corrosion requirements, the applicable code or consultant requirements, any drawings, the schedule and the destination port. You can also contact us without complete drawings and we will help define the scheme.</p>
        </details>
        <details>
          <summary>Can ZhongSai work from consultant-approved drawings?</summary>
          <p>Yes. We can fabricate against structural design and drawings approved by your local consultant or authority, and produce shop and connection drawings for review. Final design approval and sign-off remain with the local registered engineer or authority; we supply the documentation and records needed to support that review.</p>
        </details>
        <details>
          <summary>Does ZhongSai provide local installation in the UAE?</summary>
          <p>We do not keep a local erection crew in the UAE. We provide erection drawings, component marking, bolt information and technical clarification, and can arrange site guidance where separately contracted. The physical erection, labour and safety management are carried out by your local contractor.</p>
        </details>
        <details>
          <summary>How do heat and coastal corrosion affect steel building specifications?</summary>
          <p>High temperatures and humidity influence insulation, ventilation and enclosure choices, while Gulf coastal chloride exposure can call for a heavier coating system or galvanizing. The exact specification is project-specific and is set from the site environment and the consultant's requirements rather than a fixed template.</p>
        </details>
        <details>
          <summary>What documents are prepared for export delivery?</summary>
          <p>Typically packing lists, container loading records, commercial and shipping documents coordinated with your freight terms, material mill certificates, welding and QC records, and shop/erection drawings. Any product conformity or registration required for UAE customs or authority approval is confirmed per project by the importer and local consultant, and we provide the supporting manufacturing documentation.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- 10. Inquiry CTA -->
  <section class="detail-section dark">
    <div class="container" style="text-align:center;">
      <div class="section-heading" style="text-align:center;">
        <p class="section-index" style="justify-content:center;">Start Your UAE Project</p>
        <h2>Planning a Steel Structure Project in the UAE?</h2>
        <p style="margin:0 auto;">Send your drawings or project requirements for a project-specific engineering and delivery review.</p>
      </div>
      <div class="detail-hero-actions" style="justify-content:center;">
        <a href="/en/contact/#quote-form" class="btn btn-primary">Send Project Drawings</a>
        <a href={whatsapp} class="btn uae-btn-ghost" target="_blank" rel="noopener">Discuss Your Project</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* UAE market page — scoped editorial components (built on detail.css) */
  .uae-btn-ghost {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255,255,255,0.55);
  }
  .uae-btn-ghost:hover { background: rgba(255,255,255,0.12); text-decoration: none; }

  .uae-cap-list { border-top: 1px solid #e5e7eb; }
  .uae-cap-item {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 24px;
    padding: 22px 0;
    border-bottom: 1px solid #e5e7eb;
  }
  .uae-cap-num { font-size: 14px; font-weight: 700; color: #f59e0b; letter-spacing: 1px; padding-top: 3px; }
  .uae-cap-item h3 { font-size: 18px; color: #0f172a; margin: 0 0 6px; }
  .uae-cap-item p { font-size: 14.5px; color: #475569; line-height: 1.7; margin: 0; max-width: 760px; }

  .uae-app-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; }
  .uae-app-row {
    display: flex; justify-content: space-between; align-items: center; gap: 18px;
    padding: 20px 0; border-bottom: 1px solid #e5e7eb;
  }
  .uae-app-row h3 { font-size: 16px; color: #0f172a; margin: 0 0 4px; }
  .uae-app-row p { font-size: 13.5px; color: #64748b; line-height: 1.6; margin: 0; }
  .uae-arrow { color: #2563eb; font-size: 13px; font-weight: 600; white-space: nowrap; text-decoration: none; }
  .uae-arrow:hover { text-decoration: underline; }

  .uae-evidence-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .uae-ev { margin: 0; }
  .uae-ev img { width: 100%; height: 220px; object-fit: cover; display: block; border-radius: 2px; }
  .uae-ev figcaption { font-size: 12.5px; color: #64748b; margin-top: 8px; line-height: 1.5; }
  .uae-cert-line { margin-top: 24px; font-size: 13.5px; color: #64748b; line-height: 1.75; max-width: 900px; }

  .uae-note {
    background: #f8fafc; border-left: 3px solid #f59e0b;
    padding: 18px 24px; font-size: 13.5px; color: #475569; line-height: 1.75;
    border-radius: 2px; margin-top: 24px;
  }

  .uae-table-wrap {
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    border: 1px solid #e5e7eb; border-radius: 2px;
  }
  table.uae-table { width: 100%; min-width: 560px; border-collapse: collapse; background: #fff; }
  .uae-table th, .uae-table td { text-align: left; padding: 13px 18px; font-size: 14px; border-bottom: 1px solid #e5e7eb; vertical-align: top; }
  .uae-table th { background: #f8fafc; color: #0f172a; font-weight: 700; white-space: nowrap; }
  .uae-table td:first-child { font-weight: 600; color: #0f172a; white-space: nowrap; }
  .uae-table td:last-child { color: #475569; line-height: 1.6; }
  .uae-table tr:last-child td { border-bottom: none; }

  .uae-faq details { background: #fff; border: 1px solid #e5e7eb; border-radius: 2px; margin-bottom: 10px; }
  .uae-faq summary {
    list-style: none; cursor: pointer; padding: 16px 20px;
    font-weight: 600; font-size: 15px; color: #0f172a;
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
  }
  .uae-faq summary::-webkit-details-marker { display: none; }
  .uae-faq summary::after { content: '+'; color: #2563eb; font-size: 20px; font-weight: 400; line-height: 1; }
  .uae-faq details[open] summary::after { content: '\2212'; }
  .uae-faq details p { padding: 0 20px 16px; font-size: 14px; line-height: 1.75; color: #475569; margin: 0; }

  @media (max-width: 768px) {
    .uae-cap-item { grid-template-columns: 44px 1fr; gap: 14px; padding: 18px 0; }
    .uae-app-grid { grid-template-columns: 1fr; gap: 0; }
    .uae-app-row { flex-direction: column; align-items: flex-start; gap: 6px; }
    .uae-evidence-grid { grid-template-columns: 1fr; }
    .uae-ev img { height: 220px; }
  }
</style>
