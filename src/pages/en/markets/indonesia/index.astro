---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
const title = 'Steel Structure Supplier for Indonesia Projects | ZhongSai Steel Structure';
const description = 'ZhongSai provides structural steel engineering, detailing, fabrication, export delivery and installation technical support for steel structure projects in Indonesia, including industrial buildings, warehouses and mining facilities.';
const lang = 'en';
---

<BaseLayout title={title} description={description} lang={lang}>
  <section class="about-hero">
    <div class="container">
      <p class="eyebrow">Indonesia Market</p>
      <h1>Steel Structure Solutions for Projects in Indonesia</h1>
      <p class="about-hero-desc">From engineering detailing through manufacturing, export delivery to installation technical support — ZhongSai supplies structural steel for industrial, warehouse and mining projects across Indonesia.</p>
      <div class="hero-cta-group">
        <a href="/en/contact/#quote-form" class="btn btn-primary">Send Project Drawings</a>
        <a href="https://wa.me/8613192007378?text=Hello,%20I%20have%20a%20steel%20structure%20project%20in%20Indonesia%20to%20discuss." class="btn btn-outline">Discuss Your Project</a>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">ZhongSai Support for Indonesia Projects</p>
        <h2>What ZhongSai Provides for Indonesia</h2>
      </div>
      <div class="capability-grid">
        <div class="cap-card">
          <h3>Engineering & Detailing</h3>
          <p>In-house team reviews project drawings, develops shop drawings, connection details and material schedules according to project specifications.</p>
        </div>
        <div class="cap-card">
          <h3>Manufacturing & Quality</h3>
          <p>Dongguan and Huizhou manufacturing bases with approx. 100,000 tonnes annual capacity, controlled by project-specific QC requirements.</p>
        </div>
        <div class="cap-card">
          <h3>Export Delivery</h3>
          <p>Components are marked, packed and containerized for shipment to Tanjung Priok, Surabaya and other Indonesian ports.</p>
        </div>
        <div class="cap-card">
          <h3>Installation Technical Support</h3>
          <p>Erection drawings, component identification and technical guidance help Indonesian local contractors install the structure correctly.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Common Project Types</p>
        <h2>Steel Structure Applications in Indonesia</h2>
      </div>
      <div class="capability-grid">
        <div class="cap-card">
          <h3>Industrial & Manufacturing</h3>
          <p>Manufacturing workshops, assembly plants and heavy industrial buildings.</p>
          <a href="/en/steel-workshop/">View Industrial Workshop</a>
        </div>
        <div class="cap-card">
          <h3>Warehousing & Logistics</h3>
          <p>Logistics warehouses, distribution centers and storage facilities.</p>
          <a href="/en/steel-warehouse/">View Warehouse Solutions</a>
        </div>
        <div class="cap-card">
          <h3>Mining & Energy</h3>
          <p>Mining structures, processing plants, power plant auxiliaries.</p>
          <a href="/en/steel-mining-factory/">View Mining & Energy</a>
        </div>
        <div class="cap-card">
          <h3>Agricultural & Storage</h3>
          <p>Agricultural buildings, grain storage and processing facilities.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Engineering Considerations</p>
        <h2>Engineering Considerations for Projects in Indonesia</h2>
      </div>
      <div class="two-col">
        <div>
          <h3>Climate & Seismic Conditions</h3>
          <p>Indonesia's tropical climate brings high temperature and humidity. The country lies in a seismic zone, so earthquake-resistant design is important depending on project location. Corrosion protection is specified for coastal or industrial environments.</p>
        </div>
        <div>
          <h3>Design Standards</h3>
          <p>Project requirements are reviewed according to applicable local codes, client specifications and agreed design criteria. Design loads and connection details follow project drawings. Local permits and statutory approvals remain the responsibility of the project owner or appointed local engineer.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Export Delivery</p>
        <h2>How Steel Structures Are Delivered from China to Indonesia</h2>
      </div>
      <div class="two-col">
        <div>
          <h3>Delivery Process</h3>
          <p>After engineering review and detailing, steel components are fabricated in ZhongSai's Dongguan or Huizhou bases. Each component is marked, inspected, packed and loaded into containers for sea freight to Tanjung Priok, Surabaya or other Indonesian ports.</p>
        </div>
        <div>
          <h3>Local Installation Coordination</h3>
          <p>ZhongSai provides erection drawings, component marks, bolt information and technical guidance. Civil works, local permits, construction labor and physical erection are typically handled by the project's local contractor.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Frequently Asked Questions</p>
        <h2>Questions from Indonesia Project Clients</h2>
      </div>
      <div class="faq-list">
        <details>
          <summary>What drawings are needed for a quotation?</summary>
          <p>Structural drawings, architectural drawings, dimensions, load requirements, crane requirements (if any) and project location help prepare an accurate quotation. Incomplete drawings can still be submitted for initial review.</p>
        </details>
        <details>
          <summary>Can you ship steel structures to Indonesia?</summary>
          <p>Yes. Components are containerized and shipped to Tanjung Priok, Surabaya and other Indonesian ports. Export documentation and packing lists are provided.</p>
        </details>
        <details>
          <summary>How is seismic design handled?</summary>
          <p>Seismic loads are evaluated based on project location and applicable codes. Design criteria follow project specifications and agreed standards.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">Start Your Indonesia Project</p>
        <h2>Planning a Steel Structure Project in Indonesia?</h2>
        <p>Send your project location, drawings or requirements for an initial engineering review.</p>
        <div class="hero-cta-group">
          <a href="/en/contact/#quote-form" class="btn btn-primary">Send Project Drawings</a>
          <a href="https://wa.me/8613192007378?text=Hello,%20I%20have%20a%20steel%20structure%20project%20in%20Indonesia%20to%20discuss." class="btn btn-outline">Discuss Your Project</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
