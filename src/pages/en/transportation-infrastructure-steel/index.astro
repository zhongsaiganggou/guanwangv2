---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const title = 'Transportation & Infrastructure Steel Structures | Bridge, Airport, Port Steel Fabrication | ZhongSai';
const description = 'ZhongSai Steel Structure provides steel fabrication for transportation and infrastructure projects, including steel bridges, pedestrian overpasses, aircraft hangars, metro and railway steel structures, port and terminal structures, with precision fabrication and engineering coordination.';
const lang = 'en';
const canonical = 'https://zhongsai-steelstructure.com/en/transportation-infrastructure-steel/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/products/app-transport-infrastructure.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">Transportation · Infrastructure Steel</span>
      <h1>Transportation & Infrastructure Steel Structures</h1>
      <p class="lead">ZhongSai Steel Structure provides steel fabrication and component supply for transportation and infrastructure projects — including steel bridges, pedestrian overpasses, aircraft hangars, metro and railway steel structures, port and terminal structures, and highway gantries. From design detailing to precision fabrication and export, we support engineering coordination, quality-controlled manufacturing and containerized delivery for infrastructure projects worldwide.</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Get Project Quotation</a>
        <a href="/en/products/" class="btn btn-outline">View All Products</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/products/">Products</a>
      <span class="sep">/</span>
      <span class="current">Transportation & Infrastructure</span>
    </div>
  </nav>

  <!-- 01 / Infrastructure Project Requirements -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">01 / Infrastructure Project Requirements</p>
        <h2>What Information Is Needed for Infrastructure Steel Projects</h2>
        <p>Transportation and infrastructure steel projects require high precision, strict quality control and engineering coordination. The following information directly influences fabrication planning, inspection requirements and delivery organization.</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>Project Type</h3>
          <p>Steel bridge, pedestrian overpass, aircraft hangar, metro structure, port terminal or highway gantry — different project types have different fabrication and inspection requirements.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>Engineering Drawings</h3>
          <p>Structural drawings, fabrication drawings, connection details and material specifications are essential for precision fabrication.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>Material Requirements</h3>
          <p>Steel grade, thickness, welding procedure and inspection level are determined per project specifications and applicable codes.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>Quality & Inspection</h3>
          <p>NDT requirements, dimensional tolerance, welding inspection and third-party inspection needs affect fabrication planning and quality control.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>Delivery Method</h3>
          <p>Container shipping, bulk cargo or project-specific delivery method affects component sizing, packing and marking organization.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>Project Schedule</h3>
          <p>Fabrication timeline, batch delivery requirements and site installation sequence affect production planning and delivery coordination.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / Bridge & Overpass Structures -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">02 / Bridge & Overpass Structures</p>
        <h2>Steel Bridge and Pedestrian Overpass Fabrication</h2>
        <p>Steel bridges and pedestrian overpasses require high-precision fabrication, strict welding quality control and accurate dimensional control to ensure proper fit-up during site assembly.</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/app-transport-infrastructure.jpg" alt="Steel bridge transportation infrastructure" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Precision Fabrication for Bridge Structures</h3>
          <ul>
            <li>Bridge girders, crossbeams and deck support structures fabricated per engineering drawings</li>
            <li>Welding procedures qualified per project specifications and applicable codes</li>
            <li>Dimensional control and fit-up verification for site assembly accuracy</li>
            <li>NDT inspection arranged per project quality requirements</li>
            <li>Component marking and packing organized for sequential site installation</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / Rail, Aviation & Port Structures -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">03 / Rail, Aviation & Port Structures</p>
        <h2>Rail, Aviation and Port Infrastructure Steel Structures</h2>
        <p>Metro stations, railway platforms, aircraft hangars and port terminal structures require specialized steel fabrication with attention to load requirements, durability and precision connections.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/products/detail-aircraft-hangar.jpg');"></div>
          <div class="feature-body">
            <h3>Aircraft Hangars</h3>
            <p>Large-span steel hangar structures for aircraft maintenance and storage, with clear-span framing and heavy door support.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/detail-port-terminal.jpg');"></div>
          <div class="feature-body">
            <h3>Port & Terminal Structures</h3>
            <p>Steel fabrication for port terminals, warehouse structures and equipment support frames, designed for heavy loads and coastal environments.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 / Quality Control & Engineering -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">04 / Quality Control & Engineering</p>
        <h2>Quality Control and Engineering Coordination</h2>
        <p>Infrastructure projects demand rigorous quality control and close engineering coordination. ZhongSai maintains documented quality processes and works closely with project engineers to ensure fabrication meets specifications.</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/manufacturing/real/workshop-overview-wide-9815.jpg" alt="Infrastructure steel fabrication quality control" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Documented Quality for Infrastructure Projects</h3>
          <ul>
            <li>Material traceability and mill certificate verification per project requirements</li>
            <li>Welding procedure qualification and welder qualification documentation</li>
            <li>Dimensional inspection at critical fabrication stages</li>
            <li>NDT inspection (UT, MT, PT) arranged per project specifications</li>
            <li>Engineering coordination for drawing clarification and technical issue resolution</li>
          </ul>
          <div style="margin-top: 20px;">
            <a href="/en/manufacturing-quality/" class="btn btn-outline">View Manufacturing Quality</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 / Fabrication & Export Delivery -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">05 / Fabrication & Export Delivery</p>
        <h2>From Drawings to Containerized Delivery for Infrastructure</h2>
        <p>ZhongSai operates its own production base, fabricating infrastructure steel components per project drawings, with organized packing, marking and container loading for international delivery.</p>
      </div>
      <div class="process-flow">
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">01</div>
          <h4>Drawings Confirmation</h4>
          <p>Engineering drawings, specifications and technical requirements confirmed</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">02</div>
          <h4>Detailing & Planning</h4>
          <p>Fabrication detailing, production planning and inspection planning</p>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">03</div>
          <h4>Precision Fabrication</h4>
          <p>Cutting, assembly, welding and surface treatment per drawings</p>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">04</div>
          <h4>Quality Inspection</h4>
          <p>Dimensional check, welding inspection and NDT per requirements</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>Marking & Packing</h4>
          <p>Component marking, packing and loading plan organization</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">06</div>
          <h4>Container Loading</h4>
          <p>Container loading coordination and export documentation support</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">06 / Related</p>
        <h2>Related Capabilities</h2>
        <p>Explore related ZhongSai capabilities and services for your project.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3><a href="/en/products/custom-engineering/" style="color: inherit; text-decoration: none;">Custom Engineering</a></h3>
            <p>Custom steel structure fabrication</p>
            <a href="/en/products/custom-engineering/" style="color: #2563eb; font-size: 14px; font-weight: 600;">Learn more →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3><a href="/en/manufacturing-quality/" style="color: inherit; text-decoration: none;">Manufacturing Quality</a></h3>
            <p>Quality-controlled fabrication</p>
            <a href="/en/manufacturing-quality/" style="color: #2563eb; font-size: 14px; font-weight: 600;">Learn more →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3><a href="/en/engineering-design/" style="color: inherit; text-decoration: none;">Engineering Design</a></h3>
            <p>Design and detailing support</p>
            <a href="/en/engineering-design/" style="color: #2563eb; font-size: 14px; font-weight: 600;">Learn more →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-4">
          <div class="feature-body">
            <h3><a href="/en/export-delivery/" style="color: inherit; text-decoration: none;">Export Delivery</a></h3>
            <p>Packing, loading and export coordination</p>
            <a href="/en/export-delivery/" style="color: #2563eb; font-size: 14px; font-weight: 600;">Learn more →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote Form -->
  <section id="quote" class="detail-section">
    <div class="container">
      <QuoteForm />
    </div>
  </section>
</BaseLayout>
