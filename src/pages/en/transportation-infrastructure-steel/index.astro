---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const title = 'Transportation & Infrastructure Steel Structures | ZhongSai';
const description = 'Steel structures for transportation and infrastructure: pedestrian bridges, walkways, station buildings, canopies, corridors and connecting structures.';
const lang = 'en';
const canonical = 'https://zhongsai-steelstructure.com/en/transportation-infrastructure-steel/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/products/app-transport-infrastructure.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">Transportation · Infrastructure Steel</span>
      <h1>Steel Structures for Transportation and Infrastructure Projects</h1>
      <p class="lead">Steel structures for stations, pedestrian bridges, walkways, canopies, corridors and other transportation infrastructure requiring precise fabrication, complex detailing and durable performance. From structural detailing to precision manufacturing, containerized export and technical installation guidance.</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Send Infrastructure Drawings for Review</a>
        <a href="#engineering-params" class="btn btn-outline">Request Technical Consultation</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/products/">Products</a>
      <span class="sep">/</span>
      <span class="current">Transportation & Infrastructure</span>
    </div>
  </nav>

  <!-- 01 / Typical Applications -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Typical Applications</p>
        <h2>Transportation & Infrastructure Steel Structure Applications</h2>
        <p>ZhongSai fabricates steel structures for a wide range of transportation and infrastructure applications, each requiring specific engineering attention to loads, durability, geometry and site assembly conditions.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3>Pedestrian Bridges</h3>
            <p>Steel pedestrian overpasses and footbridges with span configurations, deck systems, railings and vibration control considerations.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3>Steel Walkways</h3>
            <p>Elevated walkways, access platforms and circulation structures for transit hubs, industrial complexes and public spaces.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3>Station Buildings</h3>
            <p>Steel framing for metro stations, railway stations and transit terminals including platform structures and concourse framing.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3>Station Canopies</h3>
            <p>Large-span canopy structures for platforms, bus stations and transit stops with column-free space and drainage coordination.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3>Airport-related Structures</h3>
            <p>Steel structures for airport terminals, hangars, maintenance facilities and aviation-related infrastructure requiring long-span solutions.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3>Transit Corridors</h3>
            <p>Enclosed and open transit corridors, skybridges and connecting structures between buildings or transit facilities.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3>Connecting Bridges</h3>
            <p>Building-to-building connecting bridges and pedestrian link structures with expansion joint and differential movement coordination.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3>Platform Structures</h3>
            <p>Steel platform framing, equipment support platforms and maintenance access structures for transit and industrial infrastructure.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3>Transport Maintenance Facilities</h3>
            <p>Steel structures for vehicle maintenance depots, train maintenance facilities and transport equipment workshops with crane requirements.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / Engineering Considerations -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Engineering Considerations</p>
        <h2>Key Engineering Considerations for Infrastructure Steel Structures</h2>
        <p>Transportation and infrastructure steel structures require careful engineering attention to multiple performance criteria. Specific requirements are determined per project drawings, loads, transport limits and applicable local codes.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3>Long-span Requirements</h3>
            <p>Clear-span configurations for stations, canopies and bridges, with structural system selection based on span, load and architectural requirements.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3>Fatigue & Vibration</h3>
            <p>Fatigue considerations for cyclic loading structures; pedestrian vibration comfort assessment for footbridges and walkways per applicable standards.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3>Wind & Seismic</h3>
            <p>Wind load and seismic requirement coordination per project location and applicable design codes, including connection design for lateral loads.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3>Complex Geometry</h3>
            <p>Curved, irregular and architecturally complex geometry requiring precision fabrication, 3D modeling coordination and dimensional verification.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3>Corrosion Exposure</h3>
            <p>Corrosion protection system selection based on exposure category, environmental conditions and design service life requirements per project specifications.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3>Transport Size Limits</h3>
            <p>Component segmentation design for container shipping or project-specific transport limitations, with connection design to accommodate transport segments.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / Typical Engineering Parameters -->
  <section id="engineering-params" class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Engineering Parameters</p>
        <h2>Typical Engineering Parameters for Infrastructure Steel Structures</h2>
        <p>Parameters below indicate the range of engineering considerations for transportation infrastructure steel structures. Specific values are determined per project drawings, loads, transport limits and applicable local codes.</p>
      </div>
      <div class="param-table-container reveal">
        <table class="param-table">
          <thead>
            <tr>
              <th>Parameter</th>
              <th>Typical / Project-based</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Structure Type</strong></td>
              <td>Pedestrian bridge, walkway, station frame, canopy, corridor, connecting bridge, platform structure</td>
            </tr>
            <tr>
              <td><strong>Structural System</strong></td>
              <td>Truss, frame, girder, space frame, cable-supported or project-specific system per design</td>
            </tr>
            <tr>
              <td><strong>Span</strong></td>
              <td>According to project requirements and structural design; long-span configurations available</td>
            </tr>
            <tr>
              <td><strong>Main Steel Grade</strong></td>
              <td>Q355B, Q235B or equivalent project-specified grade per design requirements</td>
            </tr>
            <tr>
              <td><strong>Connection Type</strong></td>
              <td>Bolted, welded or combined connections per structural design and fabrication requirements</td>
            </tr>
            <tr>
              <td><strong>Surface Protection</strong></td>
              <td>Painting, hot-dip galvanizing or duplex system per project exposure category and specifications</td>
            </tr>
            <tr>
              <td><strong>Corrosion Category</strong></td>
              <td>According to project environment, exposure conditions and design service life requirements</td>
            </tr>
            <tr>
              <td><strong>Fatigue Requirement</strong></td>
              <td>Project specific for cyclic loading structures; fatigue class per applicable design code</td>
            </tr>
            <tr>
              <td><strong>Design Standard</strong></td>
              <td>Based on project country, client specification and applicable local design codes</td>
            </tr>
            <tr>
              <td><strong>Fabrication Tolerance</strong></td>
              <td>According to approved drawings, project specifications and applicable fabrication standards</td>
            </tr>
            <tr>
              <td><strong>Transport Segment Size</strong></td>
              <td>Designed for container shipping or project-specific transport limitations; segmented per logistics plan</td>
            </tr>
            <tr>
              <td><strong>Export Method</strong></td>
              <td>Containerized shipment or project-specific logistics per component size and delivery requirements</td>
            </tr>
            <tr>
              <td><strong>Installation Support</strong></td>
              <td>Technical guidance available; local civil works and construction normally handled by local contractors</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p style="margin-top: 16px; color: #888; font-size: 0.85rem; font-style: italic;">Note: All parameters are project-specific and determined based on structural drawings, design loads, transport limitations and applicable local building codes. ZhongSai provides fabrication and export supply based on confirmed engineering drawings.</p>
    </div>
  </section>

  <!-- 04 / Pedestrian Bridges & Walkways -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Pedestrian Bridges & Walkways</p>
        <h2>Steel Pedestrian Bridges and Walkways</h2>
        <p>Steel pedestrian bridges and walkways require careful attention to span configuration, deck systems, railings, vibration control and modular transport for site assembly.</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/products/app-transport-infrastructure.jpg" alt="Steel pedestrian bridge and walkway infrastructure structure" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Engineering Considerations for Pedestrian Structures</h3>
          <ul>
            <li>Span configuration based on crossing requirements and site constraints</li>
            <li>Deck system design including walking surface, drainage and non-slip considerations</li>
            <li>Railing and barrier design per applicable safety standards and project requirements</li>
            <li>Pedestrian vibration comfort assessment per applicable standards where required</li>
            <li>Live load and crowd load considerations per design code</li>
            <li>Modular segmentation for container transport and sequential site assembly</li>
            <li>Component marking and packing list organized for efficient site erection</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 / Stations & Canopies -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Stations & Canopies</p>
        <h2>Steel Structures for Stations and Canopies</h2>
        <p>Station buildings and platform canopies require large-span roof systems, column-free space, architectural coordination and careful integration with cladding, lighting and MEP systems.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/products/detail-aircraft-hangar.jpg');"></div>
          <div class="feature-body">
            <h3>Large-span Roof Systems</h3>
            <p>Truss, girder or space frame roof configurations for station concourses and platform canopies with clear-span requirements.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/detail-port-terminal.jpg');"></div>
          <div class="feature-body">
            <h3>Curved & Irregular Geometry</h3>
            <p>Architecturally complex canopy shapes requiring 3D modeling coordination, precision fabrication and dimensional verification.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3>Column-free Space</h3>
            <p>Long-span structural solutions maximizing usable platform and concourse area with minimal column interference.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3>Architectural Coordination</h3>
            <p>Close coordination with architectural design for cladding interfaces, lighting attachment points and MEP system supports.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3>Drainage Coordination</h3>
            <p>Roof drainage system integration including gutter supports, downpipe locations and structural slope coordination.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3>Cladding Interface</h3>
            <p>Primary structure designed to accommodate cladding system loads, attachment points and thermal movement considerations.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 / Corridors & Connecting Structures -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Corridors & Connecting Structures</p>
        <h2>Steel Corridors and Connecting Structures</h2>
        <p>Building-to-building connecting bridges and transit corridors require careful structural interface design, expansion joint coordination and differential movement accommodation.</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/03-commercial-public.jpg" alt="Steel corridor and connecting bridge structure for transit infrastructure" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Key Design Considerations for Connecting Structures</h3>
          <ul>
            <li>Building-to-building structural interface design and load transfer coordination</li>
            <li>Expansion joint provision for thermal movement and structural deflection</li>
            <li>Differential movement accommodation between connected structures</li>
            <li>Structural interface with existing or new building framing systems</li>
            <li>Fire separation interface coordination where applicable per building code</li>
            <li>Transport and erection segmentation design for site assembly conditions</li>
            <li>Connection design accommodating construction tolerances and field adjustment</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 / Durability & Corrosion Protection -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Durability & Corrosion</p>
        <h2>Durability and Corrosion Protection</h2>
        <p>Transportation infrastructure structures often face demanding exposure conditions. Corrosion protection systems are selected based on project exposure category, environmental conditions and design service life requirements.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3>Painting Systems</h3>
            <li>Multi-coat paint systems including primer, intermediate and finish coats per project specifications</li>
            <li>Surface preparation per SA 2.5 or project-specified standard</li>
            <li>Dry film thickness verified per coating specification</li>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3>Hot-dip Galvanizing</h3>
            <li>Hot-dip galvanized protection for components suitable for galvanizing bath dimensions</li>
            <li>Zinc coating thickness per applicable standard and project requirements</li>
            <li>Galvanizing design considerations for venting and drainage</li>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3>Duplex Systems</h3>
            <li>Galvanized plus painted duplex systems where specified for enhanced durability</li>
            <li>Coating system selection based on exposure category and design life</li>
            <li>Touch-up and repair procedures for site-assembled connections</li>
          </div>
        </div>
      </div>
      <p style="margin-top: 20px; color: #888; font-size: 0.85rem; font-style: italic;">Note: Specific corrosion protection systems and expected service life are determined per project exposure category, client specifications and applicable standards. ZhongSai does not guarantee fixed corrosion-free service life without confirmed coating system specification and maintenance program.</p>
    </div>
  </section>

  <!-- 08 / Precision Fabrication & Trial Assembly -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Fabrication & Trial Assembly</p>
        <h2>Precision Fabrication and Trial Assembly</h2>
        <p>Infrastructure steel structures demand high fabrication precision. ZhongSai maintains documented quality processes including material traceability, CNC cutting, qualified welding, dimensional inspection and trial assembly where required.</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/manufacturing/real/workshop-overview-wide-9815.jpg" alt="Precision steel fabrication workshop for infrastructure projects" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Fabrication Quality Process</h3>
          <ul>
            <li>Material traceability and mill certificate verification per project requirements</li>
            <li>CNC cutting and precision machining for connection plates and details</li>
            <li>Welding procedure qualification and welder qualification documentation</li>
            <li>Dimensional inspection at critical fabrication stages with recorded results</li>
            <li>Trial assembly for complex structures where required by project specification</li>
            <li>Component marking system for identification and sequential site assembly</li>
            <li>Surface treatment and packing per project export requirements</li>
          </ul>
          <div style="margin-top: 20px;">
            <a href="/en/manufacturing-quality/" class="btn btn-outline">View Manufacturing & Quality</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 / Design for Transport & Site Assembly -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Transport & Assembly</p>
        <h2>Design for Transport and Site Assembly</h2>
        <p>For export infrastructure projects, component sizing must accommodate transport limitations while maintaining structural integrity. ZhongSai coordinates segmentation design, connection detailing and packing organization for efficient container shipping and site assembly.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3>Component Segmentation</h3>
            <p>Long or oversized components segmented to fit container dimensions or project-specific transport limitations, with structural connections designed for field assembly.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3>Container Size Limits</h3>
            <p>Component dimensions coordinated with 20ft, 40ft or 40HQ container internal dimensions, including allowance for packing materials and loading clearances.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3>Connection Design</h3>
            <p>Field connections designed to accommodate transport segmentation, including bolted splice plates, alignment features and tolerance allowance for field adjustment.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3>Site Erection Sequence</h3>
            <p>Component marking and packing organized to support logical site erection sequence, with assembly drawings and identification systems for efficient field assembly.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3>Marking System</h3>
            <p>Each component marked with unique identification matching assembly drawings, including piece mark, orientation indicators and connection reference information.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3>Packing List</h3>
            <p>Detailed packing lists organized by container, including component inventory, piece marks, weights and handling instructions for efficient unloading and site storage.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 10 / Information Required for Technical Review -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Technical Review</p>
        <h2>Information Required for Technical Review and Quotation</h2>
        <p>The more complete the project documentation, the more accurate the technical review and quotation. If documentation is incomplete, you can first submit available materials, and ZhongSai will further confirm what is needed for quotation.</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>Project Location</h3>
          <p>Project country and city to determine applicable design codes, environmental conditions and logistics considerations.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>Structural Drawings</h3>
          <p>Structural drawings, fabrication drawings, connection details and material specifications for precision fabrication review.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>Architectural Drawings</h3>
          <p>Architectural drawings for coordination of cladding interfaces, attachment points and geometric requirements.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>Span & Dimensions</h3>
          <p>Overall dimensions, span configurations, clear height requirements and critical dimensional constraints.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>Design Loads</h3>
          <p>Dead load, live load, wind load, seismic requirements, crowd load and fatigue load specifications where applicable.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>Design Code</h3>
          <p>Applicable design standards, building codes and project-specific technical specifications to be followed.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">07</div>
          <h3>Corrosion Environment</h3>
          <p>Exposure category, environmental conditions and required corrosion protection system or design service life.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">08</div>
          <h3>Surface Treatment</h3>
          <p>Required surface protection system specification including paint system, galvanizing or duplex coating requirements.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">09</div>
          <h3>Transport Limitations</h3>
          <p>Shipping method, container type, transport route constraints and any special delivery requirements affecting component sizing.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">10</div>
          <h3>Delivery Port</h3>
          <p>Destination port or delivery location for logistics planning, packing organization and export documentation coordination.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">11</div>
          <h3>Project Schedule</h3>
          <p>Fabrication timeline, batch delivery requirements and site installation sequence affecting production planning.</p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 30px;">
        <a href="#quote" class="btn btn-primary">Upload Drawings for Review</a>
      </div>
    </div>
  </section>

  <!-- 11 / Fabrication & Export Delivery Process -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Process</p>
        <h2>From Drawings to Containerized Delivery for Infrastructure</h2>
        <p>ZhongSai operates its own production base, fabricating infrastructure steel components per project drawings, with organized packing, marking and container loading for international delivery.</p>
      </div>
      <div class="process-flow">
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">01</div>
          <h4>Project Review</h4>
          <p>Drawings, specifications and technical requirements reviewed for fabrication feasibility</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">02</div>
          <h4>Detailing & Planning</h4>
          <p>Fabrication detailing, production planning, transport segmentation and inspection planning</p>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">03</div>
          <h4>Precision Fabrication</h4>
          <p>CNC cutting, assembly, welding and surface treatment per approved drawings</p>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">04</div>
          <h4>Quality Inspection</h4>
          <p>Dimensional check, welding inspection, NDT and trial assembly where required</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>Marking & Packing</h4>
          <p>Component marking, packing list organization and container loading planning</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">06</div>
          <h4>Export Delivery</h4>
          <p>Container loading coordination, export documentation and installation technical guidance</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 12 / Related Capabilities & Internal Links -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Related</p>
        <h2>Related Capabilities and Components</h2>
        <p>Explore related ZhongSai capabilities, component types and services for your transportation infrastructure project.</p>
      </div>
