---
// ZhongSai V3 - English Homepage
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import '../../styles/home.css';
import '../../styles/home-v3.css';
import { getLatestPlaylistVideos, formatVideoDate } from '../../data/youtubePlaylist';
const shipmentVideos = await getLatestPlaylistVideos(4);

const lang = 'en';
const title = 'ZhongSai Steel Structure | Design, Fabrication & Export Delivery';
const description = 'Integrated structural steel design, detailing, fabrication and export delivery for overseas projects. 100,000 m2 manufacturing base, 60+ countries.';
---

<BaseLayout title={title} description={description} lang={lang}>

  <!-- 1. Hero -->
  <section class="hero-home">
    <picture class="hero-home-bg">
      <source type="image/avif" sizes="100vw" srcset="/images/optimized/home/hero-768.avif 768w, /images/optimized/home/hero-1280.avif 1280w, /images/optimized/home/hero-1920.avif 1920w">
      <source type="image/webp" sizes="100vw" srcset="/images/optimized/home/hero-768.webp 768w, /images/optimized/home/hero-1280.webp 1280w, /images/optimized/home/hero-1920.webp 1920w">
      <img src="/images/optimized/home/hero-1280.jpg" sizes="100vw" srcset="/images/optimized/home/hero-768.jpg 768w, /images/optimized/home/hero-1280.jpg 1280w, /images/optimized/home/hero-1920.jpg 1920w" width="1920" height="1084" alt="ZhongSai steel structure manufacturing base aerial panorama" fetchpriority="high" decoding="async">
    </picture>
    <div class="hero-home-overlay"></div>
    <div class="container hero-home-content">
      <p class="eyebrow">Steel Engineering · Manufacturing · Global Delivery</p>
      <h1>From drawings to construction site</h1>
      <p class="lead">Integrated design, fabrication and export delivery for overseas steel structure projects. One team across the critical stages.</p>
      <div class="hero-home-actions">
        <a href="#quote" class="btn btn-primary">Send Project Drawings ↗</a>
        <a href="/en/steel-workshop/" class="btn btn-secondary">Explore Solutions</a>
      </div>
      <div class="hero-home-stats">
        <div class="hero-stat"><b>15<sup>+ yrs</sup></b><span>Export experience</span></div>
        <div class="hero-stat"><b>100K<sup>m2</sup></b><span>Manufacturing base</span></div>
        <div class="hero-stat"><b>100K<sup>t</sup></b><span>Annual capacity</span></div>
        <div class="hero-stat"><b>60<sup>+</sup></b><span>Countries</span></div>
      </div>
    </div>
  </section>

  <!-- 2. Project Entry -->
  <section class="section">
    <div class="container">
      <div class="entry-grid">
        <a href="#quote" class="entry-card">
          <h3>I Have Drawings / BOQ</h3>
          <p>Upload architectural, structural drawings or BOQ for engineering and fabrication review.</p>
          <span class="entry-link">Upload Project Drawings →</span>
        </a>
        <a href="#quote" class="entry-card">
          <h3>I Don't Have Complete Drawings</h3>
          <p>Tell us your project location, building use and dimensions. We help clarify scope and requirements.</p>
          <span class="entry-link">Describe Your Project →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. Solutions -->
  <section class="section section-gray">
    <div class="container container-xwide">
      <div class="section-heading">
        <p class="eyebrow">Solutions</p>
        <h2>By Project Application</h2>
      </div>
      <div class="solutions-grid">
        <a href="/en/steel-workshop/" class="solution-card">
          <div class="solution-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/sol-industrial-720.avif">
              <source type="image/webp" srcset="/images/optimized/home/sol-industrial-720.webp">
              <img src="/images/optimized/home/sol-industrial-720.jpg" width="720" height="405" loading="lazy" decoding="async" alt="Industrial and manufacturing steel workshop">
            </picture>
          </div>
          <h3>Industrial & Manufacturing</h3>
        </a>
        <a href="/en/steel-warehouse/" class="solution-card">
          <div class="solution-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/sol-warehouse-720.avif">
              <source type="image/webp" srcset="/images/optimized/home/sol-warehouse-720.webp">
              <img src="/images/optimized/home/sol-warehouse-720.jpg" width="720" height="405" loading="lazy" decoding="async" alt="Warehousing and logistics steel warehouse">
            </picture>
          </div>
          <h3>Warehousing & Logistics</h3>
        </a>
        <a href="/en/steel-mining-factory/" class="solution-card">
          <div class="solution-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/sol-mining-720.avif">
              <source type="image/webp" srcset="/images/optimized/home/sol-mining-720.webp">
              <img src="/images/optimized/home/sol-mining-720.jpg" width="720" height="405" loading="lazy" decoding="async" alt="Mining and energy steel structure and bins">
            </picture>
          </div>
          <h3>Mining & Energy</h3>
        </a>
        <a href="/en/agricultural-steel-buildings/" class="solution-card">
          <div class="solution-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/sol-agriculture-720.avif">
              <source type="image/webp" srcset="/images/optimized/home/sol-agriculture-720.webp">
              <img src="/images/optimized/home/sol-agriculture-720.jpg" width="720" height="405" loading="lazy" decoding="async" alt="Agriculture and livestock steel building">
            </picture>
          </div>
          <h3>Agriculture & Livestock</h3>
        </a>
        <a href="/en/commercial-public-steel-buildings/" class="solution-card">
          <div class="solution-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/sol-commercial-720.avif">
              <source type="image/webp" srcset="/images/optimized/home/sol-commercial-720.webp">
              <img src="/images/optimized/home/sol-commercial-720.jpg" width="720" height="405" loading="lazy" decoding="async" alt="Commercial and public steel building">
            </picture>
          </div>
          <h3>Commercial & Public</h3>
        </a>
        <a href="/en/transportation-infrastructure-steel/" class="solution-card">
          <div class="solution-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/sol-transport-720.avif">
              <source type="image/webp" srcset="/images/optimized/home/sol-transport-720.webp">
              <img src="/images/optimized/home/sol-transport-720.jpg" width="720" height="405" loading="lazy" decoding="async" alt="Transportation and infrastructure steel structure">
            </picture>
          </div>
          <h3>Infrastructure</h3>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. Engineering & Manufacturing -->
  <section class="section">
    <div class="container container-xwide">
      <div class="section-heading">
        <p class="eyebrow">Engineering & Manufacturing</p>
        <h2>Proof from design to container</h2>
      </div>
      <div class="evidence-flow">
        <div class="evidence-text">
          <p>In-house structural team handles design, detailing and connection design. Dongguan and Huizhou bases manage cutting, welding, inspection and coating. Component marking, packing lists and loading plans are delivered together.</p>
          <div class="evidence-steps">
            <span>Engineering & Detailing</span>
            <span>Fabrication & QC</span>
            <span>Packing & Export</span>
            <span>Installation Support</span>
          </div>
          <a href="/en/manufacturing-quality/" class="btn btn-outline">View Manufacturing →</a>
        </div>
        <div class="evidence-img">
          <img src="/images/manufacturing/real/welding-9820.jpg" alt="Welding at ZhongSai manufacturing base" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Selected Projects -->
  <section class="section section-gray">
    <div class="container container-xwide">
      <div class="section-heading">
        <p class="eyebrow">Selected Projects</p>
        <h2>Representative projects</h2>
      </div>
      <div class="projects-grid">
        <a href="/en/projects/singapore-airport-t2-connect/" class="project-card">
          <div class="project-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/proj-singapore-640.avif">
              <source type="image/webp" srcset="/images/optimized/home/proj-singapore-640.webp">
              <img src="/images/optimized/home/proj-singapore-640.jpg" width="640" height="421" loading="lazy" decoding="async" alt="Singapore Changi Airport T2 Connect project">
            </picture>
          </div>
          <div class="project-info"><h3>Changi Airport T2</h3><p>Singapore · Transportation</p></div>
        </a>
        <a href="/en/projects/macau-londoner/" class="project-card">
          <div class="project-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/proj-macau-640.avif">
              <source type="image/webp" srcset="/images/optimized/home/proj-macau-640.webp">
              <img src="/images/optimized/home/proj-macau-640.jpg" width="640" height="421" loading="lazy" decoding="async" alt="Macau Londoner commercial complex project">
            </picture>
          </div>
          <div class="project-info"><h3>Macau Londoner</h3><p>Macau · Commercial</p></div>
        </a>
        <a href="/en/projects/shantou-luxshare-electronics-center/" class="project-card">
          <div class="project-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/proj-shantou-640.avif">
              <source type="image/webp" srcset="/images/optimized/home/proj-shantou-640.webp">
              <img src="/images/optimized/home/proj-shantou-640.jpg" width="640" height="421" loading="lazy" decoding="async" alt="Shantou Luxshare Precision electronics factory project">
            </picture>
          </div>
          <div class="project-info"><h3>Luxshare Electronics</h3><p>Guangdong · Manufacturing</p></div>
        </a>
        <a href="/en/projects/cnpc-cracking-furnace/" class="project-card">
          <div class="project-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/proj-cnpc-640.avif">
              <source type="image/webp" srcset="/images/optimized/home/proj-cnpc-640.webp">
              <img src="/images/optimized/home/proj-cnpc-640.jpg" width="640" height="421" loading="lazy" decoding="async" alt="CNPC Sixth Construction cracking furnace project">
            </picture>
          </div>
          <div class="project-info"><h3>CNPC Cracking Furnace</h3><p>Energy · Heavy Industry</p></div>
        </a>
      </div>
      <div style="text-align:center;margin-top:32px;">
        <a href="/en/projects/" class="btn btn-outline">View All Projects →</a>
      </div>
    </div>
  </section>

  <!-- 5b. Recent Export Shipments -->
  <section class="section">
    <div class="container container-xwide">
      <div class="section-heading" style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px;">
        <div>
          <p class="eyebrow">Export Delivery</p>
          <h2>Recent Export Shipments</h2>
          <p style="margin-top:8px;max-width:560px;">ZhongSai records the packing, container loading and export preparation of structural steel components for overseas projects. Watch recent shipment activity.</p>
        </div>
        <a href="/en/export-delivery/shipments/" class="btn btn-outline">View All Shipment Videos &rarr;</a>
      </div>
      {shipmentVideos.length > 0 && (
      <div class="shipment-video-row">
        {shipmentVideos.map((v) => (
          <div class="ship-video-card" data-video-id={v.videoId}>
            <div class="ship-thumb">
              <img src={v.thumbnail} alt={v.title} loading="lazy" width="180" height="320" />
              <div class="ship-play-btn"><svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg></div>
            </div>
            <div class="ship-meta">
              <p class="ship-title">{v.title}</p>
              <p class="ship-date">{formatVideoDate(v.publishedAt, "en")}</p>
            </div>
          </div>
        ))}
      </div>
      )}
    </div>
  </section>

  <!-- 6. Delivery Process -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Delivery Process</p>
        <h2>How your project moves forward</h2>
      </div>
      <div class="process-grid">
        <div class="process-step"><b>01</b><strong>Project Review</strong><span>Location, use, dimensions and drawing requirements</span></div>
        <div class="process-step"><b>02</b><strong>Engineering & Detailing</strong><span>Structural design, connection detailing</span></div>
        <div class="process-step"><b>03</b><strong>Manufacturing & QC</strong><span>Cutting, welding, inspection, surface treatment</span></div>
        <div class="process-step"><b>04</b><strong>Packing & Export</strong><span>Component marking, packing list, container loading</span></div>
        <div class="process-step"><b>05</b><strong>Installation Support</strong><span>Erection drawings and technical guidance</span></div>
      </div>
    </div>
  </section>


  <!-- 7. Project Inquiry -->
  <section class="cta-final" id="quote">
    <div class="container">
      <p class="eyebrow" style="color:rgba(255,255,255,.6)">Start Your Project</p>
      <h2>Planning a steel structure project?</h2>
      <p>Tell us your project location, use and drawings. Our engineering team will respond within 1 business day.</p>
      <div class="cta-actions">
        <a href="/en/contact/" class="btn btn-primary">Send Project Drawings ↗</a>
        <a href="/en/about/" class="btn btn-secondary">About ZhongSai</a>
      </div>
    </div>
    <QuoteForm lang={lang} />
  </section>

</BaseLayout>

<style>
.container-wide { max-width: 1320px; }
@media (max-width: 1360px) { .container-wide { max-width: calc(100% - 48px); } }
@media (max-width: 768px) { .container-wide { max-width: calc(100% - 40px); } }
@media (max-width: 480px) { .container-wide { max-width: calc(100% - 32px); } }
.shipment-video-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.ship-video-card {
  cursor: pointer;
}
.ship-thumb {
  position: relative;
  aspect-ratio: 9/16;
  border-radius: 6px;
  overflow: hidden;
  background: #1a1a2e;
}
.ship-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.ship-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 48px;
  height: 48px;
  background: rgba(255,0,0,.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .15s;
}
.ship-video-card:hover .ship-play-btn {
  transform: translate(-50%, -50%) scale(1.1);
}
.ship-meta {
  padding: 10px 2px 0;
}
.ship-title {
  font-size: 13px;
  font-weight: 600;
  line-height: 1.4;
  margin: 0 0 4px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ship-date {
  font-size: 12px;
  color: #6b7280;
  margin: 0;
}
@media (max-width: 1024px) {
  .shipment-video-row { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .shipment-video-row {
    display: flex;
    overflow-x: auto;
    gap: 14px;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    padding-bottom: 8px;
  }
  .ship-video-card {
    flex: 0 0 85%;
    scroll-snap-align: start;
  }
}
<style>
.section-heading-left { grid-template-columns: 1fr !important; align-items: start !important; }
.section-heading-left h2 { margin-top: 8px; }
.section-heading-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 8px;
}
.section-heading-center .eyebrow { margin-bottom: 0; }
.process-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0;
  border-top: 2px solid #1a56db;
}
.process-step {
  padding: 28px 20px 24px;
  border-right: 1px solid #e5e7eb;
  position: relative;
}
.process-step:last-child { border-right: none; }
.process-step::before {
  content: '';
  position: absolute;
  top: -2px; left: 0;
  width: 12px; height: 2px;
  background: #f59e0b;
}
.process-step b {
  display: block;
  font-size: 13px;
  color: #1a56db;
  font-weight: 700;
  margin-bottom: 12px;
  letter-spacing: 1px;
}
.process-step strong {
  display: block;
  font-size: 16px;
  color: #111;
  margin-bottom: 8px;
  line-height: 1.4;
}
.process-step span {
  font-size: 13px;
  color: #6b7280;
  line-height: 1.6;
  display: block;
}
@media (max-width: 1024px) {
  .process-grid { grid-template-columns: repeat(3, 1fr); }
  .process-step:nth-child(3) { border-right: none; }
  .process-step:nth-child(4), .process-step:nth-child(5) { border-top: 1px solid #e5e7eb; }
}
@media (max-width: 640px) {
  .process-grid { grid-template-columns: 1fr; border-top: none; }
  .process-step { border-right: none; border-bottom: 1px solid #e5e7eb; border-left: 3px solid #1a56db; }
  .process-step::before { display: none; }
}
</style></style>
<script>
document.querySelectorAll('.ship-video-card').forEach(function(card) {
  card.addEventListener('click', function() {
    var vid = this.getAttribute('data-video-id');
    var thumb = this.querySelector('.ship-thumb');
    if (!vid || !thumb) return;
    if (thumb.querySelector('iframe')) return;
    var iframe = document.createElement('iframe');
    iframe.src = 'https://www.youtube.com/embed/' + vid + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
    iframe.setAttribute('allowfullscreen', '');
    iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
    thumb.innerHTML = '';
    thumb.appendChild(iframe);
  });
});
</script>
