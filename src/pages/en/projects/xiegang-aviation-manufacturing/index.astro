---
// ZhongSai V2 - English Project Detail: xiegang-aviation-manufacturing
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ProjectDetailLayout from '../../../../components/ProjectDetailLayout.astro';
import { getProjectBySlug } from '../../../../data/projects-data';

const lang = 'en';
const project = getProjectBySlug('xiegang-aviation-manufacturing')!;
const title = `${project.name.en} | ZhongSai`;
const description = `${project.name.en} - ${project.category.en} project in ${project.location.en}. ZhongSai provided structural steel fabrication.`;
---

<BaseLayout title={title} description={description} lang={lang}>
  <ProjectDetailLayout project={project} lang={lang} />
</BaseLayout>
