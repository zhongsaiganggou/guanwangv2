          </div>
        </a>
        <a href="/en/projects/xiegang-aviation-manufacturing/" class="project-card reveal reveal-delay-2">
          <div class="project-img" style="background-image: url('/images/projects/shanghai-baoye-xiegang-aviation-manufacturing-aerial-rendering.jpg');"></div>
          <div class="project-body">
            <span class="project-type">Industrial Manufacturing</span>
            <h3>Xiegang Aviation Manufacturing</h3>
            <div class="project-meta">
              <span>📍 Dongguan, China</span>
            </div>
