---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Solutions | ZhongSai Steel Structure';
const description = 'ZhongSai provides steel structure solutions for industrial, commercial, agricultural, mining, infrastructure and other industries.';
const lang = 'en';
const canonical = 'https://zhongsai-steelstructure.com/en/products/';
---

<BaseLayout title={title} description={description} lang={lang} canonical={canonical}>
  <section style="padding: 80px 0; text-align: center; background: #f8f9fa;">
    <div class="container">
      <h1 style="font-size: 1.8rem; color: #0a3d62; margin-bottom: 16px;">Steel Structure Solutions</h1>
      <p style="font-size: 1.05rem; color: #555; margin-bottom: 32px; max-width: 600px; margin-left: auto; margin-right: auto;">
        ZhongSai provides complete steel structure solutions for industrial workshops, warehousing & logistics, commercial & public buildings, agriculture, mining & energy, transportation infrastructure and more.
      </p>
      <a href="/en/products/" class="btn btn-primary" style="display: inline-block; padding: 14px 32px; font-size: 1rem;">
        View All Products & Solutions →
      </a>
    </div>
  </section>
</BaseLayout>
