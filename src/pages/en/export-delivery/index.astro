---
// ZhongSai V2 - English Export Delivery Page (detail system rebuild)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const lang = 'en';
const title = 'Steel Structure Export & Overseas Delivery | ZhongSai';
const description = 'From design and fabrication planning to component marking, packing, container loading and overseas delivery coordination, ZhongSai in-house design and...';
const canonical = 'https://zhongsai-steelstructure.com/en/export-delivery/';

// Delivery chain (7 steps)
const deliveryChain = [
  { num: '01', title: 'Delivery Planning', desc: 'Define the delivery approach against project requirements, drawings, destination and timeline.' },
  { num: '02', title: 'Member Segmentation', desc: 'Plan member segments and splice locations against container dimensions and transport limits.' },
  { num: '03', title: 'Component Marking', desc: 'Assign each component a project-specific ID matching drawings, packing list and erection order.' },
  { num: '04', title: 'Packing', desc: 'Group components by installation sequence, protect surfaces and pack accessories clearly.' },
  { num: '05', title: 'Container Loading', desc: 'Optimize container space utilization, weight distribution and site unloading order.' },
  { num: '06', title: 'Export Documentation', desc: 'Prepare commercial invoice, packing list, export declaration and shipping documents.' },
  { num: '07', title: 'Handover & Installation Support', desc: 'Coordinate shipment status and document handover; provide installation drawings and guidance.' }
];

// Design for shipping (6 points)
const shipDesignItems = [
  { title: 'Member Dimensions vs Containers', desc: 'Coordinate member lengths and cross-sections with standard container internal dimensions.' },
  { title: 'Transport Segmentation', desc: 'Design bolt splice locations at structurally appropriate positions for container transport.' },
  { title: 'Splice Location Coordination', desc: 'Position splices away from high-moment zones for efficient on-site bolted assembly.' },
  { title: 'Component Numbering System', desc: 'Develop a marking system linking components to drawings, packing list and erection sequence.' },
  { title: 'Site Assembly Interfaces', desc: 'Design connection interfaces for accurate on-site bolted assembly.' },
  { title: 'Packing & Erection Order', desc: 'Align packing and loading order with a logical site erection sequence.' }
];

// Container loading optimization factors
const loadingFactors = [
  { title: 'Member Dimensions', desc: 'Coordinate component lengths and cross-sections with container internal dimensions.' },
  { title: 'Container Dimensions', desc: 'Plan based on 40GP, 40HQ, 45HQ or project-specific container types.' },
  { title: 'Weight Distribution', desc: 'Distribute weight evenly within containers for safe transport and handling.' },
  { title: 'Loading Sequence', desc: 'Organize loading order to support logical unloading and erection sequence at site.' },
  { title: 'Movement Protection', desc: 'Secure components against movement during ocean transport with appropriate bracing.' },
  { title: 'Unloading Convenience', desc: 'Plan loading so components can be unloaded in logical order without rehandling.' }
];

// Export documentation items
const exportDocs = [
  { title: 'Commercial Invoice', desc: 'Prepare commercial documentation for export declaration and destination customs.' },
  { title: 'Packing List', desc: 'Detailed packing list linking components, packages, containers and weights.' },
  { title: 'Export Declaration Documents', desc: 'Support export declaration documentation according to Chinese export regulations.' },
  { title: 'Certificate-related Documents', desc: 'Coordinate certificate documents where applicable based on project requirements.' },
  { title: 'Bill of Lading Coordination', desc: 'Coordinate bill of lading information with freight forwarders and shipping lines.' },
  { title: 'Project / Product Documentation', desc: 'Provide installation drawings, material certificates and inspection records as required.' }
];

// Project types supported
const projectTypes = [
  { name: 'Industrial Workshops', href: '/en/steel-workshop/', desc: 'Manufacturing plants, processing facilities and crane-equipped industrial buildings.' },
  { name: 'Warehouses', href: '/en/steel-warehouse/', desc: 'Logistics centers, distribution hubs and industrial storage buildings.' },
  { name: 'Mining Structures', href: '/en/steel-mining-factory/', desc: 'Processing plants, conveyor galleries, equipment platforms and heavy industrial structures.' },
  { name: 'Agriculture Buildings', href: '/en/agricultural-steel-buildings/', desc: 'Poultry houses, cattle barns, livestock facilities and agricultural storage.' },
  { name: 'Commercial / Public Structures', href: '/en/commercial-public-steel-buildings/', desc: 'Exhibition halls, sports buildings, commercial facilities and public buildings.' },
  { name: 'Infrastructure Steel', href: '/en/transportation-infrastructure-steel/', desc: 'Pedestrian bridges, station structures, canopies and infrastructure components.' },
  { name: 'Mezzanines, Platforms & Special Structures', href: '/en/special-custom-steel-structures/', desc: 'Steel mezzanines, second-floor and equipment platforms, plus custom structures.' }
];

// FAQ items
const faqs = [
  {
    q: 'How are steel structures shipped from China?',
    a: 'Steel structures are fabricated in our factory, then components are marked, packed and loaded into shipping containers. Container loading is optimized for space utilization and component protection. After export documentation is prepared, containers are delivered to port and shipped by ocean freight to the destination country.'
  },
  {
    q: 'Can large steel members fit inside shipping containers?',
    a: 'Most standard steel components are designed to fit within standard shipping containers (typically 40GP or 40HQ). For members that exceed standard container lengths, our in-house design team can plan bolt splice locations to segment long members for container transport. In special cases, open-top containers, flat racks or project-specific logistics may be considered based on member dimensions, port conditions and logistics arrangements.'
  },
  {
    q: 'How do you identify components for installation?',
    a: 'Each steel component receives a project-specific identification marking that corresponds with approved shop drawings. The packing list links each component ID with its package, container and installation sequence reference. This system helps the local installation team correctly identify and assemble components at the project site, reducing errors and improving erection efficiency.'
  },
  {
    q: 'How are steel components packed?',
    a: 'Components are grouped by structural system and installation order, with painted surfaces protected. Bolts, nuts, washers and connection plates are identified by assembly group to prevent loss. Moisture protection is applied based on component type and voyage duration where needed. A detailed packing list links every component with its package, container and installation reference.'
  },
  {
    q: 'What export documents can you support?',
    a: 'ZhongSai can support preparation of commercial invoices, detailed packing lists, export declaration documents, and coordinate bill of lading information. Material certificates, inspection records and installation drawings are provided according to project requirements. Destination country customs clearance is normally handled by the customer or their appointed customs broker; ZhongSai provides the required documentation and information to support the process but does not act as importer of record or destination customs broker.'
  },
  {
    q: 'Do you provide installation after delivery?',
    a: 'ZhongSai provides installation technical guidance, including installation drawings, component identification references, erection sequence information and remote technical clarification. Local civil works, foundation construction, on-site labor and actual erection are normally handled by the customer or their appointed local construction team. In specific projects, on-site technical guidance may be arranged according to the agreed project scope, but ZhongSai does not act as the local construction contractor or EPC contractor.'
  }
];

// Related links
const relatedLinks = [
  { name: 'Engineering & Design', href: '/en/engineering-design/', desc: 'Structural design, detailing and engineering support' },
  { name: 'Manufacturing & Quality', href: '/en/manufacturing-quality/', desc: 'Factory fabrication, quality control and production evidence' },
  { name: 'Projects', href: '/en/projects/', desc: 'Real project cases with delivery and scope evidence' },
  { name: 'Steel Workshop', href: '/en/steel-workshop/', desc: 'Industrial workshop and manufacturing plant structures' },
  { name: 'Steel Warehouse', href: '/en/steel-warehouse/', desc: 'Logistics and storage building structures' },
  { name: 'Mining & Heavy Industry', href: '/en/steel-mining-factory/', desc: 'Mining, energy and heavy industrial steel structures' },
  { name: 'Mezzanines, Platforms & Special Structures', href: '/en/special-custom-steel-structures/', desc: 'Mezzanines, platforms and custom steel structures' },
  { name: 'Contact & Quote', href: '/en/contact/', desc: 'Submit project drawings for delivery planning and quote' }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/export/loading-truck_web.jpg')"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <div class="detail-breadcrumb">
        <a href="/en/">Home</a><span>/</span><span>Export Delivery</span>
      </div>
      <p class="eyebrow">EXPORT DELIVERY · From Factory to Destination</p>
      <h1>Steel Structure Export<br>and Overseas Project Delivery</h1>
      <p class="lead">From design and fabrication planning to component marking, packing, container loading and overseas delivery coordination, ZhongSai in-house design and delivery teams work together to support steel structure projects from factory to destination.</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Submit Drawings for Delivery Review</a>
        <a href="/en/manufacturing-quality/" class="btn btn-outline">View Manufacturing & Quality</a>
      </div>
      <div class="hero-strip">
        <span>Design for Shipping</span>
        <span>Member Segmentation</span>
        <span>Smart Container Loading</span>
        <span>Marking & Packing</span>
        <span>Export Documentation</span>
        <span>Installation Support</span>
      </div>
    </div>
  </section>

  <!-- Overview: Manufacturing completed → export delivery -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">EXPORT DELIVERY</p>
        <h2>The Complete Bridge from Fabrication to Destination</h2>
        <p>ZhongSai does more than fabricate steel components. Between manufacturing completion and overseas delivery, we handle component marking, packing, container loading, export documentation coordination, shipment coordination and installation technical support. Delivery planning can start during the design phase rather than after fabrication is complete.</p>
      </div>
      <div class="export-chain">
        <span class="chain-step"><span class="chain-num">M</span>Manufacturing</span>
        <span class="chain-arrow">→</span>
        <span class="chain-step"><span class="chain-num">1</span>Marking</span>
        <span class="chain-arrow">→</span>
        <span class="chain-step"><span class="chain-num">2</span>Packing</span>
        <span class="chain-arrow">→</span>
        <span class="chain-step"><span class="chain-num">3</span>Container Loading</span>
        <span class="chain-arrow">→</span>
        <span class="chain-step"><span class="chain-num">4</span>Export Docs</span>
        <span class="chain-arrow">→</span>
        <span class="chain-step"><span class="chain-num">5</span>Ocean Shipment</span>
        <span class="chain-arrow">→</span>
        <span class="chain-step"><span class="chain-num">6</span>Handover & Installation Support</span>
      </div>
      <p class="params-note">Fabrication, inspection, surface treatment, marking, packing and export delivery preparation are completed at ZhongSai manufacturing bases in Dongguan and Huizhou. Local unloading, lifting and on-site construction are handled by the customer or their appointed local construction team.</p>
    </div>
  </section>

  <!-- Design for Shipping -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">01 · DESIGN FOR SHIPPING</p>
        <h2>Steel Structures Are Not an Afterthought to Transport</h2>
        <p>ZhongSai in-house design team considers manufacturing, container transport and site assembly requirements during the structural design and detailing phase. By coordinating design with delivery, we reduce unnecessary shipping space waste and improve site erection efficiency — the value of an in-house team that understands both structural engineering and export delivery.</p>
      </div>
      <div class="ship-design-grid">
        {shipDesignItems.map((item, i) => (
          <div class="ship-design-card">
            <span class="sd-num">{String(i + 1).padStart(2, '0')}</span>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
      <div class="blue-note">
        <strong>Two project entry paths:</strong>
        If you have complete structural drawings, ZhongSai design team reviews fabrication feasibility, container transport compatibility and site erection efficiency, identifying members that need segmentation and planning bolt splice locations for transport. If you only have architectural drawings or project requirements, ZhongSai can consider member segmentation, transport limits and site assembly during structural scheme development. Submit whatever information you have to start the technical review.
      </div>
    </div>
  </section>

  <!-- Delivery Chain -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">02 · DELIVERY PROCESS</p>
        <h2>From Manufacturing Completion to Destination</h2>
        <p>ZhongSai project delivery team coordinates the transition from manufacturing completion to overseas shipment and destination handover. These are the key stages of steel structure export delivery.</p>
      </div>
      <div class="mfg-grid">
        {deliveryChain.map((step) => (
          <div class="mfg-card">
            <div class="mfg-body">
              <span class="mfg-num">{step.num}</span>
              <h4>{step.title}</h4>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Real Packing & Loading Evidence -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">03 · FIRST-PARTY EVIDENCE</p>
        <h2>Packing, Marking & Container Loading On Site</h2>
        <p>Components are marked, classified and packed before leaving the factory, then loaded into containers according to the project loading plan. These are real records from ZhongSai manufacturing and export delivery operations.</p>
      </div>
      <div class="evidence-strip">
        <div class="evidence-item">
          <img src="/images/manufacturing/real/component-marking.jpg" alt="Steel component identification marking at the workshop" loading="lazy">
          <h4>Component Marking</h4>
          <p>Each member carries a unique ID matching shop drawings and installation sequence for site identification and erection order.</p>
        </div>
        <div class="evidence-item">
          <img src="/images/export/container-loading-310_web.jpg" alt="Marked steel components being loaded into a shipping container" loading="lazy">
          <h4>Container Loading</h4>
          <p>Components are loaded into standard containers according to the loading plan, optimizing space while protecting coatings and member ends.</p>
        </div>
        <div class="evidence-item">
          <img src="/images/export/loading-truck_web.jpg" alt="Steel structure components loaded for shipment to the port" loading="lazy">
          <h4>Trucking & Shipment</h4>
          <p>Oversized or heavy members are transported to port with dedicated vehicles, coordinated with export documents and packing lists.</p>
        </div>
        <div class="evidence-item">
          <img src="/images/container-loading.jpg" alt="Loading large steel structure members into a container" loading="lazy">
          <h4>Large Member Loading</h4>
          <p>Portal frames, crane beams and other large members are sequenced by weight and size for safe transport and easy unloading.</p>
        </div>
        <div class="evidence-item">
          <img src="/images/export/container-loading-256_web.jpg" alt="Loaded container prepared for export shipment" loading="lazy">
          <h4>Export Container Ready</h4>
          <p>Packing lists and export documents support customs documentation checks at the destination port and make members traceable and verifiable when received on site.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Container Loading Strategy -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">04 · SMART LOADING</p>
        <h2>Container Loading Planning</h2>
        <p>Loading plans optimize space utilization, weight distribution and unloading convenience. Through rational member segmentation, container planning and careful loading, suitable projects can reduce freight costs.</p>
      </div>
      <div class="params-table-wrapper">
        <table class="params-table">
          <thead>
            <tr><th>Loading Factor</th><th>Consideration</th></tr>
          </thead>
          <tbody>
            {loadingFactors.map((f) => (
              <tr><td>{f.title}</td><td>{f.desc}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="blue-note">
        <strong>Freight cost optimization:</strong>
        Through rational member segmentation, container planning and careful loading, suitable projects can achieve approximately <strong>20% freight cost savings</strong>. Actual savings depend on component dimensions, weight, shipping route and loading conditions. This is not a guaranteed fixed saving for every project.
      </div>
    </div>
  </section>

  <!-- Oversized Members -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">05 · OVERSIZED MEMBERS</p>
        <h2>Handling Long and Oversized Steel Members</h2>
        <p>Some steel members may exceed standard shipping container dimensions. ZhongSai design team plans segmentation and transport solutions during the design phase to address oversized member challenges.</p>
      </div>
      <div class="plan-grid">
        <div class="plan-col">
          <h4>Standard Container Solution</h4>
          <ul>
            <li>Most members designed to fit 40GP / 40HQ containers</li>
            <li>Long members segmented with bolted splice connections</li>
            <li>Splice positions planned at structurally appropriate locations</li>
            <li>Segmented members bolted together on site</li>
            <li>Member marking ensures correct site assembly</li>
          </ul>
        </div>
        <div class="plan-col">
          <h4>Special Logistics Considerations</h4>
          <ul>
            <li>Height-limited members may use open-top containers</li>
            <li>Extra-wide or heavy members may use flat racks</li>
            <li>Project-specific logistics for non-standard oversized members</li>
            <li>Transport method decided by member dimensions and port conditions</li>
            <li>Destination country road transport limits assessed</li>
          </ul>
        </div>
      </div>
      <p class="params-note">The transport method for oversized members is decided project by project based on member dimensions, weight, port conditions, destination country road regulations and logistics arrangements. ZhongSai design team can provide segmentation recommendations during the design phase.</p>
    </div>
  </section>

  <!-- Export Documents -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">06 · EXPORT DOCUMENTS</p>
        <h2>Export Documentation & Coordination</h2>
        <p>ZhongSai supports preparation and coordination of export documents according to project requirements. Destination import permits, taxes and customs clearance responsibilities follow the Incoterms, contract and project agreement. ZhongSai does not replace the customer or their appointed customs broker for destination country customs clearance.</p>
      </div>
      <div class="params-table-wrapper">
        <table class="params-table">
          <thead>
            <tr><th>Document</th><th>Description</th></tr>
          </thead>
          <tbody>
            {exportDocs.map((d) => (
              <tr><td>{d.title}</td><td>{d.desc}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Responsibility Boundary -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">07 · RESPONSIBILITY BOUNDARY</p>
        <h2>Division Between ZhongSai and the Local Project Team</h2>
        <p>Steel structure export delivery is a multi-party process. ZhongSai is responsible for work inside the factory and the export interface; local unloading, lifting, construction and statutory approvals are handled by the customer or their local team as agreed per project.</p>
      </div>
      <div class="boundary-grid">
        <div class="boundary-box boundary-ok">
          <h4>ZhongSai Responsible For</h4>
          <ul>
            <li>Fabrication, inspection, surface treatment and member marking</li>
            <li>Packing plans and container loading planning</li>
            <li>Commercial invoice, packing list and export declaration support</li>
            <li>Assist with container booking, port delivery and ocean freight coordination as agreed for the project</li>
            <li>Installation drawings, component identification and remote guidance</li>
          </ul>
        </div>
        <div class="boundary-box boundary-local">
          <h4>Local Project Team Responsible For</h4>
          <ul>
            <li>Local unloading and on-site logistics</li>
            <li>Foundation and civil works</li>
            <li>On-site labor and lifting crews</li>
            <li>Actual steel structure erection and installation</li>
            <li>Local permits, statutory approvals and registered engineer stamps</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Shipment Videos Entry -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">08 · SHIPMENT RECORDS</p>
        <h2>Watch Recent Loading & Export Records</h2>
        <p>First-party video evidence: component marking, packing, lifting and container preparation. Videos open on a separate page so they never load on this page's first screen.</p>
      </div>
      <div class="shipment-entry">
        <a href="/en/export-delivery/shipments/" class="btn btn-primary">Watch Shipment Videos &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Related Capabilities & Projects -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">RELATED CAPABILITIES</p>
        <h2>Related Capabilities & Project Evidence</h2>
        <p>Export delivery integrates with ZhongSai engineering, manufacturing and project capabilities. The projects below demonstrate ZhongSai capabilities across engineering, manufacturing and project delivery.</p>
      </div>
      <div class="related-links">
        {relatedLinks.map((link) => (
          <a href={link.href} class="related-link-card">
            <h4>{link.name}</h4>
            <p>{link.desc}</p>
            <span class="rl-arrow">→</span>
          </a>
        ))}
      </div>
      <div class="rp-grid">
        <a href="/en/projects/singapore-airport-t2-connect/" class="related-project-card">
          <div class="rpc-image">
            <img src="/images/projects/overseas/singapore-airport-t2-connect.jpg" alt="Singapore Changi Airport T2 Connection" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">Overseas Export</span>
            <h4>Singapore Changi Airport T2 Connection</h4>
            <p class="rpc-location">Singapore</p>
            <p class="rpc-data">Approx. 4,600 t · 110,000 studs</p>
            <p class="rpc-scope"><span>ZhongSai scope:</span> Structural design detailing, fabrication & export supply</p>
          </div>
        </a>
        <a href="/en/projects/singapore-sats-bup-centre/" class="related-project-card">
          <div class="rpc-image">
            <img src="/images/projects/overseas/singapore-mcc-innocentre.jpg" alt="Singapore SATS Cargo Centre" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">Overseas Export</span>
            <h4>Singapore SATS Cargo Centre</h4>
            <p class="rpc-location">Singapore</p>
            <p class="rpc-data">Approx. 200 t · Segmented & containerized</p>
            <p class="rpc-scope"><span>ZhongSai scope:</span> Structural design detailing, fabrication & export supply</p>
          </div>
        </a>
        <a href="/en/projects/singapore-j107-mrt-station/" class="related-project-card">
          <div class="rpc-image">
            <img src="/images/projects/overseas/singapore-j102-station.jpg" alt="Singapore LTA J107 MRT Station" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">Overseas Export</span>
            <h4>Singapore LTA J107 MRT Station</h4>
            <p class="rpc-location">Singapore</p>
            <p class="rpc-data">Approx. 1,300 t · LTA strict standards</p>
            <p class="rpc-scope"><span>ZhongSai scope:</span> Structural design detailing, fabrication & export supply</p>
          </div>
        </a>
      </div>
      <div class="rp-more">
        <a href="/en/projects/" class="btn btn-outline">View All Projects →</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">FAQ</p>
        <h2>Steel Structure Export Delivery FAQ</h2>
        <p>Common questions about steel structure export delivery, container loading and overseas project coordination.</p>
      </div>
      <div class="detail-faq">
        {faqs.map((faq) => (
          <div class="faq-item">
            <button type="button" class="faq-question" aria-expanded="false">
              <span>{faq.q}</span>
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer">
              <div class="faq-answer-inner">{faq.a}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="detail-section" id="quote">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">PROJECT INQUIRY</p>
        <h2>Have a Steel Structure Project for Export Delivery?</h2>
        <p>Send your project drawings, delivery location and technical requirements. ZhongSai in-house design and delivery teams will review fabrication and delivery feasibility and prepare a project-specific quotation covering fabrication, packing, container loading and export delivery coordination.</p>
      </div>
      <QuoteForm lang={lang} />
    </div>
  </section>
</BaseLayout>

<style>
/* Outline button for dark hero */
.btn-outline {
  background: transparent;
  color: #ffffff;
  border: 1px solid rgba(255,255,255,0.45);
}
.btn-outline:hover {
  border-color: #ffffff;
  background: rgba(255,255,255,0.12);
  text-decoration: none;
}

/* Hero evidence strip */
.hero-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 32px;
  justify-content: center;
  padding: 18px 0 4px;
}
.hero-strip span {
  font-size: 13px;
  font-weight: 600;
  color: #475569;
  letter-spacing: 0.4px;
  position: relative;
  padding-left: 16px;
}
.hero-strip span::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 8px;
  height: 8px;
  border-radius: 2px;
  background: #f59e0b;
  transform: translateY(-50%);
}

/* Export chain */
.export-chain {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  justify-content: center;
  margin: 8px 0 28px;
}
.chain-step {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 2px;
  padding: 14px 18px;
  font-size: 14px;
