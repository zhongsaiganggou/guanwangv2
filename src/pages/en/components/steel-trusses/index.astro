const lang = 'en';
const title = 'Steel Truss Structures for Projects | ZhongSai';
const description = 'Project-specific steel truss structures for industrial buildings, warehouses, public buildings and large-span applications.';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="hub-hero">
    <div class="hub-hero-bg" style="background-image: url('/images/components/steel-truss-hero.jpg');"></div>
    <div class="hub-hero-overlay"></div>
    <div class="container hub-hero-content">
      <div class="hub-breadcrumb">
        <a href="/en/">Home</a><span>/</span><a href="/en/components/">Components</a><span>/</span><span>Steel Trusses</span>
      </div>
      <p class="eyebrow">PROJECT STEELWORK · Steel Truss Structures</p>
      <h1>Steel Truss Structures for Large-Span Projects</h1>
      <p class="lead">Project-specific steel truss structures for industrial buildings, warehouses, public buildings and other large-span applications, with detailing, fabrication and export delivery based on approved project drawings.</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Send Your Project Drawings</a>
        <a href="#engineering-review" class="btn btn-outline">Request Engineering Review</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/components/">Steel Components</a>
      <span class="sep">/</span>
      <span class="current">Steel Truss Structures</span>
    </div>
  </nav>

  <!-- 01 / What This Structure Does -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Structure Function</p>
        <h2>What Steel Truss Structures Do in Projects</h2>
        <p>Steel trusses are triangulated structural systems used where large clear spans or reduced intermediate supports are required. They efficiently carry roof, floor and transfer loads over long distances with less material weight than solid beams.</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/components/complex-steel-truss-fabrication.jpg" alt="Complex steel truss fabrication in factory with CHS/RHS nodes" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Structural Role in Building Projects</h3>
          <ul>
            <li><strong>Long-span roof support:</strong> Carries roof loads over large clear spans without intermediate columns</li>
            <li><strong>Transfer structures:</strong> Transfers upper floor loads to selected columns when lower floors require column-free space</li>
            <li><strong>Lightweight efficiency:</strong> Triangulated geometry provides high strength-to-weight ratio compared to solid beams</li>
            <li><strong>Architectural flexibility:</strong> Can be configured for various roof profiles including pitched, curved and flat</li>
            <li><strong>Economical material use:</strong> Material concentrated where stress is highest, reducing overall steel tonnage</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / Where It Is Used in Projects -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Project Applications</p>
        <h2>Where Steel Trusses Are Used in Real Projects</h2>
        <p>Steel truss structures are applied across a wide range of building and infrastructure projects where long-span, column-free space is required.</p>
      </div>
      <div class="application-grid">
        <div class="app-card reveal">
          <h4>Industrial Workshops</h4>
          <p>Large manufacturing plants and processing facilities requiring column-free production space with crane clearance.</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h4>Warehouses & Logistics</h4>
          <p>Distribution centers and logistics warehouses requiring large clear spans for racking systems and material handling.</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h4>Exhibition Halls</h4>
          <p>Exhibition and convention centers requiring large column-free floor areas for flexible exhibition layouts.</p>
        </div>
        <div class="app-card reveal">
          <h4>Sports Buildings</h4>
          <p>Indoor sports arenas, gymnasiums and stadiums requiring long-span roofs over playing surfaces.</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h4>Aircraft Hangars</h4>
          <p>Aircraft maintenance hangars requiring extremely large clear spans for aircraft access and maneuvering.</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h4>Transportation Facilities</h4>
          <p>Station canopies, airport terminals and transit hubs requiring long-span roof structures over public spaces.</p>
        </div>
        <div class="app-card reveal">
          <h4>Public Buildings</h4>
          <p>Cultural centers, auditoriums and community buildings requiring architecturally expressive long-span roofs.</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h4>Transfer Structures</h4>
          <p>Building transfer girders and transfer trusses for mixed-use buildings with changing column grids between floors.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / Key Engineering Considerations -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Engineering Considerations</p>
        <h2>Key Engineering Considerations for Truss Projects</h2>
        <p>Steel truss design and fabrication requires careful consideration of multiple engineering factors. All specific values are determined by project drawings, loads and applicable local design codes.</p>
      </div>
      <div class="param-table-container">
        <table class="param-table">
          <thead>
            <tr>
              <th>Engineering Factor</th>
              <th>Project-Based Consideration</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Span</strong></td>
              <td>Determined by project architectural requirements and column layout. Trusses can be designed for various span ranges based on loading and deflection criteria.</td>
            </tr>
            <tr>
              <td><strong>Structural Loads</strong></td>
              <td>Dead load, live load, snow load, wind load and seismic load per project location and applicable building code.</td>
            </tr>
            <tr>
              <td><strong>Crane Loads</strong></td>
              <td>Overhead crane loads, if applicable, including crane capacity, span, duty class and impact factors affecting truss design.</td>
            </tr>
            <tr>
              <td><strong>Dynamic Loads</strong></td>
              <td>Dynamic and vibration considerations for structures supporting machinery, conveyors or other dynamic equipment.</td>
            </tr>
            <tr>
              <td><strong>Connection Type</strong></td>
              <td>Welded connections (gusset plates or direct welding) or bolted connections (high-strength bolts) based on project requirements and site assembly.</td>
            </tr>
            <tr>
              <td><strong>Deflection</strong></td>
              <td>Deflection limits per applicable code and project requirements, particularly important for long-span roof trusses supporting brittle finishes.</td>
            </tr>
            <tr>
              <td><strong>Transport Limits</strong></td>
              <td>Member and truss segment sizing considering container dimensions, road transport limits and site assembly requirements.</td>
            </tr>
            <tr>
              <td><strong>Corrosion Environment</strong></td>
              <td>Environmental corrosion category determining surface protection system selection, from standard painting to hot-dip galvanizing.</td>
            </tr>
            <tr>
              <td><strong>Site Assembly</strong></td>
              <td>Site erection sequence, connection accessibility, temporary support requirements and installation tolerances per project conditions.</td>
            </tr>
            <tr>
              <td><strong>Local Design Codes</strong></td>
              <td>Design per applicable local building codes and project specifications, including material standards, load combinations and safety factors.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 04 / Project-Based Design & Detailing -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Design & Detailing</p>
        <h2>Project-Based Design and Detailing</h2>
        <p>ZhongSai works from project structural drawings and coordinates detailing to develop fabrication-ready truss drawings, with responsibility scope defined by project contract and approved drawings.</p>
      </div>
      <div class="process-grid">
        <div class="process-item reveal">
          <div class="process-num">01</div>
          <h4>Architectural / Structural Drawings Review</h4>
          <p>Review client-provided architectural and structural drawings, including truss layout, span, loading and connection requirements.</p>
        </div>
        <div class="process-item reveal reveal-delay-1">
          <div class="process-num">02</div>
          <h4>Structural Detailing Coordination</h4>
          <p>Coordinate shop drawing development based on confirmed structural design, including member sizes, node details and connection design.</p>
        </div>
        <div class="process-item reveal reveal-delay-2">
          <div class="process-num">03</div>
          <h4>Connection and Node Design</h4>
          <p>Develop connection details including gusset plates, bolted/welded connections, splice joints and base plate interfaces.</p>
        </div>
        <div class="process-item reveal">
          <div class="process-num">04</div>
          <h4>Site Assembly Interface Planning</h4>
          <p>Plan site assembly interfaces including splice locations, bolt access, temporary supports and erection sequence considerations.</p>
        </div>
        <div class="process-item reveal reveal-delay-1">
          <div class="process-num">05</div>
          <h4>Transport Segmentation Design</h4>
          <p>Design truss segmentation for container shipping and road transport, optimizing member lengths while minimizing site connections.</p>
        </div>
        <div class="process-item reveal reveal-delay-2">
          <div class="process-num">06</div>
          <h4>Approved Drawings for Fabrication</h4>
          <p>Fabrication proceeds only after approved drawings and confirmed technical specifications. Responsibility scope per project contract.</p>
        </div>
      </div>
      <div style="margin-top: 24px; padding: 16px; background: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 4px;">
        <p style="margin: 0; color: #92400e; font-size: 0.9rem;"><strong>Scope Note:</strong> ZhongSai can provide project detailing and fabrication coordination support. Structural design responsibility is determined by project contract, approved drawings and applicable professional requirements. ZhongSai does not assume structural design responsibility beyond the scope explicitly agreed in the project contract.</p>
      </div>
    </div>
  </section>

