---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../../components/QuoteForm.astro';
import '../../../../styles/detail.css';

const title = 'Fabricated Steel Beams & Columns | Custom Steel Fabrication | ZhongSai';
const description = 'ZhongSai fabricates steel beams and columns from project drawings, shop drawings and technical specifications. Includes H-section members, welded beams, steel columns and custom fabricated members, with marking, packing and export delivery support.';
const lang = 'en';
const canonical = 'https://zhongsai-steelstructure.com/en/components/fabricated-steel-beams-columns/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/components/finished-steel-beams-columns.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">Steel Beams · Columns · Drawing-Based</span>
      <h1>Fabricated Steel Beams & Columns to Project Drawings</h1>
      <p class="lead">ZhongSai fabricates H-section members, welded steel beams, steel columns and custom fabricated steel members from project structural drawings, shop drawings and technical specifications. Specific materials, dimensions, welding requirements and surface treatment are determined per project drawings and technical requirements, with component marking, packing, container loading and export delivery support.</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Submit Drawings for Quotation</a>
        <a href="/en/manufacturing-quality/" class="btn btn-outline">View Manufacturing Capability</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/components/">Components</a>
      <span class="sep">/</span>
      <span class="current">Steel Beams & Columns</span>
    </div>
  </nav>

  <!-- 01 Fabricated Beams & Columns -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">01 / What We Fabricate</p>
        <h2>What Steel Beams & Columns Can ZhongSai Fabricate</h2>
        <p>Based on project drawings and technical requirements, ZhongSai can fabricate the following types of steel beams and columns. Specific fabrication scope and technical requirements are confirmed per project drawings.</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1" id="steel-beams">
          <div class="req-icon">01</div>
          <h3>H-Section Members</h3>
          <p>H-beams and H-columns, fabricated per drawing dimensions and welding requirements.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>Welded Steel Beams</h3>
          <p>Built-up welded beams, box beams, fabricated per connection details and welding requirements.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3" id="steel-columns">
          <div class="req-icon">03</div>
          <h3>Steel Columns</h3>
          <p>H-columns, box columns, lattice columns, fabricated per project structural drawings.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1" id="box-sections">
          <div class="req-icon">04</div>
          <h3>Custom Fabricated Members</h3>
          <p>Equipment platform members, bracing, gusset plates and custom irregular steel members.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2" id="crane-beams">
          <div class="req-icon">05</div>
          <h3>Crane Beams</h3>
          <p>Crane beam fabrication per crane system and structural requirements.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>Connection Components</h3>
          <p>Gusset plates, connection plates, stiffeners and other accessory members, supplied with the primary structure.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Fabrication to Project Drawings -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">02 / Drawing-Based Fabrication</p>
        <h2>Steel Beam & Column Fabrication from Project Drawings</h2>
        <p>ZhongSai organizes steel beam and column fabrication based on customer-provided structural drawings, shop drawings and technical specifications. Specific steel grades, welding procedures, inspection requirements and surface treatment are determined per project drawings and technical requirements.</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/components/steel-beams-columns-fabrication.jpg" alt="Fabricated H-section steel beams and columns" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>From Drawings to Fabricated Members</h3>
          <p>ZhongSai operates its own production base, fabricating steel beams, columns and custom members per project drawings.</p>
          <ul>
            <li>Fabrication organized from structural and shop drawings</li>
            <li>Manufacturing requirements controlled per project technical specifications</li>
            <li>BOQ component list verification and quotation support</li>
            <li>Specific materials, dimensions and welding requirements per project agreement</li>
            <li>Surface treatment arranged per project requirements, specific methods and specifications per technical requirements</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Typical Project Applications -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">03 / Typical Applications</p>
        <h2>Typical Project Applications for Fabricated Beams & Columns</h2>
        <p>Fabricated steel beams and columns can be used in the following types of steel structure projects. Specific application scope is determined per project drawings and technical requirements.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/products/01-industrial.jpg');"></div>
          <div class="feature-body">
            <h3>Industrial Workshops & Factories</h3>
            <p>Primary frames, crane beams and bracing systems for steel structure industrial workshops.</p>
            <a href="/en/steel-workshop/" class="feature-link">View Industrial Workshop →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/04-warehouse-logistics.jpg');"></div>
          <div class="feature-body">
            <h3>Warehouses & Logistics Buildings</h3>
            <p>Primary frames and bracing systems for steel structure warehouses and logistics buildings.</p>
            <a href="/en/steel-warehouse/" class="feature-link">View Warehouse Solutions →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/components/finished-steel-members-stacked.jpg');"></div>
          <div class="feature-body">
            <h3>Equipment Platforms & Custom Structures</h3>
            <p>Industrial equipment platforms, access platforms and custom irregular steel structure members.</p>
            <a href="/en/products/custom-engineering/" class="feature-link">View Custom Engineering →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/03-commercial-public.jpg');"></div>
          <div class="feature-body">
            <h3>Commercial & Industrial Buildings</h3>
            <p>Primary frames for commercial buildings, exhibition halls and other industrial steel structure projects.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 From Drawing to Fabricated Member -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">04 / Fabrication Process</p>
        <h2>Drawing-to-Fabricated-Member Process</h2>
        <p>The following is a brief overview of the drawing-based fabrication process for steel beams and columns. For detailed manufacturing, quality control and the 8-step fabrication process, please view the manufacturing capability page.</p>
      </div>
      <div class="process-flow">
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">01</div>
          <h4>Drawing Review</h4>
          <p>Structural drawing and fabrication feasibility review</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">02</div>
          <h4>Detailing Coordination</h4>
          <p>Shop drawing and fabrication drawing coordination</p>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">03</div>
          <h4>Fabrication</h4>
          <p>Cutting, assembly, welding, straightening, drilling</p>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">04</div>
          <h4>Surface Treatment</h4>
          <p>Shot blasting and coating arranged where required per project</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>Marking & Packing</h4>
          <p>Component marking, numbering and packing for container loading</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">06</div>
          <h4>Export Preparation</h4>
          <p>Export documentation support and logistics coordination</p>
        </div>
      </div>
      <div style="margin-top: 24px;">
        <a href="/en/manufacturing-quality/" class="btn btn-outline">View Detailed 8-Step Manufacturing Process</a>
      </div>
    </div>
  </section>

  <!-- 05 What We Need for Quotation -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">05 / Quotation Requirements</p>
        <h2>What Information Is Needed for a Beam & Column Quotation</h2>
        <p>The more complete the drawings and technical documentation, the more accurate the review and quotation. If documentation is incomplete, you can first submit available materials, and ZhongSai will further confirm what is needed for fabrication and quotation.</p>
      </div>
      <div class="quote-info-grid">
        <div class="quote-info-card drawing">
          <h4>Have Complete Drawings</h4>
          <ul>
            <li>Project country</li>
            <li>Structural drawings (architectural / structural)</li>
            <li>Shop drawings (if available)</li>
            <li>Bill of Quantities (BOQ) (if available)</li>
            <li>Project technical specifications</li>
            <li>Required quantity / supply scope</li>
          </ul>
        </div>
        <div class="quote-info-card no-drawing">
          <h4>Incomplete Documentation</h4>
          <ul>
            <li>Project country</li>
            <li>Available drawings or sketches</li>
            <li>Component types and approximate quantities</li>
            <li>Project use and basic dimensions</li>
            <li>Known technical requirements</li>
            <li>Submit available materials for initial review</li>
          </ul>
        </div>
      </div>
      <p class="quote-note">* PDF drawings, BOQ or other available project documents can be submitted for initial review. Additional drawings, specifications or technical information may be required before the final fabrication scope and quotation are confirmed.</p>
    </div>
  </section>

  <!-- 06 Related Capabilities -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">06 / Related Capabilities</p>
        <h2>Related Capabilities & Pages</h2>
      </div>
      <div class="related-links">
        <a href="/en/components/" class="related-link-card reveal reveal-delay-1">

          <h4>Components & Materials</h4>
          <p>Steel beams, columns, trusses, purlins and cladding systems</p>
          <span class="rl-arrow">View Details →</span>
        </a>
        <a href="/en/products/custom-engineering/" class="related-link-card reveal reveal-delay-2">

          <h4>Custom Engineering & Fabrication</h4>
          <p>Structural steel fabrication in China for overseas projects</p>
          <span class="rl-arrow">View Details →</span>
        </a>
        <a href="/en/manufacturing-quality/" class="related-link-card reveal reveal-delay-3">

          <h4>Manufacturing & Quality Control</h4>
          <p>8-step fabrication process, quality control and packing for export</p>
          <span class="rl-arrow">View Details →</span>
        </a>
        <a href="/en/steel-workshop/" class="related-link-card reveal reveal-delay-1">

          <h4>Industrial Workshop</h4>
          <p>Steel structure industrial workshop solutions</p>
          <span class="rl-arrow">View Details →</span>
        </a>
        <a href="/en/steel-warehouse/" class="related-link-card reveal reveal-delay-2">

          <h4>Steel Warehouse</h4>
          <p>Steel structure warehouse and logistics building solutions</p>
          <span class="rl-arrow">View Details →</span>
        </a>
        <a href="/en/components/roof-wall-cladding-systems/" class="related-link-card reveal reveal-delay-3">

          <h4>Roof & Wall Cladding Systems</h4>
          <p>Roof panels, wall panels and supporting cladding materials</p>
          <span class="rl-arrow">View Details →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 07 FAQ -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal" style="text-align: center;">
        <p class="section-index" style="justify-content: center;">07 / FAQ</p>
        <h2>Frequently Asked Questions About Beam & Column Fabrication</h2>
      </div>
      <div class="detail-faq">
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Can ZhongSai fabricate steel beams and columns from customer drawings?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Yes. ZhongSai organizes steel beam, column and custom member fabrication based on customer-provided structural drawings, shop drawings and technical specifications. Specific materials, dimensions, welding requirements and surface treatment are determined per project drawings and technical requirements. Fabrication can be arranged after drawing review.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>What drawings are required for a beam and column quotation?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Ideally, you should provide structural drawings, shop drawings, Bill of Quantities (BOQ), project technical specifications and project country. If documentation is incomplete, you can first submit available materials, and ZhongSai will further confirm what is needed for fabrication and quotation. PDF drawings, BOQ or other available project documents can be submitted for initial review.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Can custom fabricated steel members be produced?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Yes. ZhongSai can fabricate custom irregular steel members per project drawings, including equipment platform members, bracing, gusset plates and other non-standard members. Specific fabrication scope and technical requirements are confirmed per project drawings.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Can fabricated beams and columns be packed and prepared for export?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Yes. Components may be marked and numbered based on shop drawings and project requirements. Packing is organized by component type, container loading sequence and export transport requirements, supporting container loading. ZhongSai provides export documentation support and logistics coordination, but does not act as a customs broker or freight forwarder. Local construction and erection are performed by the customer or local construction team.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 08 Quote CTA + QuoteForm -->
  <section class="detail-section dark" id="quote">
    <div class="container">
      <div class="section-heading reveal" style="text-align: center;">
        <p class="section-index" style="justify-content: center; color: #f59e0b;">08 / Get Quotation</p>
        <h2 style="color: #fff;">Have Drawings or BOQ? Submit for Project Quotation</h2>
        <p style="margin: 0 auto; color: rgba(255,255,255,0.75);">Submit project drawings, BOQ and technical requirements. ZhongSai will conduct an initial review and confirm what is needed for quotation.</p>
      </div>
      <QuoteForm lang="en" />
    </div>
  </section>
</BaseLayout>

<script>
  // FAQ toggle
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item.classList.contains('open');
      item.classList.toggle('open');
      btn.setAttribute('aria-expanded', !isOpen);
    });
  });

  // Scroll reveal
  const revealElements = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    revealElements.forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(24px)';
      el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      observer.observe(el);
    });
  }
</script>
