---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../../components/QuoteForm.astro';
import '../../../../styles/hub.css';

const lang = 'en';
const title = 'Steel Beams & Columns for Projects | ZhongSai';
const description = 'Project-specific steel beams and columns for industrial buildings, warehouses, commercial structures and infrastructure.';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="hub-hero">
    <div class="hub-hero-bg" style="background-image: url('/images/components/finished-steel-beams-columns.jpg');"></div>
    <div class="hub-hero-overlay"></div>
    <div class="container hub-hero-content">
      <div class="hub-breadcrumb">
        <a href="/en/">Home</a><span>/</span><a href="/en/components/">Components</a><span>/</span><span>Steel Beams & Columns</span>
      </div>
      <p class="eyebrow">PROJECT STEELWORK · Steel Beams & Columns</p>
      <h1>Steel Beams & Columns for Structural Projects</h1>
      <p class="lead">Project-specific steel beams and columns for industrial buildings, warehouses, commercial structures and infrastructure applications, with detailing, fabrication and export delivery based on approved project drawings.</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Send Your Project Drawings</a>
        <a href="#engineering-review" class="btn btn-outline">Request Engineering Review</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/components/">Steel Components</a>
      <span class="sep">/</span>
      <span class="current">Steel Beams & Columns</span>
    </div>
  </nav>

  <!-- 01 / What This Structure Does -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Structure Function</p>
        <h2>What Steel Beams and Columns Do in Projects</h2>
        <p>Steel beams and columns are the primary structural members in building and industrial projects, working together to transfer loads from roof and floor systems to foundations.</p>
      </div>
      <div class="dual-column">
        <div class="dual-card reveal" id="steel-columns">
          <div class="dual-icon">
            <img src="/images/components/steel-beams-columns-fabrication.jpg" alt="Steel columns fabricated in factory" loading="lazy">
          </div>
          <h3>Steel Columns</h3>
          <p class="dual-def">Vertical structural members used to transfer roof, floor, crane and equipment loads into foundations.</p>
          <ul>
            <li><strong>H-columns:</strong> Wide-flange columns for general building and industrial applications</li>
            <li><strong>Box columns:</strong> Built-up box sections for heavy loads and architectural applications</li>
            <li><strong>Lattice columns:</strong> Built-up lattice columns for tall and heavy industrial structures</li>
            <li><strong>Crane columns:</strong> Columns designed for overhead crane loads with bracket supports</li>
          </ul>
        </div>
        <div class="dual-card reveal reveal-delay-1" id="steel-beams">
          <div class="dual-icon">
            <img src="/images/components/steel-beams-columns-fabrication.jpg" alt="Steel beams fabricated in factory" loading="lazy">
          </div>
          <h3>Steel Beams</h3>
          <p class="dual-def">Horizontal structural members used to support roofs, floors, platforms, equipment and secondary structural systems.</p>
          <ul>
            <li><strong>H-beams:</strong> Wide-flange beams for general floor and roof support</li>
            <li><strong>Welded built-up beams:</strong> Custom fabricated beams for non-standard loads and spans</li>
            <li><strong>Box beams:</strong> Built-up box girders for heavy loads and long spans</li>
            <li><strong>Crane beams:</strong> Beams designed to support overhead crane runway systems</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / Where It Is Used in Projects -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Project Applications</p>
        <h2>Where Steel Beams and Columns Are Used</h2>
        <p>Steel beams and columns form the primary structural framework across a wide range of building and industrial project types.</p>
      </div>
      <div class="application-grid">
        <div class="app-card reveal">
          <h4>Industrial Workshops</h4>
          <p>Manufacturing plants and processing facilities requiring heavy load support, crane columns and equipment platform supports.</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h4>Warehouses & Logistics</h4>
          <p>Distribution centers and logistics warehouses requiring clear-span framing, racking support and mezzanine structures.</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h4>Commercial Buildings</h4>
          <p>Office buildings, retail centers and mixed-use structures requiring efficient floor framing and column grids.</p>
        </div>
        <div class="app-card reveal">
          <h4>Public Buildings</h4>
          <p>Exhibition halls, sports arenas and cultural facilities requiring long-span beams and heavy load columns.</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h4>Mining & Heavy Industry</h4>
          <p>Processing plants, equipment platforms and heavy industrial structures requiring heavy-duty beams and columns.</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h4>Energy Facilities</h4>
          <p>Power plants and energy facilities requiring equipment support structures, platform framing and heavy load columns.</p>
        </div>
        <div class="app-card reveal">
          <h4>Transportation Infrastructure</h4>
          <p>Station structures, canopies and bridge components requiring specialized beam and column configurations.</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h4>Multi-story Buildings</h4>
          <p>Mid-rise and high-rise structures requiring efficient column grids, floor beam systems and load transfer structures.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / Key Engineering Considerations -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Engineering Considerations</p>
        <h2>Key Engineering Considerations for Beam & Column Projects</h2>
        <p>Steel beam and column design requires careful consideration of multiple engineering factors. All specific values are determined by project drawings, loads and applicable local design codes.</p>
      </div>
      <div class="param-table-container">
        <table class="param-table">
          <thead>
            <tr>
              <th>Engineering Factor</th>
              <th>Project-Based Consideration</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Span</strong></td>
              <td>Beam span determined by column spacing and architectural layout. Column height determined by floor-to-floor and eave height requirements.</td>
            </tr>
            <tr>
              <td><strong>Structural Loads</strong></td>
              <td>Dead load, live load, snow load, wind load and seismic load per project location and applicable building code.</td>
            </tr>
            <tr>
              <td><strong>Equipment Loads</strong></td>
              <p>Concentrated equipment loads, platform loads and process equipment loads affecting beam and column sizing.</td>
            </tr>
            <tr>
              <td><strong>Crane Loads</strong></td>
              <td>Overhead crane loads, including crane capacity, span, duty class and impact factors affecting crane beams and columns.</td>
            </tr>
            <tr>
              <td><strong>Dynamic Loads</strong></td>
              <td>Dynamic and vibration considerations for structures supporting machinery, conveyors or other dynamic equipment.</td>
            </tr>
            <tr>
              <td><strong>Connection Type</strong></td>
              <td>Welded connections (shop welding) or bolted connections (site assembly) based on project requirements and transport limits.</td>
            </tr>
            <tr>
              <td><strong>Deflection</strong></td>
              <td>Beam deflection limits per applicable code and project requirements, particularly important for floors supporting brittle finishes.</td>
            </tr>
            <tr>
              <td><strong>Transport Limits</strong></td>
              <td>Member sizing considering container dimensions, road transport limits and site assembly requirements for long beams and tall columns.</td>
            </tr>
            <tr>
              <td><strong>Corrosion Environment</strong></td>
              <td>Environmental corrosion category determining surface protection system selection, from standard painting to hot-dip galvanizing.</td>
            </tr>
            <tr>
              <td><strong>Site Assembly</strong></td>
              <td>Site erection sequence, connection accessibility, lifting requirements and installation tolerances per project conditions.</td>
            </tr>
            <tr>
              <td><strong>Local Design Codes</strong></td>
              <td>Design per applicable local building codes and project specifications, including material standards, load combinations and safety factors.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 04 / Project-Based Design & Detailing -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Design & Detailing</p>
        <h2>Project-Based Design and Detailing</h2>
        <p>ZhongSai works from project structural drawings and coordinates detailing to develop fabrication-ready beam and column drawings, with responsibility scope defined by project contract and approved drawings.</p>
      </div>
      <div class="process-grid">
        <div class="process-item reveal">
          <div class="process-num">01</div>
          <h4>Architectural / Structural Drawings Review</h4>
          <p>Review client-provided architectural and structural drawings, including column grids, beam layouts, loading and connection requirements.</p>
        </div>
        <div class="process-item reveal reveal-delay-1">
          <div class="process-num">02</div>
          <h4>Structural Detailing Coordination</h4>
          <p>Coordinate shop drawing development based on confirmed structural design, including member sizes, connection details and fabrication requirements.</p>
        </div>
        <div class="process-item reveal reveal-delay-2">
          <div class="process-num">03</div>
          <h4>Connection Design Coordination</h4>
          <p>Develop connection details including base plates, end plates, stiffeners, gusset plates and bolted/welded connection interfaces.</p>
        </div>
        <div class="process-item reveal">
          <div class="process-num">04</div>
          <h4>Site Assembly Interface Planning</h4>
          <p>Plan site assembly interfaces including splice locations, bolt access, temporary supports and erection sequence considerations.</p>
        </div>
        <div class="process-item reveal reveal-delay-1">
          <div class="process-num">05</div>
          <h4>Transport Segmentation Design</h4>
          <p>Design member segmentation for container shipping and road transport, optimizing member lengths while minimizing site connections.</p>
        </div>
        <div class="process-item reveal reveal-delay-2">
          <div class="process-num">06</div>
          <h4>Approved Drawings for Fabrication</h4>
          <p>Fabrication proceeds only after approved drawings and confirmed technical specifications. Responsibility scope per project contract.</p>
        </div>
      </div>
      <div style="margin-top: 24px; padding: 16px; background: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 4px;">
        <p style="margin: 0; color: #92400e; font-size: 0.9rem;"><strong>Scope Note:</strong> ZhongSai can provide project detailing and fabrication coordination support. Structural design responsibility is determined by project contract, approved drawings and applicable professional requirements. ZhongSai does not assume structural design responsibility beyond the scope explicitly agreed in the project contract.</p>
      </div>
    </div>
  </section>

  <!-- 05 / Fabrication Capabilities -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Fabrication</p>
        <h2>Fabrication Capabilities for Project Steelwork</h2>
        <p>ZhongSai operates a production base equipped for precision steel beam and column fabrication, with documented quality processes and export-oriented packing and delivery.</p>
      </div>
      <div class="capability-grid">
        <div class="capability-item reveal">
          <h4>CNC Cutting</h4>
          <p>Precision CNC plasma and flame cutting for beam and column members, stiffeners and connection plates with accurate dimensions.</p>
        </div>
        <div class="capability-item reveal reveal-delay-1">
          <h4>Drilling</h4>
          <p>CNC drilling for bolt holes in end plates, connection plates and member end connections with accurate hole positioning.</p>
        </div>
        <div class="capability-item reveal reveal-delay-2">
          <h4>Welding</h4>
          <p>Qualified welding procedures and welders for fillet, partial penetration and full penetration welds per project specifications.</p>
        </div>
        <div class="capability-item reveal">
          <h4>Assembly</h4>
          <p>Precision beam and column assembly including web-to-flange fitting, stiffener placement and connection plate alignment.</p>
        </div>
        <div class="capability-item reveal reveal-delay-1">
          <h4>Dimensional Inspection</h4>
          <p>Dimensional verification at critical fabrication stages, including member straightness, connection alignment and fit-up verification.</p>
        </div>
        <div class="capability-item reveal reveal-delay-2">
          <h4>Trial Assembly</h4>
          <p>Trial assembly for complex connections where required by project specification, verifying fit-up before shipment.</p>
        </div>
        <div class="capability-item reveal">
          <h4>Surface Preparation</h4>
          <p>Shot blasting and surface preparation per SA 2.5 or project-specified standards before coating application.</p>
        </div>
        <div class="capability-item reveal reveal-delay-1">
          <h4>Painting</h4>
          <p>Multi-coat paint systems including primer, intermediate and finish coats, with dry film thickness verification per specification.</p>
        </div>
        <div class="capability-item reveal reveal-delay-2">
          <h4>Galvanizing</h4>
          <p>Hot-dip galvanizing coordination for members suitable for galvanizing bath dimensions, per applicable standards.</p>
        </div>
        <div class="capability-item reveal">
          <h4>Component Marking</h4>
          <p>Unique member identification system matching assembly drawings, including piece marks, orientation and connection references.</p>
        </div>
        <div class="capability-item reveal reveal-delay-1">
          <h4>Export Packing</h4>
          <p>Packing organized for container shipping, with detailed packing lists, member inventory and handling instructions.</p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 30px;">
        <a href="/en/manufacturing-quality/" class="btn btn-outline">View Manufacturing & Quality →</a>
      </div>
    </div>
  </section>

  <!-- 06 / Connections & Structural Interfaces -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Connections</p>
        <h2>Connections and Structural Interfaces</h2>
        <p>Beam and column connections and structural interfaces are critical to project performance. Connection design is coordinated based on project structural drawings and applicable standards.</p>
      </div>
      <div class="connection-grid">
        <div class="connection-item reveal">
          <h4>Base Plates</h4>
          <p>Column base plates and bearing connections, including anchor bolt interfaces and load transfer to foundations. Base plate design per column loads and foundation requirements.</p>
        </div>
        <div class="connection-item reveal reveal-delay-1">
          <h4>End Plates</h4>
          <p>Beam end plate connections for beam-to-column and beam-to-beam connections, with pre-drilled bolt holes and weld preparation per connection design.</p>
        </div>
        <div class="connection-item reveal reveal-delay-2">
          <h4>Stiffeners</h4>
          <p>Web stiffeners, flange stiffeners and bearing stiffeners for beam and column connections at load concentration points, per connection design requirements.</p>
        </div>
        <div class="connection-item reveal">
          <h4>Splice Joints</h4>
          <p>Beam and column splice joints for transport segmentation, designed for load transfer and site assembly accuracy. Splice locations optimized for transport and erection.</p>
        </div>
        <div class="connection-item reveal reveal-delay-1">
          <h4>Crane Bracket Connections</h4>
          <p>Crane beam bracket connections on columns, including bracket design, stiffener placement and crane beam support interfaces per crane system requirements.</p>
        </div>
        <div class="connection-item reveal reveal-delay-2">
          <h4>Building Interfaces</h4>
          <p>Coordination with building structural system including beam-to-column connections, bracing interfaces, floor system support and lateral load transfer paths.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 / Surface Treatment -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Surface Treatment</p>
        <h2>Surface Treatment for Beams and Columns</h2>
        <p>Surface protection systems are selected based on project environment, corrosion category, client specifications and design life requirements.</p>
      </div>
      <div class="surface-grid">
        <div class="surface-card reveal">
          <h4>Painting Systems</h4>
          <p>Multi-coat paint systems including epoxy primer, epoxy intermediate and polyurethane finish coats. System selection based on corrosion category and project specifications, with dry film thickness verification.</p>
        </div>
        <div class="surface-card reveal reveal-delay-1">
          <h4>Hot-Dip Galvanizing</h4>
          <p>Hot-dip galvanizing for beam and column members suitable for galvanizing bath dimensions. Provides durable corrosion protection for exterior and industrial environments, per applicable standards.</p>
        </div>
        <div class="surface-card reveal reveal-delay-2">
          <h4>Project-Specific Coating</h4>
          <p>Specialized coating systems for corrosive industrial environments, including high-performance epoxy, polyurethane and fluoropolymer coatings per project specifications and environmental requirements.</p>
        </div>
      </div>
      <div style="margin-top: 24px; padding: 16px; background: #f0fdf4; border-left: 4px solid #22c55e; border-radius: 4px;">
        <p style="margin: 0; color: #166534; font-size: 0.9rem;"><strong>Note:</strong> Specific corrosion protection system is determined by project environment, corrosion category, client specifications, local standards and design life requirements. ZhongSai does not guarantee fixed corrosion-free service life; actual performance depends on environment, maintenance and coating system specification.</p>
      </div>
    </div>
  </section>

  <!-- 08 / Export & Site Assembly -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Export & Assembly</p>
        <h2>Export Delivery and Site Assembly Considerations</h2>
        <p>ZhongSai beams and columns are designed and packed for export delivery, with careful consideration of transport segmentation, container loading and site assembly requirements.</p>
      </div>
      <div class="export-grid">
        <div class="export-item reveal">
          <h4>Component Marking</h4>
          <p>Unique beam and column identification system matching assembly drawings, including piece marks, orientation marks and connection references for accurate site assembly.</p>
        </div>
        <div class="export-item reveal reveal-delay-1">
          <h4>Packing Organization</h4>
          <p>Members packed by assembly sequence and connection groups, with protective packaging for finished surfaces and threaded components. Detailed packing lists included.</p>
        </div>
        <div class="export-item reveal reveal-delay-2">
          <h4>Container Loading</h4>
          <p>Optimized container loading plan maximizing space utilization while protecting members. Loading diagrams and container packing records provided per project requirements.</p>
        </div>
        <div class="export-item reveal">
          <h4>Long Member Segmentation</h4>
          <p>Long beams and tall columns segmented for container and road transport limits, with designed splice connections for site assembly. Segmentation optimized to minimize site connections.</p>
        </div>
        <div class="export-item reveal reveal-delay-1">
          <h4>Bolted Site Connections</h4>
          <p>Bolted connections designed for site assembly with pre-drilled holes, high-strength bolts and clear assembly instructions. Connection accessibility considered during detailing.</p>
        </div>
        <div class="export-item reveal reveal-delay-2">
          <h4>Installation Sequence</h4>
          <p>Site erection sequence considerations including column erection sequence, beam installation order, temporary bracing requirements and safety considerations.</p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 30px;">
        <a href="/en/export-delivery/" class="btn btn-outline">View Export & Delivery →</a>
      </div>
    </div>
  </section>

  <!-- 09 / Information Required for Engineering Review -->
  <section id="engineering-review" class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Engineering Review</p>
        <h2>Information Required for Engineering Review</h2>
        <p>The more complete the project documentation, the more accurate the engineering review and fabrication planning. Submit available materials and ZhongSai will confirm any additional information needed.</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>Project Country / City</h3>
          <p>Project location for applicable design codes, environmental conditions, logistics planning and export documentation.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>Architectural Drawings</h3>
          <p>Building architectural drawings showing column grids, beam layouts, floor plans, eave heights and architectural constraints.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>Structural Drawings</h3>
          <p>Structural design drawings including member sizes, loading specifications, connection design and foundation interfaces.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>General Arrangement Drawings</h3>
          <p>Overall building arrangement drawings showing beam and column positions, supporting structures and building interfaces.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>Loads</h3>
          <p>Design loads including dead load, live load, snow load, wind load, seismic load and any special equipment or crane loads.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>Material Requirements</h3>
          <p>Specified steel grades, material standards and any special material requirements or testing needs for beams and columns.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">07</div>
          <h3>Design Standard</h3>
          <p>Applicable design codes and standards, including material standards, load combinations, connection design and safety factors.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">08</div>
          <h3>Surface Treatment</h3>
          <p>Required surface protection system: painting specification, galvanizing requirements or project-specific coating systems.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">09</div>
          <h3>Project Schedule</h3>
          <p>Required fabrication timeline, batch delivery dates and site installation sequence affecting production planning.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">10</div>
          <h3>Delivery Port</h3>
          <p>Destination port or delivery location for logistics planning, packing organization and export documentation coordination.</p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 30px;">
        <a href="#quote" class="btn btn-primary">Upload Project Drawings</a>
        <a href="#quote" class="btn btn-outline" style="margin-left: 12px;">Send Project Requirements</a>
      </div>
    </div>
  </section>

  <!-- 10 / Related Project Types -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Related Projects</p>
        <h2>Related Project Types and Applications</h2>
        <p>Steel beams and columns are used across multiple project types. Explore related solutions and project categories where beam and column structures are commonly applied.</p>
      </div>
      <div class="related-grid">
        <a href="/en/steel-workshop/" class="related-card reveal">
          <h4>Industrial & Manufacturing</h4>
          <p>Industrial workshops and manufacturing plants requiring heavy load columns, crane beams and equipment platform supports.</p>
        </a>
        <a href="/en/steel-warehouse/" class="related-card reveal reveal-delay-1">
          <h4>Warehousing & Logistics</h4>
          <p>Warehouses and distribution centers requiring clear-span framing, racking support columns and mezzanine beam systems.</p>
        </a>
        <a href="/en/steel-mining-factory/" class="related-card reveal reveal-delay-2">
          <h4>Mining & Heavy Industry</h4>
          <p>Processing plants and heavy industrial structures requiring heavy-duty beams, equipment support columns and platform framing.</p>
        </a>
        <a href="/en/commercial-public-steel-buildings/" class="related-card reveal">
          <h4>Commercial & Public Buildings</h4>
          <p>Commercial structures and public facilities requiring efficient floor beam systems, column grids and long-span framing.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- 11 / Related Structural Capabilities -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Related Capabilities</p>
        <h2>Related Structural Capabilities</h2>
        <p>Steel beams and columns work together with other structural steel components in building projects. Explore related structural capabilities and component types.</p>
      </div>
      <div class="related-grid">
        <a href="/en/components/steel-trusses/" class="related-card reveal">
          <h4>Steel Trusses</h4>
          <p>Long-span truss structures working with beam and column framing for roof support and transfer structures.</p>
        </a>
        <a href="/en/components/" class="related-card reveal reveal-delay-1">
          <h4>All Steel Components</h4>
          <p>Complete range of structural steel components including beams, columns, trusses, platforms and special fabricated structures.</p>
        </a>
        <a href="/en/engineering-design/" class="related-card reveal reveal-delay-2">
          <h4>Engineering & Detailing</h4>
          <p>Structural detailing and engineering coordination for beam and column projects, including connection design and shop drawing development.</p>
        </a>
        <a href="/en/components/steel-purlins/" class="related-card reveal">
          <h4>Steel Purlins & Secondary</h4>
          <p>C/Z purlins and secondary structural members supporting roof and wall systems, working with primary beam and column framing.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- 12 / FAQ -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">FAQ</p>
        <h2>Frequently Asked Questions</h2>
