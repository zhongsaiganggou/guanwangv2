---
// ZhongSai V2 - English Components Hub (Rebuilt: all cards have clear action)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/hub.css';

const lang = 'en';
const title = 'Steel Components & Cladding Systems | Beams, Columns, Trusses, Purlins | ZhongSai';
const description = 'ZhongSai Steel Structure provides custom fabricated steel components and cladding systems to drawings — beams, columns, trusses, crane beams, C/Z purlins, roof and wall panels, sandwich panels, with component marking, packing and export delivery.';

// Primary Structural Members - all cards have clear action
const primaryMembers = [
  {
    title: 'Steel Beams',
    desc: 'H-beams, built-up beams and welded beams, fabricated to drawings with pre-fabricated end connection plates.',
    href: '/en/components/fabricated-steel-beams-columns/#steel-beams',
    actionType: 'anchor',
    cta: 'View Steel Beams →'
  },
  {
    title: 'Steel Columns',
    desc: 'H-columns, box columns and lattice columns, designed for load and height, with pre-fabricated base plates and stiffeners.',
    href: '/en/components/fabricated-steel-beams-columns/#steel-columns',
    actionType: 'anchor',
    cta: 'View Steel Columns →'
  },
  {
    title: 'Box Sections',
    desc: 'Box columns and box beams for long-span and heavy-load structures, fabricated to project drawings with full penetration welding.',
    href: '/en/components/fabricated-steel-beams-columns/#box-sections',
    actionType: 'anchor',
    cta: 'View Box Sections →'
  },
  {
    title: 'Crane Beams',
    desc: 'Overhead crane beams and under-hung crane beams, designed for crane tonnage and duty class, fabricated to crane system requirements.',
    href: '/en/components/fabricated-steel-beams-columns/#crane-beams',
    actionType: 'anchor',
    cta: 'View Crane Beams →'
  },
  {
    title: 'Steel Trusses',
    desc: 'Roof trusses, transfer trusses and pipe trusses, designed for span and load, with welded or bolted connections. Custom fabricated to drawings.',
    href: '/en/components/steel-trusses/',
    actionType: 'detail',
    cta: 'View Steel Trusses →'
  },
  {
    title: 'Platforms & Bracing',
    desc: 'Working platforms, equipment platforms, column bracing and roof bracing — custom fabricated to equipment layout and structural stability requirements.',
    href: '#quote',
    actionType: 'quote',
    cta: 'Send Platform & Bracing Drawings →'
  }
];

// Secondary Structural Members - all cards have clear action
const secondaryMembers = [
  {
    title: 'C Purlins',
    desc: 'Cold-formed C-section purlins for roof and wall secondary structures, selected by spacing and load, with pre-punched connection holes.',
    href: '/en/components/steel-purlins/#c-purlins',
    actionType: 'anchor',
    cta: 'View C Purlins →'
  },
  {
    title: 'Z Purlins',
    desc: 'Cold-formed Z-section purlins with lapped connections, suitable for wide-spacing roofs with better continuous bending performance.',
    href: '/en/components/steel-purlins/#z-purlins',
    actionType: 'anchor',
    cta: 'View Z Purlins →'
  },
  {
    title: 'Bracing System',
    desc: 'Column bracing, roof horizontal bracing and vertical bracing using angle steel or round bars, ensuring overall structural stability.',
    href: '#quote',
    actionType: 'quote',
    cta: 'Send Bracing Requirements →'
  },
  {
    title: 'Connection Components',
    desc: 'Gusset plates, stiffeners, connection plates and high-strength bolts, pre-fabricated to shop drawings for accurate site erection.',
    href: '#quote',
    actionType: 'quote',
    cta: 'Send Connection Details →'
  }
];

// Cladding Systems - all cards have unique anchor targets
const claddingSystems = [
  {
    title: 'Roof Panels',
    desc: 'Color-coated profiled roof panels, standing seam panels in various profiles and thicknesses, waterproof and wind-resistant.',
    href: '/en/components/roof-wall-cladding-systems/#roof-panels',
    actionType: 'anchor',
    cta: 'View Roof Panels →'
  },
  {
    title: 'Wall Panels',
    desc: 'Color-coated profiled wall panels, horizontal and vertical siding, various profiles and colors for coordinated building appearance.',
    href: '/en/components/roof-wall-cladding-systems/#wall-panels',
    actionType: 'anchor',
    cta: 'View Wall Panels →'
  },
  {
    title: 'Sandwich Panels',
    desc: 'EPS / PU / PIR sandwich panels for thermal insulation, suitable for factories and warehouses with temperature control requirements.',
    href: '/en/components/roof-wall-cladding-systems/#sandwich-panels',
    actionType: 'anchor',
    cta: 'View Sandwich Panels →'
  },
  {
    title: 'Cladding Accessories',
    desc: 'Gutters, trims, flashings, skylights and ventilators — a complete cladding accessory package coordinated with panel system.',
    href: '/en/components/roof-wall-cladding-systems/#cladding-accessories',
    actionType: 'anchor',
    cta: 'View Accessories →'
  }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="hub-hero">
    <div class="hub-hero-bg" style="background-image: url('/images/manufacturing/real/assembly-welding-9821.jpg')"></div>
    <div class="hub-hero-overlay"></div>
    <div class="container hub-hero-content">
      <div class="hub-breadcrumb">
        <a href="/en/">Home</a><span>/</span><span>Components</span>
      </div>
      <p class="eyebrow">COMPONENTS · By Steel Member Type</p>
      <h1>Custom Steel Components &<br>Cladding Systems to Drawings</h1>
      <p class="lead">Steel beams, columns, trusses, purlins and roof & wall cladding systems — custom fabricated, component marked, packed and delivered for export. <strong>Components are organized by steel member type.</strong> For complete building solutions by application, see <a href="/en/products/" style="color:rgba(255,255,255,0.92);text-decoration:underline;">Products</a>.</p>
    </div>
  </section>

  <!-- Direct Answer Block (GEO) -->
  <section class="component-section" style="padding: 40px 0; background: #f8fafc;">
    <div class="container">
      <div style="max-width: 800px; margin: 0 auto;">
        <h2 style="font-size: 1.5rem; margin-bottom: 16px; color: #0f172a;">What information is needed for fabricated steel components?</h2>
        <p style="font-size: 1.05rem; line-height: 1.7; color: #334155; margin-bottom: 16px;">
          Structural drawings, member schedules, connection details, material specifications and applicable project standards are typically needed for fabrication review. Clear drawing references and member identification help ensure accurate manufacturing and on-site assembly.
        </p>
        <div style="margin-top: 20px; padding: 16px; background: #fff; border-radius: 8px; border: 1px solid #e2e8f0;">
          <p style="font-weight: 600; margin-bottom: 8px; color: #0f172a;">Buyer Questions</p>
          <ul style="margin: 0; padding-left: 20px; color: #334155; line-height: 1.8;">
            <li>What drawings are needed for component fabrication?</li>
            <li>Can components be fabricated from customer-supplied drawings?</li>
            <li>How are steel members identified and marked?</li>
            <li>What information is needed for a quotation?</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Primary Structural Members -->
  <section class="component-section">
    <div class="container">
      <div class="component-section-header reveal">
        <p class="section-index">01 / Primary Members</p>
        <h2>Primary Structural Members</h2>
        <p>Main load-bearing building components including beams, columns, trusses and crane beams — custom fabricated to structural drawings and load requirements.</p>
      </div>
      <div class="component-item-grid">
        {primaryMembers.map((item, i) => (
          <a href={item.href} class={`component-item component-item-clickable reveal reveal-delay-${(i % 3) + 1}`}>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
            <span class="component-item-cta">{item.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Secondary Structural Members -->
  <section class="component-section" style="background: var(--color-gray-50);">
    <div class="container">
      <div class="component-section-header reveal">
        <p class="section-index">02 / Secondary Members</p>
        <h2>Secondary Structural Members</h2>
        <p>Roof and wall secondary structures, bracing systems and connection components — working with primary members to form a complete load-bearing system.</p>
      </div>
      <div class="component-item-grid">
        {secondaryMembers.map((item, i) => (
          <a href={item.href} class={`component-item component-item-clickable reveal reveal-delay-${(i % 3) + 1}`}>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
            <span class="component-item-cta">{item.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Cladding Systems -->
  <section class="component-section">
    <div class="container">
      <div class="component-section-header reveal">
        <p class="section-index">03 / Cladding Systems</p>
        <h2>Roof & Wall Cladding Systems</h2>
        <p>Roof and wall cladding systems including profiled panels, sandwich panels and accessories — supplied together with primary steel structure to form a complete building envelope package.</p>
      </div>
      <div class="component-item-grid">
        {claddingSystems.map((item, i) => (
          <a href={item.href} class={`component-item component-item-clickable reveal reveal-delay-${(i % 3) + 1}`}>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
            <span class="component-item-cta">{item.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- From Drawings to Fabrication -->
  <section class="dual-path-section">
    <div class="container">
      <div class="section-heading reveal" style="color: white; text-align: center; display: block; margin-bottom: 8px;">
        <p class="section-index" style="color: #f59e0b;">04 / Process</p>
        <h2 style="color: white; margin-bottom: 10px;">From Drawings to Delivery</h2>
        <p style="color: rgba(255,255,255,0.65); max-width: 700px; margin: 0 auto;">You provide the drawings — we complete fabrication, marking, packing and export delivery.</p>
      </div>
      <div class="dual-path-grid" style="grid-template-columns: repeat(4, 1fr); gap: 18px;">
        <div class="dual-path-card reveal reveal-delay-1" style="padding: 24px 20px;">
          <div class="path-icon" style="width: 40px; height: 40px; font-size: 15px; font-weight: 700; color:#fff; margin-bottom: 12px;">01</div>
          <h3 style="font-size: 16px; margin-bottom: 6px;">Detailing</h3>
          <p style="font-size: 13px; margin-bottom: 0;">Structural drawings converted to shop drawings and component lists</p>
        </div>
        <div class="dual-path-card reveal reveal-delay-2" style="padding: 24px 20px;">
          <div class="path-icon" style="width: 40px; height: 40px; font-size: 15px; font-weight: 700; color:#fff; margin-bottom: 12px;">02</div>
          <h3 style="font-size: 16px; margin-bottom: 6px;">Fabrication</h3>
          <p style="font-size: 13px; margin-bottom: 0;">Cutting, assembly, welding, drilling and surface treatment</p>
        </div>
        <div class="dual-path-card reveal reveal-delay-3" style="padding: 24px 20px;">
          <div class="path-icon" style="width: 40px; height: 40px; font-size: 15px; font-weight: 700; color:#fff; margin-bottom: 12px;">03</div>
          <h3 style="font-size: 16px; margin-bottom: 6px;">Marking</h3>
          <p style="font-size: 13px; margin-bottom: 0;">Component marking and packing lists based on shop drawings</p>
        </div>
        <div class="dual-path-card reveal reveal-delay-4" style="padding: 24px 20px;">
          <div class="path-icon" style="width: 40px; height: 40px; font-size: 15px; font-weight: 700; color:#fff; margin-bottom: 12px;">04</div>
          <h3 style="font-size: 16px; margin-bottom: 6px;">Packing & Export</h3>
          <p style="font-size: 13px; margin-bottom: 0;">Packed and loaded in marking order, export documentation support</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote CTA -->
  <section class="quote-cta-section" id="quote">
    <div class="container">
      <div class="quote-cta-header reveal">
        <p class="section-index" style="color: #f59e0b;">05 / Get a Quote</p>
        <h2>Submit Drawings for Component Quotation</h2>
        <p>Upload structural drawings or BOQ lists. ZhongSai will provide a quotation for component fabrication and cladding systems based on your requirements.</p>
      </div>
      <QuoteForm lang={lang} />
    </div>
  </section>
</BaseLayout>

<style>
  .component-item-clickable {
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .component-item-clickable:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  }
  .component-item-cta {
    display: inline-block;
    margin-top: 12px;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
