---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../../components/QuoteForm.astro';
import '../../../../styles/detail.css';

const title = 'Steel Roof & Wall Cladding Systems | ZhongSai';
const description = 'ZhongSai provides steel roof and wall cladding systems for steel buildings, including roof panels, wall panels, insulated sandwich panels and supporting cladding materials. Can be coordinated as part of the steel structure supply package with export delivery support.';
const lang = 'en';
const canonical = 'https://zhongsai-steelstructure.com/en/components/roof-wall-cladding-systems/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/components/finished-steel-members-stacked.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">Roof · Wall · Cladding Systems</span>
      <h1>Steel Roof & Wall Cladding Systems for Steel Buildings</h1>
      <p class="lead">ZhongSai provides roof and wall cladding systems for steel buildings, including roof panels, wall panels, insulated sandwich panels and supporting cladding materials. Cladding systems can be coordinated as part of the steel structure and secondary structure supply package. Specific panel types, thicknesses, coatings and insulation requirements are determined per project drawings and technical requirements, with packing, container loading and export delivery support.</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Submit Project Requirements for Quotation</a>
        <a href="/en/components/" class="btn btn-outline">View Components & Materials</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/components/">Components</a>
      <span class="sep">/</span>
      <span class="current">Roof & Wall Cladding Systems</span>
    </div>
  </nav>

  <!-- 01 Roof & Wall Cladding Systems -->
  <section class="detail-section" id="roof-panels">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">01 / Cladding Systems</p>
        <h2>The Role of Roof & Wall Cladding in Steel Buildings</h2>
        <p>Cladding systems are an essential part of steel buildings, including roof enclosure, wall enclosure, weather protection, insulation (where required per project) and coordination with the primary structural system. Specific panel types, material specifications and construction methods are determined per project drawings and technical requirements.</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/components/brochure-envelope-system-overview.jpg" alt="ZhongSai steel building roof and wall cladding systems" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Core Functions of Cladding Systems</h3>
          <ul>
            <li>Roof enclosure: weather protection, roof drainage coordination</li>
            <li>Wall enclosure: building envelope, facade coordination</li>
            <li>Weather protection: wind, rain and snow load coordination</li>
            <li>Insulation: insulation layers or sandwich panels where required per project</li>
            <li>Coordination with primary structure: purlins, fasteners, openings</li>
            <li>Specific panel types, thicknesses, coatings and insulation per project specifications</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Roof Systems -->
  <section class="detail-section alt" id="cladding-accessories">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">02 / Roof Systems</p>
        <h2>Roof Cladding Systems for Steel Buildings</h2>
        <p>ZhongSai can coordinate the supply of roof panels and supporting roof cladding materials per project requirements. Specific panel types, thicknesses, coatings and construction methods are determined per project drawings and technical requirements.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/components/finished-coated-components.jpg');"></div>
          <div class="feature-body">
            <h3>Roof Panel Layout</h3>
            <p>Roof panel layout coordinated per roof slope, purlin spacing and project requirements.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/01-industrial.jpg');"></div>
          <div class="feature-body">
            <h3>Waterproofing & Drainage</h3>
            <p>Roof waterproofing details and gutter drainage systems coordinated per project drawings.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/components/brochure-envelope-system-detail.jpg');"></div>
          <div class="feature-body">
            <h3>Insulation (Where Required)</h3>
            <p>Insulation layers or insulated sandwich panels configured per project use environment.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/04-warehouse-logistics.jpg');"></div>
          <div class="feature-body">
            <h3>Ventilation & Daylighting</h3>
            <p>Roof ventilators, skylights and other features coordinated with cladding per project.</p>
          </div>
        </div>
      </div>
      <p style="margin-top: 20px; color: #6b7280; font-size: 14px;">* Specific panel types, thicknesses, coatings and performance requirements are confirmed according to project drawings and technical specifications.</p>
    </div>
  </section>

  <!-- 03 Wall Systems -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">03 / Wall Systems</p>
        <h2>Wall Cladding Systems for Steel Buildings</h2>
        <p>ZhongSai can coordinate the supply of wall panels and supporting wall cladding materials per project requirements. Specific panel types, thicknesses, coatings and construction methods are determined per project drawings and technical requirements.</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>Building Envelope</h3>
          <p>Wall panel layout, lap details and trim details coordinated per project requirements.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>Facade & Opening Coordination</h3>
          <p>Door/window openings, facade divisions and trim coordinated with primary structure.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>Door & Window Interface</h3>
          <p>Cladding details around door and window openings per project drawings and requirements.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>Insulation (Where Required)</h3>
          <p>Insulation layers or insulated sandwich panels per project use environment.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>Color & Coating</h3>
          <p>Panel colors and coatings per project technical specifications and requirements.</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>Supporting Fasteners</h3>
          <p>Self-drilling screws, trim pieces, flashing and other supporting cladding materials supplied.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Insulated / Sandwich Panel Options -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">04 / Insulated Panel Options</p>
        <h2>Insulated Sandwich Panels & Insulated Cladding Options</h2>
        <p>Based on project use environment and insulation requirements, ZhongSai can coordinate the supply of insulated sandwich panels or cladding systems with insulation layers. Specific panel types, core materials, thicknesses and insulation performance are determined per project drawings and technical requirements.</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/components/brochure-envelope-system-detail.jpg" alt="ZhongSai insulated sandwich panels and cladding system details" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Available Insulated Cladding Options</h3>
          <ul>
            <li>Roof insulated sandwich panels (where required per project)</li>
            <li>Wall insulated sandwich panels (where required per project)</li>
            <li>Profiled panel systems with insulation layers (where required per project)</li>
            <li>Specific core material types, thicknesses and insulation performance per project specifications</li>
            <li>Insulated cladding materials can be coordinated as part of the steel structure supply package</li>
            <li>The cladding supply scope is confirmed according to project requirements and may include roof panels, wall panels, insulated panels and supporting materials</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Integrated Supply With Steel Structure -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">05 / Integrated Supply</p>
        <h2>Integrated Supply of Cladding With Steel Structure</h2>
        <p>ZhongSai can coordinate the primary steel structure, secondary structure and roof/wall cladding systems as a project supply package, helping simplify coordination between the primary structure, secondary structure and cladding systems. Specific supply scope is determined per project drawings and technical requirements.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/components/finished-steel-beams-columns.jpg');"></div>
          <div class="feature-body">
            <h3>Primary Steel Structure</h3>
            <p>Steel beams, columns and primary frame members, fabricated per project drawings.</p>
            <a href="/en/components/fabricated-steel-beams-columns/" class="feature-link">View Beams & Columns →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/components/finished-coated-components.jpg');"></div>
          <div class="feature-body">
            <h3>Secondary Structure & Purlins</h3>
            <p>C/Z purlins, tie rods, bracing and other secondary members, supplied with the primary structure.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/components/finished-steel-members-stacked.jpg');"></div>
          <div class="feature-body">
            <h3>Roof & Wall Cladding</h3>
            <p>Roof panels, wall panels, insulated sandwich panels and supporting cladding materials, coordinated per project.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/container-loading.jpg');"></div>
          <div class="feature-body">
            <h3>Packing & Export Delivery</h3>
            <p>Steel structure and cladding materials organized for unified packing, container loading and export delivery, with export documentation support and logistics coordination.</p>
          </div>
        </div>
      </div>
      <p style="margin-top: 20px; color: #6b7280; font-size: 14px;">* ZhongSai can coordinate roof and wall cladding materials as part of the steel structure supply package per project requirements. Local installation is carried out by the customer's or local project team. ZhongSai can provide overseas installation technical guidance according to project needs.</p>
    </div>
  </section>

  <!-- 06 What We Need for Quotation -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">06 / Quotation Requirements</p>
        <h2>What Information Is Needed for a Cladding Quotation</h2>
        <p>The more complete the project documentation, the more accurate the review and quotation. If documentation is incomplete, you can first submit available materials, and ZhongSai will further confirm what is needed for quotation.</p>
      </div>
      <div class="quote-info-grid">
        <div class="quote-info-card drawing">
          <h4>Have Complete Documentation</h4>
          <ul>
            <li>Project country</li>
            <li>Building type</li>
            <li>Architectural drawings (architectural / structural)</li>
            <li>Roof / wall technical requirements</li>
            <li>Insulation requirements</li>
            <li>Panel / material specifications (if available)</li>
            <li>Quantity / area (if available)</li>
          </ul>
        </div>
        <div class="quote-info-card no-drawing">
          <h4>Incomplete Documentation</h4>
          <ul>
            <li>Project country</li>
            <li>Building type and use</li>
            <li>Basic building dimensions (L / W / H)</li>
            <li>Known roof / wall requirements</li>
            <li>Insulation needs</li>
            <li>Submit available materials for initial review</li>
          </ul>
        </div>
      </div>
      <p class="quote-note">* Cladding system quotations require evaluation based on architectural drawings, technical specifications and project requirements. Specific panel types, material specifications and pricing are subject to project requirement confirmation.</p>
    </div>
  </section>

  <!-- 07 Related Applications -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">07 / Related Applications</p>
        <h2>Typical Application Scenarios for Cladding Systems</h2>
      </div>
      <div class="related-links">
        <a href="/en/steel-workshop/" class="related-link-card reveal reveal-delay-1">

          <h4>Industrial Workshops</h4>
          <p>Roof and wall cladding systems for steel industrial workshops</p>
          <span class="rl-arrow">View Details →</span>
        </a>
        <a href="/en/steel-warehouse/" class="related-link-card reveal reveal-delay-2">

          <h4>Warehouses & Logistics</h4>
          <p>Cladding systems for steel warehouses and logistics buildings</p>
          <span class="rl-arrow">View Details →</span>
        </a>
        <a href="/en/products/" class="related-link-card reveal reveal-delay-3">

          <h4>Commercial & Public Buildings</h4>
          <p>Cladding systems for commercial buildings, exhibition halls and public buildings</p>
          <span class="rl-arrow">View Details →</span>
        </a>
        <a href="/en/products/" class="related-link-card reveal reveal-delay-1">

          <h4>Agriculture & Special Buildings</h4>
          <p>Cladding systems for agricultural storage and special-use buildings</p>
          <span class="rl-arrow">View Details →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 08 FAQ -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal" style="text-align: center;">
        <p class="section-index" style="justify-content: center;">08 / FAQ</p>
        <h2>Frequently Asked Questions About Cladding Systems</h2>
      </div>
      <div class="detail-faq">
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Can roof and wall cladding systems be supplied with the steel structure?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Yes. ZhongSai can coordinate roof and wall cladding materials as part of the steel structure supply package per project requirements, including coordination of primary steel structure, secondary structure and cladding systems. Specific supply scope is determined per project drawings and technical requirements.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>What information is required for a cladding quotation?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Ideally, you should provide project country, building type, architectural drawings, roof/wall technical requirements, insulation requirements, panel/material specifications (if available) and quantity/area (if available). If documentation is incomplete, you can first submit available materials, and ZhongSai will further confirm what is needed for quotation.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Are insulated sandwich panels available?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Insulated sandwich panels or cladding systems with insulation layers can be coordinated based on project use environment and insulation requirements. Specific panel types, core materials, thicknesses and insulation performance are determined per project drawings and technical requirements. The cladding supply scope is confirmed according to project requirements and may include roof panels, wall panels, insulated panels and supporting materials.
            </div>
          </div>
        </div>
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            <span>Can the cladding system be coordinated with doors, windows and structural openings?</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              Yes. Wall cladding systems can be coordinated with door/window openings, facade divisions and structural openings. Specific construction methods are determined per project drawings and technical requirements. ZhongSai provides cladding material supply and technical coordination. Local construction and erection are performed by the customer or local construction team.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 Quote CTA + QuoteForm -->
  <section class="detail-section dark" id="quote">
    <div class="container">
      <div class="section-heading reveal" style="text-align: center;">
        <p class="section-index" style="justify-content: center; color: #f59e0b;">09 / Get Quotation</p>
        <h2 style="color: #fff;">Have Project Drawings or Technical Requirements? Submit for Cladding Quotation</h2>
        <p style="margin: 0 auto; color: rgba(255,255,255,0.75);">Submit project drawings, technical requirements and basic parameters. ZhongSai will conduct an initial review and confirm what is needed for quotation.</p>
      </div>
      <QuoteForm lang="en" />
    </div>
  </section>
</BaseLayout>

<script>
  // FAQ toggle
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item.classList.contains('open');
      item.classList.toggle('open');
      btn.setAttribute('aria-expanded', !isOpen);
    });
  });

  // Scroll reveal
  const revealElements = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    revealElements.forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(24px)';
      el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
      observer.observe(el);
    });
  }
</script>
