---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const title = 'Steel Structure Workshop Manufacturer China | Industrial Steel Buildings | ZhongSai';
const description = 'Steel structure workshops and industrial buildings engineered, fabricated and exported from China. ZhongSai supports structural detailing, manufacturing, container loading and overseas installation guidance.';
const lang = 'en';
const canonical = 'https://zhongsai-steelstructure.com/en/steel-workshop/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero - Customer Needs Oriented -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/products/app-industrial-workshop-hero.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">Industrial Workshop · Factory Building</span>
      <h1>Steel Structure Workshop for Industrial Manufacturing Projects</h1>
      <p class="lead">Steel workshops engineered for manufacturing plants, processing facilities and crane-equipped industrial buildings. From structural detailing to containerized export, we turn your production facility requirements into deliverable steel structures.</p>
      <div class="hero-capabilities">
        <div class="cap-item">
          <span class="cap-icon">📐</span>
          <span>Structural Design & Detailing</span>
        </div>
        <div class="cap-item">
          <span class="cap-icon">🏭</span>
          <span>Factory Fabrication</span>
        </div>
        <div class="cap-item">
          <span class="cap-icon">🚢</span>
          <span>Containerized Export</span>
        </div>
        <div class="cap-item">
          <span class="cap-icon">🔧</span>
          <span>Overseas Installation Guidance</span>
        </div>
      </div>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Send Your Drawings for Engineering Review</a>
        <a href="#quote-info" class="btn btn-outline">Request a Project Quote</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/products/">Products</a>
      <span class="sep">/</span>
      <span class="current">Industrial Workshop</span>
    </div>
  </nav>

  <!-- 01 Typical Applications -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">01 / Applications</p>
        <h2>Typical Applications for Steel Structure Workshops</h2>
        <p>Steel structure workshops are widely used across industrial sectors requiring clear-span production space, equipment integration and crane-ready structural design.</p>
      </div>
      <div class="app-grid">
        <div class="app-card reveal reveal-delay-1">
          <h3>Manufacturing Plants</h3>
          <p>Production facilities requiring open floor plans, equipment foundations and material handling integration.</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h3>Processing Workshops</h3>
          <p>Processing and assembly facilities with specific workflow layouts, ventilation and production line support.</p>
        </div>
        <div class="app-card reveal reveal-delay-3">
          <h3>Machinery Factories</h3>
          <p>Heavy machinery manufacturing with crane requirements, high load capacities and equipment access.</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h3>Automotive Workshops</h3>
          <p>Automotive production and assembly facilities with clear spans, production lines and vehicle access.</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h3>Heavy Industrial Facilities</h3>
          <p>Heavy industrial applications requiring high eave heights, heavy crane loads and robust structural design.</p>
        </div>
        <div class="app-card reveal reveal-delay-3">
          <h3>Crane Workshops</h3>
          <p>Facilities designed with overhead crane systems, reinforced columns and crane beam integration.</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h3>Assembly Plants</h3>
          <p>Assembly and production halls with flexible column grids, natural lighting and ventilation systems.</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h3>Production Halls</h3>
          <p>Multi-purpose production halls adaptable to changing manufacturing processes and equipment layouts.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Typical Engineering Parameters -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">02 / Engineering Parameters</p>
        <h2>Typical Engineering Parameters</h2>
        <p>Industrial workshop configurations vary by production process, equipment layout and local building codes. The following parameters are project-based references; actual design values must be determined per project drawings, load calculations and applicable local standards.</p>
      </div>
      <div class="params-table-wrapper">
        <table class="params-table">
          <thead>
            <tr>
              <th>Parameter</th>
              <th>Typical / Project-based</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Building Type</strong></td>
              <td>Industrial workshop / factory / processing plant</td>
            </tr>
            <tr>
              <td><strong>Structural System</strong></td>
              <td>Portal frame / multi-span steel frame</td>
            </tr>
            <tr>
              <td><strong>Span</strong></td>
              <td>According to project requirements</td>
            </tr>
            <tr>
              <td><strong>Eave Height</strong></td>
              <td>According to equipment and process requirements</td>
            </tr>
            <tr>
              <td><strong>Bay Spacing</strong></td>
              <td>Project specific</td>
            </tr>
            <tr>
              <td><strong>Crane</strong></td>
              <td>Optional, according to lifting requirements</td>
            </tr>
            <tr>
              <td><strong>Main Steel Grade</strong></td>
              <td>Q355B or equivalent project-specified grade</td>
            </tr>
            <tr>
              <td><strong>Connection</strong></td>
              <td>Bolted / welded</td>
            </tr>
            <tr>
              <td><strong>Roof System</strong></td>
              <td>Metal sheet / sandwich panel</td>
            </tr>
            <tr>
              <td><strong>Wall System</strong></td>
              <td>Metal sheet / sandwich panel</td>
            </tr>
            <tr>
              <td><strong>Surface Treatment</strong></td>
              <td>Painting / galvanizing according to environment</td>
            </tr>
            <tr>
              <td><strong>Design Standard</strong></td>
              <td>According to project location and client requirements</td>
            </tr>
            <tr>
              <td><strong>Export</strong></td>
              <td>Containerized shipment</td>
            </tr>
            <tr>
              <td><strong>Installation</strong></td>
              <td>Technical guidance available</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="params-note"><strong>Note:</strong> All parameters above are project-based references. Actual span, height, loads, steel grade and connection details must be determined by qualified structural engineers based on project-specific drawings, load calculations and applicable local building codes. ZhongSai provides fabrication and export supply based on approved project drawings.</p>
    </div>
  </section>

  <!-- 03 Steel Workshop with Overhead Crane -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">03 / Crane Workshop</p>
        <h2>Steel Workshop with Overhead Crane</h2>
        <p>Many industrial manufacturing facilities require overhead crane systems for material handling, equipment maintenance and production processes. Crane requirements significantly influence structural design and should be confirmed at the earliest project stage.</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/company/factory-steel-beam-fabrication.jpg" alt="Steel structure workshop with overhead crane fabrication" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Key Design Considerations for Crane Workshops</h3>
          <ul>
            <li><strong>Crane capacity confirmation</strong> — lifting capacity, duty cycle and operating frequency must be specified before structural design</li>
            <li><strong>Column reinforcement</strong> — crane loads require reinforced column sections and additional bracing</li>
            <li><strong>Crane beam (bracket) design</strong> — corbels or crane beams must be integrated into column design at correct elevation</li>
            <li><strong>Foundation reaction forces</strong> — crane loads transmit additional vertical and horizontal forces to foundations</li>
            <li><strong>Span and bay spacing</strong> — crane runway alignment affects column grid layout</li>
            <li><strong>Rail top height</strong> — determines required eave height and structural clearances</li>
            <li><strong>Steel tonnage impact</strong> — different crane capacities significantly affect overall structural steel weight</li>
          </ul>
          <p style="margin-top: 16px; color: #666; font-size: 0.92rem;">Specific crane tonnage ranges are not provided as universal standards — each project requires structural analysis based on actual lifting requirements, building dimensions and applicable design codes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Structural & Production Space Planning -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">04 / Structural & Space Planning</p>
        <h2>Structural and Production Space Planning Around Workflow</h2>
        <p>The core of an industrial workshop is production efficiency. Structural planning needs to accommodate equipment layout, production flow and material handling, rather than simply pursuing maximum span.</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/company/factory-interior-production.jpg" alt="ZhongSai steel structure workshop production space" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Column Grid Coordinated with Production Space</h3>
          <p>Column grid spacing is determined based on equipment dimensions, production aisles and material handling routes, balancing structural economy with usable production space.</p>
          <ul>
            <li>Column grid spacing coordinated with equipment layout and production flow</li>
            <li>Clear working height accommodates equipment operation and access</li>
            <li>Crane requirements confirmed and reserved during structural design</li>
            <li>Roof and wall systems coordinated with structural frame</li>
            <li>Specific spans, heights and loads determined per project drawings and requirements</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Information Required for Quotation -->
  <section class="detail-section" id="quote-info">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">05 / Quotation Information</p>
        <h2>Information Required for Workshop Quotation</h2>
        <p>The more complete the project information, the more accurate the quotation. Length, width and height alone cannot provide an accurate quotation — use, equipment and technical requirements must be considered.</p>
      </div>
      <div class="quote-info-grid">
        <div class="quote-info-card drawing">
          <h4>Have Drawings / BOQ</h4>
          <ul>
            <li>Project country / city</li>
            <li>Architectural / structural drawings</li>
            <li>Bill of Quantities (BOQ)</li>
            <li>Project technical specifications</li>
            <li>Crane / equipment special requirements</li>
            <li>Local design code if specified</li>
          </ul>
        </div>
        <div class="quote-info-card no-drawing">
          <h4>No Complete Drawings Yet</h4>
          <ul>
            <li>Project country / city</li>
            <li>Building length (reference)</li>
            <li>Building width (reference)</li>
            <li>Eave height (reference)</li>
            <li>Crane requirement (capacity / quantity)</li>
            <li>Intended use (production / processing / equipment)</li>
            <li>Roof and wall requirements</li>
            <li>Available drawings or sketches</li>
          </ul>
        </div>
      </div>
      <div style="margin-top: 24px; text-align: center;">
        <a href="#quote" class="btn btn-primary">Upload Drawings / Send Project Requirements</a>
      </div>
      <p class="quote-note">* Initial proposal and quotation require needs assessment based on project use and basic parameters. Final proposal and pricing are subject to drawing and technical requirement confirmation.</p>
    </div>
  </section>

  <!-- 06 From Drawings to Delivery Process -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">06 / Process</p>
        <h2>From Project Drawings to Export Delivery</h2>
        <p>ZhongSai provides steel structure supply services from design detailing to export delivery. Local construction is performed by the customer or local construction team.</p>
      </div>
      <div class="process-flow">
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">01</div>
          <h4>Project Information Review</h4>
          <p>Drawings, BOQ and technical requirements review</p>
          <a href="/en/products/custom-engineering/" class="process-link">Engineering Support →</a>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">02</div>
          <h4>Structural Design / Detailing</h4>
          <p>Detailing design and fabrication drawing preparation</p>
          <a href="/en/products/custom-engineering/" class="process-link">Detailing →</a>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">03</div>
          <h4>Material Preparation</h4>
          <p>Steel material procurement and traceability verification</p>
          <a href="/en/manufacturing-quality/" class="process-link">Manufacturing →</a>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">04</div>
          <h4>Fabrication & Quality Inspection</h4>
          <p>Cutting, assembly, welding and dimensional inspection</p>
          <a href="/en/manufacturing-quality/" class="process-link">Quality Control →</a>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>Marking, Packing & Container Loading</h4>
          <p>Component marking, packing organized for container loading</p>
          <a href="/en/export-delivery/" class="process-link">Export Delivery →</a>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">06</div>
          <h4>Export Delivery & Installation Guidance</h4>
          <p>Export documentation, sea freight and overseas installation technical guidance</p>
          <a href="/en/export-delivery/" class="process-link">Installation Guidance →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 Steel Structure Fabrication -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">07 / Steel Fabrication</p>
        <h2>From Drawings to Fabricated Steel Components</h2>
        <p>ZhongSai Steel Structure operates its own production base, covering cutting, assembly, welding, straightening, drilling, surface treatment and quality control. Steel components are fabricated according to project drawings.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/company/factory-steel-beam-fabrication.jpg');"></div>
          <div class="feature-body">
            <h3>Steel Beams & Columns</h3>
            <p>H-beams, box sections and other primary structural members are cut, assembled and welded per shop drawings, with dimensional accuracy controlled per project requirements.</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/manufacturing/real/workshop-overview-wide-9815.jpg');"></div>
          <div class="feature-body">
            <h3>Fabrication & Quality Control</h3>
            <p>Fabrication is organized per project drawings and technical specifications, with dimensional, welding and visual inspection at key stages. Specific inspection requirements follow project agreements.</p>
          </div>
        </div>
      </div>
      <div style="margin-top: 28px; display: flex; gap: 16px; flex-wrap: wrap;">
        <a href="/en/manufacturing-quality/" class="btn btn-outline">View Manufacturing Capability</a>
        <a href="/en/components/fabricated-steel-beams-columns/" class="btn btn-outline">Steel Beams & Columns</a>
      </div>
    </div>
  </section>

  <!-- 08 Roof & Wall Systems -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">08 / Roof & Wall Systems</p>
        <h2>Roof and Wall Cladding Systems</h2>
        <p>The enclosure system of an industrial workshop directly affects operating environment and operational cost. ZhongSai can supply roof panels, wall panels and supporting cladding materials per project requirements, coordinated with the primary steel structure.</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/detail-cladding-system.jpg" alt="Steel structure roof and wall cladding systems" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>Cladding Configuration Determined Per Project</h3>
          <p>Roof and wall materials, thermal insulation, waterproofing grade and ventilation configuration are determined based on building use, local climate and project technical requirements.</p>
          <ul>
            <li>Roof and wall panel systems can be supplied together with the primary structure</li>
            <li>Thermal insulation layers configured per operating environment and project requirements</li>
            <li>Roof drainage and waterproofing details designed per project technical requirements</li>
            <li>Ventilation and lighting openings coordinated with the cladding system</li>
          </ul>
          <div style="margin-top: 20px;">
            <a href="/en/components/roof-wall-cladding-systems/" class="btn btn-outline">View Cladding Systems</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 Related Projects -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">09 / Related Projects</p>
        <h2>Industrial Manufacturing Project References</h2>
        <p>Selected industrial manufacturing and production facility projects demonstrating ZhongSai's steel structure fabrication and supply capability.</p>
      </div>
      <div class="project-grid">
        <a href="/en/projects/xiegang-aviation-manufacturing/" class="project-card reveal reveal-delay-1">
          <div class="project-img" style="background-image: url('/images/projects/shanghai-baoye-xiegang-aviation-manufacturing-aerial-rendering.jpg');"></div>
          <div class="project-body">
