          </div>
        </a>
        <a href="/en/projects/guangzhou-high-end-equipment-base/" class="project-card reveal reveal-delay-2">
          <div class="project-img" style="background-image: url('/images/projects/guangzhou-gongkong-high-end-equipment-base-aerial-rendering.jpg');"></div>
          <div class="project-body">
            <span class="project-type">Industrial Manufacturing</span>
            <h3>Guangzhou High-End Equipment R&D Base</h3>
            <div class="project-meta">
