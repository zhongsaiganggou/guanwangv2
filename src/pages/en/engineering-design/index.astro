---
// ZhongSai V2 - English Engineering & Detailing Page (UX / Evidence / CRO Optimized)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const lang = 'en';
const title = 'Steel Structure Design & Detailing | ZhongSai';
const description = 'Engineering and detailing support for overseas steel structure projects: drawing review, structural coordination, shop detailing, connection...';
const canonical = 'https://zhongsai-steelstructure.com/en/engineering-design/';

const engSteps = [
  { num: '01', title: 'Project Information Review', desc: 'Review architectural, structural, GA, equipment layout drawings and project requirements to establish the engineering scope.' },
  { num: '02', title: 'Design Criteria & Structural Coordination', desc: 'Confirm use, spans, heights, loads, crane and applicable codes; coordinate column grid, framing and load paths.' },
  { num: '03', title: 'Shop Detailing & Drawings', desc: 'Develop member sizes, connection details and fabrication-ready shop drawings with holes, welds, bolts and part numbering.' },
  { num: '04', title: 'Drawing Review & Approval', desc: 'Internal review for accuracy and constructability, followed by client/engineer approval before fabrication release.' },
  { num: '05', title: 'Fabrication Release & Interface', desc: 'Release approved drawings, material lists, assembly instructions and QC requirements to production.' },
  { num: '06', title: 'Site Technical Support', desc: 'Provide drawing clarification, connection guidance, erection sequence coordination and issue resolution during installation.' }
];

const designInputs = [
  { name: 'Span & Column Grid', desc: 'Clear span, bay spacing, eave height, building dimensions and support locations' },
  { name: 'Design Loads', desc: 'Dead, live, wind, snow and seismic requirements confirmed per project location and applicable code' },
  { name: 'Crane & Equipment Loads', desc: 'Crane capacity, span, duty cycle, equipment weight and dynamic loads where applicable' },
  { name: 'Connections & Joints', desc: 'High-strength bolting, welding, field splice conditions and node detailing scope' },
  { name: 'Corrosion & Environment', desc: 'Exposure category, humidity, chemical exposure and coating requirements' },
  { name: 'Fire Protection', desc: 'Fire resistance ratings and passive fire protection specifications' },
  { name: 'Transport & Segmentation', desc: 'Container dimensions, over-length segmentation, packing and site lifting conditions' },
  { name: 'Applicable Codes', desc: 'Design, material and construction standards per project location and client specification' }
];

const deliverables = [
  { name: 'GA Drawings', desc: 'Overall arrangement, column grid, framing and key dimensions' },
  { name: 'Shop Drawings', desc: 'Member sizes, plates, hole positions, welds and bolting information' },
  { name: 'Connection Details', desc: 'Joints, column bases, splices and stiffener details' },
  { name: 'BOM / Material List', desc: 'Material take-off, part numbering and procurement reference' },
  { name: 'Erection Drawings', desc: 'Lifting sequence, installation reference and site coordination' }
];

const nodeTypes = [
  'Beam-column connections',
  'Column bases & anchor bolts',
  'Truss & intersecting nodes',
  'Splice joints',
  'Bracing & lateral system connections',
  'Crane brackets & equipment interfaces'
];

const mfPoints = [
  { name: 'Fabricability', desc: 'Member details developed for existing manufacturing equipment and processes.' },
  { name: 'Welding Access', desc: 'Connection configurations ensure welding access and quality control conditions.' },
  { name: 'Plate Optimization', desc: 'Member and plate sizes coordinated with standard material dimensions to reduce waste.' },
  { name: 'Member Segmentation', desc: 'Long members segmented at appropriate locations for transport and site assembly.' }
];

const exportSteps = ['Transport Design', 'Segmentation', 'Numbering', 'Packing', 'Container Loading', 'Site Assembly Support'];

const standards = [
  { code: 'GB', desc: 'Chinese national standards for structural design and fabrication' },
  { code: 'AISC / ASCE', desc: 'American Institute of Steel Construction and ASCE standards' },
  { code: 'Eurocode', desc: 'European standards for structural steel design (EN 1990-1993)' },
  { code: 'Australian', desc: 'Australian standards for steel structures (AS 4100, AS/NZS 1170)' },
  { code: 'Other', desc: 'Other project-specified standards subject to technical review and coordination' }
];

const faqs = [
  {
    q: 'Can ZhongSai work from architectural drawings?',
    a: 'Yes. ZhongSai can work from architectural drawings, concept drawings, general arrangement drawings or preliminary structural drawings. The level of engineering coordination and detailing required depends on the completeness of the provided information. Where only architectural drawings are available, additional structural coordination and design input may be required within the agreed project scope.'
  },
  {
    q: 'Can you provide shop drawings for fabrication?',
    a: 'Yes. ZhongSai provides fabrication-ready shop drawings including member dimensions, plate sizes, hole positions, weld information, bolt connections, part numbering, assembly details and fabrication notes. Shop drawings are coordinated with the manufacturing process to ensure they directly support production and site installation.'
  },
  {
    q: 'Can you work with AISC or Eurocode projects?',
    a: 'Project design and detailing can be coordinated according to the applicable code specified for the project, including AISC/ASCE, Eurocode, GB, Australian standards or other project-specified standards, subject to technical review. We do not claim compliance with all international standards universally; the applicable code is confirmed per project based on client requirements and local regulations.'
  },
  {
    q: 'Can you detail crane-equipped steel buildings?',
    a: 'Yes. ZhongSai has experience detailing crane-equipped industrial buildings, including crane runway beam supports, brackets, stiffeners, column reinforcement and load transfer details. Crane capacity, span, duty cycle and runway requirements are confirmed as part of the design criteria before detailing begins.'
  },
  {
    q: 'How do you coordinate drawings with fabrication?',
    a: 'Engineering and detailing are coordinated directly with the manufacturing team. Shop drawings include fabrication-relevant information such as material lists, cutting lists, assembly sequences, weld details and quality control requirements. Approved drawings are released to fabrication with clear documentation, and the engineering team remains available for technical clarification during production.'
  },
  {
    q: 'Can steel members be optimized for container shipping?',
    a: 'Yes. As part of design for export shipping, member lengths and connection locations can be coordinated to fit standard container dimensions. Long members may be segmented with bolted splice joints for transport, and component numbering is coordinated with packing and erection sequence. The specific segmentation approach is determined based on project dimensions, container type and site assembly requirements.'
  },
  {
    q: 'Can ZhongSai coordinate with Malaysia CIDB certification requirements?',
    a: 'Yes. ZhongSai\u2019s manufacturing base holds Malaysia CIDB IBS certification (Cert. No. IBS231/039) covering metal framing and steel structure components. For Malaysia-based projects, design detailing, connection development and fabrication documentation can be coordinated with CIDB certification requirements. Local approvals, professional engineer stamping and statutory compliance remain the responsibility of the project owner or their appointed local licensed engineer per project.'
  },
  {
    q: 'Do you provide local engineer stamping?',
    a: 'ZhongSai provides structural engineering support, detailing and fabrication documentation within the agreed project scope. Local permitting, statutory approval and professional engineer stamping, where required by local regulations, remain the responsibility of the project owner or their appointed local licensed engineer. ZhongSai does not claim to provide licensed professional engineering services in all jurisdictions; the specific responsibility allocation is confirmed per project contract and local regulatory requirements.'
  }
];

const relatedLinks = [
  { name: 'Manufacturing & Quality', href: '/en/manufacturing-quality/', desc: 'Factory fabrication, quality control and production evidence' },
  { name: 'Steel Workshop', href: '/en/steel-workshop/', desc: 'Industrial workshop and manufacturing plant steel structures' },
  { name: 'Steel Warehouse', href: '/en/steel-warehouse/', desc: 'Logistics and storage warehouse steel structures' },
  { name: 'Mining & Heavy Industry', href: '/en/steel-mining-factory/', desc: 'Heavy industrial steel structures for mining and energy' },
  { name: 'Mezzanines, Platforms & Special Structures', href: '/en/special-custom-steel-structures/', desc: 'Detailing and engineering for mezzanines, platforms and custom structures' },
  { name: 'Project Cases', href: '/en/projects/', desc: 'Real project evidence with engineering and fabrication scope' },
  { name: 'Export Delivery', href: '/en/export-delivery/', desc: 'Container loading, export documentation and logistics' },
  { name: 'Contact & Quote', href: '/en/contact/', desc: 'Submit drawings for engineering review and quotation' }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/company/factory-aerial-panorama.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">ENGINEERING · From Drawings to Fabrication</span>
      <h1>Steel Structure Design,<br>Detailing and Engineering Support</h1>
      <p class="lead">Engineering and detailing support for overseas steel structure projects — drawing review, structural coordination, shop detailing, connection development and fabrication documentation, coordinated with manufacturing and export delivery.</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">Send Drawings for Engineering Review</a>
        <a href="/en/projects/" class="btn btn-outline">View Project Evidence</a>
      </div>
    </div>
  </section>

  <!-- Hero Evidence Strip -->
  <section class="detail-section" style="padding-top: 0;">
    <div class="container">
      <div class="hero-strip">
        <span>Drawing Review</span>
        <span>Structural Coordination</span>
        <span>Shop Detailing</span>
        <span>Fabrication Interface</span>
        <span>Export Delivery</span>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <span class="current">Engineering & Detailing</span>
    </div>
  </nav>

  <!-- 01 / Starting the Project: What We Need -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Project Information</p>
        <h2>Starting a Steel Structure Project: What Do We Need?</h2>
        <p>ZhongSai can begin engineering coordination from various levels of project documentation. The more complete the project files, the more accurate the technical review and fabrication plan. If some information is not yet confirmed, submit what you have — the engineering team will confirm what else is needed.</p>
      </div>
      <div class="quote-info-grid">
        <div class="quote-info-card drawing reveal">
          <h4>With Project Drawings</h4>
          <ul>
            <li>Architectural / concept / GA drawings</li>
            <li>Structural drawings (if available)</li>
            <li>Design data and load information</li>
            <li>BOQ / member schedule (if available)</li>
          </ul>
        </div>
        <div class="quote-info-card no-drawing reveal reveal-delay-1">
          <h4>Without Complete Drawings</h4>
          <ul>
            <li>Project country / city</li>
            <li>Building use and function</li>
            <li>Length / width / height</li>
            <li>Expected span and crane / equipment conditions</li>
            <li>Applicable design code (if known)</li>
            <li>Destination port</li>
          </ul>
        </div>
      </div>
      <p class="quote-note reveal">You can inquire without complete drawings. Submit the information you have to start the technical review — the engineering team will confirm what else is needed.</p>
      <div style="text-align: center; margin-top: 30px;">
        <a href="#quote" class="btn btn-primary">Submit Current Project Information</a>
      </div>
    </div>
  </section>

  <!-- 02 / From Project Drawings to Fabrication-Ready Members — Real Engineering Evidence -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Engineering Evidence</p>
        <h2>From Project Drawings to Fabrication-Ready Members</h2>
        <p>ZhongSai\u2019s engineering team develops details in Tekla / BIM models, outputs shop drawings, connection details and fabrication documentation, and coordinates directly with shop cutting, assembly and welding. Samples below have client and project-sensitive information redacted.</p>
      </div>
      <div class="evidence-strip">
        <figure class="evidence-item reveal">
          <img src="/images/engineering/tekla-model.jpg" alt="Tekla 3D structural model showing beam, column and truss joint relationships" loading="lazy">
          <figcaption>Tekla / BIM 3D model · model built per project</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-1">
          <img src="/images/manufacturing/process/01-drawing-review.jpg" alt="Engineers checking project drawings and fabrication information in the workshop" loading="lazy">
          <figcaption>Drawing review and fabrication handover</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-2">
          <img src="/images/engineering/workflow/step-06-drawing-approval.jpg" alt="Drawing confirmation and approval process" loading="lazy">
          <figcaption>Drawing confirmation and approval before fabrication</figcaption>
        </figure>
      </div>
      <figure class="office-evidence reveal">
        <img src="/images/engineering/design-office/design-office-cad-work.webp" alt="Design office workbench: engineer detailing and coordinating shop drawings from project drawings in CAD" loading="lazy" width="900" height="900">
        <figcaption>Design office workbench — connection detailing and shop drawing coordination from project drawings</figcaption>
      </figure>
      <p class="params-note reveal"><strong>Scope note:</strong> ZhongSai provides structural engineering support, detailing and fabrication documentation within the agreed project scope. Structural design responsibility is determined by the project contract, approved drawings and applicable professional requirements; local approvals and professional engineer stamping remain the responsibility of the project owner or their appointed local licensed engineer.</p>
    </div>
  </section>

  <!-- 03 / Engineering and Detailing Workflow -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Workflow</p>
        <h2>Engineering and Detailing Workflow</h2>
        <p>From project information review through fabrication release and site technical support, every stage includes quality control and review gates to ensure accurate, fabricable drawings that coordinate with site conditions.</p>
      </div>
      <div class="eng-flow">
        {engSteps.map((step, i) => (
          <div class={`process-step reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="step-num">{step.num}</div>
            <h4>{step.title}</h4>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 / Engineering Inputs and Design Criteria -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Design Inputs</p>
        <h2>Engineering Inputs and Design Criteria</h2>
        <p>Structural design and detailing are based on project-specific design conditions confirmed at project start. Actual values, load combinations and safety factors are determined by project drawings, approved technical specifications and applicable local design codes.</p>
      </div>
      <div class="params-table-wrapper reveal">
        <table class="params-table">
          <thead>
            <tr>
              <th>Project Condition</th>
              <th>What We Need to Confirm</th>
            </tr>
          </thead>
          <tbody>
            {designInputs.map(row => (
              <tr>
                <td>{row.name}</td>
                <td>{row.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="params-note reveal">These are general confirmation items. Wind, snow, seismic and other conditions vary by project location and applicable code; all design inputs are confirmed per project based on client-provided information and local regulatory requirements.</p>
    </div>
  </section>

  <!-- 05 / Design & Detailing Deliverables -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Deliverables</p>
        <h2>Design & Detailing Deliverables</h2>
        <p>From structural scheme to shop drawings, connection details and erection drawings, ZhongSai\u2019s engineering team delivers complete documentation at each project stage, coordinated directly with factory fabrication.</p>
      </div>
      <div class="media-gallery media-gallery--feature3">
        <figure class="media-tile reveal">
          <img src="/images/engineering/workflow/step-05-shop-detailing.jpg" alt="Detailing engineers developing member shop drawings" loading="lazy">
          <figcaption>Shop drawing and member detail development</figcaption>
        </figure>
        <figure class="media-tile reveal reveal-delay-1">
          <img src="/images/engineering/workflow/step-04-connection-development.jpg" alt="Connection node detailing sample" loading="lazy">
          <figcaption>Connection node detailing</figcaption>
        </figure>
        <figure class="media-tile reveal reveal-delay-2">
          <img src="/images/blog/overhead-crane-workshop-design/crane-column-detail.jpg" alt="Crane runway beam and column connection detail" loading="lazy">
          <figcaption>Crane runway system details</figcaption>
        </figure>
      </div>
      <div class="deliverables-two-col">
        <div class="reveal">
          <h3 class="col-title">Drawing Deliverables</h3>
          <ul class="check-list">
            {deliverables.map(item => (
              <li><strong>{item.name}</strong> — {item.desc}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-1">
          <h3 class="col-title">Node Detailing Types</h3>
          <ul class="check-list">
            {nodeTypes.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 / Design for Manufacturing & Export Shipping -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Fabrication & Export</p>
        <h2>Design for Manufacturing and Export Shipping</h2>
        <p>Engineering is not separated from manufacturing or shipping. ZhongSai coordinates design and detailing with fabrication capabilities and plans segmentation, numbering, packing and container loading to support export delivery and site assembly.</p>
      </div>
      <div class="mf-points">
        {mfPoints.map((point, i) => (
          <div class={`mf-point reveal reveal-delay-${(i % 4) + 1}`}>
            <h4>{point.name}</h4>
            <p>{point.desc}</p>
          </div>
        ))}
      </div>
      <div class="export-chain">
        {exportSteps.map((step, i) => (
          <>
            {i > 0 && <span class="chain-arrow reveal">→</span>}
            <span class="chain-step reveal"><span class="chain-num">0{i + 1}</span>{step}</span>
          </>
        ))}
      </div>
      <div class="evidence-strip">
        <figure class="evidence-item reveal">
          <img src="/images/blog/packing-loading-steel-export/loading.jpg" alt="Forklift loading bundled steel members into a container" loading="lazy">
          <figcaption>Member packing and container loading</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-1">
          <img src="/images/blog/packing-loading-steel-export/packing.jpg" alt="Labelled boxes of bolted connection components" loading="lazy">
          <figcaption>Connection and hardware packed by label</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-2">
          <img src="/images/projects/site-erection.jpg" alt="Mobile crane erecting steel structure members on site" loading="lazy">
          <figcaption>Site erection and installation coordination</figcaption>
        </figure>
      </div>
      <p class="params-note reveal"><strong>Responsibility boundary:</strong> ZhongSai provides installation technical guidance and engineering coordination, including component numbering, assembly instructions and remote technical support where needed; local construction is normally carried out by local contractors.</p>
    </div>
  </section>

  <!-- 07 / Design Standards & Compliance -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Design Standards</p>
        <h2>Design Standards & Compliance</h2>
        <p>Project design and detailing can be coordinated according to the applicable code specified for the project, subject to technical review. We do not claim compliance with all international standards universally.</p>
      </div>
      <div class="standards-tags reveal">
        {standards.map(std => (
          <span class="std-tag"><strong>{std.code}</strong>{std.desc}</span>
        ))}
      </div>
      <div style="margin-top: 28px; padding: 20px 24px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 2px; display: flex; gap: 16px; align-items: flex-start;" class="reveal">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1e40af" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
        <div>
          <strong style="color: #1e40af; font-size: 15px; display: block; margin-bottom: 4px;">Malaysia CIDB IBS Certification Coordination</strong>
          <p style="margin: 0; color: #475569; font-size: 13.5px; line-height: 1.7;">For Malaysia-based projects, ZhongSai can coordinate design detailing and fabrication documentation with CIDB certification requirements (Cert. No. IBS231/039). Applicable codes and local approval requirements are still confirmed per project.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 08 / Responsibility Boundary & Local Compliance -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Responsibility</p>
        <h2>Engineering Responsibility and Local Compliance</h2>
        <p>Clear definition of engineering responsibilities is essential for overseas projects. ZhongSai provides engineering support within the agreed project scope, while local regulatory responsibilities remain with the appropriate local parties.</p>
      </div>
      <div class="coord-grid">
        <div class="reveal">
          <h4>Owner / Investor</h4>
          <p>Help clarify project technical requirements, coordinate drawings and quotation documentation, and support project planning and feasibility assessment.</p>
        </div>
        <div class="reveal reveal-delay-1">
          <h4>Engineering Company / Contractor</h4>
          <p>Detail from existing structural drawings, coordinate connection details and interfaces, produce fabrication-ready shop drawings and resolve technical issues during fabrication and erection.</p>
        </div>
        <div class="reveal reveal-delay-2">
          <h4>Local Engineer</h4>
          <p>Coordinate per local code and project requirements, provide fabrication-required documentation and support drawing review and approval. ZhongSai does not replace local licensed engineer responsibilities.</p>
        </div>
      </div>
      <div class="boundary-grid">
        <div class="reveal" style="padding: 28px 30px; background: #ecfdf5; border: 1px solid #a7f3d0;">
          <h3 style="font-size: 17px; color: #065f46; margin: 0 0 14px; display: flex; align-items: center; gap: 10px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>
            ZhongSai Provides
          </h3>
          <ul style="margin: 0; padding-left: 20px; color: #065f46; font-size: 13.5px; line-height: 2;">
            <li>Structural engineering support and coordination</li>
            <li>Drawing review and structural coordination</li>
            <li>Shop detailing and fabrication documentation</li>
            <li>Connection development and node detailing</li>
            <li>Design for manufacturing and shipping optimization</li>
            <li>Technical support during fabrication and erection</li>
            <li>Coordination with project-specified design codes</li>
          </ul>
        </div>
        <div class="reveal reveal-delay-1" style="padding: 28px 30px; background: #fef2f2; border: 1px solid #fecaca;">
          <h3 style="font-size: 17px; color: #991b1b; margin: 0 0 14px; display: flex; align-items: center; gap: 10px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
            Remains Local Responsibility
          </h3>
          <ul style="margin: 0; padding-left: 20px; color: #991b1b; font-size: 13.5px; line-height: 2;">
            <li>Local permitting and statutory approval</li>
            <li>Professional engineer stamping where required</li>
            <li>Local licensed engineer design responsibility</li>
            <li>Site civil works and foundation construction</li>
            <li>Local labor installation and erection</li>
            <li>Local MEP coordination and installation</li>
            <li>Local government regulatory compliance</li>
          </ul>
        </div>
      </div>
      <div style="margin-top: 24px; padding: 18px 20px; background: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 0 8px 8px 0;" class="reveal">
        <p style="margin: 0; color: #92400e; font-size: 13.5px; line-height: 1.7;"><strong>Important:</strong> ZhongSai provides structural engineering support, detailing and fabrication documentation within the agreed project scope. Local permitting, statutory approval and professional engineer stamping, where required, remain subject to local regulations and project responsibilities. The specific allocation of engineering responsibilities is confirmed per project contract and local regulatory requirements.</p>
      </div>
    </div>
  </section>

  <!-- 09 / Related Capabilities & Project Evidence -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">Related Capabilities</p>
        <h2>Related Capabilities and Project Evidence</h2>
        <p>Engineering and detailing work is closely integrated with manufacturing, quality control, project delivery and specific product types.</p>
      </div>
      <div class="related-links related-4col">
        {relatedLinks.map((link, i) => (
          <a href={link.href} class={`related-link-card reveal reveal-delay-${(i % 4) + 1}`}>
            <h4>{link.name}</h4>
            <p>{link.desc}</p>
            <span class="rl-arrow">Learn More →</span>
          </a>
        ))}
      </div>
      <div class="section-heading reveal" style="margin-top: 56px;">
        <p class="section-index">Real Projects</p>
        <h2>Real Projects with Detailing Support</h2>
        <p>The following projects include structural detailing, connection development and fabrication documentation from ZhongSai's engineering team.</p>
      </div>
      <div class="rp-grid">
        <a href="/en/projects/macau-city-of-dreams-phase2/" class="related-project-card reveal">
          <div class="rpc-image">
            <img src="/images/projects/overseas/macau-city-of-dreams.jpg" alt="Macau City of Dreams Phase 2" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">Overseas</span>
            <h4>Macau City of Dreams Phase 2</h4>
            <p class="rpc-location">Macau, China</p>
            <p class="rpc-data">5,000 tonnes · 40+ complex nodes</p>
