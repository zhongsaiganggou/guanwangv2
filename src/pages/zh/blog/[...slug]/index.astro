---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return data.language === 'zh' && data.status === 'published';
  });
  return posts.map((post) => {
    const slug = post.id.replace(/^zh\//, '').replace(/\.md$/, '');
    return {
      params: { slug: slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await post.render();

// 从post.id中提取slug，格式为 en/slug.md 或 zh/slug.md
const slug = post.id.replace(/^zh\//, '').replace(/\.md$/, '');

const seoTitle = post.data.seoTitle || `${post.data.title} | 中赛钢结构`;
const metaDescription = post.data.metaDescription || post.data.excerpt || '';
const canonical = `https://zhongsai-steelstructure.com/zh/blog/${slug}/`;
const h1 = post.data.h1 || post.data.title;

// Breadcrumb JSON-LD
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: 'https://zhongsai-steelstructure.com/zh/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '技术资料',
      item: 'https://zhongsai-steelstructure.com/zh/resources/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.category || '文章',
      item: canonical,
    },
  ],
};
---


<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
<BaseLayout
  title={seoTitle}
  description={metaDescription}
  canonical={canonical}
  lang="zh-CN"
>
  <main class="article-page">
    <div class="container">
      <article class="article-content-wrapper">
        <header class="article-header">
          <div class="article-breadcrumb">
            <a href="/zh/">首页</a> / <a href="/zh/resources/">技术资源</a> / <span>{post.data.category}</span>
          </div>
          <h1>{h1}</h1>
          {post.data.excerpt && <p class="article-excerpt">{post.data.excerpt}</p>}
          <div class="article-meta">
            {post.data.publishedAt && <span>发布时间：{post.data.publishedAt}</span>}
            {post.data.updatedAt && <span>更新时间：{post.data.updatedAt}</span>}
            <span>分类：{post.data.category}</span>
          </div>
        </header>

        {post.data.coverImage && (
          <div class="article-cover">
            <img src={post.data.coverImage} alt={post.data.coverImageAlt || post.data.title} loading="lazy" />
          </div>
        )}

        <div class="article-body">
          <Content />
        </div>

        <footer class="article-footer">
          <div class="article-cta">
            <h2>有项目需求？</h2>
            <p>发送您的图纸或项目需求，中赛将为您进行专业评估。</p>
            <a href="/zh/contact/#quote-form" class="btn btn-primary">提交项目需求</a>
          </div>
        </footer>
      </article>
    </div>
  </main>
</BaseLayout>

<style>
.article-page {
  padding: 60px 0;
}
.article-content-wrapper {
  max-width: 800px;
  margin: 0 auto;
}
.article-breadcrumb {
  font-size: 0.85rem;
  color: #888;
  margin-bottom: 16px;
}
.article-breadcrumb a {
  color: #0a3d62;
  text-decoration: none;
}
.article-header h1 {
  font-size: 2rem;
  color: #0a3d62;
  margin-bottom: 16px;
  line-height: 1.3;
}
.article-excerpt {
  font-size: 1.1rem;
  color: #555;
  margin-bottom: 20px;
  line-height: 1.6;
}
.article-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  font-size: 0.85rem;
  color: #888;
  margin-bottom: 32px;
  padding-bottom: 20px;
  border-bottom: 1px solid #eee;
}
.article-cover {
  margin-bottom: 32px;
  border-radius: 8px;
  overflow: hidden;
}
.article-cover img {
  width: 100%;
  height: auto;
}
.article-body {
  font-size: 1rem;
  line-height: 1.8;
  color: #333;
}
.article-body :global(h2) {
  font-size: 1.5rem;
  color: #0a3d62;
  margin: 32px 0 16px;
}
.article-body :global(h3) {
  font-size: 1.2rem;
  color: #0a3d62;
  margin: 24px 0 12px;
}
.article-body :global(p) {
  margin-bottom: 16px;
}
.article-body :global(ul), .article-body :global(ol) {
  margin-bottom: 16px;
  padding-left: 24px;
}
.article-body :global(li) {
  margin-bottom: 8px;
}
.article-body :global(table) {
  width: 100%;
  border-collapse: collapse;
  margin: 20px 0;
}
.article-body :global(th), .article-body :global(td) {
  border: 1px solid #ddd;
  padding: 10px 12px;
  text-align: left;
}
.article-body :global(th) {
  background: #f5f5f5;
}
.article-body :global(blockquote) {
  border-left: 4px solid #0a3d62;
  padding-left: 16px;
  margin: 20px 0;
  color: #555;
  font-style: italic;
}
.article-body :global(img) {
  max-width: 100%;
  height: auto;
  border-radius: 6px;
  margin: 16px 0;
}
.article-body :global(a) {
  color: #0a3d62;
  text-decoration: underline;
}
.article-footer {
  margin-top: 48px;
  padding-top: 32px;
  border-top: 1px solid #eee;
}
.article-cta {
  background: #f8f9fa;
  padding: 32px;
  border-radius: 8px;
  text-align: center;
}
.article-cta h2 {
  color: #0a3d62;
  margin-bottom: 12px;
}
.article-cta p {
  color: #666;
  margin-bottom: 20px;
}
@media (max-width: 768px) {
  .article-page {
    padding: 32px 0;
  }
  .article-header h1 {
    font-size: 1.5rem;
  }
  .article-body :global(h2) {
    font-size: 1.3rem;
  }
}
</style>
