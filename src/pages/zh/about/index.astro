---
// ZhongSai V2 - Chinese About Us Page
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/hub.css';
import '../../../styles/detail.css';

const lang = 'zh';
const title = '中赛钢构｜钢结构工程、制造与出口交付';
const description = '中赛钢构是钢结构工程、制造与出口交付供应商。东莞与惠州制造基地，提供设计深化、制造、质量控制、包装装柜、出口交付及安装技术支持。';

const coreFacts = [
  { num: '15+年', label: '出口经验' },
  { num: '10万㎡', label: '生产基地' },
  { num: '10万吨', label: '年产能' },
  { num: '300+', label: '一线工人' }
];

const services = [
  {
    num: '01',
    title: '设计与深化支持',
    desc: '根据项目需求和确认图纸，进行结构设计协调与加工图深化支持。'
  },
  {
    num: '02',
    title: '钢结构生产加工',
    desc: '切割、组立、焊接、矫正、钻孔及异形构件加工，按项目图纸组织生产。'
  },
  {
    num: '03',
    title: '钢构件及材料供应',
    desc: '按需供应加工钢梁、钢柱、桁架、支撑、次结构及屋面墙面围护系统。'
  },
  {
    num: '04',
    title: '包装与装柜',
    desc: '构件标识、装箱清单和装柜方案，按构件类型和出口运输要求组织。'
  },
  {
    num: '05',
    title: '出口单证与物流协调',
    desc: '出口单证支持与物流协调，按项目范围组织海外项目交付。'
  },
  {
    num: '06',
    title: '海外安装技术指导',
    desc: '提供安装图纸、视频资料和技术指导，支持客户或当地施工团队进行现场安装。'
  }
];

const certifications = [
  {
    title: 'ISO 9001 质量管理体系',
    desc: '钢结构加工制造与项目协调质量管理体系认证。',
    image: '/images/certifications/iso-9001-quality.jpg',
    certNo: 'NOA2502483',
    valid: '2025 - 2028'
  },
  {
    title: 'ISO 14001 环境管理体系',
    desc: '钢结构制造运营环境管理体系认证。',
    image: '/images/certifications/iso-14001-environmental.jpg',
    certNo: 'NOA2502482',
    valid: '2025 - 2028'
  },
  {
    title: 'ISO 45001 职业健康安全',
    desc: '生产设施职业健康安全管理体系认证。',
    image: '/images/certifications/iso-45001-occupational.jpg',
    certNo: 'NOA2502481',
    valid: '2025 - 2028'
  },
  {
    title: '欧盟CE认证 (EN 1090)',
    desc: '钢结构构件CE认证，执行等级最高EXC2，符合欧盟建筑产品法规。',
    image: '/images/certifications/en-1090-ce.jpg',
    certNo: '1381-CPR-902',
    valid: '2024 - 持续有效'
  },
  {
    title: 'ISO 3834-2 焊接质量',
    desc: '金属材料熔焊质量综合要求认证，SGS认证。',
    image: '/images/certifications/iso-3834-welding.jpg',
    certNo: '24/1028-3834',
    valid: '2024 - 2027'
  },
  {
    title: '马来西亚 CIDB IBS',
    desc: '马来西亚市场工业化建筑体系评估认证，涵盖金属框架和钢结构构件。',
    image: '/images/certifications/malaysia-cidb-ibs.jpg',
    certNo: 'IBS231/039',
    valid: '2026 - 2027'
  }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/manufacturing/real/factory-aerial-panorama.jpg')"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <div class="hub-breadcrumb">
        <a href="/zh/">首页</a><span>/</span><span>关于中赛</span>
      </div>
      <p class="eyebrow">关于中赛</p>
      <h1>面向海外项目的钢结构制造与出口供应</h1>
      <p class="lead">中赛钢构是中国钢结构制造与出口供应商，为海外工业厂房、仓库及工程钢结构项目提供设计深化、生产加工、包装装柜、出口协调及海外安装技术指导。</p>
    </div>
  </section>

  <!-- 01: Who We Are -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">01 · 中赛定位</div>
        <h2>专注海外项目的钢结构制造与出口供应商</h2>
      </div>
      <div class="about-intro">
        <p>中赛钢构为海外项目业主、工程公司、承包商和采购团队提供钢结构制造与出口供应服务。</p>
        <p>我们的工作重点是将确认的项目需求和图纸转化为可出口交付的加工钢构件。</p>
        <p>根据项目范围，中赛可提供设计深化、生产加工、构件供应、包装装柜、出口单证协调及海外安装技术指导。</p>
        <p><strong>当地安装及施工由客户或当地施工团队负责。</strong></p>
      </div>
      <div class="about-facts">
        {coreFacts.map(fact => (
          <div class="about-fact-card">
            <div class="about-fact-num">{fact.num}</div>
            <div class="about-fact-label">{fact.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 02: Company Facts -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">02 · 公司概况</div>
        <h2>公司基本信息</h2>
      </div>
      <div class="company-facts-grid">
        <div class="company-fact-item">
          <span class="cf-label">品牌名称</span>
          <span class="cf-value">中赛钢构 / ZhongSai Steel Structure</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">核心业务</span>
          <span class="cf-value">钢结构设计深化、制造加工与出口供应</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">制造基地</span>
          <span class="cf-value">广东东莞 / 惠州生产基地</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">设计团队</span>
          <span class="cf-value">结构设计与深化团队</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">交付团队</span>
          <span class="cf-value">项目交付与出口协调团队</span>
        </div>
        <div class="company-fact-item">
          <span class="cf-label">出口市场</span>
          <span class="cf-value">东南亚、中东、非洲、南美等60+国家和地区</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 03: Real Manufacturing -->
  <section class="detail-section dark">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">03 · 制造基地</div>
        <h2>真实工厂 · 真实制造</h2>
        <p>以下为生产基地真实加工过程照片，覆盖从钢材下料到表面处理的主要工序。</p>
      </div>
      <div class="factory-main">
        <img src="/images/manufacturing/real/factory-overview-9819.jpg" alt="中赛钢构工厂生产车间全景" width="1320" height="420" loading="lazy">
      </div>
      <div class="factory-grid">
        <figure class="factory-tile">
          <img src="/images/manufacturing/real/cutting-prep-9809.jpg" alt="CNC数控切割与钢材准备" width="400" height="300" loading="lazy">
          <figcaption>切割下料</figcaption>
        </figure>
        <figure class="factory-tile">
          <img src="/images/manufacturing/real/welding-9820.jpg" alt="钢结构焊接加工" width="400" height="300" loading="lazy">
          <figcaption>焊接</figcaption>
        </figure>
        <figure class="factory-tile">
          <img src="/images/manufacturing/real/assembly-welding-9821.jpg" alt="钢构件组立加工车间" width="400" height="300" loading="lazy">
          <figcaption>组立加工</figcaption>
        </figure>
        <figure class="factory-tile">
          <img src="/images/components/finished-coated-components.jpg" alt="成品涂层钢构件表面处理" width="400" height="300" loading="lazy">
          <figcaption>表面处理与成品</figcaption>
        </figure>
      </div>
      <p class="factory-caption">约10万㎡生产基地，覆盖切割、组立、焊接、表面处理、质量检验、构件编号与包装装柜等出口交付关键环节。</p>
    </div>
  </section>

  <!-- 04: What We Support -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">04 · 服务范围</div>
        <h2>中赛提供哪些支持</h2>
      </div>
      <div class="requirement-grid">
        {services.map(svc => (
          <div class="requirement-card">
            <div class="req-icon">{svc.num}</div>
            <h3>{svc.title}</h3>
            <p>{svc.desc}</p>
          </div>
        ))}
      </div>

      <div class="geo-boundary">
        <div class="geo-box include">
          <h4>中赛负责</h4>
          <ul>
            <li>项目需求协调</li>
            <li>设计深化支持</li>
            <li>制造加工</li>
            <li>钢构件及材料供应</li>
            <li>包装装柜</li>
            <li>出口单证支持与物流协调</li>
            <li>海外安装技术指导</li>
          </ul>
        </div>
        <div class="geo-box exclude">
          <h4>客户 / 当地施工团队负责</h4>
          <ul>
            <li>当地土建与基础施工</li>
            <li>现场安装与人工组织</li>
            <li>当地审批及许可（如适用）</li>
            <li>现场内陆运输与吊装</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 05: Quality & Certifications -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">05 · 质量认证</div>
        <h2>质量体系与认证</h2>
        <p>证书编号与有效期如下，证书主体关系请参考各证书详情。</p>
      </div>
      <div class="cert-grid">
        {certifications.map(cert => (
          <div class="cert-card">
            <div class="cert-card-image">
              <img src={cert.image} alt={cert.title + ' 证书'} loading="lazy">
            </div>
            <div class="cert-card-content">
              <h3>{cert.title}</h3>
              <p>{cert.desc}</p>
              <div class="cert-card-meta">
                <span>证书编号：{cert.certNo}</span>
                <span>有效期：{cert.valid}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="cert-note">完整核验文件可在符合条件的项目沟通中提供。</p>
    </div>
  </section>

  <!-- 06: Representative Projects -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">06 · 代表项目</div>
        <h2>代表性项目</h2>
        <p>以下项目的钢结构构件经过中赛设计深化、制造加工和出口交付。</p>
      </div>
      <div class="rp-grid">
        <a href="/zh/projects/singapore-airport-t2-connect/" class="related-project-card">
          <div class="rpc-image">
            <img src="/images/projects/overseas/singapore-airport-t2-connect.jpg" alt="新加坡樟宜机场T2连接项目" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">海外项目</span>
            <h4>新加坡樟宜机场T2连接</h4>
            <p class="rpc-location">新加坡</p>
            <p class="rpc-data">约4,600吨 · 209支Kingpost</p>
            <p class="rpc-scope"><span>中赛范围:</span> 钢结构设计深化、制造与出口供应</p>
          </div>
        </a>
        <a href="/zh/projects/macau-londoner/" class="related-project-card">
          <div class="rpc-image">
            <img src="/images/projects/overseas/macau-londoner.jpg" alt="澳门伦敦人项目" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">海外项目</span>
            <h4>澳门伦敦人</h4>
            <p class="rpc-location">中国澳门</p>
            <p class="rpc-data">约8,000吨 · 复杂异形结构</p>
            <p class="rpc-scope"><span>中赛范围:</span> 钢结构设计深化、制造与供应</p>
          </div>
        </a>
        <a href="/zh/projects/zhanjiang-logistics-port/" class="related-project-card">
          <div class="rpc-image">
            <img src="/images/projects/shenzhen-international-zhanjiang-logistics-port-aerial-rendering.jpg" alt="湛江综合物流港项目" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">物流仓储</span>
            <h4>湛江综合物流港</h4>
            <p class="rpc-location">广东湛江</p>
            <p class="rpc-data">约10万㎡ · 约3,160吨</p>
            <p class="rpc-scope"><span>中赛范围:</span> 钢结构制造与加工供应</p>
          </div>
        </a>
      </div>
      <div class="rp-more">
        <a href="/zh/projects/" class="btn btn-secondary">查看全部项目案例 →</a>
      </div>
    </div>
  </section>

  <!-- 07: FAQ -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">07 · 常见问题</div>
        <h2>关于中赛的常见问题</h2>
      </div>
      <div class="detail-faq">
        <details class="faq-item">
          <summary>中赛是钢结构制造商还是贸易公司？</summary>
          <p>中赛是钢结构项目供应商，拥有设计深化团队、广东制造基地和项目交付团队。公司同时承担出口、项目管理和制造协调职能，不是单纯的钢材贸易商。</p>
        </details>
        <details class="faq-item">
          <summary>中赛的制造基地在哪里？</summary>
          <p>中赛钢结构构件在广东东莞和惠州生产基地加工制造，生产基地面积约10万㎡，年产能约10万吨。</p>
        </details>
        <details class="faq-item">
          <summary>中赛有自己的设计团队吗？</summary>
          <p>中赛设有结构设计与深化团队，负责结构设计协调、节点深化、加工图处理和制造/运输/安装接口协调。具体设计责任根据项目合同和当地法规确定。</p>
        </details>
        <details class="faq-item">
          <summary>谁负责海外项目的交付和出口？</summary>
          <p>项目交付团队负责生产进度协调、构件编号、包装方案、装柜规划、出口单证支持和发运协调。中赛的交付能力是钢结构项目交付协调，不是国际货代业务。</p>
        </details>
        <details class="faq-item">
          <summary>中赛出口到哪些国家？</summary>
          <p>中赛钢结构项目出口覆盖东南亚、中东、非洲、南美等60+国家和地区，包括新加坡、马来西亚、印度尼西亚、沙特、尼日利亚、巴西等市场。</p>
        </details>
        <details class="faq-item">
          <summary>客户可以参观工厂吗？</summary>
          <p>符合条件的项目客户可以预约参观中赛广东生产基地，进行制造能力和质量控制核验。请提前联系项目团队安排工厂访问。</p>
        </details>
        <details class="faq-item">
          <summary>中赛持有哪些认证？</summary>
          <p>中赛及制造基地持有ISO 9001质量管理体系、ISO 14001环境管理体系、ISO 45001职业健康安全、欧盟CE认证（EN 1090 EXC2）、ISO 3834-2焊接质量、马来西亚CIDB IBS等认证。证书主体关系请参考证书详情。</p>
        </details>
        <details class="faq-item">
          <summary>中赛提供当地施工和安装吗？</summary>
          <p>中赛提供设计深化、制造加工、出口供应和安装技术指导。当地土建、实际施工和现场安装通常由客户或当地施工团队负责。特定项目可根据合同范围安排技术人员现场支持。</p>
        </details>
      </div>
    </div>
  </section>

  <!-- 08: Quote -->
  <section class="detail-section dark" id="quote">
    <div class="container">
      <div class="section-heading">
        <div class="section-index">08 · 提交需求</div>
        <h2>已有图纸或项目需求？</h2>
      </div>
      <div class="quote-intro">
        <p>已有图纸或BOQ，可提交资料进行初步项目评估。</p>
        <p>如果暂时没有图纸，可提供项目国家、建筑类型、用途及已有尺寸信息。</p>
      </div>
      <QuoteForm lang="zh" />
    </div>
  </section>
</BaseLayout>

<style>
/* Intro */
.about-intro {
  max-width: 800px;
  margin: 0 auto 56px;
}
.about-intro p {
  margin-bottom: 16px;
  font-size: 16px;
  line-height: 1.8;
  color: #475569;
}

/* Core facts */
.about-facts {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  max-width: 1000px;
  margin: 0 auto;
}
.about-fact-card {
  padding-top: 14px;
  border-top: 2px solid #f59e0b;
}
.about-fact-num {
  font-size: 2.2rem;
  font-weight: 800;
  line-height: 1;
  color: #0f172a;
  margin-bottom: 10px;
}
.about-fact-label {
  font-size: 0.9rem;
  color: #64748b;
}

/* Factory gallery */
.factory-main {
  border-radius: 2px;
  overflow: hidden;
  margin-bottom: 16px;
}
.factory-main img {
  width: 100%;
  height: 420px;
  object-fit: cover;
  display: block;
}
.factory-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.factory-tile {
  position: relative;
  margin: 0;
  border-radius: 2px;
  overflow: hidden;
  background: #0b1720;
}
.factory-tile img {
  width: 100%;
  height: 180px;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
.factory-tile:hover img {
  transform: scale(1.05);
}
.factory-tile figcaption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24px 12px 8px;
  font-size: 12.5px;
  color: #ffffff;
  background: linear-gradient(180deg, rgba(8,15,28,0) 0%, rgba(8,15,28,0.85) 100%);
}
.factory-caption {
  margin-top: 24px;
  font-size: 14px;
  line-height: 1.75;
  color: rgba(255,255,255,0.72);
}

/* Cert grid */
.cert-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.cert-card {
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 2px;
  overflow: hidden;
}
.cert-card-image {
  height: 200px;
  overflow: hidden;
  background: #f5f5f5;
}
.cert-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
}
.cert-card-content {
  padding: 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.cert-card-content h3 {
  font-size: 15px;
  color: #0f172a;
  margin: 0 0 8px;
}
.cert-card-content p {
  font-size: 13px;
  line-height: 1.6;
  color: #64748b;
  margin: 0 0 12px;
}
.cert-card-meta {
  margin-top: auto;
  padding-top: 12px;
  border-top: 1px solid #e5e7eb;
  display: flex;
