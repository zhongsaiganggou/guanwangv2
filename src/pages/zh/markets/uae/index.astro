---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/detail.css';

const title = '阿联酋钢结构供应商与出口交付｜中赛钢构';
const description = '中赛钢构为阿联酋（UAE）项目提供钢结构工程协调、深化设计、制造、质检、编号包装、装柜与出口单证支持，并配合当地顾问与承包商完成交付。';
const lang = 'zh';
const whatsapp = 'https://wa.me/8613192007378?text=%E4%BD%A0%E5%A5%BD%EF%BC%8C%E6%88%91%E6%9C%89%E4%B8%80%E4%B8%AA%E9%98%BF%E8%81%94%E9%85%8B%E9%92%A2%E7%BB%93%E6%9E%84%E9%A1%B9%E7%9B%AE%E6%83%B3%E5%92%A8%E8%AF%A2%E3%80%82';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- 1. Hero / 直接回答 -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/manufacturing/real/factory-aerial-panorama.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">阿联酋市场</span>
      <h1>阿联酋钢结构项目供应与出口交付</h1>
      <p class="lead">中赛钢构是一家位于中国的钢结构制造商，为阿联酋（UAE）项目提供工程协调、深化设计、制造加工、质量控制、构件编号、包装、装柜、出口单证协调以及安装技术指导。当地许可、顾问审批、基础与土建工程以及现场实体安装，除非合同另有约定，通常由项目当地各方负责。</p>
      <div class="detail-hero-actions">
        <a href="/zh/contact/#quote-form" class="btn btn-primary">提交项目图纸</a>
        <a href={whatsapp} class="btn uae-btn-ghost" target="_blank" rel="noopener">沟通项目需求</a>
      </div>
    </div>
  </section>

  <!-- 2. 中赛可提供什么 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">中赛可提供的支持</p>
        <h2>面向阿联酋项目的工程、制造与出口支持</h2>
        <p>由一家中国供应商对整套钢结构负责，与您的当地顾问和承包商协同——我们配合当地团队，而不是取代他们。</p>
      </div>
      <div class="uae-cap-list">
        <div class="uae-cap-item">
          <span class="uae-cap-num">01</span>
          <div>
            <h3>工程协调</h3>
            <p>在投产前审核项目需求、设计准则与结构意图，并就钢结构部分与建筑师、注册结构工程师及当地顾问协同。</p>
          </div>
        </div>
        <div class="uae-cap-item">
          <span class="uae-cap-num">02</span>
          <div>
            <h3>深化设计与加工图</h3>
            <p>提供节点设计支持、Tekla 三维建模、加工图、安装图、材料表与螺栓清单，供顾问审批与现场使用。</p>
          </div>
        </div>
        <div class="uae-cap-item">
          <span class="uae-cap-num">03</span>
          <div>
            <h3>制造加工</h3>
            <p>在中赛制造基地完成钢柱、钢梁、桁架、檩条、支撑与板件的数控切割、钻孔、组立与焊接。</p>
          </div>
        </div>
        <div class="uae-cap-item">
          <span class="uae-cap-num">04</span>
          <div>
            <h3>质量控制与表面处理</h3>
            <p>来料核验、尺寸检验、焊接质检、抛丸、涂装与干膜厚度检测，可提供材质单与检验记录供顾问审核。</p>
          </div>
        </div>
        <div class="uae-cap-item">
          <span class="uae-cap-num">05</span>
          <div>
            <h3>构件编号与包装</h3>
            <p>每件构件按安装图编号，再分类打包，确保经海运后仍可被当地安装团队在现场清晰识别。</p>
          </div>
        </div>
        <div class="uae-cap-item">
          <span class="uae-cap-num">06</span>
          <div>
            <h3>装柜与出口单证</h3>
            <p>针对超长、超重构件制定装柜方案，提供装箱单并协调出口单证，配合您的进口商与货代。</p>
          </div>
        </div>
        <div class="uae-cap-item">
          <span class="uae-cap-num">07</span>
          <div>
            <h3>安装技术指导</h3>
            <p>提供安装图、螺栓信息与技术答疑（远程支持，或按另行约定派员现场指导）；实体安装由当地承包商完成。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. 典型项目类型 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">项目应用</p>
        <h2>阿联酋项目常见钢结构建筑类型</h2>
        <p>我们按建筑类型与用途供货，以下是阿联酋工业与物流项目的典型钢结构建筑类型。</p>
      </div>
      <div class="uae-app-grid">
        <div class="uae-app-row">
          <div>
            <h3>工业厂房</h3>
            <p>单跨/多跨生产厂房，含带行车（吊车）厂房。</p>
          </div>
          <a class="uae-arrow" href="/zh/steel-workshop/">工业厂房方案 →</a>
        </div>
        <div class="uae-app-row">
          <div>
            <h3>仓储与物流</h3>
            <p>大跨度配送中心、存储仓库与物流设施。</p>
          </div>
          <a class="uae-arrow" href="/zh/steel-warehouse/">仓储方案 →</a>
        </div>
        <div class="uae-app-row">
          <div>
            <h3>制造工厂</h3>
            <p>带设备支架、夹层与重载楼面的厂房建筑。</p>
          </div>
        </div>
        <div class="uae-app-row">
          <div>
            <h3>冷库与食品加工</h3>
            <p>适用于冷链与食品加工的保温钢结构围护。</p>
          </div>
        </div>
        <div class="uae-app-row">
          <div>
            <h3>设备平台</h3>
            <p>设备平台、管廊、检修通道与工业支撑钢结构。</p>
          </div>
        </div>
        <div class="uae-app-row">
          <div>
            <h3>商业与公共钢结构</h3>
            <p>展厅、体育设施、农业及其他工程化钢结构建筑。</p>
          </div>
          <a class="uae-arrow" href="/zh/agricultural-steel-buildings/">农业钢结构 →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. 工程要点 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">工程背景</p>
        <h2>阿联酋项目的工程考虑</h2>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/engineering/tekla-model.jpg" alt="中赛钢构工程部门使用 Tekla 进行钢结构三维建模与深化" loading="lazy" width="720" height="360" />
        </div>
        <div class="itb-content">
          <h3>按项目逐项确认，投产前锁定参数</h3>
          <p>阿联酋夏季气温极高、沿海湿度大、存在风沙与风荷载，沿海地区还面临氯化物腐蚀环境。这些条件会影响保温、防腐涂装体系以及节点与围护做法，但所有取值都必须依据项目实际位置和适用设计准则确认。</p>
          <ul>
            <li>风荷载、地震作用等按项目图纸及当地顾问指定的规范/标准取值</li>
            <li>沿海氯化物环境通过合适的表面处理、涂装或镀锌应对</li>
            <li>屋面墙面保温与通风按高温环境选用</li>
            <li>防火要求按项目主管部门与建筑使用性质确定</li>
            <li>跨度、檐口高度与行车荷载决定构件与节点设计</li>
          </ul>
          <p style="margin-top:16px;">我们不套用固定参数。荷载、材料、防火与防腐要求均以审批图纸和当地注册工程师确认为准，再放行投产。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. 制造与质检证据 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">制造与质检证据</p>
        <h2>在中赛制造基地完成制造与检验</h2>
        <p>以下照片为中赛制造基地的制造与质检环节，展示的是中赛通用制造与质检能力，并非某个阿联酋具体项目。</p>
      </div>
      <div class="uae-evidence-grid">
        <figure class="uae-ev">
          <img src="/images/manufacturing/real/assembly-welding-9821.jpg" alt="中赛中国制造基地内钢结构组立与焊接作业" loading="lazy" width="480" height="220" />
          <figcaption>钢结构组立与焊接——中赛制造能力</figcaption>
        </figure>
        <figure class="uae-ev">
          <img src="/images/manufacturing/real/qc-inspection.jpg" alt="对加工完成的钢构件进行尺寸质量检验" loading="lazy" width="480" height="220" />
          <figcaption>出厂前尺寸检验——中赛质量控制</figcaption>
        </figure>
        <figure class="uae-ev">
          <img src="/images/manufacturing/real/coating-thickness.jpg" alt="对涂装后的钢结构进行干膜厚度检测" loading="lazy" width="480" height="220" />
          <figcaption>表面处理与涂装后的干膜厚度检测</figcaption>
        </figure>
      </div>
      <p class="uae-cert-line">质量按文件化流程管理，对齐 ISO 9001 质量管理体系，焊接质量参照 ISO 3834 原则；项目需要时可按 EN 1090 提供 CE 标识钢结构制造。材质单、焊接记录与检验报告可纳入项目文件包，供顾问审核。</p>
    </div>
  </section>

  <!-- 6. 包装、装柜与出口交付 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">包装、装柜与交付</p>
        <h2>从中赛制造基地到阿联酋港口</h2>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/export/container-loading-256_web.jpg" alt="中赛将编号包装好的钢构件装入海运集装箱用于出口" loading="lazy" width="720" height="360" />
        </div>
        <div class="itb-content">
          <h3>编号、打包、装柜，海运交付</h3>
          <p>构件按安装图编号、分类打包防护，并依据装柜方案装入集装箱，妥善处理超长、超重构件。我们协调出口所需单证，配合您的进口商与货代。</p>
          <ul>
            <li>阿联酋项目可根据物流方案经杰贝阿里港（Jebel Ali，迪拜）或哈利法港（Khalifa Port，阿布扎比）等主要港口到港</li>
            <li>提供装箱单、装柜记录与构件编号，便于现场识别</li>
            <li>商务与运输单证按买方贸易条款协调</li>
            <li>阿联酋境内清关与内陆运输通常由买方或当地各方安排</li>
          </ul>
          <p style="margin-top:16px;">完整流程见<a href="/zh/export-delivery/">出口交付</a>与<a href="/zh/manufacturing-quality/">制造与质量</a>页面。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. 合规与责任边界 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">合规与责任分工</p>
        <h2>审批要求，以及各方职责</h2>
        <p>符合性与审批要求取决于所在酋长国、项目类型、产品分类以及主管部门。</p>
      </div>
      <p style="max-width:900px;color:#475569;line-height:1.8;font-size:15px;">在联邦层面，钢铁产品可能纳入工业与先进技术部（MoIAT，原 ESMA）主管的钢铁法规，适用范围内的产品使用 ECAS 标志。在迪拜，建筑工程依据《迪拜建筑规范》（Dubai Building Code）与迪拜市政局（Dubai Municipality）流程管理，部分区域的最终设计审批由迪拜发展局（Dubai Development Authority）负责。某一产品是否需要注册、第三方认证或材料批准，由项目业主、进口商以及当地注册顾问或结构工程师确认。中赛提供制造文件、材质证书、焊接/质检记录与加工图以支持审批；中赛不是当地持牌工程师，也不担任许可持有人。</p>
      <div class="uae-note">具体符合性与审批要求取决于酋长国、项目类型、产品分类及当地主管部门要求。项目业主、进口商与当地注册顾问应在制造与发运前确认适用要求。</div>
      <div class="geo-boundary" style="margin-top:32px;">
        <div class="geo-box include">
          <h4>中赛可提供</h4>
          <ul>
            <li>工程协调</li>
            <li>深化、加工图与节点图</li>
            <li>钢结构制造加工</li>
            <li>焊接与尺寸质量控制</li>
            <li>表面处理</li>
            <li>构件编号与包装</li>
            <li>装柜</li>
            <li>出口单证协调</li>
            <li>安装技术指导</li>
          </ul>
        </div>
        <div class="geo-box exclude">
          <h4>通常由当地各方负责</h4>
          <ul>
            <li>当地许可</li>
            <li>注册顾问/工程师审批</li>
            <li>向主管部门报审</li>
            <li>基础工程与土建</li>
            <li>清关</li>
            <li>内陆运输</li>
            <li>当地用工</li>
            <li>现场实体安装</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. 报价所需资料 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">报价资料清单</p>
        <h2>准确报价需要哪些信息</h2>
        <p>钢结构报价必须针对具体项目。您提供的信息越完整，工程与价格评审越准确；没有完整图纸也可以先启动沟通。</p>
      </div>
      <div class="uae-table-wrap">
        <table class="uae-table">
          <thead>
            <tr><th>信息项</th><th>需要提供的内容</th></tr>
          </thead>
          <tbody>
            <tr><td>项目位置/酋长国</td><td>所在酋长国与场地位置，注明沿海或内陆</td></tr>
            <tr><td>建筑用途</td><td>厂房、仓库、工厂、冷库、设备平台等</td></tr>
            <tr><td>长度</td><td>建筑总长与跨数（开间数）</td></tr>
            <tr><td>宽度</td><td>总宽度/跨度布置</td></tr>
            <tr><td>檐口高度</td><td>所需净空或檐口高度</td></tr>
            <tr><td>是否大跨度</td><td>是否允许设置中柱</td></tr>
            <tr><td>行车要求</td><td>行车吨位、起升高度与数量（如有）</td></tr>
            <tr><td>设计荷载</td><td>按适用标准的风荷载、地震作用等</td></tr>
            <tr><td>屋面/墙面系统</td><td>单板或保温夹芯板、板型偏好</td></tr>
            <tr><td>防火要求</td><td>耐火/防火保护要求（如有规定）</td></tr>
            <tr><td>腐蚀环境</td><td>沿海/工业暴露等级与预期防腐年限</td></tr>
            <tr><td>适用规范/顾问要求</td><td>设计标准、材料等级与审批要求</td></tr>
            <tr><td>图纸</td><td>建筑/结构图或草图（如有）</td></tr>
            <tr><td>交付计划</td><td>要求的发运或到场时间</td></tr>
            <tr><td>目的港</td><td>如杰贝阿里港或哈利法港，以及贸易条款</td></tr>
          </tbody>
        </table>
      </div>

      <div class="quote-info-grid" style="margin-top:40px;">
        <div class="quote-info-card drawing">
          <h4>已有图纸</h4>
          <ul>
            <li>提交建筑图与结构图</li>
            <li>注明荷载、行车与防火要求</li>
            <li>我方评审用钢量、深化范围与交期</li>
          </ul>
        </div>
        <div class="quote-info-card no-drawing">
          <h4>暂无完整图纸</h4>
          <ul>
            <li>提供尺寸、用途与项目位置</li>
            <li>说明行车、围护与工期需求</li>
            <li>我方提出结构方案供评审</li>
          </ul>
        </div>
      </div>
      <div style="text-align:center;">
        <a href="/zh/contact/#quote-form" class="btn btn-primary">提交项目图纸或需求</a>
      </div>
    </div>
  </section>

  <!-- 9. 常见问题 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading" style="text-align:center;">
        <p class="section-index" style="justify-content:center;">常见问题</p>
        <h2>阿联酋项目常见问题</h2>
      </div>
      <div class="uae-faq detail-faq">
        <details>
          <summary>你们是钢结构制造商还是阿联酋当地承包商？</summary>
          <p>中赛是位于中国的钢结构制造商与出口供应商，负责工程、深化、制造、检验、包装与出口交付协调，并提供安装技术指导。我们不是阿联酋注册承包商；当地许可、土建与实体安装由您的当地各方负责。</p>
        </details>
        <details>
          <summary>可以把钢结构发到阿联酋吗？</summary>
          <p>可以。加工好的钢结构装柜海运，可根据您的物流方案经杰贝阿里港（迪拜）或哈利法港（阿布扎比）等到港。清关与内陆运输通常由买方或其当地代理安排，贸易条款在合作前约定。</p>
        </details>
        <details>
          <summary>报价需要提供哪些信息？</summary>
          <p>项目位置与酋长国、建筑用途、长度、宽度、檐口高度、是否大跨度、行车要求、设计荷载、屋面/墙面系统、防火与防腐要求、适用规范或顾问要求、图纸（如有）、工期与目的港。即使没有完整图纸，也可以先联系我们共同明确方案。</p>
        </details>
        <details>
          <summary>中赛能否按顾问审批通过的图纸加工？</summary>
          <p>可以。我方可依据当地顾问或主管部门审批的结构设计与图纸制造，并出具加工图与节点图供审核。最终设计审批与签署仍由当地注册工程师或主管部门完成，我方提供评审所需的文件与记录。</p>
        </details>
        <details>
          <summary>中赛在阿联酋提供当地安装吗？</summary>
