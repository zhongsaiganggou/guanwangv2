---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const title = '全球市场与出口项目｜钢结构出口服务国家与地区｜中赛钢构';
const description = '中赛钢构钢结构出口服务60+国家和地区，重点市场包括东南亚、中东和非洲。了解中赛在各市场的项目经验和交付能力。';
const lang = 'zh';
---

<BaseLayout title={title} description={description} lang={lang}>
  <section class="detail-hero" style="min-height: 50vh;">
    <div class="detail-hero-bg" style="background-image: url('/images/company/factory-aerial-panorama.jpg');"></div>
    <div class="container">
      <div class="detail-hero-content">
        <h1>全球钢结构出口市场</h1>
        <p>中赛钢构为海外项目提供钢结构设计深化、制造加工、出口交付及安装技术指导，服务60+国家和地区。</p>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">重点市场</p>
        <h2>我们服务的主要海外市场</h2>
      </div>
      <div class="project-grid">
        <a href="/zh/markets/singapore/" class="project-card">
          <div class="project-img" style="background-image: url('/images/projects/overseas/singapore-cr101-depot.jpg');"></div>
          <div class="project-body">
            <span class="project-type">东南亚</span>
            <h3>新加坡</h3>
            <p class="project-scope">LTA地铁站、樟宜机场货运中心等项目经验，熟悉新加坡规范和质量要求。</p>
          </div>
        </a>
      </div>
      <div style="margin-top: 32px; padding: 24px; background: #f8fafc; border-radius: 8px;">
        <h3>其他服务市场</h3>
        <p style="color: #666; margin-top: 8px;">中赛钢构还服务于东南亚其他国家、中东、非洲等60+国家和地区的钢结构项目。具体项目经验和交付能力请通过询盘沟通。</p>
      </div>
    </div>
  </section>

  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">项目交付方式</p>
        <h2>从中国工厂到海外项目现场</h2>
      </div>
      <div class="capability-grid">
        <div class="cap-card">
          <h3>设计深化</h3>
          <p>自有设计团队按项目图纸和当地规范进行结构深化。</p>
        </div>
        <div class="cap-card">
          <h3>制造检验</h3>
          <p>10万㎡制造基地，可配合RTO驻厂和第三方检验。</p>
        </div>
        <div class="cap-card">
          <h3>出口交付</h3>
          <p>科学装柜、构件编号、出口单证和到港交付协调。</p>
        </div>
        <div class="cap-card">
          <h3>安装技术指导</h3>
          <p>安装图纸和技术答疑，配合当地施工团队。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section quote-cta-section">
    <div class="container" style="text-align: center;">
      <h2>您的项目在哪个国家？</h2>
      <p style="margin: 16px 0 24px; color: #666;">告知项目地点和需求，中赛团队将提供针对性的技术和交付方案。</p>
      <a href="/zh/contact/#quote-form" class="btn btn-primary btn-large">咨询项目需求</a>
    </div>
  </section>
</BaseLayout>
