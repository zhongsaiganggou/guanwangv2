---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
const title = '泰国钢结构项目供应｜设计深化、制造与出口交付｜中赛钢构';
const description = '中赛钢构为泰国项目提供钢结构设计深化、制造加工、出口交付及安装技术指导，服务工业厂房、仓储物流和农业设施。';
const lang = 'zh';
---

<BaseLayout title={title} description={description} lang={lang}>
  <section class="about-hero">
    <div class="container">
      <p class="eyebrow">泰国市场</p>
      <h1>泰国钢结构项目供应解决方案</h1>
      <p class="about-hero-desc">从设计深化、制造加工到出口交付和安装技术指导，中赛钢构为泰国工业厂房、仓储物流和农业项目提供钢结构供应。</p>
      <div class="hero-cta-group">
        <a href="/zh/contact/#quote-form" class="btn btn-primary">获取项目方案</a>
        <a href="https://wa.me/8613192007378?text=%E4%BD%A0%E5%A5%BD%EF%BC%8C%E6%88%91%E6%9C%89%E4%B8%80%E4%B8%AA%E6%B3%B0%E5%9B%BD%E9%92%A2%E7%BB%93%E6%9E%84%E9%A1%B9%E7%9B%AE%E6%83%B3%E5%92%A8%E8%AF%A2%E3%80%82" class="btn btn-outline">沟通项目需求</a>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">中赛对泰国项目的支持</p>
        <h2>中赛钢构为泰国项目提供什么</h2>
      </div>
      <div class="capability-grid">
        <div class="cap-card">
          <h3>设计与深化</h3>
          <p>自有设计团队审核项目图纸，完成加工图和材料清单。</p>
        </div>
        <div class="cap-card">
          <h3>制造与质量</h3>
          <p>东莞、惠州制造基地，年产能约10万吨。</p>
        </div>
        <div class="cap-card">
          <h3>出口交付</h3>
          <p>构件编号、包装装柜，海运至曼谷港、林查班港。</p>
        </div>
        <div class="cap-card">
          <h3>安装技术支持</h3>
          <p>安装图、构件编号和技术指导，配合泰国当地施工团队。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">常见项目类型</p>
        <h2>泰国钢结构应用场景</h2>
      </div>
      <div class="capability-grid">
        <div class="cap-card">
          <h3>工业与制造</h3>
          <p>制造业厂房和工业设施。</p>
          <a href="/zh/steel-workshop/">查看工业厂房方案</a>
        </div>
        <div class="cap-card">
          <h3>仓储与物流</h3>
          <p>物流仓库、配送中心和冷库。</p>
          <a href="/zh/steel-warehouse/">查看仓储方案</a>
        </div>
        <div class="cap-card">
          <h3>农业与畜牧</h3>
          <p>农业建筑、畜牧厂房和加工设施。</p>
        </div>
        <div class="cap-card">
          <h3>商业与公共建筑</h3>
          <p>商业建筑、体育馆和展览厅。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">工程考虑</p>
        <h2>泰国项目的工程要点</h2>
      </div>
      <div class="two-col">
        <div>
          <h3>气候与环境</h3>
          <p>泰国地处热带，高温高湿。沿海或工业环境需指定防腐涂层。风和地震荷载根据项目位置和适用规范评估。</p>
        </div>
        <div>
          <h3>设计标准</h3>
          <p>项目需求根据适用当地规范、业主技术规格书和约定设计标准评审。当地许可和法定审批由业主或当地持牌工程师负责。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">出口交付</p>
        <h2>从中国到泰国的钢结构交付</h2>
      </div>
      <div class="two-col">
        <div>
          <h3>交付流程</h3>
          <p>钢构件在东莞或惠州制造，编号、检验、包装、装柜，海运至曼谷港或林查班港。出口单证随货同行。</p>
        </div>
        <div>
          <h3>当地施工衔接</h3>
          <p>中赛提供安装图、构件编号和技术指导。土建、当地许可、施工人力和现场安装由项目当地承包商负责。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">开始您的泰国项目</p>
        <h2>准备在泰国建设钢结构项目？</h2>
        <p>提交项目所在地、图纸或需求，中赛工程团队将进行初步技术评审。</p>
        <div class="hero-cta-group">
          <a href="/zh/contact/#quote-form" class="btn btn-primary">获取项目方案</a>
          <a href="https://wa.me/8613192007378?text=%E4%BD%A0%E5%A5%BD%EF%BC%8C%E6%88%91%E6%9C%89%E4%B8%80%E4%B8%AA%E6%B3%B0%E5%9B%BD%E9%92%A2%E7%BB%93%E6%9E%84%E9%A1%B9%E7%9B%AE%E6%83%B3%E5%92%A8%E8%AF%A2%E3%80%82" class="btn btn-outline">沟通项目需求</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
