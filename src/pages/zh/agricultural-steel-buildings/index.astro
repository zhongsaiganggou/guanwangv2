---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const title = '农业与养殖钢结构建筑 | 畜牧棚舍与农场钢结构 | 中赛钢构';
const description = '中赛钢构提供农业与养殖钢结构建筑解决方案，覆盖畜牧棚舍、养鸡场、农场仓储及温室钢架，支持耐腐蚀设计、通风规划与耐久围护系统。';
const lang = 'zh';
const canonical = 'https://zhongsai-steelstructure.com/zh/agricultural-steel-buildings/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/products/app-agriculture-livestock.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">农业 · 养殖钢结构</span>
      <h1>农业与养殖钢结构建筑</h1>
      <p class="lead">中赛钢构为农业与养殖类项目提供钢结构解决方案——包括畜牧棚舍、养鸡场、农场仓储建筑及温室钢架。从设计深化到制造出口，支持耐腐蚀框架、通风规划、耐久围护系统与高性价比的农场建筑供应。</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">获取项目报价</a>
        <a href="/zh/products/" class="btn btn-outline">查看全部产品</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/zh/">首页</a>
      <span class="sep">/</span>
      <a href="/zh/products/">产品</a>
      <span class="sep">/</span>
      <span class="current">农业与养殖建筑</span>
    </div>
  </nav>

  <!-- 01 / 农业项目需求 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">01 / 农业项目需求</p>
        <h2>农业钢结构建筑项目需要确认哪些信息</h2>
        <p>农业钢结构建筑需要围绕动物福利、通风、耐腐蚀和运营效率进行仔细规划。以下信息直接影响结构框架、围护规格和建筑布局。</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>建筑类型</h3>
          <p>养鸡场、畜牧棚舍、农场仓储、温室钢架或综合农业建筑——不同用途需要不同的结构和围护配置。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>通风需求</h3>
          <p>自然通风、机械通风、纵向通风或混合系统——气流需求影响建筑尺寸、开口和屋面设计。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>腐蚀环境</h3>
          <p>养殖建筑湿度和氨气浓度较高——耐腐蚀涂装和材料选择对长期耐久性至关重要。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>气候与位置</h3>
          <p>当地风荷载、雪荷载、温度范围和抗震条件决定结构构件尺寸和连接设计。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>围护系统</h3>
          <p>屋面板和墙面板类型、保温等级、采光板和通风开口根据建筑用途和当地气候确定。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>运营布局</h3>
          <p>饲料通道、动物区、设备通道和清洁路线影响建筑宽度、柱位和门洞设置。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / 畜牧与养殖结构 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">02 / 畜牧与养殖结构</p>
        <h2>畜牧与养殖建筑的钢结构框架</h2>
        <p>畜牧和养殖建筑需要大跨度、无柱内部空间，以最大化动物饲养和运营设备的可用空间。钢门式框架为这些应用提供所需的结构效率。</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/app-agriculture-livestock.jpg" alt="农业钢结构养殖建筑" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>农业用途的大跨度框架</h3>
          <ul>
            <li>门式框架设计提供无柱内部空间，适合畜牧饲养和运营空间</li>
            <li>针对高湿度养殖环境指定耐腐蚀表面处理</li>
            <li>屋面坡度和通风开口根据建筑类型和气候设计</li>
            <li>保温和围护系统根据动物舒适度和能效配置</li>
            <li>具体跨度、高度和荷载根据项目图纸和技术要求确定</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / 农场仓储与温室钢架 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">03 / 农场仓储与温室钢架</p>
        <h2>农场仓储建筑与温室钢架</h2>
        <p>除畜牧舍外，农业项目通常还需要设备、饲料和农产品的仓储建筑，以及温室和育苗结构的钢架。</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/products/05-agriculture-special.jpg');"></div>
          <div class="feature-body">
            <h3>农场仓储建筑</h3>
            <p>用于农场设备、饲料存储和农产品的钢结构仓储建筑，大跨度内部空间和灵活的门洞配置。</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/06-custom-engineering.jpg');"></div>
          <div class="feature-body">
            <h3>温室钢架</h3>
            <p>为温室和育苗结构定制的钢架，支撑玻璃覆盖系统、通风设备和环境控制装置。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 / 耐腐蚀与耐久性 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">04 / 耐腐蚀与耐久性</p>
        <h2>耐腐蚀与长期耐久性</h2>
        <p>农业环境——尤其是养殖建筑——存在较高的湿度、氨气暴露和腐蚀条件。材料选择和表面处理直接影响建筑使用寿命。</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/manufacturing/real/workshop-overview-wide-9815.jpg" alt="钢结构制造耐腐蚀处理" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>农业环境的耐久性规划</h3>
          <ul>
            <li>根据环境暴露等级指定表面处理和涂装</li>
            <li>材料牌号和厚度按长期结构性能选择</li>
            <li>围护材料选择适应农业环境的耐腐蚀性能</li>
            <li>连接节点设计减少水分积聚和腐蚀点</li>
            <li>具体涂装系统和材料牌号根据项目技术要求确定</li>
          </ul>
          <div style="margin-top: 20px;">
            <a href="/zh/manufacturing-quality/" class="btn btn-outline">查看制造质量</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 / 制造与出口供应 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">05 / 制造与出口供应</p>
        <h2>从图纸到出口交付的农业项目流程</h2>
        <p>中赛拥有自有生产基地，按项目图纸制造农业钢结构建筑构件，覆盖切割、装配、焊接、表面处理和质量控制。</p>
      </div>
      <div class="process-flow">
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">01</div>
          <h4>图纸确认</h4>
          <p>项目图纸、BOQ和技术要求确认</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">02</div>
          <h4>设计深化</h4>
          <p>深化设计和制造图纸准备</p>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">03</div>
          <h4>制造加工</h4>
          <p>按图纸组织农业钢结构构件制造</p>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">04</div>
          <h4>构件编号</h4>
          <p>根据加工图进行构件标记和编号</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>包装装柜</h4>
          <p>按构件类型和装柜要求组织包装</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">06</div>
          <h4>出口协调</h4>
          <p>出口资料支持和物流协调</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">06 / 相关能力</p>
        <h2>相关能力</h2>
        <p>探索中赛为您项目提供的相关能力和服务。</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3><a href="/zh/steel-warehouse/" style="color: inherit; text-decoration: none;">钢结构仓库</a></h3>
            <p>仓储与物流钢结构建筑</p>
            <a href="/zh/steel-warehouse/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3><a href="/zh/products/custom-engineering/" style="color: inherit; text-decoration: none;">定制工程</a></h3>
            <p>定制钢结构加工</p>
            <a href="/zh/products/custom-engineering/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3><a href="/zh/components/roof-wall-cladding-systems/" style="color: inherit; text-decoration: none;">围护系统</a></h3>
            <p>围护系统供应</p>
            <a href="/zh/components/roof-wall-cladding-systems/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-4">
          <div class="feature-body">
            <h3><a href="/zh/export-delivery/" style="color: inherit; text-decoration: none;">出口交付</a></h3>
            <p>包装、装柜与出口协调</p>
            <a href="/zh/export-delivery/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote Form -->
  <section id="quote" class="detail-section">
    <div class="container">
      <QuoteForm />
    </div>
  </section>
</BaseLayout>
