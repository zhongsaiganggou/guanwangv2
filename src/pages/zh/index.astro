---
// ZhongSai V3 - Chinese Homepage
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import '../../styles/home.css';
import '../../styles/home-v3.css';
import { getLatestPlaylistVideos, formatVideoDate } from '../../data/youtubePlaylist';
const shipmentVideos = await getLatestPlaylistVideos(4);

const lang = 'zh';
const title = '中赛钢构｜钢结构设计、深化、制造与出口交付';
const description = '中赛钢构是钢结构出口制造商，提供结构设计、深化出图、工厂制造、包装装柜、出口运输与海外安装技术指导。';
---

<BaseLayout title={title} description={description} lang={lang}>

  <!-- 1. Hero -->
  <section class="hero-home">
    <picture class="hero-home-bg">
      <source type="image/avif" sizes="100vw" srcset="/images/optimized/home/hero-768.avif 768w, /images/optimized/home/hero-1280.avif 1280w, /images/optimized/home/hero-1920.avif 1920w">
      <source type="image/webp" sizes="100vw" srcset="/images/optimized/home/hero-768.webp 768w, /images/optimized/home/hero-1280.webp 1280w, /images/optimized/home/hero-1920.webp 1920w">
      <img src="/images/optimized/home/hero-1280.jpg" sizes="100vw" srcset="/images/optimized/home/hero-768.jpg 768w, /images/optimized/home/hero-1280.jpg 1280w, /images/optimized/home/hero-1920.jpg 1920w" width="1920" height="1084" alt="中赛钢结构制造基地航拍全景" fetchpriority="high" decoding="async">
    </picture>
    <div class="hero-home-overlay"></div>
    <div class="container hero-home-content">
      <p class="eyebrow">钢结构工程 · 设计制造 · 全球交付</p>
      <h1>让钢结构项目<br>从图纸走向现场</h1>
      <p class="lead">从结构设计、深化出图、工厂制造到出口装柜与海外安装指导，由一支团队贯通关键环节。</p>
      <div class="hero-home-actions">
        <a href="#quote" class="btn btn-primary">获取项目方案 ↗</a>
        <a href="/zh/steel-workshop/" class="btn btn-secondary">查看解决方案</a>
      </div>
      <div class="hero-home-stats">
        <div class="hero-stat"><b>15<sup>年+</sup></b><span>钢结构出口经验</span></div>
        <div class="hero-stat"><b>10<sup>万㎡</sup></b><span>生产基地</span></div>
        <div class="hero-stat"><b>10<sup>万吨</sup></b><span>年产能</span></div>
        <div class="hero-stat"><b>60<sup>+</sup></b><span>出口国家</span></div>
      </div>
    </div>
  </section>

  <!-- 2. Project Entry -->
  <section class="section">
    <div class="container">
      <div class="entry-grid">
        <a href="#quote" class="entry-card">
          <h3>已有图纸 / BOQ</h3>
          <p>上传建筑、结构图纸或工程量清单，工程团队进行评审并反馈下一步。</p>
          <span class="entry-link">上传项目图纸 →</span>
        </a>
        <a href="#quote" class="entry-card">
          <h3>暂无完整图纸</h3>
          <p>告诉我项目地点、用途和基本尺寸，我们帮您理清方案和报价所需资料。</p>
          <span class="entry-link">描述项目需求 →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. Solutions -->
  <section class="section section-gray">
    <div class="container container-xwide">
      <div class="section-heading">
        <p class="eyebrow">解决方案</p>
        <h2>按项目场景选择</h2>
      </div>
      <div class="solutions-grid">
        <a href="/zh/steel-workshop/" class="solution-card">
          <div class="solution-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/sol-industrial-720.avif">
              <source type="image/webp" srcset="/images/optimized/home/sol-industrial-720.webp">
              <img src="/images/optimized/home/sol-industrial-720.jpg" width="720" height="405" loading="lazy" decoding="async" alt="工业与制造钢结构厂房">
            </picture>
          </div>
          <h3>工业与制造</h3>
        </a>
        <a href="/zh/steel-warehouse/" class="solution-card">
          <div class="solution-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/sol-warehouse-720.avif">
              <source type="image/webp" srcset="/images/optimized/home/sol-warehouse-720.webp">
              <img src="/images/optimized/home/sol-warehouse-720.jpg" width="720" height="405" loading="lazy" decoding="async" alt="仓储与物流钢结构仓库">
            </picture>
          </div>
          <h3>仓储与物流</h3>
        </a>
        <a href="/zh/steel-mining-factory/" class="solution-card">
          <div class="solution-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/sol-mining-720.avif">
              <source type="image/webp" srcset="/images/optimized/home/sol-mining-720.webp">
              <img src="/images/optimized/home/sol-mining-720.jpg" width="720" height="405" loading="lazy" decoding="async" alt="矿业与能源钢结构及料仓">
            </picture>
          </div>
          <h3>矿业与能源</h3>
        </a>
        <a href="/zh/agricultural-steel-buildings/" class="solution-card">
          <div class="solution-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/sol-agriculture-720.avif">
              <source type="image/webp" srcset="/images/optimized/home/sol-agriculture-720.webp">
              <img src="/images/optimized/home/sol-agriculture-720.jpg" width="720" height="405" loading="lazy" decoding="async" alt="农业与养殖钢结构建筑">
            </picture>
          </div>
          <h3>农业与养殖</h3>
        </a>
        <a href="/zh/commercial-public-steel-buildings/" class="solution-card">
          <div class="solution-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/sol-commercial-720.avif">
              <source type="image/webp" srcset="/images/optimized/home/sol-commercial-720.webp">
              <img src="/images/optimized/home/sol-commercial-720.jpg" width="720" height="405" loading="lazy" decoding="async" alt="商业与公共钢结构建筑">
            </picture>
          </div>
          <h3>商业与公共</h3>
        </a>
        <a href="/zh/transportation-infrastructure-steel/" class="solution-card">
          <div class="solution-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/sol-transport-720.avif">
              <source type="image/webp" srcset="/images/optimized/home/sol-transport-720.webp">
              <img src="/images/optimized/home/sol-transport-720.jpg" width="720" height="405" loading="lazy" decoding="async" alt="交通与基础设施钢结构">
            </picture>
          </div>
          <h3>交通与基础设施</h3>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. Engineering & Manufacturing -->
  <section class="section">
    <div class="container container-xwide">
      <div class="section-heading">
        <p class="eyebrow">工程与制造</p>
        <h2>设计到装柜的证据链</h2>
      </div>
      <div class="evidence-flow">
        <div class="evidence-text">
          <p>自有设计团队负责结构方案、深化出图和节点设计；东莞、惠州制造基地负责切割、焊接、检验和涂装。构件编号、装箱清单和装柜方案同步交付。</p>
          <div class="evidence-steps">
            <span>工程设计与深化</span>
            <span>工厂制造与质检</span>
            <span>包装装柜出口</span>
            <span>安装技术支持</span>
          </div>
          <a href="/zh/manufacturing-quality/" class="btn btn-outline">查看制造能力 →</a>
        </div>
        <div class="evidence-img">
          <img src="/images/manufacturing/real/welding-9820.jpg" alt="中赛工厂焊接作业现场" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Selected Projects -->
  <section class="section section-gray">
    <div class="container container-xwide">
      <div class="section-heading">
        <p class="eyebrow">项目案例</p>
        <h2>代表项目</h2>
      </div>
      <div class="projects-grid">
        <a href="/zh/projects/singapore-airport-t2-connect/" class="project-card">
          <div class="project-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/proj-singapore-640.avif">
              <source type="image/webp" srcset="/images/optimized/home/proj-singapore-640.webp">
              <img src="/images/optimized/home/proj-singapore-640.jpg" width="640" height="421" loading="lazy" decoding="async" alt="新加坡樟宜机场T2连接项目">
            </picture>
          </div>
          <div class="project-info"><h3>新加坡樟宜机场T2</h3><p>新加坡 · 交通基础设施</p></div>
        </a>
        <a href="/zh/projects/macau-londoner/" class="project-card">
          <div class="project-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/proj-macau-640.avif">
              <source type="image/webp" srcset="/images/optimized/home/proj-macau-640.webp">
              <img src="/images/optimized/home/proj-macau-640.jpg" width="640" height="421" loading="lazy" decoding="async" alt="澳门伦敦人商业综合项目">
            </picture>
          </div>
          <div class="project-info"><h3>澳门伦敦人</h3><p>澳门 · 商业公共建筑</p></div>
        </a>
        <a href="/zh/projects/shantou-luxshare-electronics-center/" class="project-card">
          <div class="project-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/proj-shantou-640.avif">
              <source type="image/webp" srcset="/images/optimized/home/proj-shantou-640.webp">
              <img src="/images/optimized/home/proj-shantou-640.jpg" width="640" height="421" loading="lazy" decoding="async" alt="汕头立讯精密电子厂房项目">
            </picture>
          </div>
          <div class="project-info"><h3>汕头立讯电子中心</h3><p>广东 · 工业制造</p></div>
        </a>
        <a href="/zh/projects/cnpc-cracking-furnace/" class="project-card">
          <div class="project-img">
            <picture>
              <source type="image/avif" srcset="/images/optimized/home/proj-cnpc-640.avif">
              <source type="image/webp" srcset="/images/optimized/home/proj-cnpc-640.webp">
              <img src="/images/optimized/home/proj-cnpc-640.jpg" width="640" height="421" loading="lazy" decoding="async" alt="中石油第六建设公司裂解炉项目">
            </picture>
          </div>
          <div class="project-info"><h3>中石油裂解炉项目</h3><p>能源 · 重工业</p></div>
        </a>
      </div>
      <div style="text-align:center;margin-top:32px;">
        <a href="/zh/projects/" class="btn btn-outline">查看全部项目 →</a>
      </div>
    </div>
  </section>

  <!-- 5b. 近期装柜与出口发货 -->
  <section class="section">
    <div class="container container-xwide">
      <div class="section-heading" style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px;">
        <div>
          <p class="eyebrow">出口交付</p>
          <h2>近期装柜与出口发货</h2>
          <p style="margin-top:8px;max-width:560px;">中赛持续记录钢结构构件的包装、装柜及出口准备过程。以下为近期真实发货与装柜视频记录。</p>
        </div>
        <a href="/zh/export-delivery/shipments/" class="btn btn-outline">查看全部发货视频 &rarr;</a>
      </div>
      {shipmentVideos.length > 0 && (
      <div class="shipment-video-row">
        {shipmentVideos.map((v) => (
          <div class="ship-video-card" data-video-id={v.videoId}>
            <div class="ship-thumb">
              <img src={v.thumbnail} alt={v.title} loading="lazy" width="180" height="320" />
              <div class="ship-play-btn"><svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg></div>
            </div>
            <div class="ship-meta">
              <p class="ship-title">{v.title}</p>
              <p class="ship-date">{formatVideoDate(v.publishedAt, "zh")}</p>
            </div>
          </div>
        ))}
      </div>
      )}
    </div>
  </section>

  <!-- 6. Delivery Process -->
  <section class="section">
    <div class="container">
      <div class="section-heading section-heading-center">
        <p class="eyebrow">交付流程</p>
        <h2>项目如何推进</h2>
      </div>
      <div class="process-grid">
        <div class="process-step"><b>01</b><strong>项目评审</strong><span>确认地点、用途、尺寸和图纸需求</span></div>
        <div class="process-step"><b>02</b><strong>工程深化</strong><span>结构设计、节点深化和构件图</span></div>
        <div class="process-step"><b>03</b><strong>制造与质检</strong><span>切割焊接、尺寸检验和表面处理</span></div>
        <div class="process-step"><b>04</b><strong>包装装柜</strong><span>构件编号、装箱清单和出口装柜</span></div>
        <div class="process-step"><b>05</b><strong>安装指导</strong><span>提供安装图和现场技术支持</span></div>
      </div>
    </div>
  </section>


  <!-- 7. Project Inquiry -->
  <section class="cta-final" id="quote">
    <div class="container">
      <p class="eyebrow" style="color:rgba(255,255,255,.6)">开始项目</p>
      <h2>有钢结构项目要做？</h2>
      <p>告诉我们项目地点、用途和图纸情况，工程团队会在1个工作日内回复。</p>
      <div class="cta-actions">
        <a href="/zh/contact/" class="btn btn-primary">获取项目方案 ↗</a>
        <a href="/zh/about/" class="btn btn-secondary">了解中赛</a>
      </div>
    </div>
    <QuoteForm lang={lang} />
  </section>

</BaseLayout>

<style>
.container-wide { max-width: 1320px; }
@media (max-width: 1360px) { .container-wide { max-width: calc(100% - 48px); } }
@media (max-width: 768px) { .container-wide { max-width: calc(100% - 40px); } }
@media (max-width: 480px) { .container-wide { max-width: calc(100% - 32px); } }
.shipment-video-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.ship-video-card { cursor: pointer; touch-action: manipulation; display: block; text-decoration: none; color: inherit; }
.ship-more-thumb {
  background: #1f2937;
  display: flex; align-items: center; justify-content: center;
}
.ship-more-thumb span { color: #fff; font-size: 14px; font-weight: 600; }
.ship-thumb {
  position: relative;
  aspect-ratio: 9/16;
  border-radius: 6px;
  overflow: hidden;
  background: #1a1a2e;
}
.ship-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ship-play-btn {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 48px; height: 48px; background: rgba(255,0,0,.9); border-radius: 50%;
  display: flex; align-items: center; justify-content: center; transition: transform .15s;
}
.ship-video-card:hover .ship-play-btn { transform: translate(-50%, -50%) scale(1.1); }
.ship-meta { padding: 10px 2px 0; }
.ship-title {
  font-size: 13px; font-weight: 600; line-height: 1.4; margin: 0 0 4px;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.ship-date { font-size: 12px; color: #6b7280; margin: 0; }
@media (max-width: 1024px) { .shipment-video-row { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) {
  .shipment-video-row {
    display: flex; overflow-x: auto; gap: 14px;
    -webkit-overflow-scrolling: touch; scroll-snap-type: x mandatory; padding-bottom: 8px;
  }
  .ship-video-card { flex: 0 0 85%; scroll-snap-align: start; }
}
<style>
.section-heading-left { grid-template-columns: 1fr !important; align-items: start !important; }
.section-heading-left h2 { margin-top: 8px; }
.section-heading-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 8px;
}
.section-heading-center .eyebrow { margin-bottom: 0; }
.process-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0;
  border-top: 2px solid #1a56db;
}
.process-step {
  padding: 28px 20px 24px;
  border-right: 1px solid #e5e7eb;
  position: relative;
}
.process-step:last-child { border-right: none; }
.process-step::before {
  content: '';
  position: absolute;
  top: -2px; left: 0;
  width: 12px; height: 2px;
  background: #f59e0b;
}
.process-step b {
  display: block;
  font-size: 13px;
  color: #1a56db;
  font-weight: 700;
  margin-bottom: 12px;
  letter-spacing: 1px;
}
.process-step strong {
  display: block;
  font-size: 16px;
  color: #111;
  margin-bottom: 8px;
  line-height: 1.4;
}
.process-step span {
  font-size: 13px;
  color: #6b7280;
  line-height: 1.6;
  display: block;
}
@media (max-width: 1024px) {
  .process-grid { grid-template-columns: repeat(3, 1fr); }
  .process-step:nth-child(3) { border-right: none; }
  .process-step:nth-child(4), .process-step:nth-child(5) { border-top: 1px solid #e5e7eb; }
}
@media (max-width: 640px) {
  .process-grid { grid-template-columns: 1fr; border-top: none; }
  .process-step { border-right: none; border-bottom: 1px solid #e5e7eb; border-left: 3px solid #1a56db; }
  .process-step::before { display: none; }
}
</style></style>
<script>
document.querySelectorAll('.ship-video-card').forEach(function(card) {
  card.addEventListener('click', function() {
    var vid = this.getAttribute('data-video-id');
    var thumb = this.querySelector('.ship-thumb');
    if (!vid || !thumb) return;
    if (thumb.querySelector('iframe')) return;
    var iframe = document.createElement('iframe');
    iframe.src = 'https://www.youtube.com/embed/' + vid + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
    iframe.setAttribute('allowfullscreen', '');
    iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
    thumb.innerHTML = '';
    thumb.appendChild(iframe);
  });
});
</script>
