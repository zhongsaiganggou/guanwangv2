---
// ZhongSai V3 - Chinese Homepage
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import '../../styles/home.css';
import '../../styles/home-v3.css';

const lang = 'zh';
const title = '中赛钢构｜钢结构设计、深化、制造与出口交付';
const description = '中赛钢构是钢结构出口制造商，提供结构设计、深化出图、工厂制造、包装装柜、出口运输与海外安装技术指导。';
---

<BaseLayout title={title} description={description} lang={lang}>

  <!-- 1. Hero -->
  <section class="hero-home">
    <div class="hero-home-bg" style="background-image: url('/images/company/factory-aerial-panorama.jpg')"></div>
    <div class="hero-home-overlay"></div>
    <div class="container hero-home-content">
      <p class="eyebrow">钢结构工程 · 设计制造 · 全球交付</p>
      <h1>让钢结构项目<br>从图纸走向现场</h1>
      <p class="lead">从结构设计、深化出图、工厂制造到出口装柜与海外安装指导，由一支团队贯通关键环节。</p>
      <div class="hero-home-actions">
        <a href="#quote" class="btn btn-primary">提交项目图纸 ↗</a>
        <a href="/zh/steel-workshop/" class="btn btn-secondary">查看解决方案</a>
      </div>
      <div class="hero-home-stats">
        <div class="hero-stat"><b>15<sup>年+</sup></b><span>钢结构出口经验</span></div>
        <div class="hero-stat"><b>10<sup>万㎡</sup></b><span>生产基地</span></div>
        <div class="hero-stat"><b>10<sup>万吨</sup></b><span>年产能</span></div>
        <div class="hero-stat"><b>60<sup>+</sup></b><span>出口国家</span></div>
      </div>
    </div>
  </section>

  <!-- 2. Project Entry -->
  <section class="section">
    <div class="container">
      <div class="entry-grid">
        <a href="#quote" class="entry-card">
          <h3>已有图纸 / BOQ</h3>
          <p>上传建筑、结构图纸或工程量清单，工程团队进行评审并反馈下一步。</p>
          <span class="entry-link">上传项目图纸 →</span>
        </a>
        <a href="#quote" class="entry-card">
          <h3>暂无完整图纸</h3>
          <p>告诉我项目地点、用途和基本尺寸，我们帮您理清方案和报价所需资料。</p>
          <span class="entry-link">描述项目需求 →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. Solutions -->
  <section class="section section-gray">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">解决方案</p>
        <h2>按项目场景选择</h2>
      </div>
      <div class="solutions-grid">
        <a href="/zh/steel-workshop/" class="solution-card"><div class="solution-img" style="background-image:url('/images/products/app-industrial-workshop-hero.jpg')"></div><h3>工业与制造</h3></a>
        <a href="/zh/steel-warehouse/" class="solution-card"><div class="solution-img" style="background-image:url('/images/products/app-warehouse-logistics-hero.jpg')"></div><h3>仓储与物流</h3></a>
        <a href="/zh/steel-mining-factory/" class="solution-card"><div class="solution-img" style="background-image:url('/images/products/app-mining-energy-hero.jpg')"></div><h3>矿业与能源</h3></a>
        <a href="/zh/agricultural-steel-buildings/" class="solution-card"><div class="solution-img" style="background-image:url('/images/products/app-agriculture-livestock.jpg')"></div><h3>农业与养殖</h3></a>
        <a href="/zh/commercial-public-steel-buildings/" class="solution-card"><div class="solution-img" style="background-image:url('/images/products/app-commercial-public.jpg')"></div><h3>商业与公共</h3></a>
        <a href="/zh/transportation-infrastructure-steel/" class="solution-card"><div class="solution-img" style="background-image:url('/images/products/app-transport-infrastructure.jpg')"></div><h3>交通与基础设施</h3></a>
      </div>
    </div>
  </section>

  <!-- 4. Engineering & Manufacturing -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">工程与制造</p>
        <h2>设计到装柜的证据链</h2>
      </div>
      <div class="evidence-flow">
        <div class="evidence-text">
          <p>自有设计团队负责结构方案、深化出图和节点设计；东莞、惠州制造基地负责切割、焊接、检验和涂装。构件编号、装箱清单和装柜方案同步交付。</p>
          <div class="evidence-steps">
            <span>工程设计与深化</span>
            <span>工厂制造与质检</span>
            <span>包装装柜出口</span>
            <span>安装技术支持</span>
          </div>
          <a href="/zh/manufacturing-quality/" class="btn btn-outline">查看制造能力 →</a>
        </div>
        <div class="evidence-img">
          <img src="/images/manufacturing/real/welding-9820.jpg" alt="中赛工厂焊接作业现场" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Selected Projects -->
  <section class="section section-gray">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">项目案例</p>
        <h2>代表项目</h2>
      </div>
      <div class="projects-grid">
        <a href="/zh/projects/singapore-airport-t2-connect/" class="project-card">
          <div class="project-img" style="background-image:url('/images/projects/overseas/singapore-airport-t2-connect.jpg')"></div>
          <div class="project-info"><h3>新加坡樟宜机场T2</h3><p>新加坡 · 交通基础设施</p></div>
        </a>
        <a href="/zh/projects/macau-londoner/" class="project-card">
          <div class="project-img" style="background-image:url('/images/projects/overseas/macau-londoner.jpg')"></div>
          <div class="project-info"><h3>澳门伦敦人</h3><p>澳门 · 商业公共建筑</p></div>
        </a>
        <a href="/zh/projects/shantou-luxshare-electronics-center/" class="project-card">
          <div class="project-img" style="background-image:url('/images/projects/shantou-luxshare-precision-electronics-aerial-rendering.jpg')"></div>
          <div class="project-info"><h3>汕头立讯电子中心</h3><p>广东 · 工业制造</p></div>
        </a>
        <a href="/zh/projects/cnpc-cracking-furnace/" class="project-card">
          <div class="project-img" style="background-image:url('/images/projects/cnpc-sixth-construction-cracking-furnace-aerial-view.jpg')"></div>
          <div class="project-info"><h3>中石油裂解炉项目</h3><p>能源 · 重工业</p></div>
        </a>
      </div>
      <div style="text-align:center;margin-top:32px;">
        <a href="/zh/projects/" class="btn btn-outline">查看全部项目 →</a>
      </div>
    </div>
  </section>

  <!-- 6. Delivery Process -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">交付流程</p>
        <h2>项目如何推进</h2>
      </div>
      <div class="process-list">
        <div class="process-item"><b>01</b><span><strong>项目评审</strong>确认地点、用途、尺寸和图纸需求</span></div>
        <div class="process-item"><b>02</b><span><strong>工程深化</strong>结构设计、节点深化和构件图</span></div>
        <div class="process-item"><b>03</b><span><strong>制造与质检</strong>切割焊接、尺寸检验和表面处理</span></div>
        <div class="process-item"><b>04</b><span><strong>包装装柜</strong>构件编号、装箱清单和出口装柜</span></div>
        <div class="process-item"><b>05</b><span><strong>安装指导</strong>提供安装图和现场技术支持</span></div>
      </div>
    </div>
  </section>

  <!-- 7. Project Inquiry -->
  <section class="cta-final" id="quote">
    <div class="container">
      <p class="eyebrow" style="color:rgba(255,255,255,.6)">开始项目</p>
      <h2>有钢结构项目要做？</h2>
      <p>告诉我们项目地点、用途和图纸情况，工程团队会在1个工作日内回复。</p>
      <div class="cta-actions">
        <a href="/zh/contact/" class="btn btn-primary">提交项目图纸 ↗</a>
        <a href="/zh/about/" class="btn btn-secondary">了解中赛</a>
      </div>
    </div>
    <QuoteForm lang={lang} />
  </section>

</BaseLayout>
