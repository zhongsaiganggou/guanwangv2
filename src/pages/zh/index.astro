---
// ZhongSai V2 - Chinese Homepage
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import '../../styles/home.css';

const lang = 'zh';
const title = '中赛钢构｜钢结构设计、深化、制造与出口交付';
const description = '中赛钢构是钢结构出口制造商，提供结构设计、深化出图、工厂制造、包装装柜、出口运输与海外安装技术指导。10万㎡生产基地，10万吨年产能。';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="hero-home">
    <div class="hero-home-bg" style="background-image: url('/images/company/factory-aerial-panorama.jpg')"></div>
    <div class="hero-home-overlay"></div>
    <div class="container hero-home-content">
      <div class="hero-home-copy">
        <p class="eyebrow hero-fade">中国制造 · 出口交付</p>
        <h1 class="hero-fade hero-fade-delay-1">让钢结构项目<br><em>从图纸走向现场</em></h1>
        <p class="lead hero-fade hero-fade-delay-2">从结构设计、深化出图、工厂制造到出口装柜与海外安装指导，由一支团队贯通关键环节。您负责当地施工，我们把钢结构材料按计划送达。</p>
        <div class="hero-home-actions hero-fade hero-fade-delay-3">
          <a href="#quote" class="btn btn-primary">发送图纸 / 项目需求 <span style="margin-left:6px">↗</span></a>
          <a href="/zh/manufacturing-quality/" class="btn btn-secondary">查看制造与出口交付流程</a>
        </div>
      </div>
      <div class="hero-home-stats hero-fade hero-fade-delay-2">
        <div class="hero-stat">
          <b>15<sup>年+</sup></b>
          <span>钢结构行业与项目交付经验</span>
        </div>
        <div class="hero-stat">
          <b>10<sup>万㎡</sup></b>
          <span>生产基地面积</span>
        </div>
        <div class="hero-stat">
          <b>10<sup>万吨</sup></b>
          <span>年产能</span>
        </div>
        <div class="hero-stat">
          <b>300<sup>+</sup></b>
          <span>一线生产工人</span>
        </div>
      </div>
    </div>

    <!-- Hero 工业信息条 -->
    <div class="hero-industry-bar">
      <div class="container hero-industry-bar-inner">
        <span class="bar-label">出口制造能力</span>
        <div class="bar-items">
          <span class="bar-item">按图定制加工</span>
          <span class="bar-item">切割组立焊接</span>
          <span class="bar-item">表面处理质检</span>
          <span class="bar-item">包装装柜出口</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <div class="trust-bar">
    <div class="container trust-bar-inner">
      <span>ISO 9001</span>
      <span>GB / ASTM / EN</span>
      <span>15年+出口经验</span>
      <span>构件编号与装箱清单</span>
      <span>海外安装技术指导</span>
    </div>
  </div>

  <!-- Customer Entry -->
  <section class="section">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">找到你的入口</p>
          <h2>不同角色，<br>不同的项目起点。</h2>
        </div>
        <div>
          <p>不管您是有图纸的工程公司，还是只有地皮尺寸的业主，都能从这里找到对应入口。</p>
        </div>
      </div>
      <div class="customer-entry">
        <a href="#quote" class="customer-card reveal reveal-delay-1">
          
          <h3>我是项目业主 / 投资方</h3>
          <p>计划建设厂房、仓库或工业设施，需要从设计到出口的完整钢结构方案。</p>
          <ul>
            <li>只有地皮和尺寸，需要初步设计方案</li>
            <li>需要完整材料包和出口交付</li>
            <li>需要安装指导和技术支持</li>
          </ul>
          <span class="card-link">获取项目方案 →</span>
        </a>
        <a href="#quote" class="customer-card reveal reveal-delay-2">
          
          <h3>我是工程公司 / 当地总包</h3>
          <p>已有图纸和BOQ，需要可靠的钢结构加工厂和出口供应商。</p>
          <ul>
            <li>按图纸加工，需要深化设计支持</li>
            <li>需要构件编号、装箱和装柜管理</li>
            <li>需要稳定交期和质量控制</li>
          </ul>
          <span class="card-link">上传项目图纸 →</span>
        </a>
        <a href="/zh/export-delivery/" class="customer-card reveal reveal-delay-3">
          
          <h3>第一次从中国采购？</h3>
          <p>担心供应商真实性、出口文件、装柜、构件编号和安装衔接？了解中赛如何降低海外采购风险。</p>
          <ul>
            <li>了解制造、编号、包装和装柜流程</li>
            <li>了解出口资料和物流协调</li>
            <li>获取海外安装技术指导</li>
          </ul>
          <span class="card-link">查看出口流程 →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 01 Service Scope -->
  <section class="section" style="background: var(--color-gray-100)">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">服务边界</p>
          <h2>把复杂留在工厂，<br>把确定性交给客户。</h2>
        </div>
        <div>
          <p>我们专注钢结构材料的工程化交付。明确边界，让职责、成本和进度都更容易控制。</p>
        </div>
      </div>
      <div class="scope-grid">
        <article class="scope-card scope-deliver reveal reveal-delay-1">
          <div class="scope-card-head">
            
            <small>WHAT WE DELIVER</small>
          </div>
          <h3>从设计到装柜的材料交付</h3>
          <ol>
            <li><b style="font-size:12px;color:var(--color-secondary);letter-spacing:1px">01</b><span><strong>工程设计与深化</strong>根据荷载、跨度、用途与当地规范形成可制造方案。</span></li>
            <li><b style="font-size:12px;color:var(--color-secondary);letter-spacing:1px">02</b><span><strong>工厂制造与质检</strong>下料、组立、焊接、抛丸、涂装，制造与检验按项目要求组织。</span></li>
            <li><b style="font-size:12px;color:var(--color-secondary);letter-spacing:1px">03</b><span><strong>打包、装柜与出口</strong>构件编号、装箱清单和装柜方案同步交付。</span></li>
            <li><b style="font-size:12px;color:var(--color-secondary);letter-spacing:1px">04</b><span><strong>海外安装技术指导</strong>提供安装图、视频资料，可派工程师现场指导。</span></li>
          </ol>
        </article>
        <article class="scope-card scope-boundary reveal reveal-delay-2">
          <div class="scope-card-head">
            
            <small>SCOPE BOUNDARY</small>
          </div>
          <h3>现场工程由客户当地完成</h3>
          <p>我们不承接当地土建、装修与施工总包；客户配置当地施工队，我们提供可执行的技术文件和指导。</p>
          <ul>
            <li>不承接现场施工安装</li>
            <li>不承接地基及混凝土基础</li>
            <li>不承接室内外装修与机电</li>
            <li>不提供 EPC 交钥匙总包</li>
          </ul>
          <b class="scope-note">清晰分工 · 风险可控 · 成本透明</b>
        </article>
      </div>
    </div>
  </section>

  <!-- 03 Core Capabilities -->
  <section class="section">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">核心业务能力</p>
          <h2>制造、构件、围护<br>三项核心能力。</h2>
        </div>
        <div>
          <p>从工厂制造到按图定制构件，再到完整围护系统配套——中赛钢构为海外项目提供一站式钢结构材料供应。</p>
        </div>
      </div>
      <div class="capability-grid">
        <div class="capability-card reveal reveal-delay-1">
          <div class="capability-img">
            <img src="/images/manufacturing/real/cutting-prep-9809.jpg" alt="钢结构制造中的钢板切割下料" loading="lazy">
          </div>
          <div class="capability-body">
            <span class="capability-num">01</span>
            <h3>制造加工与质量控制</h3>
            <p>从原材料核验、CNC切割、组立焊接到表面处理与质量检验，覆盖钢结构制造关键环节。</p>
            <a href="#quote" class="capability-cta">了解制造能力 →</a>
          </div>
        </div>
        <div class="capability-card reveal reveal-delay-2">
          <div class="capability-img">
            <img src="/images/manufacturing/real/assembly-welding-9821.jpg" alt="钢构件组装与焊接加工" loading="lazy">
          </div>
          <div class="capability-body">
            <span class="capability-num">02</span>
            <h3>按图定制钢构件</h3>
            <p>根据结构图纸和BOQ加工钢柱、钢梁、吊车梁、箱型构件及桁架，构件标识可根据图纸和项目要求组织。</p>
            <a href="#quote" class="capability-cta">查看构件供应 →</a>
          </div>
        </div>
        <div class="capability-card reveal reveal-delay-3">
          <div class="capability-img">
            <img src="/images/components/finished-coated-components.jpg" alt="涂装完成、待项目供应的成品钢构件" loading="lazy">
          </div>
          <div class="capability-body">
            <span class="capability-num">03</span>
            <h3>屋面与墙面围护系统</h3>
            <p>提供檩条、屋面板、墙面板、夹芯板、楼承板及收边配件，完整围护系统配套供应。</p>
            <a href="#quote" class="capability-cta">了解围护系统 →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Manufacturing Evidence -->
  <section class="section" style="background: var(--color-gray-100)">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">制造能力</p>
          <h2>真实工厂 · 真实制造</h2>
          <p style="font-size:13px;color:#16a34a;margin-top:8px;">以下为中赛制造基地实景拍摄</p>
        </div>
        <div>
          <p>10万㎡生产基地，具备切割、组立、焊接、表面处理、质量检验与包装能力。构件标识与包装可根据确认图纸和项目要求协调，配合出口装柜与现场安装。</p>
        </div>
      </div>
      <div class="factory-grid reveal">
        <figure class="factory-item large">
          <img src="/images/company/factory-aerial-panorama.jpg" alt="中赛钢构生产基地航拍，龙门吊、主厂房和成品构件堆场" loading="lazy">
          <figcaption>生产基地航拍 · 龙门吊与成品堆场</figcaption>
        </figure>
        <figure class="factory-item">
          <img src="/images/company/factory-interior-production.jpg" alt="中赛钢构生产车间内部，行车、钢梁生产线和已加工钢构件" loading="lazy">
          <figcaption>生产车间 · 行车与构件生产线</figcaption>
        </figure>
        <figure class="factory-item">
          <img src="/images/company/factory-steel-beam-fabrication.jpg" alt="中赛钢构已加工完成的钢梁，带节点板和螺栓孔，整齐堆放在车间" loading="lazy">
          <figcaption>已加工钢梁 · 节点板与螺栓孔</figcaption>
        </figure>
        <figure class="factory-item">
          <img src="/images/company/factory-yard-gantry-crane.jpg" alt="中赛钢构室外货场，龙门吊正在吊运成品钢构件，构件已编号待装柜" loading="lazy">
          <figcaption>室外货场 · 构件编号与待装柜</figcaption>
        </figure>
        <figure class="factory-item">
          <img src="/images/container-loading.jpg" alt="钢结构构件装柜出口，工人正在将编号构件装入集装箱" loading="lazy">
          <figcaption>包装装柜 · 按编号顺序装箱</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 正在规划钢结构项目？ -->
  <section class="section" style="background: var(--color-gray-100)">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">开始您的项目</p>
          <h2>正在规划钢结构项目？</h2>
        </div>
        <div>
          <p>根据您当前的项目阶段选择合适的入口。不需要完整图纸也可以开始沟通。</p>
        </div>
      </div>
      <div class="planning-grid">
        <a href="#quote" class="planning-card reveal reveal-delay-1">
          <div class="planning-icon">📐</div>
          <h3>已有图纸？</h3>
          <p>发送结构图、深化图或BOQ，中赛可根据现有资料审核加工制造需求。</p>
          <span class="card-link">发送图纸 →</span>
        </a>
        <a href="#quote" class="planning-card reveal reveal-delay-2">
          <div class="planning-icon">🏗️</div>
          <h3>还没有完整图纸？</h3>
          <p>提供项目国家、建筑用途和现有尺寸，中赛可协助明确结构范围。</p>
          <span class="card-link">提交项目需求 →</span>
        </a>
        <a href="/zh/export-delivery/" class="planning-card reveal reveal-delay-3">
          <div class="planning-icon">🌏</div>
          <h3>第一次从中国采购？</h3>
          <p>了解制造、构件编号、包装、装柜和出口协调的完整流程。</p>
          <span class="card-link">查看出口流程 →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 提交之后会发生什么 -->
  <section class="section">
    <div class="container">
      <div class="section-heading reveal" style="text-align: center; display: block; margin-bottom: 48px">
        <p class="section-index">提交之后</p>
        <h2 style="margin-bottom: 12px">提交之后，不会掉进黑洞。</h2>
        <p style="max-width: 600px; margin: 0 auto; color: var(--color-gray-600)">清晰的审核流程让您在每个阶段都了解进展。</p>
      </div>
      <div class="next-steps reveal">
        <div class="next-step">
          <div class="next-step-num">01</div>
          <strong>提交图纸或项目需求</strong>
          <span>提交您现有的资料——图纸、BOQ，或基本项目参数。</span>
        </div>
        <div class="next-step">
          <div class="next-step-num">02</div>
          <strong>中赛审核现有项目资料</strong>
          <span>我们审核加工可行性。如资料不完整，会确认还需要哪些信息。</span>
        </div>
        <div class="next-step">
          <div class="next-step-num">03</div>
          <strong>沟通技术要求与报价</strong>
          <span>根据确认后的项目资料，继续进行技术与商务沟通。</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 降低从中国采购钢结构的项目风险 -->
  <section class="section" style="background: var(--color-dark); color: white">
    <div class="container">
      <div class="section-heading reveal" style="color: white">
        <div>
          <p class="section-index" style="color: var(--color-secondary)">降低风险</p>
          <h2 style="color: white">降低从中国采购钢结构的项目风险。</h2>
        </div>
        <div>
          <p style="color: rgba(255,255,255,0.7)">清晰的流程、可识别的构件和有记录的出口协调，降低海外采购的不确定性。</p>
        </div>
      </div>
      <div class="risk-grid">
        <div class="risk-card reveal reveal-delay-1">
          <div class="risk-num">01</div>
          <h3>图纸与需求审核</h3>
          <p>生产前审核加工可行性。清晰定义工作范围边界。</p>
        </div>
        <div class="risk-card reveal reveal-delay-2">
          <div class="risk-num">02</div>
          <h3>构件编号与识别</h3>
          <p>每个构件标注唯一编号。装箱清单与编号对应，便于现场分拣。</p>
        </div>
        <div class="risk-card reveal reveal-delay-3">
          <div class="risk-num">03</div>
          <h3>包装与装柜规划</h3>
          <p>按安装顺序组织集装箱装柜计划。构件做好远洋运输保护。</p>
        </div>
        <div class="risk-card reveal reveal-delay-1">
          <div class="risk-num">04</div>
          <h3>出口资料支持</h3>
          <p>商业发票、装箱清单及所需出口文件，按目的国要求准备。</p>
        </div>
        <div class="risk-card reveal reveal-delay-2">
          <div class="risk-num">05</div>
          <h3>物流协调</h3>
          <p>拖车、集装箱订舱和发运协调，与生产完成和项目时间线对齐。</p>
        </div>
        <div class="risk-card reveal reveal-delay-3">
          <div class="risk-num">06</div>
          <h3>海外安装技术指导</h3>
          <p>提供安装图纸、安装视频和工程师指导。当地施工由客户团队负责。</p>
        </div>
      </div>
    </div>
  </section>

<!-- 06 Process -->
  <section class="section">
    <div class="container">
      <div class="section-heading reveal" style="text-align: center; display: block; margin-bottom: 48px">
        <p class="section-index">合作流程</p>
        <h2 style="margin-bottom: 12px">每一步，都有明确产出。</h2>
        <p style="max-width: 600px; margin: 0 auto; color: var(--color-gray-600)">从需求输入到安装指导，流程透明，关键节点可确认。</p>
      </div>
      <div class="process-steps reveal">
        <div class="process-step">
          <div class="process-step-num">01</div>
          <strong>需求参数</strong>
          <span>用途、尺寸、国家、荷载、图纸</span>
        </div>
        <div class="process-step">
          <div class="process-step-num">02</div>
          <strong>初步方案</strong>
          <span>结构建议与预算范围</span>
        </div>
        <div class="process-step">
          <div class="process-step-num">03</div>
          <strong>结构设计</strong>
          <span>计算书与设计图纸</span>
        </div>
        <div class="process-step">
          <div class="process-step-num">04</div>
          <strong>深化确认</strong>
          <span>施工图、清单与计划</span>
        </div>
        <div class="process-step">
          <div class="process-step-num">05</div>
          <strong>生产质检</strong>
          <span>制造、检验与进度追踪</span>
        </div>
        <div class="process-step">
          <div class="process-step-num">06</div>
          <strong>包装出口</strong>
          <span>编号、装柜、单证与海运</span>
        </div>
        <div class="process-step">
          <div class="process-step-num">07</div>
          <strong>安装指导</strong>
          <span>安装图、视频与工程师支持</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 Cases Entry -->
  <section class="section" id="cases" style="background: var(--color-dark); color: white">
    <div class="container">
      <div class="section-heading reveal" style="color: white">
        <div>
          <p class="section-index" style="color: var(--color-secondary)">精选项目</p>
          <h2 style="color: white">精选项目与出口交付</h2>
        </div>
        <div>
          <p style="color: rgba(255,255,255,0.7)">查看中赛钢构的项目、制造与出口交付资料。</p>
        </div>
      </div>
      <div class="cases-grid cases-grid-4">
        <a href="/zh/projects/singapore-airport-t2-connect/" class="case-card reveal reveal-delay-1">
          <img src="/images/projects/overseas/singapore-airport-t2-connect.jpg" alt="新加坡樟宜机场T2连接" loading="lazy">
          <div class="case-overlay">
            <small>海外项目 · 新加坡</small>
            <b>新加坡樟宜机场T2连接</b>
