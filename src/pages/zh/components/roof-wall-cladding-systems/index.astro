---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../../components/QuoteForm.astro';
import '../../../../styles/detail.css';

const title = '钢结构屋面与墙面围护系统 | 中赛钢构';
const description = '中赛钢构为钢结构建筑提供屋面与墙面围护系统，包括屋面板、墙面板、保温夹芯板及配套围护材料，可与主钢结构作为项目供应包协调供应，支持出口交付。';
const lang = 'zh';
const canonical = 'https://zhongsai-steelstructure.com/zh/components/roof-wall-cladding-systems/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/components/finished-steel-members-stacked.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">屋面 · 墙面 · 围护系统</span>
      <h1>钢结构建筑屋面与墙面围护系统</h1>
      <p class="lead">中赛钢构为钢结构建筑提供屋面与墙面围护系统，包括屋面板、墙面板、保温夹芯板及配套围护材料。围护系统可与主钢结构、次结构作为项目供应包协调供应，具体板型、厚度、涂层和保温要求按项目图纸与技术要求确定，支持包装装柜与出口交付。</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">提交项目需求获取报价</a>
        <a href="/zh/components/" class="btn btn-outline">查看构件与材料</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/zh/">首页</a>
      <span class="sep">/</span>
      <a href="/zh/components/">构件与材料</a>
      <span class="sep">/</span>
      <span class="current">屋面与墙面围护系统</span>
    </div>
  </nav>

  <!-- 01 Roof & Wall Cladding Systems -->
  <section class="detail-section" id="cladding-overview">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">01 / 围护系统</p>
        <h2>屋面与墙面围护系统在钢结构建筑中的作用</h2>
        <p>围护系统是钢结构建筑的重要组成部分，包括屋面围护、墙面围护、天气防护、保温隔热（按项目要求）以及与主体结构的协调配合。具体板型、材料规格和构造方式按项目图纸与技术要求确定。</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/components/brochure-envelope-system-overview.jpg" alt="中赛钢构钢结构建筑屋面墙面围护系统" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>围护系统的核心功能</h3>
          <ul>
            <li>屋面围护：遮风挡雨、屋面排水协调</li>
            <li>墙面围护：建筑外围护、立面协调</li>
            <li>天气防护：防风、防雨、防雪荷载协调</li>
            <li>保温隔热：按项目要求配置保温层或夹芯板</li>
            <li>与主体结构协调：檩条、连接件、开洞配合</li>
            <li>具体板型、厚度、涂层和保温要求按项目技术规格确定</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Roof Systems -->
  <section class="detail-section alt" id="roof-panels">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">02 / 屋面系统</p>
        <h2>钢结构建筑屋面围护系统</h2>
        <p>中赛钢构可根据项目要求协调供应屋面板及配套屋面围护材料。具体板型、厚度、涂层和构造方式按项目图纸与技术要求确定。</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/components/finished-coated-components.jpg');"></div>
          <div class="feature-body">
            <h3>屋面板布置</h3>
            <p>根据屋面坡度、檩条间距和项目要求协调屋面板布置方式。</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/01-industrial.jpg');"></div>
          <div class="feature-body">
            <h3>防水与排水协调</h3>
            <p>屋面防水构造和天沟排水系统按项目图纸和技术要求协调。</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/components/brochure-envelope-system-detail.jpg');"></div>
          <div class="feature-body">
            <h3>保温隔热（按项目要求）</h3>
            <p>根据项目使用环境和要求配置保温层或保温夹芯板。</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/04-warehouse-logistics.jpg');"></div>
          <div class="feature-body">
            <h3>通风与采光协调</h3>
            <p>屋面通风器、采光带等按项目要求与围护系统协调配合。</p>
          </div>
        </div>
      </div>
      <p style="margin-top: 20px; color: #6b7280; font-size: 14px;">* 具体板型、厚度、涂层和性能要求根据项目图纸和技术规格确认。</p>
    </div>
  </section>

  <!-- 03 Wall Systems -->
  <section class="detail-section" id="wall-panels">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">03 / 墙面系统</p>
        <h2>钢结构建筑墙面围护系统</h2>
        <p>中赛钢构可根据项目要求协调供应墙面板及配套墙面围护材料。具体板型、厚度、涂层和构造方式按项目图纸与技术要求确定。</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>建筑外围护</h3>
          <p>墙面板布置、搭接方式和收边构造按项目要求协调。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>立面与开洞协调</h3>
          <p>门窗开洞、立面分格和收边与主体结构协调配合。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>门窗接口配合</h3>
          <p>门洞、窗洞周边围护构造按项目图纸和技术要求协调。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>保温隔热（按项目要求）</h3>
          <p>根据项目使用环境配置保温层或保温夹芯板。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>颜色与涂层</h3>
          <p>面板颜色和涂层按项目技术规格和要求确定。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>配套连接件</h3>
          <p>自攻钉、收边件、泛水板等配套围护材料可一并供应。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Insulated / Sandwich Panel Options -->
  <section class="detail-section alt" id="sandwich-panels">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">04 / 保温板选项</p>
        <h2>保温夹芯板与保温围护选项</h2>
        <p>根据项目使用环境和保温要求，中赛钢构可协调供应保温夹芯板或带保温层的围护系统。具体板型、芯材、厚度和保温性能按项目图纸与技术要求确定。</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/components/brochure-envelope-system-detail.jpg" alt="中赛钢构保温夹芯板与围护系统细节" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>可协调供应的保温围护选项</h3>
          <ul>
            <li>屋面保温夹芯板（按项目要求）</li>
            <li>墙面保温夹芯板（按项目要求）</li>
            <li>带保温层的压型板系统（按项目要求）</li>
            <li>具体芯材类型、厚度和保温性能按项目技术规格确定</li>
            <li>保温围护材料可与主钢结构作为项目供应包协调供应</li>
            <li>围护系统供应范围根据项目要求确认，可包括屋面板、墙面板、保温夹芯板及相关配套材料</li>
          </ul>
        </div>
      </div>
      <div class="section-heading reveal" id="cladding-accessories" style="margin-top: 48px;">
        <h2>屋面与墙面围护系统配套附件</h2>
        <p>配套材料可包括天沟、屋脊与边部收边、泛水件、紧固件、采光板及通风部件，具体范围根据项目图纸和技术要求确认。</p>
      </div>
    </div>
  </section>

  <!-- 05 Integrated Supply With Steel Structure -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">05 / 一体化供应</p>
        <h2>围护系统与钢结构一体化供应</h2>
