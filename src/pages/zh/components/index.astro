---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/hub.css';

const lang = 'zh';
const title = '钢结构构件与特殊钢结构｜加工制造与出口｜中赛钢构';
const description = '按项目图纸加工制造钢结构构件与特殊钢结构：钢梁、钢柱、钢桁架、钢平台、管廊、输送廊道及定制加工结构。基于图纸制造、出口包装与交付。';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="hub-hero">
    <div class="hub-hero-bg" style="background-image: url('/images/manufacturing/real/assembly-welding-9821.jpg');"></div>
    <div class="hub-hero-overlay"></div>
    <div class="container hub-hero-content">
      <div class="hub-breadcrumb">
        <a href="/zh/">首页</a><span>/</span><a href="/zh/products/">产品</a><span>/</span><span>钢构件</span>
      </div>
      <p class="eyebrow">钢构件 · 特殊钢结构</p>
      <h1>钢结构构件与特殊加工钢结构</h1>
      <p class="lead">按项目图纸加工制造钢结构构件与特殊钢结构，适用于工业、矿业、商业和基础设施项目。中赛钢构提供基于图纸的制造、结构深化、复杂焊接/螺栓装配、出口包装与交付。</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">发送构件图纸评审</a>
        <a href="#fabrication" class="btn btn-outline">申请制造报价</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/zh/">首页</a>
      <span class="sep">/</span>
      <a href="/zh/products/">产品</a>
      <span class="sep">/</span>
      <span class="current">钢构件与特殊钢结构</span>
    </div>
  </nav>

  <!-- 01 / 构件分类 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">构件分类</p>
        <h2>我们制造的钢构件类型</h2>
        <p>中赛钢构按客户图纸制造各类钢结构构件和特殊结构。每种构件类型都有特定的工程考虑因素和制造要求。</p>
      </div>
      <div class="component-category-grid">
        <a href="/zh/components/fabricated-steel-beams-columns/#steel-columns" class="component-category-card reveal">
          <div class="cc-image">
            <img src="/images/components/finished-steel-beams-columns.jpg" alt="成品钢柱构件" loading="lazy">
          </div>
          <div class="cc-content">
            <h3>钢柱</h3>
            <p>用于将屋面、楼面和设备荷载传递到基础的竖向结构构件。H型钢柱、箱型柱和格构柱按图纸加工。</p>
            <span class="cc-cta">查看钢柱 →</span>
          </div>
        </a>
        <a href="/zh/components/fabricated-steel-beams-columns/#steel-beams" class="component-category-card reveal reveal-delay-1">
          <div class="cc-image">
            <img src="/images/components/finished-steel-members-stacked.jpg" alt="成品钢梁构件" loading="lazy">
          </div>
          <div class="cc-content">
            <h3>钢梁</h3>
            <p>用于支撑楼面、屋面、平台和设备的水平结构构件。H型钢梁、组合梁和焊接梁，带预制连接节点。</p>
            <span class="cc-cta">查看钢梁 →</span>
          </div>
        </a>
        <a href="/zh/components/steel-trusses/" class="component-category-card reveal reveal-delay-2">
          <div class="cc-image">
            <img src="/images/components/steel-truss-hero.jpg" alt="工厂内的钢桁架结构" loading="lazy">
          </div>
          <div class="cc-content">
            <h3>钢桁架</h3>
            <p>用于需要减少中间支撑的大跨度结构装配。屋架、转换桁架和管桁架，焊接或螺栓连接。</p>
            <span class="cc-cta">查看钢桁架 →</span>
          </div>
        </a>
        <a href="#quote" class="component-category-card reveal">
          <div class="cc-image">
            <img src="/images/products/02-mining-energy.jpg" alt="工业钢平台结构" loading="lazy">
          </div>
          <div class="cc-content">
            <h3>钢平台</h3>
            <p>用于设备支撑、检修通道和工业操作的高架结构。工作平台、设备平台和通道结构按布局加工。</p>
            <span class="cc-cta">发送平台图纸 →</span>
          </div>
        </a>
        <a href="#quote" class="component-category-card reveal reveal-delay-1">
          <div class="cc-image">
            <img src="/images/products/app-mining-energy.jpg" alt="工业厂房用管廊钢结构" loading="lazy">
          </div>
          <div class="cc-content">
            <h3>管廊</h3>
            <p>支撑工艺管道、电缆桥架和公用设施的结构系统。多层管廊，带协调支撑点和检修平台。</p>
            <span class="cc-cta">发送管廊图纸 →</span>
          </div>
        </a>
        <a href="#quote" class="component-category-card reveal reveal-delay-2">
          <div class="cc-image">
            <img src="/images/products/app-mining-energy-hero.jpg" alt="散料输送用输送廊道钢结构" loading="lazy">
          </div>
          <div class="cc-content">
            <h3>输送廊道</h3>
            <p>散料输送系统的钢结构支撑和围护结构。输送廊道、转运站和支撑结构，带检修通道。</p>
            <span class="cc-cta">发送输送图纸 →</span>
          </div>
        </a>
        <a href="/zh/special-custom-steel-structures/" class="component-category-card reveal">
          <div class="cc-image">
            <img src="/images/products/06-custom-engineering.jpg" alt="复杂几何形状的特殊加工钢结构" loading="lazy">
          </div>
          <div class="cc-content">
            <h3>特殊加工结构</h3>
            <p>需要专门制造的定制和复杂钢结构。曲线结构、空间网架、建筑钢结构和非标准结构装配。</p>
            <span class="cc-cta">查看特殊结构 →</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 02 / 构件定义 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">构件定义</p>
        <h2>每种钢构件的用途</h2>
        <p>各类结构钢构件的明确定义及其在建筑和工业项目中的典型应用。</p>
      </div>
      <div class="definition-grid">
        <div class="definition-item reveal">
          <h4>钢柱</h4>
          <p>将重力荷载（屋面、楼面、设备）和侧向荷载传递到基础的竖向结构构件。可用H型、箱型、格构和组合柱。</p>
        </div>
        <div class="definition-item reveal reveal-delay-1">
          <h4>钢梁</h4>
          <p>承受横向荷载并将其传递给柱子或支撑的水平结构构件。用于楼面支撑、屋面框架、吊车梁和设备支撑。</p>
        </div>
        <div class="definition-item reveal reveal-delay-2">
          <h4>钢桁架</h4>
          <p>以较少材料重量高效承受大跨度荷载的三角化结构装配。用于屋面、桥梁、转换结构和大跨度雨棚。</p>
        </div>
        <div class="definition-item reveal">
          <h4>钢平台</h4>
          <p>提供通道、工作空间或设备支撑的高架结构表面。包括夹层、检修平台、设备平台和通道走道。</p>
        </div>
        <div class="definition-item reveal reveal-delay-1">
          <h4>管廊</h4>
          <p>设计用于支撑工业厂房中工艺管道、电缆桥架、暖通空调管道和公用设施管线的结构框架。多层配置带协调支撑点。</p>
        </div>
        <div class="definition-item reveal reveal-delay-2">
          <h4>输送廊道</h4>
          <p>散料输送设备的封闭或开放式结构支撑系统。包括廊道框架、支撑塔、转运结构和检修通道系统。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / 制造能力 -->
  <section id="fabrication" class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">制造能力</p>
        <h2>钢构件制造能力</h2>
        <p>中赛钢构运营生产基地，配备精密钢构件制造设备，具有文件化的质量流程和面向出口的包装与交付。</p>
      </div>
      <div class="capability-grid">
        <div class="capability-item reveal">
          <h4>数控切割</h4>
          <p>精密数控等离子和火焰切割板材和型钢，确保尺寸准确和切割边缘清洁。</p>
        </div>
        <div class="capability-item reveal reveal-delay-1">
          <h4>钻孔</h4>
          <p>数控钻孔和冲孔，用于螺栓孔、连接板和构件细节，孔位定位准确。</p>
        </div>
        <div class="capability-item reveal reveal-delay-2">
          <h4>焊接</h4>
          <p>合格的焊接工艺和焊工，按项目规范进行角焊、部分熔透和全熔透焊接。</p>
        </div>
        <div class="capability-item reveal">
          <h4>装配</h4>
          <p>构件精密装配，包括组合截面、桁架装配和复杂焊接结构。</p>
        </div>
        <div class="capability-item reveal reveal-delay-1">
          <h4>尺寸检验</h4>
          <p>关键制造阶段的尺寸验证，记录检验结果和配合验证。</p>
        </div>
        <div class="capability-item reveal reveal-delay-2">
          <h4>表面处理</h4>
          <p>按SA 2.5或项目指定标准进行抛丸和表面处理，然后进行涂层施工。</p>
        </div>
        <div class="capability-item reveal">
          <h4>涂装</h4>
          <p>多道涂装体系，包括底漆、中间漆和面漆，按规范验证干膜厚度。</p>
        </div>
        <div class="capability-item reveal reveal-delay-1">
          <h4>镀锌</h4>
          <p>适用于镀锌浴尺寸的构件热浸镀锌协调，按适用标准执行。</p>
        </div>
        <div class="capability-item reveal reveal-delay-2">
          <h4>试拼装</h4>
          <p>按项目规范要求对复杂结构进行试拼装，发货前验证配合。</p>
        </div>
        <div class="capability-item reveal">
          <h4>构件编号</h4>
          <p>与装配图匹配的唯一构件标识系统，包括件号、方向和连接参考。</p>
        </div>
        <div class="capability-item reveal reveal-delay-1">
          <h4>出口包装</h4>
          <p>为集装箱运输组织的包装，附详细装箱单、构件清单和处理说明。</p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 30px;">
        <a href="/zh/manufacturing-quality/" class="btn btn-outline">查看制造与质量 →</a>
      </div>
    </div>
  </section>

  <!-- 04 / 基于图纸制造 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">基于图纸</p>
        <h2>基于客户图纸的制造</h2>
        <p>中赛钢构根据客户提供的图纸和规范制造钢构件，按需提供工程协调和深化支持。</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/manufacturing/real/workshop-overview-wide-9815.jpg" alt="基于客户图纸的钢构件制造" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>基于图纸制造的工作方式</h3>
          <ul>
            <li>可按客户发布的IFC（施工图）图纸和加工图制造</li>
            <li>可按项目范围要求提供结构深化和连接设计协调支持</li>
            <li>可在生产前进行连接优化和制造可行性评审</li>
            <li>可按项目指定的材料牌号、焊接标准和检验要求生产</li>
            <li>仅在批准图纸和确认技术规范后进行制造</li>
            <li>中赛钢构不承担超出项目合同明确约定范围的结构设计责任</li>
          </ul>
          <div style="margin-top: 20px;">
            <a href="/zh/engineering-design/" class="btn btn-outline">查看工程与深化 →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 / 所需资料 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">所需资料</p>
        <h2>制造评审典型所需资料</h2>
        <p>项目文件越完整，制造评审和报价越准确。提交现有资料，中赛钢构将确认所需的任何补充信息。</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>结构图纸</h3>
          <p>总体布置图、结构图纸和连接细节，用于构件制造评审。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>加工图纸</h3>
          <p>制造图纸、构件清单和材料表（如有），用于准确的生产计划。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>材料牌号</h3>
          <p>指定的钢材牌号、材料标准和任何特殊材料要求或测试需求。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>连接要求</h3>
          <p>螺栓或焊接连接规范、螺栓等级、连接设计标准和检验要求。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>焊接要求</h3>
          <p>焊接工艺规范、焊工资格要求、无损检测等级和验收标准。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>表面处理</h3>
          <p>所需表面保护体系：涂装规范、镀锌要求或复合涂层体系。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">07</div>
          <h3>数量 / 吨位</h3>
          <p>估算构件数量、总钢吨位、分批交付要求和生产进度需求。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">08</div>
          <h3>项目国家</h3>
          <p>项目位置，用于适用设计规范、环境条件、物流规划和出口文件。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">09</div>
          <h3>目的港</h3>
          <p>目的港或交付地点，用于物流规划、包装组织和出口文件协调。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">10</div>
          <h3>要求进度</h3>
          <p>要求的制造时间线、分批交付日期和影响生产计划的现场安装顺序。</p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 30px;">
        <a href="#quote" class="btn btn-primary">上传钢构件图纸</a>
      </div>
    </div>
  </section>

  <!-- 06 / 服务行业 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">服务行业</p>
        <h2>钢构件服务的行业</h2>
        <p>中赛钢构制造的钢构件用于广泛的行业和应用，每个行业都有特定的结构要求。</p>
      </div>
      <div class="industry-grid">
        <a href="/zh/steel-workshop/" class="industry-card reveal">
          <h4>工业厂房</h4>
          <p>制造设施、加工厂、车间和工业建筑，带吊车和设备支撑要求。</p>
        </a>
        <a href="/zh/steel-warehouse/" class="industry-card reveal reveal-delay-1">
          <h4>仓储物流</h4>
          <p>物流中心、配送枢纽、仓储设施和工业仓库，大跨度和货架要求。</p>
        </a>
        <a href="/zh/steel-mining-factory/" class="industry-card reveal reveal-delay-2">
          <h4>矿业</h4>
          <p>选矿厂、输送廊道、管廊、设备平台和重工业结构。</p>
        </a>
        <a href="/zh/steel-mining-factory/" class="industry-card reveal">
          <h4>能源</h4>
          <p>发电厂、能源设施、工业基础设施和重型设备支撑结构。</p>
        </a>
        <a href="/zh/agricultural-steel-buildings/" class="industry-card reveal reveal-delay-1">
          <h4>农业</h4>
          <p>畜牧建筑、家禽舍、农场仓储、农业设施和温室结构。</p>
        </a>
        <a href="/zh/commercial-public-steel-buildings/" class="industry-card reveal reveal-delay-2">
          <h4>商业建筑</h4>
          <p>商业结构、公共建筑、展览馆、体育设施和建筑钢结构。</p>
        </a>
        <a href="/zh/transportation-infrastructure-steel/" class="industry-card reveal">
          <h4>基础设施</h4>
          <p>人行天桥、站房结构、雨棚、连廊和交通基础设施钢构件。</p>
        </a>
      </div>
    </div>
  </section>

  <!-- 07 / 相关解决方案 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">相关方案</p>
        <h2>按应用的完整建筑解决方案</h2>
        <p>除独立钢构件外，中赛钢构还提供按行业和应用的完整预制钢结构建筑解决方案。</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3><a href="/zh/steel-workshop/" style="color: inherit; text-decoration: none;">钢结构厂房</a></h3>
            <p>工业制造建筑、加工车间和带吊车设施。</p>
            <a href="/zh/steel-workshop/" style="color: #2563eb; font-size: 14px; font-weight: 600;">查看钢结构厂房 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3><a href="/zh/steel-warehouse/" style="color: inherit; text-decoration: none;">钢结构仓库</a></h3>
            <p>物流仓库、配送中心和工业仓储建筑。</p>
            <a href="/zh/steel-warehouse/" style="color: #2563eb; font-size: 14px; font-weight: 600;">查看钢结构仓库 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3><a href="/zh/steel-mining-factory/" style="color: inherit; text-decoration: none;">矿业与重工业</a></h3>
            <p>选矿厂、加工设施、输送系统和重工业结构。</p>
            <a href="/zh/steel-mining-factory/" style="color: #2563eb; font-size: 14px; font-weight: 600;">查看矿业 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
