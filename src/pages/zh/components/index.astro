---
// ZhongSai V2 - Chinese Components Hub (Rebuilt: all cards have clear action)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/hub.css';

const lang = 'zh';
const title = '钢构件与围护系统｜钢梁、钢柱、桁架、檩条、彩钢板｜中赛钢构';
const description = '中赛钢构按图纸定制加工钢构件与围护系统：钢梁、钢柱、桁架、行车梁、C/Z型钢檩条、屋面板、墙面板、夹芯板，提供构件编号、包装与出口交付。';

const primaryMembers = [
  { title: '钢梁', desc: 'H型钢梁、组合截面梁、焊接梁，按图纸加工，预制端部连接板。', href: '/zh/components/fabricated-steel-beams-columns/#steel-beams', actionType: 'anchor', cta: '查看钢梁 →' },
  { title: '钢柱', desc: 'H型钢柱、箱型柱、格构柱，按荷载与高度设计，预制底板与加劲板。', href: '/zh/components/fabricated-steel-beams-columns/#steel-columns', actionType: 'anchor', cta: '查看钢柱 →' },
  { title: '箱型截面', desc: '箱型柱与箱型梁，适用于大跨度重载结构，按图纸全熔透焊接加工。', href: '/zh/components/fabricated-steel-beams-columns/#box-sections', actionType: 'anchor', cta: '查看箱型截面 →' },
  { title: '行车梁', desc: '桥式行车梁与悬挂行车梁，按行车吨位与工作制设计，按行车系统要求加工。', href: '/zh/components/fabricated-steel-beams-columns/#crane-beams', actionType: 'anchor', cta: '查看行车梁 →' },
  { title: '钢桁架', desc: '屋架桁架、转换桁架、管桁架，按跨度与荷载设计，焊接或螺栓连接。', href: '/zh/components/steel-trusses/', actionType: 'detail', cta: '查看钢桁架 →' },
  { title: '平台与支撑', desc: '操作平台、设备平台、柱间支撑与屋面支撑，按设备布局与结构稳定要求定制加工。', href: '#quote', actionType: 'quote', cta: '发送平台与支撑图纸 →' }
];

const secondaryMembers = [
  { title: 'C型钢檩条', desc: '冷弯C型檩条，用于屋面墙面次结构，按间距与荷载选型，预制连接孔。', href: '/zh/components/steel-purlins/#c-purlins', actionType: 'anchor', cta: '查看C型钢檩条 →' },
  { title: 'Z型钢檩条', desc: '冷弯Z型檩条，搭接连接，适用于大间距屋面，连续抗弯性能优于C型。', href: '/zh/components/steel-purlins/#z-purlins', actionType: 'anchor', cta: '查看Z型钢檩条 →' },
  { title: '支撑系统', desc: '柱间支撑、屋面水平支撑与垂直支撑，采用角钢或圆钢，确保整体结构稳定。', href: '#quote', actionType: 'quote', cta: '发送支撑系统需求 →' },
  { title: '连接构件', desc: '节点板、加劲板、连接板与高强螺栓，按深化图预制，确保现场安装精准。', href: '#quote', actionType: 'quote', cta: '发送节点详图 →' }
];

const claddingSystems = [
  { title: '屋面板', desc: '彩涂压型屋面板、直立锁边板，多种板型与厚度，防水抗风。', href: '/zh/components/roof-wall-cladding-systems/#roof-panels', actionType: 'anchor', cta: '查看屋面板 →' },
  { title: '墙面板', desc: '彩涂压型墙面板，横铺与竖铺，多种板型与颜色，建筑外观协调统一。', href: '/zh/components/roof-wall-cladding-systems/#wall-panels', actionType: 'anchor', cta: '查看墙面板 →' },
  { title: '夹芯板', desc: 'EPS/PU/PIR夹芯板，保温隔热，适用于有温控要求的厂房与仓库。', href: '/zh/components/roof-wall-cladding-systems/#sandwich-panels', actionType: 'anchor', cta: '查看夹芯板 →' },
  { title: '围护附件', desc: '天沟、收边、泛水、采光带、通风器——完整的围护附件配套。', href: '/zh/components/roof-wall-cladding-systems/#cladding-accessories', actionType: 'anchor', cta: '查看围护附件 →' }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <section class="hub-hero">
    <div class="hub-hero-bg" style="background-image: url('/images/manufacturing/real/assembly-welding-9821.jpg')"></div>
    <div class="hub-hero-overlay"></div>
    <div class="container hub-hero-content">
      <div class="hub-breadcrumb">
        <a href="/zh/">首页</a><span>/</span><span>构件</span>
      </div>
      <p class="eyebrow">构件 · 按钢构件类型</p>
      <h1>按图纸定制加工<br>钢构件与围护系统</h1>
      <p class="lead">钢梁、钢柱、桁架、檩条、屋面板与墙面板——按图纸定制加工、构件编号、包装出口交付。<strong>构件按钢构件类型分类。</strong>按建筑应用查看完整方案，请前往 <a href="/zh/products/" style="color:rgba(255,255,255,0.92);text-decoration:underline;">产品</a> 页面。</p>
    </div>
  </section>

  <section class="component-section">
    <div class="container">
      <div class="component-section-header reveal">
        <p class="section-index">01 / 主要受力构件</p>
        <h2>主要受力构件</h2>
        <p>建筑主要承重构件，包括钢梁、钢柱、桁架与行车梁——按结构图纸与荷载要求定制加工。</p>
      </div>
      <div class="component-item-grid">
        {primaryMembers.map((item, i) => (
          <a href={item.href} class={`component-item component-item-clickable reveal reveal-delay-${(i % 3) + 1}`}>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
            <span class="component-item-cta">{item.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="component-section" style="background: var(--color-gray-50);">
    <div class="container">
      <div class="component-section-header reveal">
        <p class="section-index">02 / 次要构件</p>
        <h2>次要结构构件</h2>
        <p>屋面墙面次结构、支撑系统与连接构件——与主要构件配合形成完整受力体系。</p>
      </div>
      <div class="component-item-grid">
        {secondaryMembers.map((item, i) => (
          <a href={item.href} class={`component-item component-item-clickable reveal reveal-delay-${(i % 3) + 1}`}>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
            <span class="component-item-cta">{item.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="component-section">
    <div class="container">
      <div class="component-section-header reveal">
        <p class="section-index">03 / 围护系统</p>
        <h2>屋面与墙面围护系统</h2>
        <p>屋面板、墙面板、夹芯板与围护附件——可与主要钢结构配套供应，形成完整建筑围护体系。</p>
      </div>
      <div class="component-item-grid">
        {claddingSystems.map((item, i) => (
          <a href={item.href} class={`component-item component-item-clickable reveal reveal-delay-${(i % 3) + 1}`}>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
            <span class="component-item-cta">{item.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="dual-path-section">
    <div class="container">
      <div class="section-heading reveal" style="color: white; text-align: center; display: block; margin-bottom: 8px;">
        <p class="section-index" style="color: #f59e0b;">04 / 流程</p>
        <h2 style="color: white; margin-bottom: 10px;">从图纸到交付</h2>
        <p style="color: rgba(255,255,255,0.65); max-width: 700px; margin: 0 auto;">您提供图纸——我们完成加工、编号、包装与出口交付。</p>
      </div>
      <div class="dual-path-grid" style="grid-template-columns: repeat(4, 1fr); gap: 18px;">
        <div class="dual-path-card reveal reveal-delay-1" style="padding: 24px 20px;">
          <div class="path-icon" style="width: 40px; height: 40px; font-size: 15px; font-weight: 700; color:#fff; margin-bottom: 12px;">01</div>
          <h3 style="font-size: 16px; margin-bottom: 6px;">深化设计</h3>
          <p style="font-size: 13px; margin-bottom: 0;">结构图纸转化为加工图与构件清单</p>
        </div>
        <div class="dual-path-card reveal reveal-delay-2" style="padding: 24px 20px;">
          <div class="path-icon" style="width: 40px; height: 40px; font-size: 15px; font-weight: 700; color:#fff; margin-bottom: 12px;">02</div>
          <h3 style="font-size: 16px; margin-bottom: 6px;">加工制造</h3>
          <p style="font-size: 13px; margin-bottom: 0;">切割、装配、焊接、钻孔与表面处理</p>
        </div>
        <div class="dual-path-card reveal reveal-delay-3" style="padding: 24px 20px;">
          <div class="path-icon" style="width: 40px; height: 40px; font-size: 15px; font-weight: 700; color:#fff; margin-bottom: 12px;">03</div>
          <h3 style="font-size: 16px; margin-bottom: 6px;">构件编号</h3>
          <p style="font-size: 13px; margin-bottom: 0;">按加工图构件编号与包装清单</p>
        </div>
        <div class="dual-path-card reveal reveal-delay-4" style="padding: 24px 20px;">
          <div class="path-icon" style="width: 40px; height: 40px; font-size: 15px; font-weight: 700; color:#fff; margin-bottom: 12px;">04</div>
          <h3 style="font-size: 16px; margin-bottom: 6px;">包装出口</h3>
          <p style="font-size: 13px; margin-bottom: 0;">按编号顺序包装装柜，出口资料支持</p>
        </div>
      </div>
    </div>
  </section>

  <section class="quote-cta-section" id="quote">
    <div class="container">
      <div class="quote-cta-header reveal">
        <p class="section-index" style="color: #f59e0b;">05 / 获取报价</p>
        <h2>发送图纸获取构件报价</h2>
        <p>上传结构图纸或BOQ材料清单，中赛将根据您的需求提供构件加工与围护系统报价。</p>
      </div>
      <QuoteForm lang={lang} />
    </div>
  </section>
</BaseLayout>

<style>
  .component-item-clickable {
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .component-item-clickable:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  }
  .component-item-cta {
    display: inline-block;
    margin-top: 12px;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
