---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../../components/QuoteForm.astro';
import '../../../../styles/detail.css';

const lang = 'zh';
const title = '项目用钢桁架结构｜深化、制造与出口｜中赛钢构';
const description = '适用于工业建筑、仓库、公共建筑及大跨度应用的项目定制钢桁架结构。中赛钢构基于批准的项目图纸提供结构深化、制造、出口交付和技术支持。';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/components/steel-truss-hero.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">项目钢结构 · 钢桁架结构</span>
      <h1>大跨度项目用钢桁架结构</h1>
      <p class="lead">面向工业厂房、仓库、公共建筑及其他大跨度项目，基于项目图纸提供钢桁架深化、节点协调、制造、分段运输与出口交付。</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">提交图纸进行技术评审</a>
        <a href="/zh/manufacturing-quality/" class="btn btn-outline">查看工程制造能力</a>
      </div>
    </div>
  </section>

  <!-- Hero Evidence Strip -->
  <section class="detail-section" style="padding-top: 0;">
    <div class="container">
      <div class="hero-strip">
        <span>工程深化</span>
        <span>节点协调</span>
        <span>工厂制造</span>
        <span>分段运输</span>
        <span>出口交付</span>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/zh/">首页</a>
      <span class="sep">/</span>
      <a href="/zh/components/">钢构件</a>
      <span class="sep">/</span>
      <span class="current">钢桁架结构</span>
    </div>
  </nav>

  <!-- 01 / 什么时候适合采用钢桁架 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">适用场景</p>
        <h2>什么时候适合采用钢桁架？</h2>
        <p>钢桁架通常用于需要较大无柱空间、较长跨度、设备或建筑功能对空间布置有特殊要求的项目。最终体系仍应根据跨度、荷载、建筑功能、运输条件和当地设计规范确定。</p>
      </div>
      <div class="scenario-grid">
        <div class="scenario-card reveal">
          <span class="scenario-num">01</span>
          <h4>工业厂房与生产建筑</h4>
          <p>大型制造工厂和加工设施，需要无柱生产空间与吊车净空，桁架屋面可减少中间柱对工艺流程的干扰。</p>
        </div>
        <div class="scenario-card reveal reveal-delay-1">
          <span class="scenario-num">02</span>
          <h4>仓库与物流建筑</h4>
          <p>配送中心和物流仓库，需要大跨度用于货架系统与物料搬运设备布置，减少柱位对存储布局的影响。</p>
        </div>
        <div class="scenario-card reveal">
          <span class="scenario-num">03</span>
          <h4>体育、展览与公共建筑</h4>
          <p>室内体育馆、展览中心和文化设施，需要运动场地或展览空间上方的大跨度无柱屋面。</p>
        </div>
        <div class="scenario-card reveal reveal-delay-1">
          <span class="scenario-num">04</span>
          <h4>特殊大跨度与转换结构</h4>
          <p>飞机库、车站雨棚、交通枢纽，以及混合用途建筑中楼层柱网变化时的转换桁架。</p>
        </div>
      </div>
      <p class="secondary-note reveal">除上述主场景外，钢桁架也用于屋面轮廓特殊、设备吊挂复杂或需要局部大跨的各类建筑。在适合的跨度、荷载和结构条件下，桁架体系可通过三角化受力提高材料利用效率；在部分大跨度项目中，合理的桁架体系可以在结构性能、空间利用和材料效率之间取得更合适的平衡。具体是否采用桁架，仍应按项目条件由设计方确定。</p>
      <div class="evidence-strip">
        <figure class="evidence-item reveal">
          <img src="/images/components/application-industrial-workshop-frame.jpg" alt="大型工业厂房内部桁架屋面与无柱生产空间" loading="lazy">
          <figcaption>工业厂房桁架屋面提供无柱生产空间</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-1">
          <img src="/images/blog/portal-frame-vs-truss-steel-building/2-truss.jpg" alt="桁架式钢框架结构施工现场，塔吊吊装桁架梁" loading="lazy">
          <figcaption>桁架式框架用于大跨度结构施工</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-2">
          <img src="/images/projects/shenzhen-international-zhanjiang-logistics-port.jpg" alt="物流仓储项目钢框架结构" loading="lazy">
          <figcaption>仓储物流项目应用大跨度桁架体系</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 02 / 从项目图纸到可制造钢桁架 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">工程深化</p>
        <h2>从项目图纸到可制造钢桁架</h2>
        <p>中赛钢构根据批准的项目资料进行工程协调和深化，重点处理桁架布置、节点连接、制造拆分、运输分段和加工图纸之间的衔接。责任范围由项目合同和批准图纸确定。</p>
      </div>
      <div class="eng-flow">
        <div class="process-step reveal">
          <div class="step-num">01</div>
          <h4>项目资料评审</h4>
          <p>评审建筑和结构图纸，确认跨度、荷载、节点与连接要求。</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">02</div>
          <h4>结构与节点协调</h4>
          <p>基于确认的结构设计，协调构件尺寸、节点细节与连接方案。</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">03</div>
          <h4>深化与加工图</h4>
          <p>开发可制造的加工图纸，含构件、节点、拼接与底板接口。</p>
        </div>
        <div class="process-step reveal">
          <div class="step-num">04</div>
          <h4>制造分段</h4>
          <p>按运输和安装条件拆分构件，优化分段长度与现场连接。</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>运输与包装考虑</h4>
          <p>结合集装箱和公路运输限制，确定包装、装柜与吊装方案。</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">06</div>
          <h4>制造与交付</h4>
          <p>在批准图纸和确认技术规范后进行制造、检验与出口交付。</p>
        </div>
      </div>
      <p class="params-note reveal"><strong>范围说明：</strong>中赛钢构可提供项目深化和制造协调支持。结构设计责任由项目合同、批准图纸和适用的专业要求确定，中赛钢构不承担超出项目合同明确约定范围的结构设计责任。</p>
      <div class="media-gallery media-gallery--grid2" style="margin-top: 28px;">
        <figure class="media-tile reveal">
          <img src="/images/manufacturing/process/01-drawing-review.jpg" alt="工程师在车间核对项目图纸与加工信息" loading="lazy">
          <figcaption>项目图纸评审与信息核对</figcaption>
        </figure>
        <figure class="media-tile reveal reveal-delay-1">
          <img src="/images/engineering/workflow/step-05-shop-detailing.jpg" alt="深化设计人员绘制桁架加工图" loading="lazy">
          <figcaption>深化与加工图绘制</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 03 / 工程条件表格 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">工程条件</p>
        <h2>钢桁架项目需要确认哪些工程条件？</h2>
        <p>钢桁架设计和制造需要确认以下工程条件。具体数值由项目图纸、设计荷载和适用的当地设计规范确定。</p>
      </div>
      <div class="params-table-wrapper reveal">
        <table class="params-table">
          <thead>
            <tr>
              <th>项目条件</th>
              <th>需要确认</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>跨度与柱网</td>
              <td>净跨、柱距、建筑净空和桁架支承位置。</td>
            </tr>
            <tr>
              <td>设计荷载</td>
              <td>恒载、活载、风、雪、地震等按项目位置与适用规范确认。</td>
            </tr>
            <tr>
              <td>吊车与设备荷载</td>
              <td>吊车等级、起重量、设备重量及动力荷载对桁架的影响。</td>
            </tr>
            <tr>
              <td>连接与拼接</td>
              <td>高强螺栓连接、焊接连接、现场拼接与运输分段位置。</td>
            </tr>
            <tr>
              <td>挠度与使用要求</td>
              <td>按规范与项目要求的挠度限值，尤其支撑脆性饰面的大跨度屋架。</td>
            </tr>
            <tr>
              <td>防腐与环境</td>
              <td>使用环境腐蚀类别，决定涂装或热浸镀锌等表面保护体系。</td>
            </tr>
            <tr>
              <td>运输与分段</td>
              <td>集装箱尺寸、公路运输限制、超长分段及现场吊装条件。</td>
            </tr>
            <tr>
              <td>适用规范</td>
              <td>项目所在地及客户指定的设计、材料与施工标准。</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="params-note reveal">以上为通用确认项。实际设计值、荷载组合和安全系数按项目图纸、批准技术规范与当地设计规范确定。</p>
    </div>
  </section>

  <!-- 04 / 制造与质量控制 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">制造质量</p>
        <h2>钢桁架制造与质量控制</h2>
        <p>中赛钢构在东莞和惠州设有制造基地，用于钢结构构件制造、检查、包装和出口交付准备。制造按项目批准图纸、适用工艺要求和检验要求执行。</p>
      </div>
      <div class="mf-flow">
        <div class="process-step reveal">
          <div class="step-num">01</div>
          <h4>下料与钻孔</h4>
          <p>数控下料、钻孔与节点板加工，控制尺寸与孔位精度。</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">02</div>
          <h4>组立与焊接</h4>
          <p>按项目批准图纸、适用工艺要求和检验要求进行制造与焊接。</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">03</div>
          <h4>尺寸与构件检查</h4>
          <p>关键制造阶段的几何形状、节点位置与连接配合验证。</p>
        </div>
        <div class="process-step reveal">
          <div class="step-num">04</div>
          <h4>必要时试拼装</h4>
          <p>按项目规范要求，对复杂桁架进行发货前试拼装验证。</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>表面处理与编号</h4>
          <p>抛丸、涂装或镀锌协调，并按装配图完成构件编号与包装准备。</p>
        </div>
      </div>
      <div class="evidence-strip">
        <figure class="evidence-item reveal">
          <img src="/images/components/steel-truss-fabrication.jpg" alt="工厂内焊工焊接大型钢桁架构件，行车吊装配合" loading="lazy">
          <figcaption>桁架构件焊接制造</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-1">
          <img src="/images/components/finished-steel-members-stacked.jpg" alt="成品钢构件堆场，构件带编号标识" loading="lazy">
          <figcaption>成品构件堆场与编号管理</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-2">
          <img src="/images/components/finished-coated-components.jpg" alt="涂装完成的钢结构构件，表面带手写编号" loading="lazy">
          <figcaption>表面涂装完成的构件</figcaption>
        </figure>
      </div>
      <div style="text-align: center; margin-top: 30px;">
        <a href="/zh/manufacturing-quality/" class="btn btn-outline">查看制造与质量 →</a>
      </div>
    </div>
  </section>

  <!-- 05 / 关键节点与制造细节 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">节点细节</p>
        <h2>关键节点与制造细节</h2>
        <p>钢桁架的连接与制造细节对项目性能至关重要。连接设计基于项目结构图纸和适用标准协调，表面保护体系根据项目环境、腐蚀类别与设计寿命要求选择。</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image reveal">
          <img src="/images/components/complex-steel-truss-fabrication.jpg" alt="工厂内复杂钢桁架制造，CHS/RHS相贯节点" loading="lazy">
        </div>
        <div class="itb-content reveal">
          <h3>连接与表面处理要点</h3>
          <ul>
            <li><strong>节点板：</strong>多构件汇交处定制节点板，精确孔位与焊接准备，确保桁架装配准确。</li>
            <li><strong>高强螺栓连接：</strong>现场装配用螺栓等级、孔公差与拧紧程序按项目要求执行。</li>
            <li><strong>工厂焊接：</strong>角钢桁架节点板焊接，管桁架直接焊接 CHS/RHS 节点，按批准工艺与检验要求执行。</li>
            <li><strong>现场拼接：</strong>运输分段拼接接头按荷载传递与现场装配精度设计，优化位置以减少现场连接。</li>
            <li><strong>表面涂装：</strong>多道涂装体系（底漆、中间漆、面漆），按规范验证干膜厚度。</li>
            <li><strong>热浸镀锌：</strong>适用于镀锌浴尺寸的构件，仅在项目要求时采用。</li>
          </ul>
        </div>
      </div>
      <p class="params-note reveal"><strong>说明：</strong>具体防腐保护体系由项目环境、腐蚀类别、客户规范、当地标准和设计寿命要求确定。中赛钢构不保证固定的无腐蚀使用寿命；实际性能取决于环境、维护和涂层体系规范。</p>
    </div>
  </section>

  <!-- 06 / 面向出口运输的钢桁架工程考虑 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">出口交付</p>
        <h2>面向出口运输的钢桁架工程考虑</h2>
        <p>钢桁架按出口交付设计和包装，从运输设计到现场安装技术衔接形成连续流程，重点考虑运输分段、集装箱装载和现场装配要求。</p>
      </div>
      <div class="export-chain">
        <div class="chain-step reveal"><span class="chain-num">01</span>运输设计</div>
        <div class="chain-arrow reveal reveal-delay-1">→</div>
        <div class="chain-step reveal reveal-delay-1"><span class="chain-num">02</span>构件分段</div>
        <div class="chain-arrow reveal reveal-delay-2">→</div>
        <div class="chain-step reveal reveal-delay-2"><span class="chain-num">03</span>编号</div>
        <div class="chain-arrow reveal reveal-delay-3">→</div>
        <div class="chain-step reveal reveal-delay-3"><span class="chain-num">04</span>包装</div>
        <div class="chain-arrow reveal">→</div>
        <div class="chain-step reveal"><span class="chain-num">05</span>装柜</div>
        <div class="chain-arrow reveal reveal-delay-1">→</div>
        <div class="chain-step reveal reveal-delay-1"><span class="chain-num">06</span>现场安装技术衔接</div>
      </div>
      <div class="evidence-strip">
        <figure class="evidence-item reveal">
          <img src="/images/blog/packing-loading-steel-export/loading.jpg" alt="叉车将成捆镀锌构件装入集装箱" loading="lazy">
          <figcaption>构件装箱与集装箱装载</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-1">
          <img src="/images/blog/packing-loading-steel-export/packing.jpg" alt="带标签的螺栓连接件包装箱" loading="lazy">
          <figcaption>连接件与五金按标签分类包装</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-2">
          <img src="/images/projects/site-erection.jpg" alt="现场汽车吊吊装钢结构构件" loading="lazy">
          <figcaption>现场吊装与安装配合</figcaption>
        </figure>
      </div>
      <p class="params-note reveal"><strong>责任边界：</strong>中赛钢构提供安装技术指导与工程配合，包括构件编号、装配说明和必要的远程技术指导；当地实际施工通常由当地施工方完成。</p>
      <div style="text-align: center; margin-top: 30px;">
        <a href="/zh/export-delivery/" class="btn btn-outline">查看出口与交付 →</a>
      </div>
    </div>
  </section>

  <!-- 07 / 开始项目：需要哪些资料 -->
  <section id="engineering-review" class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">项目资料</p>
        <h2>开始钢桁架项目，我们需要哪些资料？</h2>
        <p>项目文件越完整，技术评审和制造计划越准确。如果部分资料暂时不确定，可以先提交现有信息，工程团队会根据项目情况确认还需要哪些资料。</p>
      </div>
      <div class="quote-info-grid">
        <div class="quote-info-card drawing reveal">
          <h4>已有项目图纸</h4>
          <ul>
            <li>建筑图</li>
            <li>结构图</li>
            <li>设计资料与荷载说明</li>
            <li>BOQ / 构件表（如有）</li>
          </ul>
        </div>
        <div class="quote-info-card no-drawing reveal reveal-delay-1">
          <h4>暂无完整图纸</h4>
          <ul>
            <li>项目国家 / 城市</li>
            <li>建筑用途</li>
            <li>长度 / 宽度 / 高度</li>
            <li>预计跨度与吊车 / 设备条件</li>
            <li>目的港</li>
          </ul>
        </div>
      </div>
      <p class="quote-note reveal">如果部分资料暂时不确定，可以先提交现有信息，工程团队会根据项目情况确认还需要哪些资料。</p>
      <div style="text-align: center; margin-top: 30px;">
        <a href="#quote" class="btn btn-primary">提交现有项目资料</a>
      </div>
