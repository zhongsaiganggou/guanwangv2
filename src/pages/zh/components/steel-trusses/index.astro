---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../../components/QuoteForm.astro';
import '../../../../styles/hub.css';

const lang = 'zh';
const title = '项目用钢桁架结构｜深化、制造与出口｜中赛钢构';
const description = '适用于工业建筑、仓库、公共建筑及大跨度应用的项目定制钢桁架结构。中赛钢构基于批准的项目图纸提供结构深化、制造、出口交付和技术支持。';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="hub-hero">
    <div class="hub-hero-bg" style="background-image: url('/images/components/steel-truss-hero.jpg');"></div>
    <div class="hub-hero-overlay"></div>
    <div class="container hub-hero-content">
      <div class="hub-breadcrumb">
        <a href="/zh/">首页</a><span>/</span><a href="/zh/components/">钢构件</a><span>/</span><span>钢桁架</span>
      </div>
      <p class="eyebrow">项目钢结构 · 钢桁架结构</p>
      <h1>大跨度项目用钢桁架结构</h1>
      <p class="lead">适用于工业建筑、仓库、公共建筑及其他大跨度应用的项目定制钢桁架结构，基于批准的项目图纸提供深化、制造和出口交付。</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">提交项目图纸</a>
        <a href="#engineering-review" class="btn btn-outline">申请技术评审</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/zh/">首页</a>
      <span class="sep">/</span>
      <a href="/zh/components/">钢构件</a>
      <span class="sep">/</span>
      <span class="current">钢桁架结构</span>
    </div>
  </nav>

  <!-- 01 / 结构作用 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">结构作用</p>
        <h2>钢桁架结构在项目中的作用</h2>
        <p>钢桁架是用于需要大跨度或减少中间支撑的三角化结构体系。它们以比实腹梁更少的材料重量，高效承受大跨度的屋面、楼面和转换荷载。</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/components/complex-steel-truss-fabrication.jpg" alt="工厂内复杂钢桁架制造，CHS/RHS相贯节点" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>在建筑项目中的结构角色</h3>
          <ul>
            <li><strong>大跨度屋面支撑：</strong>在没有中间柱子的情况下承受大跨度屋面荷载</li>
            <li><strong>转换结构：</strong>当下层需要无柱空间时，将上部楼层荷载传递到选定的柱子</li>
            <li><strong>轻质高效：</strong>三角化几何形状提供比实腹梁更高的强度重量比</li>
            <li><strong>建筑灵活性：</strong>可配置为各种屋面轮廓，包括坡顶、弧形和平顶</li>
            <li><strong>经济用材：</strong>材料集中在应力最高处，减少整体钢材用量</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / 项目应用 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">项目应用</p>
        <h2>钢桁架在实际项目中的应用场景</h2>
        <p>钢桁架结构广泛应用于需要大跨度、无柱空间的各类建筑和基础设施项目。</p>
      </div>
      <div class="application-grid">
        <div class="app-card reveal">
          <h4>工业厂房</h4>
          <p>大型制造工厂和加工设施，需要无柱生产空间和吊车净空。</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h4>仓储物流</h4>
          <p>配送中心和物流仓库，需要大跨度用于货架系统和物料搬运。</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h4>展览馆</h4>
          <p>展览和会议中心，需要大型无柱楼层面积用于灵活展览布局。</p>
        </div>
        <div class="app-card reveal">
          <h4>体育建筑</h4>
          <p>室内体育馆、健身房和体育场，需要运动场地上方的大跨度屋面。</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h4>飞机库</h4>
          <p>飞机维修机库，需要极大的净跨度用于飞机进出和操作。</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h4>交通设施</h4>
          <p>车站雨棚、机场航站楼和交通枢纽，需要公共空间上方的大跨度屋面结构。</p>
        </div>
        <div class="app-card reveal">
          <h4>公共建筑</h4>
          <p>文化中心、礼堂和社区建筑，需要建筑表现力强的大跨度屋面。</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h4>转换结构</h4>
          <p>混合用途建筑的转换大梁和转换桁架，楼层间柱网变化时使用。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / 工程考虑因素 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">工程考虑</p>
        <h2>桁架项目的关键工程考虑因素</h2>
        <p>钢桁架设计和制造需要仔细考虑多个工程因素。所有具体数值由项目图纸、荷载和适用的当地设计规范确定。</p>
      </div>
      <div class="param-table-container">
        <table class="param-table">
          <thead>
            <tr>
              <th>工程因素</th>
              <th>基于项目的考虑</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>跨度</strong></td>
              <td>由项目建筑要求和柱网布置确定。桁架可根据荷载和挠度标准设计为各种跨度范围。</td>
            </tr>
            <tr>
              <td><strong>结构荷载</strong></td>
              <td>恒载、活载、雪载、风载和地震荷载，按项目位置和适用建筑规范确定。</td>
            </tr>
            <tr>
              <td><strong>吊车荷载</strong></td>
              <td>桥式吊车荷载（如适用），包括吊车起重量、跨度、工作级别和影响桁架设计的冲击系数。</td>
            </tr>
            <tr>
              <td><strong>动力荷载</strong></td>
              <td>支撑机械、输送机或其他动力设备的结构的动力和振动考虑。</td>
            </tr>
            <tr>
              <td><strong>连接类型</strong></td>
              <td>焊接连接（节点板或直接焊接）或螺栓连接（高强度螺栓），根据项目要求和现场装配确定。</td>
            </tr>
            <tr>
              <td><strong>挠度</strong></td>
              <td>按适用规范和项目要求的挠度限值，对支撑脆性饰面的大跨度屋架尤为重要。</td>
            </tr>
            <tr>
              <td><strong>运输限制</strong></td>
              <td>构件和桁架分段尺寸考虑集装箱尺寸、公路运输限制和现场装配要求。</td>
            </tr>
            <tr>
              <td><strong>腐蚀环境</strong></td>
              <td>环境腐蚀类别决定表面保护体系选择，从标准涂装到热浸镀锌。</td>
            </tr>
            <tr>
              <td><strong>现场装配</strong></td>
              <td>现场安装顺序、连接可达性、临时支撑要求和安装公差，按项目条件确定。</td>
            </tr>
            <tr>
              <td><strong>当地设计规范</strong></td>
              <td>按适用的当地建筑规范和项目规范设计，包括材料标准、荷载组合和安全系数。</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 04 / 项目设计与深化 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">设计深化</p>
        <h2>基于项目的设计与深化</h2>
        <p>中赛钢构从项目结构图纸出发，协调深化以开发可制造的桁架图纸，责任范围由项目合同和批准图纸确定。</p>
      </div>
      <div class="process-grid">
        <div class="process-item reveal">
          <div class="process-num">01</div>
          <h4>建筑/结构图纸评审</h4>
          <p>评审客户提供的建筑和结构图纸，包括桁架布置、跨度、荷载和连接要求。</p>
        </div>
        <div class="process-item reveal reveal-delay-1">
          <div class="process-num">02</div>
          <h4>结构深化协调</h4>
          <p>基于确认的结构设计协调加工图开发，包括构件尺寸、节点细节和连接设计。</p>
        </div>
        <div class="process-item reveal reveal-delay-2">
          <div class="process-num">03</div>
          <h4>连接与节点设计</h4>
          <p>开发连接细节，包括节点板、螺栓/焊接连接、拼接接头和底板接口。</p>
        </div>
        <div class="process-item reveal">
          <div class="process-num">04</div>
          <h4>现场装配接口规划</h4>
          <p>规划现场装配接口，包括拼接位置、螺栓可达性、临时支撑和安装顺序考虑。</p>
        </div>
        <div class="process-item reveal reveal-delay-1">
          <div class="process-num">05</div>
          <h4>运输分段设计</h4>
          <p>设计桁架分段用于集装箱运输和公路运输，优化构件长度同时减少现场连接。</p>
        </div>
        <div class="process-item reveal reveal-delay-2">
          <div class="process-num">06</div>
          <h4>批准图纸用于制造</h4>
          <p>仅在批准图纸和确认技术规范后进行制造。责任范围按项目合同确定。</p>
        </div>
      </div>
      <div style="margin-top: 24px; padding: 16px; background: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 4px;">
        <p style="margin: 0; color: #92400e; font-size: 0.9rem;"><strong>范围说明：</strong>中赛钢构可提供项目深化和制造协调支持。结构设计责任由项目合同、批准图纸和适用的专业要求确定。中赛钢构不承担超出项目合同明确约定范围的结构设计责任。</p>
      </div>
    </div>
  </section>

  <!-- 05 / 制造能力 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">制造能力</p>
        <h2>项目钢结构制造能力</h2>
        <p>中赛钢构运营生产基地，配备精密钢桁架制造设备，具有文件化的质量流程和面向出口的包装与交付。</p>
      </div>
      <div class="capability-grid">
        <div class="capability-item reveal">
          <h4>数控切割</h4>
          <p>精密数控等离子和火焰切割桁架构件、节点板和连接板，尺寸准确。</p>
        </div>
        <div class="capability-item reveal reveal-delay-1">
          <h4>钻孔</h4>
          <p>数控钻孔用于节点板、连接板和构件端连接的螺栓孔，孔位定位准确。</p>
        </div>
        <div class="capability-item reveal reveal-delay-2">
          <h4>焊接</h4>
          <p>合格的焊接工艺和焊工，按项目规范进行角焊、部分熔透和全熔透焊接。</p>
        </div>
        <div class="capability-item reveal">
          <h4>装配</h4>
          <p>精密桁架装配，包括构件配合、节点对齐和胎架装配，精确控制几何形状。</p>
        </div>
        <div class="capability-item reveal reveal-delay-1">
          <h4>尺寸检验</h4>
          <p>关键制造阶段的尺寸验证，包括桁架几何形状、节点位置和连接配合。</p>
        </div>
        <div class="capability-item reveal reveal-delay-2">
          <h4>试拼装</h4>
          <p>按项目规范要求对复杂桁架进行试拼装，发货前验证配合和连接对齐。</p>
        </div>
        <div class="capability-item reveal">
          <h4>表面处理</h4>
          <p>按SA 2.5或项目指定标准进行抛丸和表面处理，然后进行涂层施工。</p>
        </div>
        <div class="capability-item reveal reveal-delay-1">
          <h4>涂装</h4>
          <p>多道涂装体系，包括底漆、中间漆和面漆，按规范验证干膜厚度。</p>
        </div>
        <div class="capability-item reveal reveal-delay-2">
          <h4>镀锌</h4>
          <p>适用于镀锌浴尺寸的桁架构件热浸镀锌协调，按适用标准执行。</p>
        </div>
        <div class="capability-item reveal">
          <h4>构件编号</h4>
          <p>与装配图匹配的唯一桁架和构件标识系统，包括件号、方向和连接参考。</p>
        </div>
        <div class="capability-item reveal reveal-delay-1">
          <h4>出口包装</h4>
          <p>为集装箱运输组织的包装，附详细装箱单、桁架构件清单和处理说明。</p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 30px;">
        <a href="/zh/manufacturing-quality/" class="btn btn-outline">查看制造与质量 →</a>
      </div>
    </div>
  </section>

  <!-- 06 / 连接与结构接口 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">连接接口</p>
        <h2>连接与结构接口</h2>
        <p>钢桁架连接和结构接口对项目性能至关重要。连接设计基于项目结构图纸和适用标准进行协调。</p>
      </div>
      <div class="connection-grid">
        <div class="connection-item reveal">
          <h4>焊接连接</h4>
          <p>角钢桁架的节点板焊接连接，以及管桁架的直接焊接CHS/RHS连接。按合格WPS和项目检验要求焊接。</p>
        </div>
        <div class="connection-item reveal reveal-delay-1">
          <h4>螺栓连接</h4>
          <p>现场装配桁架的高强度螺栓连接，包括螺栓等级规范、孔公差和按项目要求的拧紧程序。</p>
        </div>
        <div class="connection-item reveal reveal-delay-2">
          <h4>拼接接头</h4>
          <p>用于运输分段的桁架拼接接头，设计用于荷载传递和现场装配精度。拼接位置优化用于运输和安装。</p>
        </div>
        <div class="connection-item reveal">
          <h4>底板</h4>
          <p>桁架支撑底板和承压连接，包括锚栓接口和向支撑柱或基础的荷载传递。</p>
        </div>
        <div class="connection-item reveal reveal-delay-1">
          <h4>节点板</h4>
          <p>用于多构件连接节点的定制节点板，精确孔位和焊接准备，确保桁架装配准确。</p>
        </div>
        <div class="connection-item reveal reveal-delay-2">
          <h4>建筑接口</h4>
          <p>与建筑结构体系的协调，包括柱连接、支撑接口、屋面系统支撑和侧向荷载传递路径。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 / 表面处理 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">表面处理</p>
        <h2>桁架结构表面处理</h2>
        <p>表面保护体系根据项目环境、腐蚀类别、客户规范和设计寿命要求选择。</p>
      </div>
      <div class="surface-grid">
        <div class="surface-card reveal">
          <h4>涂装体系</h4>
          <p>多道涂装体系，包括环氧底漆、环氧中间漆和聚氨酯面漆。体系选择基于腐蚀类别和项目规范，验证干膜厚度。</p>
        </div>
        <div class="surface-card reveal reveal-delay-1">
          <h4>热浸镀锌</h4>
          <p>适用于镀锌浴尺寸的桁架构件和部件热浸镀锌。为外部和工业环境提供持久的腐蚀保护，按适用标准执行。</p>
        </div>
        <div class="surface-card reveal reveal-delay-2">
          <h4>项目定制涂层</h4>
          <p>用于腐蚀性工业环境的专业涂层体系，包括高性能环氧、聚氨酯和氟碳涂层，按项目规范和环境要求执行。</p>
        </div>
      </div>
      <div style="margin-top: 24px; padding: 16px; background: #f0fdf4; border-left: 4px solid #22c55e; border-radius: 4px;">
        <p style="margin: 0; color: #166534; font-size: 0.9rem;"><strong>说明：</strong>具体防腐保护体系由项目环境、腐蚀类别、客户规范、当地标准和设计寿命要求确定。中赛钢构不保证固定的无腐蚀使用寿命；实际性能取决于环境、维护和涂层体系规范。</p>
      </div>
    </div>
  </section>

  <!-- 08 / 出口与现场装配 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">出口装配</p>
        <h2>出口交付与现场装配考虑</h2>
        <p>中赛钢构桁架结构为出口交付设计和包装，仔细考虑运输分段、集装箱装载和现场装配要求。</p>
      </div>
      <div class="export-grid">
        <div class="export-item reveal">
          <h4>构件编号</h4>
          <p>与装配图匹配的唯一桁架和构件标识系统，包括件号、方向标记和连接参考，确保现场装配准确。</p>
        </div>
        <div class="export-item reveal reveal-delay-1">
          <h4>包装组织</h4>
          <p>桁架构件按装配顺序和连接组包装，成品表面和螺纹部件有保护包装。附详细装箱单。</p>
        </div>
        <div class="export-item reveal reveal-delay-2">
          <h4>集装箱装载</h4>
          <p>优化集装箱装载计划，最大化空间利用同时保护桁架构件。按项目要求提供装载图和集装箱装箱记录。</p>
        </div>
        <div class="export-item reveal">
          <h4>超长构件分段</h4>
          <p>长桁架构件按集装箱和公路运输限制分段，带设计的拼接连接用于现场装配。分段优化以减少现场连接。</p>
        </div>
        <div class="export-item reveal reveal-delay-1">
          <h4>螺栓现场连接</h4>
