---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = '解决方案 | 中赛钢构';
const description = '中赛钢构为工业、商业、农业、矿业、基础设施等行业提供钢结构解决方案。';
const lang = 'zh';
const canonical = 'https://zhongsai-steelstructure.com/zh/products/';
---

<BaseLayout title={title} description={description} lang={lang} canonical={canonical}>
  <section style="padding: 80px 0; text-align: center; background: #f8f9fa;">
    <div class="container">
      <h1 style="font-size: 1.8rem; color: #0a3d62; margin-bottom: 16px;">钢结构解决方案</h1>
      <p style="font-size: 1.05rem; color: #555; margin-bottom: 32px; max-width: 600px; margin-left: auto; margin-right: auto;">
        中赛钢构为工业厂房、仓储物流、商业公共、农业养殖、矿业能源、交通基础设施等行业提供完整的钢结构解决方案。
      </p>
      <a href="/zh/products/" class="btn btn-primary" style="display: inline-block; padding: 14px 32px; font-size: 1rem;">
        查看全部产品与解决方案 →
      </a>
    </div>
  </section>
</BaseLayout>
