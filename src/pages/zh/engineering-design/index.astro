---
// ZhongSai V2 - 中文 工程设计与深化页面（UX / Evidence / CRO 优化版）
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const lang = 'zh';
const title = '钢结构设计与深化｜加工图、节点深化与工程技术支持｜中赛钢构';
const description = '中赛钢构为海外钢结构项目提供工程技术支持：图纸审核、结构协调、加工图深化、节点开发、制造文档和现场技术支持。';
const canonical = 'https://zhongsai-steelstructure.com/zh/engineering-design/';

const engSteps = [
  { num: '01', title: '项目资料评审', desc: '审核建筑图、结构图、总布置图、设备布置图和项目要求，确定工程技术配合范围。' },
  { num: '02', title: '设计条件与结构协调', desc: '确认用途、跨度、高度、荷载、吊车与适用规范，协调柱网、框架布置和荷载传递路径。' },
  { num: '03', title: '深化与加工图', desc: '开发构件尺寸、节点细节和可直接用于制造的加工图，含孔位、焊缝、螺栓与零件编号。' },
  { num: '04', title: '图纸审核与批准', desc: '内部审核加工图的准确性与可制造性，提交客户或工程师审核批准后放行。' },
  { num: '05', title: '制造放行与接口', desc: '将批准图纸和材料清单、装配说明、质量控制要求放行到生产部门。' },
  { num: '06', title: '现场技术支持', desc: '安装期间提供图纸澄清、连接指导、安装顺序协调和技术问题解决。' }
];

const designInputs = [
  { name: '跨度与柱网', desc: '净跨、柱距、檐口高度、建筑尺寸和支承位置' },
  { name: '设计荷载', desc: '恒载、活载、风、雪、抗震要求，按项目位置与适用规范确认' },
  { name: '吊车与设备荷载', desc: '吊车吨位、跨度、工作级别、设备重量及动力荷载（如适用）' },
  { name: '连接与节点', desc: '高强螺栓、焊接、现场拼接条件和节点开发范围' },
  { name: '防腐与环境', desc: '环境暴露类别、湿度、化学暴露和涂层要求' },
  { name: '防火要求', desc: '耐火极限要求和被动防火保护规格' },
  { name: '运输与分段', desc: '集装箱尺寸、超长分段、包装和现场吊装条件' },
  { name: '适用规范', desc: '项目所在地及客户指定的设计、材料与施工标准' }
];

const deliverables = [
  { name: '布置图（GA）', desc: '总体布置、柱网、框架与主要尺寸' },
  { name: '加工图', desc: '构件尺寸、板件、孔位、焊缝与螺栓信息' },
  { name: '节点详图', desc: '连接节点、柱脚、拼接与加劲细节' },
  { name: '材料清单（BOM）', desc: '材料统计、零件编号与采购参考' },
  { name: '安装图', desc: '吊装顺序、安装参考与现场配合' }
];

const nodeTypes = [
  '梁柱连接节点',
  '柱脚与锚栓节点',
  '桁架与相贯节点',
  '拼接节点',
  '支撑与抗侧力连接',
  '吊车牛腿与设备接口'
];

const mfPoints = [
  { name: '可制造性', desc: '构件细节按现有制造设备和工艺能力开发。' },
  { name: '焊接可达性', desc: '连接构造保证焊接操作空间与质量控制条件。' },
  { name: '板材优化', desc: '构件与板件尺寸与标准材料规格协调，减少浪费。' },
  { name: '构件分段', desc: '长构件在适当位置分段，便于运输与现场组装。' }
];

const exportSteps = ['运输设计', '构件分段', '编号', '包装', '装柜', '现场安装技术衔接'];

const standards = [
  { code: 'GB', desc: '中国国家标准，结构设计与制造规范' },
  { code: 'AISC / ASCE', desc: '美国钢结构学会与 ASCE 标准' },
  { code: 'Eurocode', desc: '欧洲钢结构设计标准（EN 1990-1993）' },
  { code: 'Australian', desc: '澳大利亚钢结构标准（AS 4100, AS/NZS 1170）' },
  { code: '其他', desc: '其他项目指定标准，需经技术评审和协调' }
];

const faqs = [
  {
    q: '中赛可以根据建筑图进行工作吗？',
    a: '可以。中赛可以根据建筑图、方案图、总布置图或初步结构图开始工程技术配合。所需的工程协调和深化深度取决于所提供资料的完整程度。如果只有建筑图，可能需要在约定的项目范围内进行额外的结构协调和设计输入。'
  },
  {
    q: '可以提供用于制造的加工图吗？',
    a: '可以。中赛提供可直接用于制造的加工图，包括构件尺寸、板件尺寸、孔位、焊接信息、螺栓连接、零件编号、装配说明和制造注释。加工图与制造流程直接协调，确保能够直接指导生产和现场安装。'
  },
  {
    q: '可以按AISC或Eurocode规范进行项目工作吗？',
    a: '项目设计和深化可以根据项目指定的适用规范进行协调，包括AISC/ASCE、Eurocode、GB、澳大利亚标准或其他项目指定标准，需经技术评审。我们不宣称普遍符合所有国际标准；适用规范根据客户要求和当地法规按项目确认。'
  },
  {
    q: '可以深化带吊车的钢结构建筑吗？',
    a: '可以。中赛有带吊车工业建筑的深化经验，包括吊车梁支撑、牛腿、加劲肋、柱加强和荷载传递节点。吊车吨位、跨度、工作级别和吊车梁要求在深化开始前作为设计条件的一部分进行确认。'
  },
  {
    q: '图纸如何与制造协调？',
    a: '工程和深化与制造团队直接协调。加工图包含制造相关信息，如材料清单、切割清单、装配顺序、焊接细节和质量控制要求。批准的图纸随清晰文档放行到制造部门，工程团队在生产期间可随时提供技术澄清。'
  },
  {
    q: '钢构件可以为集装箱运输进行优化吗？',
    a: '可以。作为出口运输设计的一部分，构件长度和连接位置可以协调以适应标准集装箱尺寸。长构件可以采用螺栓拼接节点分段运输，构件编号与包装和吊装顺序协调。具体分段方式根据项目尺寸、集装箱类型和现场安装要求确定。'
  },
  {
    q: '中赛能配合马来西亚 CIDB 认证要求吗？',
    a: '可以。中赛制造基地持有马来西亚 CIDB IBS 认证（证书号 IBS231/039），覆盖金属框架和钢结构构件。针对马来西亚项目，设计深化、节点开发和制造文件可按 CIDB 认证要求协调。当地审批、注册工程师签章和法定合规仍按项目由业主或其指定的当地持牌工程师负责。'
  },
  {
    q: '中赛提供当地注册工程师签章吗？',
    a: '中赛在约定的项目范围内提供结构工程技术支持、深化和制造文档。当地许可、法定审批和注册工程师签章（如当地法规要求）仍由项目业主或其指定的当地持牌工程师负责。中赛不宣称在所有司法管辖区提供持牌专业工程服务；具体责任分配根据项目合同和当地法规要求确认。'
  }
];

const relatedLinks = [
  { name: '制造与质量控制', href: '/zh/manufacturing-quality/', desc: '工厂制造、质量控制和生产证据' },
  { name: '钢结构厂房', href: '/zh/steel-workshop/', desc: '工业厂房和制造工厂钢结构' },
  { name: '钢结构仓库', href: '/zh/steel-warehouse/', desc: '物流仓储建筑钢结构' },
  { name: '矿业与重工业', href: '/zh/steel-mining-factory/', desc: '矿业和能源重型钢结构' },
  { name: '夹层 / 二层平台 / 特种钢结构', href: '/zh/special-custom-steel-structures/', desc: '夹层、二层平台与定制钢结构的深化设计' },
  { name: '项目案例', href: '/zh/projects/', desc: '真实项目案例，含工程和制造范围' },
  { name: '出口交付', href: '/zh/export-delivery/', desc: '集装箱装柜、出口单证和物流' },
  { name: '联系与报价', href: '/zh/contact/', desc: '提交图纸进行工程评审和报价' }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/company/factory-aerial-panorama.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">工程技术 · 从图纸到制造</span>
      <h1>钢结构设计、深化<br>与工程技术支持</h1>
      <p class="lead">面向海外钢结构项目，提供图纸审核、结构协调、加工图深化、节点开发与制造文档编制。基于项目图纸与适用规范开展工程配合，并衔接工厂制造与出口交付。</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">提交图纸进行工程评审</a>
        <a href="/zh/projects/" class="btn btn-outline">查看项目案例</a>
      </div>
    </div>
  </section>

  <!-- Hero Evidence Strip -->
  <section class="detail-section" style="padding-top: 0;">
    <div class="container">
      <div class="hero-strip">
        <span>图纸审核</span>
        <span>结构协调</span>
        <span>加工图深化</span>
        <span>制造接口</span>
        <span>出口交付</span>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/zh/">首页</a>
      <span class="sep">/</span>
      <span class="current">工程设计与深化</span>
    </div>
  </nav>

  <!-- 01 / 开始项目：需要哪些资料 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">项目资料</p>
        <h2>开始钢结构项目，需要哪些资料？</h2>
        <p>中赛可以从不同完整程度的项目文档开始工程技术配合。项目文件越完整，技术评审和制造计划越准确；如果部分资料暂时不确定，可以先提交现有信息，工程团队会根据项目情况确认还需要哪些资料。</p>
      </div>
      <div class="quote-info-grid">
        <div class="quote-info-card drawing reveal">
          <h4>已有项目图纸</h4>
          <ul>
            <li>建筑图 / 方案图 / 总布置图</li>
            <li>结构图（如有）</li>
            <li>设计资料与荷载说明</li>
            <li>BOQ / 构件表（如有）</li>
          </ul>
        </div>
        <div class="quote-info-card no-drawing reveal reveal-delay-1">
          <h4>暂无完整图纸</h4>
          <ul>
            <li>项目国家 / 城市</li>
            <li>建筑用途与功能</li>
            <li>长度 / 宽度 / 高度</li>
            <li>预计跨度与吊车 / 设备条件</li>
            <li>适用设计规范（如已知）</li>
            <li>目的港</li>
          </ul>
        </div>
      </div>
      <p class="quote-note reveal">没有完整图纸也可以询盘。提供现有信息即可启动技术评审，工程团队会确认还需要哪些资料。</p>
      <div style="text-align: center; margin-top: 30px;">
        <a href="#quote" class="btn btn-primary">提交现有项目资料</a>
      </div>
    </div>
  </section>

  <!-- 02 / 从项目图纸到可制造构件 — 真实工程证据 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">工程证据</p>
        <h2>从项目图纸到可制造构件</h2>
        <p>中赛工程团队基于 Tekla / BIM 模型进行深化，输出加工图、节点详图和制造文档，并直接衔接工厂下料、装配与焊接。以下为真实工程深化与图纸交底样例，客户及项目敏感信息已脱敏处理。</p>
      </div>
      <div class="evidence-strip">
        <figure class="evidence-item reveal">
          <img src="/images/engineering/tekla-model.jpg" alt="Tekla BIM三维钢结构模型，展示梁柱桁架节点关系" loading="lazy">
          <figcaption>Tekla / BIM 三维模型 · 实际模型根据项目建立</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-1">
          <img src="/images/manufacturing/process/01-drawing-review.jpg" alt="工程师在车间核对项目图纸与加工信息" loading="lazy">
          <figcaption>图纸评审与加工交底</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-2">
          <img src="/images/engineering/workflow/step-06-drawing-approval.jpg" alt="图纸确认与批准流程" loading="lazy">
          <figcaption>加工前图纸确认与批准</figcaption>
        </figure>
      </div>
      <p class="params-note reveal"><strong>范围说明：</strong>中赛在约定的项目范围内提供结构工程技术支持、深化和制造文档。结构设计责任由项目合同、批准图纸和适用的专业要求确定；当地审批与注册工程师签章仍按项目由业主或其指定的当地持牌工程师负责。</p>
    </div>
  </section>

  <!-- 03 / 工程设计与深化流程 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">工作流程</p>
        <h2>工程设计与深化工作流程</h2>
        <p>从项目资料评审到制造放行和现场技术支持，每个阶段都有质量控制与审核节点，确保图纸准确、可制造并与现场衔接。</p>
      </div>
      <div class="eng-flow">
        {engSteps.map((step, i) => (
          <div class={`process-step reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="step-num">{step.num}</div>
            <h4>{step.title}</h4>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 / 工程输入与设计条件 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">设计输入</p>
        <h2>工程输入与设计条件</h2>
        <p>结构设计和深化基于项目特定的设计条件。这些输入在项目开始时确认，指导所有工程决策；具体数值由项目图纸、设计荷载和适用的当地设计规范确定。</p>
      </div>
      <div class="params-table-wrapper reveal">
        <table class="params-table">
          <thead>
            <tr>
              <th>项目条件</th>
              <th>需要确认</th>
            </tr>
          </thead>
          <tbody>
            {designInputs.map(row => (
              <tr>
                <td>{row.name}</td>
                <td>{row.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="params-note reveal">以上为通用确认项。风荷载、雪荷载、抗震要求和其他条件因项目位置和适用规范而异，所有设计输入根据客户提供的信息和当地法规要求按项目确认。</p>
    </div>
  </section>

  <!-- 05 / 设计与深化交付物 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">交付物</p>
        <h2>设计与深化交付物</h2>
        <p>从结构方案到加工图、节点详图和安装图，中赛工程团队按项目阶段输出完整图纸资料，并直接衔接工厂制造。</p>
      </div>
      <div class="media-gallery media-gallery--feature3">
        <figure class="media-tile reveal">
          <img src="/images/engineering/workflow/step-05-shop-detailing.jpg" alt="深化设计人员绘制构件加工图" loading="lazy">
          <figcaption>加工图与构件详图绘制</figcaption>
        </figure>
        <figure class="media-tile reveal reveal-delay-1">
          <img src="/images/engineering/workflow/step-04-connection-development.jpg" alt="连接节点深化设计样例" loading="lazy">
          <figcaption>连接节点深化</figcaption>
        </figure>
        <figure class="media-tile reveal reveal-delay-2">
          <img src="/images/blog/overhead-crane-workshop-design/crane-column-detail.jpg" alt="吊车梁与柱节点详图" loading="lazy">
          <figcaption>吊车梁系统详图</figcaption>
        </figure>
      </div>
      <div class="deliverables-two-col">
        <div class="reveal">
          <h3 class="col-title">图纸交付物</h3>
          <ul class="check-list">
            {deliverables.map(item => (
              <li><strong>{item.name}</strong> — {item.desc}</li>
            ))}
          </ul>
        </div>
        <div class="reveal reveal-delay-1">
          <h3 class="col-title">节点深化类型</h3>
          <ul class="check-list">
            {nodeTypes.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 / 面向制造与出口运输的设计 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">制造与出口</p>
        <h2>面向制造与出口运输的设计</h2>
        <p>工程不脱离制造与运输。中赛将设计深化与制造能力协调，并按集装箱运输和现场安装要求进行构件分段、编号、包装与装柜规划。</p>
      </div>
      <div class="mf-points">
        {mfPoints.map((point, i) => (
          <div class={`mf-point reveal reveal-delay-${(i % 4) + 1}`}>
            <h4>{point.name}</h4>
            <p>{point.desc}</p>
          </div>
        ))}
      </div>
      <div class="export-chain">
        {exportSteps.map((step, i) => (
          <>
            {i > 0 && <span class="chain-arrow reveal">→</span>}
            <span class="chain-step reveal"><span class="chain-num">0{i + 1}</span>{step}</span>
          </>
        ))}
      </div>
      <div class="evidence-strip">
        <figure class="evidence-item reveal">
          <img src="/images/blog/packing-loading-steel-export/loading.jpg" alt="叉车将成捆构件装入集装箱" loading="lazy">
          <figcaption>构件装箱与集装箱装载</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-1">
          <img src="/images/blog/packing-loading-steel-export/packing.jpg" alt="带标签的连接件包装箱" loading="lazy">
          <figcaption>连接件与五金按标签分类包装</figcaption>
        </figure>
        <figure class="evidence-item reveal reveal-delay-2">
          <img src="/images/projects/site-erection.jpg" alt="现场汽车吊吊装钢结构构件" loading="lazy">
          <figcaption>现场吊装与安装配合</figcaption>
        </figure>
      </div>
