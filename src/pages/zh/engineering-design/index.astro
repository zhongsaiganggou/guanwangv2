---
// ZhongSai V2 - 中文 工程设计与深化页面（升级版）
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import ExportDeliveryCTA from '../../../components/ExportDeliveryCTA.astro';
import '../../../styles/hub.css';
import '../../../styles/manufacturing.css';

const lang = 'zh';
const title = '钢结构设计与深化｜加工图、节点深化与工程技术支持｜中赛钢构';
const description = '中赛钢构为海外钢结构项目提供工程技术支持：图纸审核、结构协调、加工图深化、节点开发、制造文档和现场技术支持。';
const canonical = 'https://zhongsai-steelstructure.com/zh/engineering-design/';

const engineeringSteps = [
  {
    num: '01',
    image: '/images/engineering/workflow/step-01-document-review.jpg',
    title: '项目资料审核',
    desc: '审核建筑图、结构图、总布置图、设备布置图和项目要求，确定工程技术配合范围。',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z'
  },
  {
    num: '02',
    image: '/images/engineering/workflow/step-02-design-criteria.jpg',
    title: '设计条件确认',
    desc: '确认建筑用途、跨度、高度、设计荷载、风/雪/抗震要求、吊车荷载、腐蚀环境和适用设计规范。',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4'
  },
  {
    num: '03',
    image: '/images/engineering/workflow/step-03-structural-coordination.jpg',
    title: '结构协调',
    desc: '协调结构体系布置、柱网、框架布置、支撑系统和荷载传递路径，与建筑和机电要求协调。',
    icon: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z'
  },
  {
    num: '04',
    image: '/images/engineering/workflow/step-04-connection-development.jpg',
    title: '构件与节点开发',
    desc: '根据结构分析开发构件截面、连接节点、梁柱节点、柱脚、桁架节点、拼接节点和吊车牛腿。',
    icon: 'M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1'
  },
  {
    num: '05',
    image: '/images/engineering/workflow/step-05-shop-detailing.jpg',
    title: '加工图深化',
    desc: '编制可直接用于制造的加工图，包括构件尺寸、板件尺寸、孔位、焊接信息、螺栓连接、零件编号和装配说明。',
    icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z'
  },
  {
    num: '06',
    image: '/images/engineering/workflow/step-06-drawing-approval.jpg',
    title: '图纸审核与批准',
    desc: '内部审核加工图的准确性、可制造性和协调性，然后提交客户/工程师审核批准后再放行制造。',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z'
  },
  {
    num: '07',
    image: '/images/engineering/workflow/step-07-fabrication-release.jpg',
    title: '制造放行',
    desc: '将批准的图纸和制造文档放行到生产部门，包括材料清单、切割清单、装配说明和质量控制要求。',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z'
  },
  {
    num: '08',
    image: '/images/engineering/workflow/step-08-site-support.jpg',
    title: '现场技术支持',
    desc: '在现场安装期间提供技术支持，包括图纸澄清、连接指导、安装顺序协调和技术问题解决。',
    icon: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z'
  }
];

const designInputs = [
  { name: '建筑用途', desc: '工业、仓储、商业、农业、矿业、基础设施或特殊用途结构' },
  { name: '跨度与高度', desc: '所需净跨度、檐口高度、柱距和建筑尺寸' },
  { name: '风荷载', desc: '项目所在地风速、暴露类别和适用风荷载要求' },
  { name: '雪荷载', desc: '地面雪荷载、屋面雪荷载和积雪漂移考虑（如适用）' },
  { name: '抗震', desc: '抗震设计类别、场地类别和适用抗震要求' },
  { name: '吊车荷载', desc: '吊车吨位、跨度、工作级别和吊车梁要求（如适用）' },
  { name: '设备荷载', desc: '集中设备荷载、动力荷载和振动考虑' },
  { name: '腐蚀环境', desc: '环境暴露类别、湿度、化学暴露和涂层要求' },
  { name: '防火要求', desc: '耐火极限要求和被动防火保护规格' },
  { name: '当地规范', desc: '适用建筑规范、设计标准和项目技术规格书' }
];

const designStandards = [
  { code: 'GB', desc: '中国国家标准，结构设计与制造规范' },
  { code: 'AISC / ASCE', desc: '美国钢结构学会和ASCE标准' },
  { code: 'Eurocode', desc: '欧洲钢结构设计标准（EN 1990-1993）' },
  { code: 'Australian', desc: '澳大利亚钢结构标准（AS 4100, AS/NZS 1170）' },
  { code: '其他', desc: '其他项目指定标准，需经技术评审和协调' }
];

const shopDrawingContents = [
  '构件尺寸和截面',
  '板件尺寸和厚度',
  '孔位和螺栓排列',
  '焊脚尺寸和焊接信息',
  '螺栓连接节点',
  '零件编号和材料标识',
  '装配顺序信息',
  '制造说明和公差',
  '表面处理要求',
  '安装和吊装参考'
];

const connectionTypes = [
  { name: '梁柱连接节点', desc: '刚接、铰接和半刚性梁柱节点，具备适当的弯矩和剪力传递能力' },
  { name: '柱脚节点', desc: '柱底板设计、锚栓布置、调平和灌浆细节' },
  { name: '桁架连接节点', desc: '节点板连接、弦杆与腹杆连接节点和拼接细节' },
  { name: '拼接节点', desc: '柱拼接、梁拼接和现场螺栓连接节点，用于运输分段' },
  { name: '支撑连接节点', desc: '交叉支撑、门架支撑和抗侧力体系连接节点' },
  { name: '吊车牛腿', desc: '吊车梁支撑、牛腿、加劲肋和荷载传递节点' },
  { name: '设备接口节点', desc: '设备支撑连接、平台接口和动力荷载传递节点' },
  { name: '屋面墙面连接', desc: '檩条连接、墙梁连接、围护支撑和洞口加强' }
];

const faqs = [
  {
    q: '中赛可以根据建筑图进行工作吗？',
    a: '可以。中赛可以根据建筑图、方案图、总布置图或初步结构图开始工程技术配合。所需的工程协调和深化深度取决于所提供资料的完整程度。如果只有建筑图，可能需要在约定的项目范围内进行额外的结构协调和设计输入。'
  },
  {
    q: '可以提供用于制造的加工图吗？',
    a: '可以。中赛提供可直接用于制造的加工图，包括构件尺寸、板件尺寸、孔位、焊接信息、螺栓连接、零件编号、装配说明和制造注释。加工图与制造流程直接协调，确保能够直接指导生产和现场安装。'
  },
  {
    q: '可以按AISC或Eurocode规范进行项目工作吗？',
    a: '项目设计和深化可以根据项目指定的适用规范进行协调，包括AISC/ASCE、Eurocode、GB、澳大利亚标准或其他项目指定标准，需经技术评审。我们不宣称普遍符合所有国际标准；适用规范根据客户要求和当地法规按项目确认。'
  },
  {
    q: '可以深化带吊车的钢结构建筑吗？',
    a: '可以。中赛有带吊车工业建筑的深化经验，包括吊车梁支撑、牛腿、加劲肋、柱加强和荷载传递节点。吊车吨位、跨度、工作级别和吊车梁要求在深化开始前作为设计条件的一部分进行确认。'
  },
  {
    q: '图纸如何与制造协调？',
    a: '工程和深化与制造团队直接协调。加工图包含制造相关信息，如材料清单、切割清单、装配顺序、焊接细节和质量控制要求。批准的图纸随清晰文档放行到制造部门，工程团队在生产期间可随时提供技术澄清。'
  },
  {
    q: '钢构件可以为集装箱运输进行优化吗？',
    a: '可以。作为出口运输设计的一部分，构件长度和连接位置可以协调以适应标准集装箱尺寸。长构件可以采用螺栓拼接节点分段运输，构件编号与包装和吊装顺序协调。具体分段方式根据项目尺寸、集装箱类型和现场安装要求确定。'
  },
  {
    q: '中赛提供当地注册工程师签章吗？',
    a: '中赛在约定的项目范围内提供结构工程技术支持、深化和制造文档。当地许可、法定审批和注册工程师签章（如当地法规要求）仍由项目业主或其指定的当地持牌工程师负责。中赛不宣称在所有司法管辖区提供持牌专业工程服务；具体责任分配根据项目合同和当地法规要求确认。'
  }
];

const relatedLinks = [
  { name: '制造与质量控制', href: '/zh/manufacturing-quality/', desc: '工厂制造、质量控制和生产证据' },
  { name: '钢结构厂房', href: '/zh/steel-workshop/', desc: '工业厂房和制造工厂钢结构' },
  { name: '钢结构仓库', href: '/zh/steel-warehouse/', desc: '物流仓储建筑钢结构' },
  { name: '矿业与重工业', href: '/zh/steel-mining-factory/', desc: '矿业和能源重型钢结构' },
  { name: '特种钢结构', href: '/zh/special-custom-steel-structures/', desc: '定制和特殊用途钢结构工程' },
  { name: '项目案例', href: '/zh/projects/', desc: '真实项目案例，含工程和制造范围' },
  { name: '出口交付', href: '/zh/export-delivery/', desc: '集装箱装柜、出口单证和物流' },
  { name: '联系与报价', href: '/zh/contact/', desc: '提交图纸进行工程评审和报价' }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="about-hero">
    <div class="hub-hero-bg" style="background-image: url('/images/company/factory-aerial-panorama.jpg')"></div>
    <div class="hub-hero-overlay"></div>
    <div class="container hub-hero-content">
      <div class="hub-breadcrumb">
        <a href="/zh/">首页</a><span>/</span><span>工程设计与深化</span>
      </div>
      <p class="eyebrow">工程技术 · 从图纸到制造</p>
      <h1>钢结构设计、深化<br>与工程技术支持</h1>
      <p class="lead">中赛为海外钢结构项目提供工程技术支持，包括图纸审核、结构协调、加工图深化、节点开发和制造文档编制。</p>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="stat-number">图纸审核</span>
          <span class="stat-label">建筑图与结构图</span>
        </div>
        <div class="hero-stat">
          <span class="stat-number">加工图深化</span>
          <span class="stat-label">可直接用于制造</span>
        </div>
        <div class="hero-stat">
          <span class="stat-number">节点开发</span>
          <span class="stat-label">连接与节点处理</span>
        </div>
        <div class="hero-stat">
          <span class="stat-number">现场支持</span>
          <span class="stat-label">技术协调与指导</span>
        </div>
      </div>
      <div class="hero-cta-group">
        <a href="#quote" class="btn btn-primary">提交图纸进行工程评审</a>
        <a href="/zh/projects/" class="btn btn-secondary">查看项目案例</a>
      </div>
    </div>
  </section>

  <!-- 01 起始资料 -->
  <section class="section" style="padding: 70px 0;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">起始资料</p>
          <h2>可以从哪些项目资料开始工作？</h2>
        </div>
        <div>
          <p>中赛可以从不同完整程度的项目文档开始工程技术配合。工作范围根据是否有完整结构图或仅有建筑方案图而有所不同。</p>
        </div>
      </div>
      <div class="quality-grid" style="margin-top: 40px;">
        <div class="quality-item reveal reveal-delay-1">
          <h4>建筑图纸</h4>
          <p>建筑平面图、立面图、剖面图和建筑方案图，展示布局、尺寸和功能要求。</p>
        </div>
        <div class="quality-item reveal reveal-delay-2">
          <h4>结构图纸</h4>
          <p>现有结构图、框架布置图、构件表和连接节点，可深化为制造加工图。</p>
        </div>
        <div class="quality-item reveal reveal-delay-3">
          <h4>方案图纸</h4>
          <p>初步方案草图、3D模型或布局方案，需要进行结构开发和工程协调。</p>
        </div>
        <div class="quality-item reveal reveal-delay-4">
          <h4>总布置图</h4>
          <p>GA图纸展示建筑总体布局、柱网、框架布置和主要尺寸要求。</p>
        </div>
        <div class="quality-item reveal reveal-delay-1">
          <h4>设备布置图</h4>
          <p>工业项目的设备布置图、吊车布置、工艺流程图和荷载要求。</p>
        </div>
        <div class="quality-item reveal reveal-delay-2">
          <h4>项目尺寸</h4>
          <p>建筑长度、宽度、高度、跨度要求、檐口高度和柱距规格。</p>
        </div>
        <div class="quality-item reveal reveal-delay-3">
          <h4>设计荷载</h4>
          <p>风荷载、雪荷载、抗震要求、吊车荷载、设备荷载和其他设计条件。</p>
        </div>
        <div class="quality-item reveal reveal-delay-4">
          <h4>当地设计规范</h4>
          <p>适用建筑规范、设计标准、项目技术规格书和客户要求。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 工程流程 -->
  <section class="manufacturing-process-section">
    <div class="container">
      <div class="section-heading reveal" style="margin-bottom: 40px;">
        <div>
          <p class="section-index">工作流程</p>
          <h2>工程设计与深化工作流程</h2>
        </div>
        <div>
          <p>从项目资料审核到制造放行和现场技术支持的八步工程流程，每个阶段都有质量控制。</p>
        </div>
      </div>
      <div class="process-grid">
        {engineeringSteps.map((step, i) => (
          <div class={`process-card reveal reveal-delay-${(i % 4) + 1}`}>
            <div class="process-card-img" style="position: relative; min-height: 180px; overflow: hidden;">
              <img src={step.image} alt={step.title} style="width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0;" width="400" height="200" loading="lazy">
              <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, rgba(15,23,42,0.65) 0%, rgba(30,64,175,0.55) 100%);"></div>
              <div style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; min-height: 180px; flex-direction: column; gap: 8px;">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.95)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d={step.icon} />
                </svg>
              </div>
              <span class="process-card-num" style="position: absolute; top: 12px; left: 12px; z-index: 2;">{step.num}</span>
            </div>
            <div class="process-card-body">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 设计条件 -->
  <section class="section" style="padding: 70px 0; background: #f8fafc;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">设计输入</p>
          <h2>设计条件与项目输入</h2>
        </div>
        <div>
          <p>结构设计和深化基于项目特定的设计条件。这些输入在项目开始时确认，指导所有工程决策。</p>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-top: 40px;" class="design-inputs-grid">
        {designInputs.map((input, i) => (
          <div class={`reveal reveal-delay-${(i % 4) + 1}`} style="padding: 20px; background: white; border-radius: 10px; border: 1px solid #e2e8f0;">
            <h4 style="font-size: 14px; font-weight: 600; color: #1e3a5f; margin-bottom: 8px;">{input.name}</h4>
            <p style="font-size: 12px; color: #64748b; line-height: 1.6; margin: 0;">{input.desc}</p>
          </div>
        ))}
      </div>
      <div style="margin-top: 24px; padding: 20px; background: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 0 8px 8px 0;" class="reveal">
        <p style="margin: 0; color: #92400e; font-size: 13px; line-height: 1.7;"><strong>说明：</strong>设计参数不是所有项目统一标准。风荷载、雪荷载、抗震要求和其他条件因项目位置和适用规范而异。所有设计输入根据客户提供的信息和当地法规要求按项目确认。</p>
      </div>
    </div>
  </section>

  <!-- 04 设计标准 -->
  <section class="section" style="padding: 70px 0;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">设计标准</p>
          <h2>设计标准</h2>
        </div>
        <div>
          <p>项目设计和深化可以根据项目指定的适用规范进行协调，需经技术评审。我们不宣称普遍符合所有国际标准。</p>
        </div>
      </div>
