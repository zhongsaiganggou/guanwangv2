---
// ZhongSai V2 - 中文 制造与质量控制页面（升级版）
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import ExportDeliveryCTA from '../../../components/ExportDeliveryCTA.astro';
import '../../../styles/hub.css';
import '../../../styles/manufacturing.css';

const lang = 'zh';
const title = '钢结构制造与质量控制｜中赛钢构生产基地';
const description = '中赛钢构为海外项目提供按图加工的钢结构制造服务：原材料控制、数控切割、装配焊接、尺寸检验、表面处理、构件编号、包装装柜与出口交付。受控生产与质量控制体系。';

const manufacturingSteps = [
  {
    num: '01',
    title: '图纸审核与深化',
    desc: '对项目图纸和加工图进行审核，确认关键尺寸、连接节点和制造要求后再开始生产。',
    img: '/images/manufacturing/process/01-drawing-review.jpg'
  },
  {
    num: '02',
    title: '材料准备',
    desc: '钢板、型钢及配套材料按项目规格和材质要求进场、标识并准备，确保材料符合项目要求。',
    img: '/images/company/factory-yard-gantry-crane.jpg'
  },
  {
    num: '03',
    title: '数控切割与钻孔',
    desc: '采用数控切割和钻孔设备按加工图加工钢板和型钢，控制尺寸精度和孔位准确性。',
    img: '/images/manufacturing/real/cutting-prep-9809.jpg'
  },
  {
    num: '04',
    title: '装配与焊接',
    desc: '构件按批准图纸和焊接工艺要求进行装配和焊接，控制装配精度和焊接变形。',
    img: '/images/manufacturing/real/assembly-welding-9821.jpg'
  },
  {
    num: '05',
    title: '尺寸检验',
    desc: '成品构件按项目图纸检验长度、孔位、对角线、直线度和连接接口尺寸。',
    img: '/images/manufacturing/real/qc-inspection.jpg'
  },
  {
    num: '06',
    title: '表面处理',
    desc: '根据项目环境、腐蚀等级和客户规范，可安排表面清理、抛丸、喷漆或热浸镀锌。',
    img: '/images/manufacturing/real/painting.jpg'
  },
  {
    num: '07',
    title: '构件编号',
    desc: '构件按加工图和安装顺序要求进行编号标识，便于海外现场识别和吊装。',
    img: '/images/manufacturing/real/component-marking.jpg'
  },
  {
    num: '08',
    title: '包装与装柜',
    desc: '构件按类型、装柜顺序和出口运输要求分组、包装并装入集装箱，附带装箱清单。',
    img: '/images/container-loading.jpg'
  }
];

const qualityStages = [
  { stage: '材料', control: '材质确认、质保书核验、材料标识追溯' },
  { stage: '切割', control: '尺寸核验、切割面质量、孔位精度' },
  { stage: '装配', control: '几何尺寸核验、装配间隙检查、对齐控制' },
  { stage: '焊接', control: '外观检验、焊接工艺合规、项目要求的无损检测（如指定）' },
  { stage: '表面', control: '表面处理质量、涂层厚度、镀锌检验（如适用）' },
  { stage: '成品', control: '尺寸核验、编号检查、装箱清单复核' }
];

const evidenceImages = [
  { src: '/images/manufacturing/real/factory-overview-9819.jpg', alt: '中赛钢构生产基地全景', caption: '生产基地全景' },
  { src: '/images/manufacturing/real/cnc-cutting.jpg', alt: '数控切割下料', caption: '数控切割下料' },
  { src: '/images/manufacturing/real/shot-blasting.jpg', alt: '抛丸除锈处理', caption: '抛丸除锈处理' },
  { src: '/images/manufacturing/real/qc-inspection.jpg', alt: 'QC尺寸检验', caption: 'QC尺寸检验' },
  { src: '/images/manufacturing/real/cutting-prep-9809.jpg', alt: '中赛工厂数控切割与材料准备', caption: '数控切割与准备' },
  { src: '/images/manufacturing/real/welding-9820.jpg', alt: '中赛生产基地钢结构焊接工序', caption: '装配与焊接' },
  { src: '/images/manufacturing/real/assembly-welding-9821.jpg', alt: 'H型钢装配焊接生产线', caption: 'H型钢装配线' },
  { src: '/images/company/factory-steel-beam-fabrication.jpg', alt: '中赛生产基地钢梁加工', caption: '钢梁加工' },
  { src: '/images/components/finished-coated-components.jpg', alt: '成品表面处理后的钢结构构件', caption: '表面处理构件' },
  { src: '/images/container-loading.jpg', alt: '钢结构构件装入出口集装箱', caption: '出口装柜' },
  { src: '/images/company/factory-yard-gantry-crane.jpg', alt: '工厂堆场龙门吊钢材存放区', caption: '材料堆场' }
];

const projectTypes = [
  { name: '工业厂房', href: '/zh/steel-workshop/' },
  { name: '仓储物流', href: '/zh/steel-warehouse/' },
  { name: '矿业与重工业', href: '/zh/steel-mining-factory/' },
  { name: '钢平台', href: '/zh/components/' },
  { name: '输送廊道', href: '/zh/components/' },
  { name: '管廊架', href: '/zh/components/' },
  { name: '公共与基础设施', href: '/zh/transportation-infrastructure-steel/' },
  { name: '特种钢结构', href: '/zh/special-custom-steel-structures/' }
];

const certifications = [
  { name: 'ISO 9001', desc: '质量管理体系认证', holder: '惠州制造基地', img: '/images/certifications/iso-9001-quality.jpg', valid: '2025-2028' },
  { name: 'ISO 14001', desc: '环境管理体系认证', holder: '惠州制造基地', img: '/images/certifications/iso-14001-environmental.jpg', valid: '2025-2028' },
  { name: 'ISO 45001', desc: '职业健康安全管理体系', holder: '惠州制造基地', img: '/images/certifications/iso-45001-occupational.jpg', valid: '2025-2028' },
  { name: 'ISO 3834-2', desc: '熔焊质量综合要求', holder: '东莞制造基地', img: '/images/certifications/iso-3834-welding.jpg', valid: '2024-2027' },
  { name: 'EN 1090 EXC2', desc: '钢结构构件CE/CPR认证', holder: '东莞制造基地', img: '/images/certifications/en-1090-ce.jpg', valid: '2024起' },
  { name: 'CIDB IBS', desc: '马来西亚工业化建筑系统认证', holder: '马来西亚合作方/惠州工厂', img: '/images/certifications/malaysia-cidb-ibs.jpg', valid: '2026-2027' },
];

const faqs = [
  {
    q: '中赛可以按客户提供的图纸进行制造吗？',
    a: '可以。中赛可以根据客户提供的结构图、建筑图和加工图进行钢结构制造。如有需要，我们也可以在生产前配合进行加工图深化。所有制造均以批准的图纸和项目技术规格为准。'
  },
  {
    q: '生产前可以配合加工图深化吗？',
    a: '可以。中赛可以在项目范围内配合结构深化和加工图编制，包括节点深化、构件清单和制造图准备。具体深化责任范围根据项目合同和图纸要求确定。'
  },
  {
    q: '中赛如何控制钢结构制造质量？',
    a: '质量控制按制造阶段组织：进场材料进行材质和质保书核验；切割后检查尺寸和孔位；装配时核验几何尺寸和装配间隙；焊接过程进行外观检验和项目要求的无损检测；表面处理后检查处理质量和涂层；成品出厂前进行尺寸和编号核验。具体检验方法和验收标准按项目技术规格执行。'
  },
  {
    q: '复杂钢结构可以在发货前进行预拼装吗？',
    a: '对于复杂桁架、钢平台、特殊节点、基础设施结构等复杂项目，可以根据项目要求安排试拼装或局部预拼。并非所有项目都需要全尺寸试拼装，是否需要及预拼范围根据项目复杂度、客户要求和合同规格确定。'
  },
  {
    q: '构件如何编号以便海外安装？',
    a: '构件按加工图、安装顺序和项目标识系统进行编号。每个构件标注其图纸编号、构件ID和包装组号，帮助海外安装团队按安装顺序正确识别、定位和吊装构件，减少现场混乱和错误。'
  },
  {
    q: '可以提供哪些防腐处理方案？',
    a: '表面处理方案包括喷漆体系、热浸镀锌（如适用）以及项目定制涂层体系。具体防腐方案根据项目环境、腐蚀等级、客户规范、当地标准和设计寿命要求确定。我们不对所有项目采用统一涂层方案，也不承诺未经项目工程分析的固定防腐寿命。'
  },
  {
    q: '钢结构如何包装装入集装箱？',
    a: '构件按类型、重量、装柜顺序和出口运输要求分组包装。超长构件可根据需要拆分以适应集装箱尺寸，采用螺栓拼接节点便于现场组装。每批发货附带装箱清单，构件在运输过程中采取保护措施防止损坏。优化装柜可以在合适项目中降低运费，但实际节省幅度因项目尺寸、构件规格和运输路线而异。'
  },
  {
    q: '中赛提供当地施工服务吗？',
    a: '中赛提供设计/深化配合、钢结构制造、出口供货和安装技术指导。当地土建施工、基础施工、现场人工安装和当地政府审批通常由当地承包商或业主指定的施工团队负责。具体范围按项目合同确定。'
  }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="hub-hero">
    <div class="hub-hero-bg" style="background-image: url('/images/manufacturing/real/factory-overview-9819.jpg')"></div>
    <div class="hub-hero-overlay"></div>
    <div class="container hub-hero-content">
      <div class="hub-breadcrumb">
        <a href="/zh/">首页</a><span>/</span><span>制造与质量</span>
      </div>
      <p class="eyebrow">制造实力 · 从图纸到出口交付</p>
      <h1>海外钢结构项目<br>制造与质量控制</h1>
      <p class="lead">中赛为工业厂房、仓储物流、矿业能源、基础设施等海外钢结构项目提供按图加工制造服务，涵盖受控生产、检验、编号、包装与出口交付。</p>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="stat-number">约10万㎡</span>
          <span class="stat-label">生产基地面积</span>
        </div>
        <div class="hero-stat">
          <span class="stat-number">约10万吨</span>
          <span class="stat-label">年产能</span>
        </div>
        <div class="hero-stat">
          <span class="stat-number">300+</span>
          <span class="stat-label">一线生产工人</span>
        </div>
        <div class="hero-stat">
          <span class="stat-number">按项目</span>
          <span class="stat-label">定制制造与出口</span>
        </div>
      </div>
      <div class="hero-cta-group">
        <a href="#quote" class="btn btn-primary">提交项目图纸进行制造评审</a>
        <a href="/zh/projects/" class="btn btn-secondary">查看项目案例</a>
      </div>
    </div>
  </section>

  <!-- 01 制造概述 -->
  <section class="section" style="padding: 70px 0;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">概述</p>
          <h2>从批准图纸到出口成品构件</h2>
        </div>
        <div>
          <p>中赛提供按项目定制的钢结构制造服务，涵盖图纸审核、深化配合、材料准备、数控切割、装配焊接、尺寸检验、表面处理、构件编号、包装与装柜出口。</p>
          <p style="margin-top: 12px;">制造与检验按批准的项目图纸、加工图、项目技术规格和适用要求执行。具体材料、焊接工艺、表面处理和检验参数按项目要求和合同条款确定。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 八步制造流程 -->
  <section class="manufacturing-process-section">
    <div class="container">
      <div class="section-heading reveal" style="margin-bottom: 40px;">
        <div>
          <p class="section-index">流程</p>
          <h2>从图纸到制造：八步生产流程</h2>
        </div>
        <div>
          <p>每一步均按批准的项目图纸和技术要求组织，质量控制贯穿每个制造阶段。</p>
        </div>
      </div>
      <p style="font-size:13px;color:#16a34a;margin-bottom:16px;">以下制造环节均在中赛东莞/惠州制造基地实际完成</p>
      <div class="process-grid">
        {manufacturingSteps.map((step, i) => (
          <div class={`process-card reveal reveal-delay-${(i % 4) + 1}`}>
            <div class="process-card-img">
              <img src={step.img} alt={step.title} loading={i < 2 ? "eager" : "lazy"} width="400" height="250">
              <span class="process-card-num">第 {step.num} 步</span>
            </div>
            <div class="process-card-body">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 原材料控制 -->
  <section class="section" style="padding: 70px 0; background: #f8fafc;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">材料</p>
          <h2>原材料检验与追溯</h2>
        </div>
        <div>
          <p>材料控制从进场检验开始，贯穿整个生产过程，确保钢材材质和性能符合项目要求。</p>
        </div>
      </div>
      <div class="quality-grid">
        <div class="quality-item reveal reveal-delay-1">
          <h4>材质确认</h4>
          <p>钢板和型钢进场时按项目指定的材质等级和标准进行核验，确认无误后进入生产。</p>
        </div>
        <div class="quality-item reveal reveal-delay-2">
          <h4>质保书核验</h4>
          <p>按项目规格和客户要求收集并核验进场材料的钢厂质保书和材质证明文件。</p>
        </div>
        <div class="quality-item reveal reveal-delay-3">
          <h4>材料标识</h4>
          <p>钢板和型钢在生产过程中进行标识和跟踪，保持从进场材料到成品构件的可追溯性。</p>
        </div>
        <div class="quality-item reveal reveal-delay-4">
          <h4>进场检验</h4>
          <p>对进场材料进行外观和尺寸检查，按项目要求核验表面质量、截面尺寸和钢板厚度。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 切割装配焊接 -->
  <section class="section" style="padding: 70px 0;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">生产</p>
          <h2>数控切割、装配与焊接</h2>
        </div>
        <div>
          <p>核心生产工序按批准图纸和焊接工艺要求组织，每个阶段控制尺寸精度和焊接质量。</p>
        </div>
      </div>
            <div class="dual-path-grid" style="grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px;">
        <div class="dual-path-card reveal reveal-delay-1" style="padding: 0; overflow: hidden;">
          <div style="width: 100%; height: 180px; overflow: hidden; background: #e2e8f0;">
            <img src="/images/manufacturing/real/cutting-prep-9809.jpg" alt="数控切割与材料准备" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" width="400" height="180">
          </div>
          <div style="padding: 24px 28px;">
            <div class="path-icon" style="width: 48px; height: 48px; font-size: 16px; font-weight: 700; color:#fff; margin-bottom: 16px; display:flex; align-items:center; justify-content:center; background: #1e40af; border-radius: 8px;">01</div>
            <h3 style="font-size: 20px; margin-bottom: 12px; color: #0f172a;">数控切割与钻孔</h3>
            <ul style="margin: 0; padding-left: 18px; color: #475569; font-size: 14px; line-height: 1.8;">
            <li>按加工图进行钢板切割</li>
            <li>型钢切割与端部加工</li>
            <li>螺栓连接节点数控钻孔</li>
            <li>孔位精度控制</li>
            <li>构件装配前准备</li>
            </ul>
          </div>
        </div>
        <div class="dual-path-card reveal reveal-delay-2" style="padding: 0; overflow: hidden;">
          <div style="width: 100%; height: 180px; overflow: hidden; background: #e2e8f0;">
            <img src="/images/manufacturing/real/assembly-welding-9821.jpg" alt="H型钢装配与组对" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" width="400" height="180">
          </div>
          <div style="padding: 24px 28px;">
            <div class="path-icon" style="width: 48px; height: 48px; font-size: 16px; font-weight: 700; color:#fff; margin-bottom: 16px; display:flex; align-items:center; justify-content:center; background: #1e40af; border-radius: 8px;">02</div>
            <h3 style="font-size: 20px; margin-bottom: 12px; color: #0f172a;">装配与组对</h3>
            <ul style="margin: 0; padding-left: 18px; color: #475569; font-size: 14px; line-height: 1.8;">
            <li>H型钢装配与对齐</li>
            <li>按图纸进行构件组对</li>
            <li>连接接口尺寸核验</li>
            <li>几何尺寸控制</li>
            <li>焊接准备与顺序安排</li>
            </ul>
          </div>
        </div>
        <div class="dual-path-card reveal reveal-delay-3" style="padding: 0; overflow: hidden;">
          <div style="width: 100%; height: 180px; overflow: hidden; background: #e2e8f0;">
            <img src="/images/manufacturing/real/welding-9820.jpg" alt="钢结构焊接质量控制" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" width="400" height="180">
          </div>
          <div style="padding: 24px 28px;">
            <div class="path-icon" style="width: 48px; height: 48px; font-size: 16px; font-weight: 700; color:#fff; margin-bottom: 16px; display:flex; align-items:center; justify-content:center; background: #1e40af; border-radius: 8px;">03</div>
            <h3 style="font-size: 20px; margin-bottom: 12px; color: #0f172a;">焊接质量</h3>
            <ul style="margin: 0; padding-left: 18px; color: #475569; font-size: 14px; line-height: 1.8;">
            <li>按批准的WPS焊接（如适用）</li>
            <li>焊接顺序与变形控制</li>
            <li>所有焊缝外观检验</li>
            <li>项目要求的无损检测（UT/MT/PT）</li>
            <li>焊工资质按项目要求确认</li>
            </ul>
          </div>
        </div>
      </div>
  </section>

  <!-- 05 尺寸检验与预拼装 -->
  <section class="section" style="padding: 70px 0; background: #f8fafc;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">检验</p>
          <h2>尺寸检验与预拼装</h2>
        </div>
        <div>
          <p>成品检验确保构件尺寸、连接接口和编号与项目图纸一致，支持海外现场正确安装。</p>
        </div>
      </div>
