---
// ZhongSai V2 - 中文 制造与质量控制页面（detail 体系重构版）
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const lang = 'zh';
const title = '钢结构制造与质量控制｜中赛钢构生产基地';
const description = '中赛钢构为海外项目提供按图加工的钢结构制造服务：原材料控制、数控切割、装配焊接、尺寸检验、表面处理、构件编号、包装装柜与出口交付。受控生产与质量控制体系。';
const canonical = 'https://zhongsai-steelstructure.com/zh/manufacturing-quality/';

const heroStrip = ['图纸审核', '材料准备', '制造与焊接', '质量控制', '出口交付准备'];

const flowSteps = ['批准图纸', '材料准备', '制造加工', '检验', '表面处理', '包装与交付准备'];

const mfgSteps = [
  {
    num: '01',
    title: '材料准备 / 下料',
    desc: '钢板、型钢及配套材料按项目规格和材质要求进场、标识并准备，确保材料符合项目要求。',
    img: '/images/company/factory-yard-gantry-crane.jpg',
    alt: '工厂堆场龙门吊钢材存放区'
  },
  {
    num: '02',
    title: '切割与钻孔',
    desc: '采用数控切割和钻孔设备按加工图加工钢板和型钢，控制尺寸精度和孔位准确性。',
    img: '/images/manufacturing/real/cutting-prep-9809.jpg',
    alt: '数控切割与材料准备'
  },
  {
    num: '03',
    title: '组立与焊接',
    desc: '构件按批准图纸和项目适用工艺要求进行装配和焊接，控制装配精度和焊接变形。',
    img: '/images/manufacturing/real/assembly-welding-9821.jpg',
    alt: 'H型钢装配焊接生产线'
  },
  {
    num: '04',
    title: '尺寸检验 / 必要时试拼',
    desc: '成品构件按项目图纸检验长度、孔位、对角线、直线度和连接接口尺寸；复杂项目按需安排试拼装。',
    img: '/images/manufacturing/real/qc-inspection.jpg',
    alt: 'QC尺寸检验'
  },
  {
    num: '05',
    title: '表面处理',
    desc: '根据项目环境、腐蚀等级和客户规范，可安排表面清理、抛丸、喷漆或热浸镀锌。',
    img: '/images/manufacturing/real/painting.jpg',
    alt: '构件表面喷涂处理'
  },
  {
    num: '06',
    title: '编号、包装与交付准备',
    desc: '构件按加工图和安装顺序编号标识，按类型与装柜顺序分组包装，附带装箱清单，为出口交付做准备。',
    img: '/images/manufacturing/real/component-marking.jpg',
    alt: '出口构件编号与标识'
  }
];

const evidenceGallery = [
  { src: '/images/company/factory-steel-beam-fabrication.jpg', alt: '中赛生产基地钢梁构件加工', caption: '钢梁构件工厂加工' },
  { src: '/images/components/finished-coated-components.jpg', alt: '成品表面处理后的钢结构构件', caption: '表面处理成品构件' },
  { src: '/images/container-loading.jpg', alt: '钢结构构件装入出口集装箱', caption: '出口装柜准备' }
];

const qcStages = [
  { stage: '材料准备', control: '材质确认、质保书核验、材料标识追溯' },
  { stage: '切割钻孔', control: '尺寸核验、切割面质量、孔位精度' },
  { stage: '组立', control: '几何尺寸核验、装配间隙检查、对齐控制' },
  { stage: '焊接', control: '外观检验、焊接工艺合规、项目要求的无损检测（如指定）' },
  { stage: '试拼（必要时）', control: '接口尺寸、孔位、组装协调性核验' },
  { stage: '表面处理', control: '表面处理质量、涂层厚度、镀锌检验（如适用）' },
  { stage: '编号包装', control: '尺寸核验、构件编号、装箱清单复核' }
];

const surfacePoints = [
  { name: '表面清理', desc: '涂层前对钢材表面进行清理和预处理，按项目要求去除锈蚀、氧化皮和污染物。' },
  { name: '抛丸处理', desc: '按项目规格要求可安排抛丸或喷砂处理，达到要求的表面清洁度和粗糙度。' },
  { name: '喷漆体系', desc: '按项目规格可施工底漆、中间漆和面漆体系，必要时核验涂层厚度和附着力。' },
  { name: '热浸镀锌', desc: '对适用构件可按项目要求安排热浸镀锌，为合适应用场景提供防腐保护。' }
];

const markingPoints = [
  { name: '构件编号', desc: '每个构件标注唯一识别编号，对应其在加工图和吊装顺序中的位置。' },
  { name: '图纸对应', desc: '编号包含图纸图号和构件标记，便于现场团队对照安装图纸核对构件。' },
  { name: '包装分组', desc: '构件按包装单元和集装箱分组，装箱清单标明每个包装和集装箱内的构件。' },
  { name: '安装顺序', desc: '按项目需要，编号可包含吊装顺序参考，支持现场有序组装，减少安装错误。' }
];

const projectTypes = [
  { name: '工业厂房', href: '/zh/steel-workshop/' },
  { name: '仓储物流', href: '/zh/steel-warehouse/' },
  { name: '矿业与重工业', href: '/zh/steel-mining-factory/' },
  { name: '钢平台', href: '/zh/components/' },
  { name: '输送廊道', href: '/zh/components/' },
  { name: '管廊架', href: '/zh/components/' },
  { name: '公共与基础设施', href: '/zh/transportation-infrastructure-steel/' },
  { name: '夹层 / 二层平台 / 特种钢结构', href: '/zh/special-custom-steel-structures/' }
];

const certifications = [
  { name: 'ISO 9001', desc: '质量管理体系认证', holder: '惠州制造基地', valid: '2025-2028' },
  { name: 'ISO 14001', desc: '环境管理体系认证', holder: '惠州制造基地', valid: '2025-2028' },
  { name: 'ISO 45001', desc: '职业健康安全管理体系', holder: '惠州制造基地', valid: '2025-2028' },
  { name: 'ISO 3834-2', desc: '熔焊质量综合要求', holder: '东莞制造基地', valid: '2024-2027' },
  { name: 'EN 1090 EXC2', desc: '钢结构构件CE/CPR认证', holder: '东莞制造基地', valid: '2024起' },
  { name: 'CIDB IBS', desc: '马来西亚工业化建筑系统认证', holder: '马来西亚合作方/惠州工厂', valid: '2026-2027' }
];

const faqs = [
  {
    q: '中赛可以按客户提供的图纸进行制造吗？',
    a: '可以。中赛可以根据客户提供的结构图、建筑图和加工图进行钢结构制造。如有需要，我们也可以在生产前配合进行加工图深化。所有制造均以批准的图纸和项目技术规格为准。'
  },
  {
    q: '生产前可以配合加工图深化吗？',
    a: '可以。中赛可以在项目范围内配合结构深化和加工图编制，包括节点深化、构件清单和制造图准备。具体深化责任范围根据项目合同和图纸要求确定。'
  },
  {
    q: '中赛如何控制钢结构制造质量？',
    a: '质量控制按制造阶段组织：进场材料进行材质和质保书核验；切割后检查尺寸和孔位；装配时核验几何尺寸和装配间隙；焊接过程进行外观检验和项目要求的无损检测；表面处理后检查处理质量和涂层；成品出厂前进行尺寸和编号核验。具体检验方法和验收标准按项目技术规格执行。'
  },
  {
    q: '复杂钢结构可以在发货前进行预拼装吗？',
    a: '对于复杂桁架、钢平台、特殊节点、基础设施结构等复杂项目，可以根据项目要求安排试拼装或局部预拼。并非所有项目都需要全尺寸试拼装，是否需要及预拼范围根据项目复杂度、客户要求和合同规格确定。'
  },
  {
    q: '构件如何编号以便海外安装？',
    a: '构件按加工图、安装顺序和项目标识系统进行编号。每个构件标注其图纸编号、构件ID和包装组号，帮助海外安装团队按安装顺序正确识别、定位和吊装构件，减少现场混乱和错误。'
  },
  {
    q: '中赛提供当地施工服务吗？',
    a: '中赛提供设计/深化配合、钢结构制造、出口供货和安装技术指导。当地土建施工、基础施工、现场人工安装和当地政府审批通常由当地承包商或业主指定的施工团队负责。具体范围按项目合同确定。'
  }
];

const relatedLinks = [
  { name: '工程设计与深化', href: '/zh/engineering-design/', desc: '结构设计配合、加工图深化和节点工程，支撑制造生产。' },
  { name: '钢结构厂房', href: '/zh/steel-workshop/', desc: '工业厂房和制造工厂钢结构，按项目图纸加工制造。' },
  { name: '钢结构仓库', href: '/zh/steel-warehouse/', desc: '物流仓储建筑钢结构，具备大跨度和高净空制造能力。' },
  { name: '出口交付', href: '/zh/export-delivery/', desc: '集装箱装柜、出口单证和物流协调，支持海外项目交付。' },
  { name: '项目案例', href: '/zh/projects/', desc: '真实项目案例，展示中赛制造和出口交付能力。' },
  { name: '钢构件', href: '/zh/components/', desc: '钢梁、钢柱、钢桁架、钢平台等加工钢结构构件。' },
  { name: '矿业与重工业', href: '/zh/steel-mining-factory/', desc: '矿业、能源和加工厂应用的重型钢结构。' },
  { name: '联系与报价', href: '/zh/contact/', desc: '提交项目图纸和技术要求，进行制造评审和报价。' }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/manufacturing/real/factory-overview-9819.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">制造与质量 · 从图纸到出口交付</span>
      <h1>海外钢结构项目<br>制造与质量控制</h1>
      <p class="lead">基于批准的工程图纸和加工图，中赛在东莞和惠州制造基地完成钢结构构件的下料、组立、焊接、检查、表面处理、编号及出口交付准备。</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">提交图纸进行制造评审</a>
        <a href="/zh/export-delivery/" class="btn btn-outline">查看出口交付能力</a>
      </div>
    </div>
  </section>

  <!-- Hero Evidence Strip -->
  <section class="detail-section" style="padding-top: 0;">
    <div class="container">
      <div class="hero-strip">
        {heroStrip.map(item => <span>{item}</span>)}
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/zh/">首页</a>
      <span class="sep">/</span>
      <span class="current">制造与质量</span>
    </div>
  </nav>

  <!-- 01 / 制造概述：从图纸到成品 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">概述</p>
        <h2>从批准图纸到出口成品构件</h2>
        <p>中赛提供按项目定制的钢结构制造服务，制造与检验按批准的项目图纸、加工图、项目技术规格和适用要求执行。具体材料、焊接工艺、表面处理和检验参数按项目要求和合同条款确定。</p>
      </div>
      <div class="export-chain" style="margin-top: 28px;">
        {flowSteps.map((step, i) => (
          <>{i > 0 && <span class="chain-arrow reveal">→</span>}<span class="chain-step reveal"><span class="chain-num">0{i + 1}</span>{step}</span></>
        ))}
      </div>
      <div class="stats-row reveal">
        <div class="stat-item"><span class="stat-number">约10万㎡</span><span class="stat-label">生产基地面积</span></div>
        <div class="stat-item"><span class="stat-number">约10万吨</span><span class="stat-label">年产能</span></div>
        <div class="stat-item"><span class="stat-number">300+</span><span class="stat-label">一线生产工人</span></div>
        <div class="stat-item"><span class="stat-number">按项目</span><span class="stat-label">定制制造与出口</span></div>
      </div>
    </div>
  </section>

  <!-- 02 / 制造流程 6 阶段 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">流程</p>
        <h2>制造流程：从材料到出口构件</h2>
        <p>制造按批准图纸和项目技术要求组织，每个阶段均进行相应检查，重要工序以真实生产照片说明。</p>
      </div>
      <div class="mfg-grid">
        {mfgSteps.map((step, i) => (
          <div class={`mfg-card reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="mfg-img">
              <img src={step.img} alt={step.alt} loading={i < 2 ? "eager" : "lazy"} width="400" height="220">
              <span class="mfg-num">{step.num}</span>
            </div>
            <div class="mfg-body">
              <h4>{step.title}</h4>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 / 真实制造证据 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">证据</p>
        <h2>真实制造证据</h2>
        <p>以下为中赛生产基地、生产工序、质量控制和出口准备的实拍照片，非AI生成效果图。</p>
      </div>
      <div class="evidence-strip">
        {evidenceGallery.map((item, i) => (
          <figure class={`evidence-item reveal reveal-delay-${i + 1}`}>
            <img src={item.src} alt={item.alt} loading="lazy" width="400" height="220">
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 / 分制造阶段质量控制表 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">质量表</p>
        <h2>分制造阶段质量控制</h2>
        <p>质量控制贯穿每个制造阶段，具体检验活动按项目技术规格和合同条款组织。</p>
      </div>
      <div class="params-table-wrapper reveal">
        <table class="params-table">
          <thead>
            <tr>
              <th>制造阶段</th>
              <th>典型质量控制活动</th>
            </tr>
          </thead>
          <tbody>
            {qcStages.map(row => (
              <tr>
                <td>{row.stage}</td>
                <td>{row.control}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="params-note reveal">具体检验方法、验收标准和检测要求按项目技术规格和合同条款确定。并非所有项目都需要全部列出的检验活动。</p>
    </div>
  </section>

  <!-- 05 / 焊接与装配细节 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">工艺</p>
        <h2>焊接与装配控制</h2>
        <p>焊接与装配按批准图纸、项目适用工艺要求和检验要求进行制造。如项目指定，可安排无损检测（UT/MT/PT），焊工资质按项目要求确认。</p>
      </div>
      <div class="weld-layout">
        <figure class="weld-img reveal">
          <img src="/images/manufacturing/real/welding-9820.jpg" alt="中赛生产基地钢结构焊接工序" loading="lazy" width="600" height="380">
          <figcaption>钢构件焊接工序</figcaption>
        </figure>
        <ul class="check-list reveal reveal-delay-1">
          <li><strong>装配对齐</strong> — H型钢装配与对齐，按图纸进行构件组对</li>
          <li><strong>接口尺寸</strong> — 连接接口尺寸核验，几何尺寸控制</li>
          <li><strong>焊接顺序</strong> — 焊接顺序与变形控制</li>
          <li><strong>焊缝检验</strong> — 所有焊缝外观检验，项目要求的无损检测（如指定）</li>
          <li><strong>焊工资质</strong> — 焊工资质按项目要求确认</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 06 / 表面处理与防腐 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">防腐</p>
        <h2>表面处理与防腐保护</h2>
        <p>表面保护方案根据项目环境、腐蚀等级、客户规范和设计寿命要求选择。</p>
      </div>
      <div class="surf-layout">
        <div class="mf-points" style="margin: 0;">
          {surfacePoints.map((point, i) => (
            <div class={`mf-point reveal reveal-delay-${(i % 4) + 1}`}>
              <h4>{point.name}</h4>
              <p>{point.desc}</p>
            </div>
          ))}
        </div>
        <figure class="surf-img reveal">
          <img src="/images/manufacturing/real/shot-blasting.jpg" alt="抛丸除锈处理" loading="lazy" width="600" height="340">
          <figcaption>抛丸除锈处理</figcaption>
        </figure>
      </div>
      <div style="margin-top: 24px; padding: 18px 20px; background: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 0 8px 8px 0;" class="reveal">
        <p style="margin: 0; color: #92400e; font-size: 13.5px; line-height: 1.7;"><strong>重要说明：</strong>具体防腐保护体系根据项目环境、腐蚀等级、客户规范、当地标准和设计寿命要求确定。我们不对所有项目采用统一涂层方案，也不承诺未经项目工程分析的固定防腐寿命。</p>
      </div>
    </div>
  </section>

  <!-- 07 / 构件编号与出口交付准备 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">编号</p>
        <h2>面向海外安装的构件编号与交付准备</h2>
        <p>清晰的构件编号和标识减少海外现场安装混乱，帮助当地承包商按安装顺序正确识别、定位和吊装每个构件。</p>
      </div>
      <div class="mark-layout">
        <div class="mark-grid">
          {markingPoints.map((point, i) => (
            <div class={`mf-point reveal reveal-delay-${(i % 4) + 1}`}>
              <h4>{point.name}</h4>
              <p>{point.desc}</p>
            </div>
          ))}
        </div>
        <figure class="mark-img reveal">
          <img src="/images/manufacturing/real/component-marking.jpg" alt="出口构件编号与标识" loading="lazy" width="600" height="340">
          <figcaption>构件编号与标识</figcaption>
