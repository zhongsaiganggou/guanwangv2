---
// ZhongSai V2 - Chinese Contact / Project Inquiry Page
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/hub.css';

const lang = 'zh';
const title = '钢结构项目询盘｜提交图纸与工程需求｜中赛钢构';
const description = '与中赛钢构沟通您的钢结构项目。上传图纸或提交项目需求，由自有设计与交付团队进行初步工程评审。';

const inquiryPaths = [
  {
    title: '我有图纸',
    desc: '我有建筑图、结构图、BOQ或初步图纸。',
    items: [
      '结构图',
      '建筑图',
      'BOQ / 材料清单',
      '项目技术要求',
      '参考图纸或项目资料'
    ],
    fileTypes: 'PDF, DWG, DXF, JPG, PNG, XLS, XLSX',
    cta: '上传项目图纸'
  },
  {
    title: '我还没有完整图纸',
    desc: '我有项目概念、尺寸或建设需求。',
    items: [
      '项目国家',
      '建筑类型',
      '项目用途',
      '大致尺寸',
      '吊车 / 设备需求',
      '其他项目要求'
    ],
    note: '尚未确定的信息不需要强行填写。我们的工程团队可以在沟通中协助明确需求。',
    cta: '告诉我们您的项目'
  }
];

const checklist = [
  '项目国家',
  '建筑类型',
  '项目用途',
  '已有尺寸',
  '图纸 / BOQ',
  '吊车需求（如适用）',
  '适用项目规范（如已有）',
  '当前项目阶段或需求说明'
];

const supportItems = [
  '设计深化支持',
  '钢结构生产加工',
  '钢构件及材料供应',
  '包装与装柜',
  '出口单证支持',
  '物流协调',
  '海外安装技术指导'
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Section 01: Hero -->
  <section class="contact-hero">
    <div class="container contact-hero-inner">
      <div class="contact-hero-text">
        <div class="hub-breadcrumb">
          <a href="/zh/">首页</a><span>/</span><span>联系我们</span>
        </div>
        <p class="eyebrow">项目询盘</p>
        <h1>提交您的钢结构项目需求</h1>
        <p class="contact-hero-desc">无论您已有完整图纸，还是仍处于项目规划阶段，中赛钢构自有设计团队和交付团队都可以评审您的项目需求，并协调下一步工作。</p>
        <a href="#inquiry-paths" class="btn btn-primary btn-large">开始项目询盘</a>
      </div>
      <div class="contact-hero-visual">
        <img src="/images/manufacturing/real/factory-overview-9819.jpg" alt="中赛钢构钢结构制造工厂" width="600" height="450" loading="eager">
      </div>
    </div>
  </section>

  <!-- Section 02: Two Inquiry Paths -->
  <section class="hub-section">
    <div class="container">
      <div class="hub-section-head">
        <h2>两种方式提交项目需求</h2>
      </div>
      <div class="inquiry-paths">
        {inquiryPaths.map((path, i) => (
          <div class={`inquiry-card ${i === 0 ? 'inquiry-card-primary' : ''}`}>
            <h3>{path.title}</h3>
            <p class="inquiry-desc">{path.desc}</p>
            <ul class="inquiry-list">
              {path.items.map(item => (
                <li>{item}</li>
              ))}
            </ul>
            {path.fileTypes && <p class="inquiry-filetypes">支持文件格式：{path.fileTypes}</p>}
            {path.note && <p class="inquiry-note">{path.note}</p>}
            <a href="#quote-form" class="btn {i === 0 ? 'btn-primary' : 'btn-outline'}">{path.cta}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 03: Project Information Checklist -->
  <section class="hub-section hub-section-light">
    <div class="container">
      <div class="hub-section-head">
        <h2>有助于了解项目的信息</h2>
      </div>
      <div class="checklist-grid">
        {checklist.map((item, i) => (
          <div class="checklist-item">
            <span class="checklist-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="checklist-text">{item}</span>
          </div>
        ))}
      </div>
      <p class="checklist-note">提交目前已有的信息即可，其他资料可在后续项目沟通中进一步确认。</p>
    </div>
  </section>

  <!-- Section 04: What ZhongSai Supports + Boundary + Contact Cards -->
  <section class="hub-section">
    <div class="container">
      <div class="hub-section-head">
        <h2>中赛可以提供的项目支持</h2>
      </div>
      <div class="support-grid">
        {supportItems.map(item => (
          <div class="support-item">
            <span class="support-dot"></span>
            <span>{item}</span>
          </div>
        ))}
      </div>

      <!-- Boundary Statement -->
      <div class="boundary-statement">
        <p><strong>中赛钢构是钢结构制造与出口供应商。</strong>项目当地安装及施工由客户或当地施工团队负责。中赛可根据项目需求提供海外安装技术指导。</p>
      </div>

      <!-- Contact Cards -->
      <div class="contact-cards">
        <a href="https://wa.me/8613192007378?text=您好中赛钢构，我有一个钢结构项目，想沟通项目需求。" target="_blank" rel="noopener" class="contact-card">
          <div class="contact-card-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div>
          <div class="contact-card-info">
            <small>WHATSAPP / 电话</small>
            <b>+86 131 9200 7378</b>
          </div>
        </a>
        <a href="mailto:zhongsaiganggou@gmail.com" class="contact-card">
          <div class="contact-card-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg></div>
          <div class="contact-card-info">
            <small>邮箱</small>
            <b>zhongsaiganggou@gmail.com</b>
          </div>
        </a>
        <a href="#quote-form" class="contact-card contact-card-primary">
          <div class="contact-card-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></svg></div>
          <div class="contact-card-info">
            <small>项目询盘表单</small>
            <b>提交项目需求</b>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Section 04b: Contact FAQ -->
  <section class="hub-section hub-section-light">
    <div class="container">
      <div class="hub-section-head">
        <h2>联系中赛前的常见问题</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>中赛是制造商还是贸易公司？</summary>
          <p>中赛是钢结构项目供应商，拥有自有设计深化团队、广东制造基地和项目交付团队。公司同时承担出口、项目管理和制造协调职能，钢结构构件在广东生产基地加工制造。</p>
        </details>
        <details class="faq-item">
          <summary>没有图纸可以询价吗？</summary>
          <p>可以。请提供项目国家、建筑类型、用途、已有尺寸（长/宽/高）和其他已知要求。中赛可根据基础信息进行初步项目评估，后续在沟通中补充详细资料。</p>
        </details>
        <details class="faq-item">
          <summary>报价需要多长时间？</summary>
          <p>有完整图纸和BOQ的项目，通常在1-3个工作日内给出初步报价。仅有基础参数的项目，需要先进行结构方案确认，时间根据项目复杂度而定。</p>
        </details>
        <details class="faq-item">
          <summary>可以参观工厂吗？</summary>
          <p>符合条件的项目客户可以预约参观中赛广东生产基地，进行制造能力和质量控制核验。请提前联系项目团队安排工厂访问。</p>
        </details>
        <details class="faq-item">
          <summary>中赛提供当地施工和安装吗？</summary>
          <p>中赛提供设计深化、制造加工、出口供应和安装技术指导。当地土建、实际施工和现场安装通常由客户或当地施工团队负责。特定项目可根据合同范围安排技术人员现场支持。</p>
        </details>
        <details class="faq-item">
          <summary>如何联系中赛最快？</summary>
          <p>微信是中赛的核心联系方式，添加后可直接发送图纸和项目需求。也可以通过WhatsApp（+86 131 9200 7378）或邮箱（zhongsaiganggou@gmail.com）联系。</p>
        </details>
      </div>
    </div>
  </section>


  <!-- Section 04b: 设计团队评审内容 -->
  <section class="hub-section">
    <div class="container">
      <div class="hub-section-head">
        <h2>我们的工程团队会评审什么</h2>
        <p class="section-subtitle">您的项目信息将进入初步工程评审流程，而不是普通销售邮箱。</p>
      </div>
      <div class="review-grid">
        <div class="review-item">
          <div class="review-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3>项目所在地</h3>
          <p>国家、城市及影响结构设计的当地设计规范要求。</p>
        </div>
        <div class="review-item">
          <div class="review-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3>建筑用途与类型</h3>
          <p>工业厂房、仓库物流、矿业能源、商业公共、农业或基础设施应用。</p>
        </div>
        <div class="review-item">
          <div class="review-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          </div>
          <h3>尺寸与布局</h3>
          <p>跨度、长度、檐高、柱距及设备布局要求。</p>
        </div>
        <div class="review-item">
          <div class="review-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h3>结构图纸</h3>
          <p>建筑图、结构图、BOQ及项目技术规格，用于详细评审。</p>
        </div>
        <div class="review-item">
          <div class="review-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </div>
          <h3>吊车与设备荷载</h3>
          <p>行车吨位、设备荷载、动荷载及振动要求。</p>
        </div>
        <div class="review-item">
          <div class="review-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <h3>运输与拼装</h3>
          <p>集装箱装载可行性、构件拆分及现场拼装考虑。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 04c: 提交后流程 -->
  <section class="hub-section hub-section-light">
    <div class="container">
      <div class="hub-section-head">
        <h2>提交以后会发生什么</h2>
        <p class="section-subtitle">从初步提交到项目方案的清晰流程。</p>
      </div>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-num">01</div>
          <h3>项目信息接收</h3>
          <p>您的图纸和项目需求被接收并录入我们的项目跟踪系统。</p>
        </div>
        <div class="process-step">
          <div class="step-num">02</div>
          <h3>初步工程评审</h3>
          <p>自有设计团队评审结构可行性、荷载、尺寸及制造要求。</p>
        </div>
        <div class="process-step">
          <div class="step-num">03</div>
          <h3>补充信息确认</h3>
          <p>如需更多细节，我们通过微信或邮件联系您确认项目需求。</p>
        </div>
        <div class="process-step">
          <div class="step-num">04</div>
          <h3>技术与商务沟通</h3>
          <p>讨论结构方案、制造范围、交付周期及项目协调细节。</p>
        </div>
        <div class="process-step">
          <div class="step-num">05</div>
          <h3>确认范围后出方案</h3>
          <p>基于确认的图纸、范围和需求，提供正式项目方案和报价。</p>
        </div>
      </div>
      <p class="process-note">我们力争在24小时内回复合格的项目询盘。复杂项目可能需要额外的工程评审时间。</p>
    </div>
  </section>

  <!-- Section 04d: 信任证据 -->
  <section class="hub-section">
    <div class="container">
      <div class="hub-section-head">
        <h2>项目业主选择中赛的原因</h2>
      </div>
      <div class="trust-grid">
        <div class="trust-item">
          <div class="trust-num">自有</div>
          <h3>设计深化团队</h3>
          <p>自有工程团队负责结构协调、深化设计及节点开发。</p>
        </div>
        <div class="trust-item">
          <div class="trust-num">自有</div>
          <h3>项目交付团队</h3>
          <p>专属交付团队协调生产、包装、装柜及出口单证。</p>
        </div>
        <div class="trust-item">
          <div class="trust-num">约10万㎡</div>
          <h3>制造基地</h3>
          <p>广东生产基地，具备受控制造、检验和质量管理。</p>
        </div>
        <div class="trust-item">
          <div class="trust-num">60+</div>
          <h3>出口国家</h3>
          <p>项目交付经验覆盖东南亚、中东、非洲、南美等地区。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 05: Quote Form -->
  <section class="hub-section hub-section-dark">
    <div class="container">
      <div class="hub-section-head">
        <h2>项目询盘表单</h2>
      </div>
      <div class="form-intro">
        <p>已有图纸，可直接上传现有资料。</p>
        <p>暂无图纸，可填写目前已有的项目需求信息。</p>
      </div>
      <QuoteForm lang="zh" />
    </div>
  </section>
</BaseLayout>

<style>
.contact-hero {
  padding: 60px 0 40px;
  background: var(--bg-light, #f8f9fa);
}
.contact-hero-inner {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 48px;
  align-items: center;
}
.contact-hero-text h1 {
  font-size: 2.2rem;
  line-height: 1.25;
  margin: 12px 0 16px;
  color: var(--primary, #0a3d62);
}
.contact-hero-desc {
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--text-secondary, #555);
  margin-bottom: 24px;
}
.contact-hero-visual img {
  width: 100%;
  height: auto;
  border-radius: 12px;
  object-fit: cover;
}
.inquiry-paths {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32px;
  margin-top: 32px;
}
.inquiry-card {
  padding: 36px;
  border-radius: 12px;
  background: #fff;
  border: 1px solid rgba(0,0,0,0.08);
}
.inquiry-card-primary {
  border: 2px solid var(--primary, #0a3d62);
  background: rgba(10, 61, 98, 0.02);
}
.inquiry-card h3 {
  font-size: 1.3rem;
  margin-bottom: 8px;
  color: var(--primary, #0a3d62);
}
.inquiry-desc {
  color: var(--text-secondary, #666);
  margin-bottom: 16px;
  font-size: 0.95rem;
}
.inquiry-list {
  list-style: none;
  padding: 0;
  margin-bottom: 16px;
}
.inquiry-list li {
  padding: 6px 0;
  padding-left: 20px;
  position: relative;
  font-size: 0.92rem;
  color: var(--text-secondary, #555);
}
.inquiry-list li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--primary, #0a3d62);
  font-weight: 700;
}
.inquiry-filetypes {
  font-size: 0.82rem;
  color: #888;
  margin-bottom: 16px;
  padding: 8px 12px;
  background: rgba(0,0,0,0.03);
  border-radius: 6px;
}
.inquiry-note {
  font-size: 0.88rem;
  color: var(--primary, #0a3d62);
  font-style: italic;
  margin-bottom: 16px;
}
.checklist-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-top: 32px;
}
.checklist-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  background: #fff;
  border-radius: 8px;
  border: 1px solid rgba(0,0,0,0.06);
}
.checklist-num {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--primary, #0a3d62);
  min-width: 28px;
}
.checklist-text {
  font-size: 0.9rem;
  color: var(--text-secondary, #555);
}
.checklist-note {
  text-align: center;
  margin-top: 24px;
