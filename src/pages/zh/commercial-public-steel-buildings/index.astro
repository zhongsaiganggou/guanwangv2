---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const title = '商业与公共钢结构建筑｜大跨度空间设计、制造与出口｜中赛钢构';
const description = '中赛钢构提供商业与公共钢结构建筑解决方案，覆盖购物中心、展厅、汽车4S店、医院、学校、酒店、写字楼及体育场馆，支持大跨度设计、灵活布局与公共安全标准。';
const lang = 'zh';
const canonical = 'https://zhongsai-steelstructure.com/zh/commercial-public-steel-buildings/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/products/app-commercial-public.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">商业 · 公共钢结构</span>
      <h1>商业与公共钢结构建筑</h1>
      <p class="lead">中赛钢构为商业与公共建筑提供钢结构解决方案——包括购物中心、展厅、汽车4S店、医院、学校、酒店、写字楼及体育场馆。从设计深化到制造出口，支持大跨度框架、灵活内部布局、公共安全要求与耐久围护系统。</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">提交商业公共建筑需求</a>
        <a href="/zh/products/" class="btn btn-outline">查看全部产品</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/zh/">首页</a>
      <span class="sep">/</span>
      <a href="/zh/products/">产品</a>
      <span class="sep">/</span>
      <span class="current">商业与公共建筑</span>
    </div>
  </nav>

  <!-- 01 / 商业项目需求 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">商业项目需求</p>
        <h2>商业钢结构建筑项目需要确认哪些信息</h2>
        <p>商业与公共建筑需要围绕人员安全、大跨度空间、灵活布局和美学要求进行仔细规划。以下信息直接影响结构设计、围护规格和建筑配置。</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>建筑功能</h3>
          <p>购物中心、展厅、汽车4S店、医院、学校、酒店、写字楼或体育场馆——不同功能需要不同的结构和空间配置。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>跨度与高度</h3>
          <p>所需净跨度、层高和无柱区域决定结构框架类型和构件尺寸。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>楼面荷载</h3>
          <p>人员荷载、设备荷载和潜在未来用途变更影响楼盖系统设计和结构承载力。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>公共安全</h3>
          <p>耐火等级、疏散路线和公共安全规范影响材料选择、涂装和结构节点设计。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>外立面与围护</h3>
          <p>幕墙支撑、屋面系统、保温和防水要求根据建筑设计和当地气候确定。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>多层需求</h3>
          <p>单层、多层或综合用途配置影响结构体系选择和荷载传递设计。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / 大跨度商业结构 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">大跨度商业结构</p>
        <h2>商业建筑的大跨度钢结构框架</h2>
        <p>商业建筑通常需要大型无柱空间用于零售楼层、展厅、体育场馆和中庭。钢结构为这些应用提供所需的跨度能力和设计灵活性。</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/app-commercial-public.jpg" alt="商业公共钢结构大跨度建筑" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>商业用途的灵活框架</h3>
          <ul>
            <li>门式框架和桁架系统提供大跨度、无柱内部空间，适合零售和公共空间</li>
            <li>多层钢框架支持写字楼、酒店和综合用途建筑的灵活楼层布局</li>
            <li>幕墙和外立面支撑结构与建筑设计协调</li>
            <li>屋面系统按大跨度设计，配合适当的排水和保温</li>
            <li>具体跨度、高度和荷载根据项目图纸和技术要求确定</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / 公共建筑类型 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">公共建筑类型</p>
        <h2>公共与机构建筑的钢结构</h2>
        <p>医院、学校、体育场馆和交通枢纽等公共建筑在人员安全、耐久性和功能灵活性方面有特定的结构要求。</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/products/03-commercial-public.jpg');"></div>
          <div class="feature-body">
            <h3>医院与医疗建筑</h3>
            <p>医院建筑的钢结构框架，支持灵活楼层布局、设备荷载和严格的公共安全要求。</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/detail-hospital-building.jpg');"></div>
          <div class="feature-body">
            <h3>学校与体育场馆</h3>
            <p>体育馆、体育场和学校建筑的大跨度钢结构，支持无柱活动空间。</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!--  工程参数 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">工程参数</p>
        <h2>商业与公共建筑典型工程参数</h2>
        <p>以下参数根据项目图纸、荷载要求和当地设计规范确定，不代表固定标准值。</p>
      </div>
      <div class="params-table-wrapper">
        <table class="params-table">
          <thead>
            <tr>
              <th>参数</th>
              <th>说明 / 项目确定</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>建筑类型</td><td>商业综合体、展厅、医院、学校、体育场馆、写字楼、酒店等</td></tr>
            <tr><td>结构体系</td><td>多层钢框架 / 大跨度桁架 / 门式框架 / 混合结构</td></tr>
            <tr><td>跨度</td><td>根据建筑功能和无柱空间需求确定</td></tr>
            <tr><td>层高 / 檐高</td><td>根据建筑用途、设备和规范要求确定</td></tr>
            <tr><td>楼面荷载</td><td>人员荷载、设备荷载、活荷载按项目用途和当地规范确定</td></tr>
            <tr><td>吊车需求</td><td>如适用，根据设备吊装要求确定</td></tr>
            <tr><td>主钢材等级</td><td>Q355B或项目指定等级</td></tr>
            <tr><td>连接方式</td><td>螺栓连接 / 焊接 / 混合连接</td></tr>
            <tr><td>屋面系统</td><td>金属屋面板 / 夹芯板 / 项目指定屋面系统</td></tr>
            <tr><td>墙面系统</td><td>金属墙面板 / 夹芯板 / 幕墙支撑结构</td></tr>
            <tr><td>表面处理</td><td>涂装 / 热浸镀锌 / 项目指定防腐体系</td></tr>
            <tr><td>耐火要求</td><td>根据建筑类型和当地消防规范确定</td></tr>
            <tr><td>设计标准</td><td>根据项目所在地和客户规范确定</td></tr>
            <tr><td>出口方式</td><td>集装箱运输 / 项目指定物流方案</td></tr>
            <tr><td>安装支持</td><td>提供安装技术指导</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 04 / 围护与幕墙支撑 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">围护与幕墙支撑</p>
        <h2>围护系统与幕墙支撑结构</h2>
        <p>商业建筑需要高质量的围护系统和幕墙支撑结构，满足美学、热工和防水要求，同时确保长期耐久性。</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/06-custom-engineering.jpg" alt="商业建筑围护幕墙支撑" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>一体化围护与幕墙解决方案</h3>
          <ul>
            <li>屋面板和墙面板系统与主体钢结构一起供应</li>
            <li>幕墙支撑框架和连接结构按建筑图纸制造</li>
            <li>保温、防水和排水节点按项目要求设计</li>
            <li>外立面荷载通过合理设计的连接传递到主体结构</li>
            <li>具体围护系统和幕墙节点根据项目技术要求确定</li>
          </ul>
          <div style="margin-top: 20px;">
            <a href="/zh/components/roof-wall-cladding-systems/" class="btn btn-outline">查看围护系统</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 / 制造与出口供应 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">制造与出口供应</p>
        <h2>从图纸到出口交付的商业项目流程</h2>
        <p>中赛拥有自有生产基地，按项目图纸制造商业钢结构建筑构件，覆盖切割、装配、焊接、表面处理和质量控制。</p>
      </div>
      <div class="process-flow">
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">01</div>
          <h4>图纸确认</h4>
          <p>项目图纸、BOQ和技术要求确认</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">02</div>
          <h4>设计深化</h4>
          <p>深化设计和制造图纸准备</p>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">03</div>
          <h4>制造加工</h4>
          <p>按图纸组织商业钢结构构件制造</p>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">04</div>
          <h4>构件编号</h4>
          <p>根据加工图进行构件标记和编号</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>包装装柜</h4>
          <p>按构件类型和装柜要求组织包装</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">06</div>
          <h4>出口协调</h4>
          <p>出口资料支持和物流协调</p>
        </div>
      </div>
    </div>
  </section>


  <!-- 05b / 报价所需信息 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">报价信息</p>
        <h2>商业建筑报价需要哪些信息</h2>
        <p>提供以下信息有助于中赛进行准确的项目评估和报价。目前已有的信息可以先提交，其他资料可在后续沟通中补充。</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>项目基本信息</h3>
          <p>项目国家/城市、建筑类型、用途、预计规模。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>建筑尺寸</h3>
          <p>长度、宽度、高度、层数、跨度要求。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>荷载与规范</h3>
          <p>楼面荷载、设备荷载、设计规范、耐火等级要求。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>围护与幕墙</h3>
          <p>屋面系统、墙面系统、幕墙要求、保温需求。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>图纸资料</h3>
          <p>建筑图、结构图、BOQ、技术规格书（如有）。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>项目时间线</h3>
          <p>预计开工时间、交付要求、目的港（如出口）。</p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 32px;">
        <a href="#quote" class="btn btn-primary">提交商业建筑项目需求</a>
      </div>
    </div>
  </section>


  <!-- 05c / 真实项目案例 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">项目案例</p>
        <h2>商业与公共建筑相关项目</h2>
        <p>以下项目的钢结构构件经过中赛设计深化、制造加工和出口交付。</p>
      </div>
      <div class="rp-grid">
        <a href="/zh/projects/macau-londoner/" class="related-project-card">
          <div class="rpc-image">
            <img src="/images/projects/overseas/macau-londoner.jpg" alt="澳门伦敦人商业综合项目" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">商业综合</span>
            <h4>澳门伦敦人</h4>
            <p class="rpc-location">中国澳门</p>
            <p class="rpc-data">约8,000吨 · 复杂异形结构</p>
            <p class="rpc-scope"><span>中赛范围:</span> 钢结构设计深化、制造与供应</p>
          </div>
        </a>
        <a href="/zh/projects/macau-city-of-dreams-phase2/" class="related-project-card">
          <div class="rpc-image">
            <img src="/images/projects/overseas/macau-city-of-dreams.jpg" alt="澳门新濠影汇二期项目" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">商业娱乐</span>
            <h4>澳门新濠影汇二期</h4>
            <p class="rpc-location">中国澳门</p>
            <p class="rpc-data">约5,000吨 · 40+复杂相贯节点</p>
            <p class="rpc-scope"><span>中赛范围:</span> 钢结构设计深化、制造与供应</p>
          </div>
        </a>
        <a href="/zh/projects/dongguan-huarun-center/" class="related-project-card">
          <div class="rpc-image">
            <img src="/images/projects/dongguan-cr-landmark-rendering.jpg" alt="东莞华润中心商业综合体项目" loading="lazy">
          </div>
          <div class="rpc-content">
            <span class="rpc-category">商业综合体</span>
            <h4>东莞华润中心</h4>
            <p class="rpc-location">广东东莞</p>
            <p class="rpc-data">约80万㎡ · 指定钢结构构件</p>
            <p class="rpc-scope"><span>中赛范围:</span> 指定钢结构构件制造与加工</p>
          </div>
        </a>
      </div>
      <div class="rp-more">
        <a href="/zh/projects/" class="btn btn-outline">查看全部项目案例 →</a>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">相关能力</p>
        <h2>相关能力</h2>
        <p>探索中赛为您项目提供的相关能力和服务。</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3><a href="/zh/transportation-infrastructure-steel/" style="color: inherit; text-decoration: none;">交通与基础设施</a></h3>
            <p>工业与生产建筑</p>
            <a href="/zh/transportation-infrastructure-steel/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3><a href="/zh/products/custom-engineering/" style="color: inherit; text-decoration: none;">定制工程</a></h3>
            <p>定制钢结构加工</p>
            <a href="/zh/products/custom-engineering/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3><a href="/zh/engineering-design/" style="color: inherit; text-decoration: none;">工程设计</a></h3>
            <p>设计与深化支持</p>
            <a href="/zh/engineering-design/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-4">
          <div class="feature-body">
            <h3><a href="/zh/export-delivery/" style="color: inherit; text-decoration: none;">出口交付</a></h3>
            <p>包装、装柜与出口协调</p>
            <a href="/zh/export-delivery/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- FAQ -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">常见问题</p>
        <h2>商业与公共建筑常见问题</h2>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>中赛可以做多层商业建筑吗？</summary>
          <p>可以。中赛可根据项目图纸和技术要求制造多层钢框架结构，支持写字楼、酒店、商业综合体等多层建筑。具体层数、荷载和结构体系根据项目设计确定。</p>
        </details>
        <details class="faq-item">
          <summary>大跨度展厅和体育场馆可以做吗？</summary>
          <p>可以。中赛可制造大跨度桁架、门式框架和空间钢结构，支持展厅、体育馆、机场等大跨度无柱空间。具体跨度和结构形式根据项目设计和荷载要求确定。</p>
        </details>
        <details class="faq-item">
          <summary>商业建筑的耐火要求如何处理？</summary>
          <p>耐火等级和防火要求根据建筑类型、高度和当地消防规范确定。中赛可根据项目要求采用防火涂料、防火板等耐火保护方案，具体方案需在项目设计阶段确认。</p>
        </details>
        <details class="faq-item">
          <summary>幕墙支撑结构可以一起供应吗？</summary>
          <p>可以。中赛可根据建筑图纸制造幕墙支撑框架和连接结构，与主体钢结构一起供应。具体幕墙系统和节点根据建筑设计和幕墙分包要求确定。</p>
        </details>
        <details class="faq-item">
          <summary>没有完整图纸可以报价吗？</summary>
          <p>可以先提供项目国家、建筑类型、用途、尺寸和已知要求进行初步评估。完整报价需要建筑图、结构图和技术规格书。中赛可在项目初期提供设计配合建议。</p>
        </details>
        <details class="faq-item">
          <summary>中赛提供当地施工吗？</summary>
          <p>中赛提供设计深化、制造加工、出口供应和安装技术指导。当地土建、实际施工和现场安装通常由客户或当地施工团队负责。特定项目可根据合同范围安排技术人员现场支持。</p>
        </details>
      </div>
    </div>
  </section>

