---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const title = '商业与公共钢结构建筑 | 商场、展厅、医院钢结构 | 中赛钢构';
const description = '中赛钢构提供商业与公共钢结构建筑解决方案，覆盖购物中心、展厅、汽车4S店、医院、学校、酒店、写字楼及体育场馆，支持大跨度设计、灵活布局与公共安全标准。';
const lang = 'zh';
const canonical = 'https://zhongsai-steelstructure.com/zh/commercial-public-steel-buildings/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/products/app-commercial-public.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">商业 · 公共钢结构</span>
      <h1>商业与公共钢结构建筑</h1>
      <p class="lead">中赛钢构为商业与公共建筑提供钢结构解决方案——包括购物中心、展厅、汽车4S店、医院、学校、酒店、写字楼及体育场馆。从设计深化到制造出口，支持大跨度框架、灵活内部布局、公共安全要求与耐久围护系统。</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">获取项目报价</a>
        <a href="/zh/products/" class="btn btn-outline">查看全部产品</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/zh/">首页</a>
      <span class="sep">/</span>
      <a href="/zh/products/">产品</a>
      <span class="sep">/</span>
      <span class="current">商业与公共建筑</span>
    </div>
  </nav>

  <!-- 01 / 商业项目需求 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">01 / 商业项目需求</p>
        <h2>商业钢结构建筑项目需要确认哪些信息</h2>
        <p>商业与公共建筑需要围绕人员安全、大跨度空间、灵活布局和美学要求进行仔细规划。以下信息直接影响结构设计、围护规格和建筑配置。</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>建筑功能</h3>
          <p>购物中心、展厅、汽车4S店、医院、学校、酒店、写字楼或体育场馆——不同功能需要不同的结构和空间配置。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>跨度与高度</h3>
          <p>所需净跨度、层高和无柱区域决定结构框架类型和构件尺寸。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>楼面荷载</h3>
          <p>人员荷载、设备荷载和潜在未来用途变更影响楼盖系统设计和结构承载力。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>公共安全</h3>
          <p>耐火等级、疏散路线和公共安全规范影响材料选择、涂装和结构节点设计。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>外立面与围护</h3>
          <p>幕墙支撑、屋面系统、保温和防水要求根据建筑设计和当地气候确定。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>多层需求</h3>
          <p>单层、多层或综合用途配置影响结构体系选择和荷载传递设计。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / 大跨度商业结构 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">02 / 大跨度商业结构</p>
        <h2>商业建筑的大跨度钢结构框架</h2>
        <p>商业建筑通常需要大型无柱空间用于零售楼层、展厅、体育场馆和中庭。钢结构为这些应用提供所需的跨度能力和设计灵活性。</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/app-commercial-public.jpg" alt="商业公共钢结构大跨度建筑" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>商业用途的灵活框架</h3>
          <ul>
            <li>门式框架和桁架系统提供大跨度、无柱内部空间，适合零售和公共空间</li>
            <li>多层钢框架支持写字楼、酒店和综合用途建筑的灵活楼层布局</li>
            <li>幕墙和外立面支撑结构与建筑设计协调</li>
            <li>屋面系统按大跨度设计，配合适当的排水和保温</li>
            <li>具体跨度、高度和荷载根据项目图纸和技术要求确定</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / 公共建筑类型 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">03 / 公共建筑类型</p>
        <h2>公共与机构建筑的钢结构</h2>
        <p>医院、学校、体育场馆和交通枢纽等公共建筑在人员安全、耐久性和功能灵活性方面有特定的结构要求。</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/products/03-commercial-public.jpg');"></div>
          <div class="feature-body">
            <h3>医院与医疗建筑</h3>
            <p>医院建筑的钢结构框架，支持灵活楼层布局、设备荷载和严格的公共安全要求。</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/detail-hospital-building.jpg');"></div>
          <div class="feature-body">
            <h3>学校与体育场馆</h3>
            <p>体育馆、体育场和学校建筑的大跨度钢结构，支持无柱活动空间。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 / 围护与幕墙支撑 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">04 / 围护与幕墙支撑</p>
        <h2>围护系统与幕墙支撑结构</h2>
        <p>商业建筑需要高质量的围护系统和幕墙支撑结构，满足美学、热工和防水要求，同时确保长期耐久性。</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/06-custom-engineering.jpg" alt="商业建筑围护幕墙支撑" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>一体化围护与幕墙解决方案</h3>
          <ul>
            <li>屋面板和墙面板系统与主体钢结构一起供应</li>
            <li>幕墙支撑框架和连接结构按建筑图纸制造</li>
            <li>保温、防水和排水节点按项目要求设计</li>
            <li>外立面荷载通过合理设计的连接传递到主体结构</li>
            <li>具体围护系统和幕墙节点根据项目技术要求确定</li>
          </ul>
          <div style="margin-top: 20px;">
            <a href="/zh/components/roof-wall-cladding-systems/" class="btn btn-outline">查看围护系统</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 / 制造与出口供应 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">05 / 制造与出口供应</p>
        <h2>从图纸到出口交付的商业项目流程</h2>
        <p>中赛拥有自有生产基地，按项目图纸制造商业钢结构建筑构件，覆盖切割、装配、焊接、表面处理和质量控制。</p>
      </div>
      <div class="process-flow">
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">01</div>
          <h4>图纸确认</h4>
          <p>项目图纸、BOQ和技术要求确认</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">02</div>
          <h4>设计深化</h4>
          <p>深化设计和制造图纸准备</p>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">03</div>
          <h4>制造加工</h4>
          <p>按图纸组织商业钢结构构件制造</p>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">04</div>
          <h4>构件编号</h4>
          <p>根据加工图进行构件标记和编号</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>包装装柜</h4>
          <p>按构件类型和装柜要求组织包装</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">06</div>
          <h4>出口协调</h4>
          <p>出口资料支持和物流协调</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">06 / 相关能力</p>
        <h2>相关能力</h2>
        <p>探索中赛为您项目提供的相关能力和服务。</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3><a href="/zh/steel-workshop/" style="color: inherit; text-decoration: none;">钢结构厂房</a></h3>
            <p>工业与生产建筑</p>
            <a href="/zh/steel-workshop/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3><a href="/zh/products/custom-engineering/" style="color: inherit; text-decoration: none;">定制工程</a></h3>
            <p>定制钢结构加工</p>
            <a href="/zh/products/custom-engineering/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3><a href="/zh/engineering-design/" style="color: inherit; text-decoration: none;">工程设计</a></h3>
            <p>设计与深化支持</p>
            <a href="/zh/engineering-design/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-4">
          <div class="feature-body">
            <h3><a href="/zh/export-delivery/" style="color: inherit; text-decoration: none;">出口交付</a></h3>
            <p>包装、装柜与出口协调</p>
            <a href="/zh/export-delivery/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote Form -->
  <section id="quote" class="detail-section">
    <div class="container">
      <QuoteForm />
    </div>
  </section>
</BaseLayout>
