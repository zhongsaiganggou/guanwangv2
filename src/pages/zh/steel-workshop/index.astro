---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const title = '钢结构厂房厂家｜工业厂房设计、制造与出口｜中赛钢构';
const description = '中赛钢构提供钢结构厂房、工业车间的设计深化、生产加工、装柜出口及海外安装技术指导，适用于制造工厂、加工车间及带行车工业建筑。';
const lang = 'zh';
const canonical = 'https://zhongsai-steelstructure.com/zh/steel-workshop/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero - 客户需求导向 -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/products/app-industrial-workshop-hero.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">工业厂房 · 生产车间</span>
      <h1>工业制造项目钢结构厂房</h1>
      <p class="lead">为制造工厂、加工车间及带行车工业建筑定制的钢结构厂房。从结构深化到装柜出口，我们将您的生产场地需求转化为可交付的钢结构建筑。</p>
      <div class="hero-capabilities">
        <div class="cap-item">
          <span class="cap-icon">📐</span>
          <span>结构设计与深化</span>
        </div>
        <div class="cap-item">
          <span class="cap-icon">🏭</span>
          <span>工厂制造加工</span>
        </div>
        <div class="cap-item">
          <span class="cap-icon">🚢</span>
          <span>集装箱出口</span>
        </div>
        <div class="cap-item">
          <span class="cap-icon">🔧</span>
          <span>海外安装技术指导</span>
        </div>
      </div>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">提交图纸进行工程审核</a>
        <a href="#quote-info" class="btn btn-outline">获取项目报价</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/zh/">首页</a>
      <span class="sep">/</span>
      <a href="/zh/products/">产品</a>
      <span class="sep">/</span>
      <span class="current">工业厂房与车间</span>
    </div>
  </nav>

  <!-- 01 典型应用场景 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">01 / 应用场景</p>
        <h2>钢结构厂房典型应用场景</h2>
        <p>钢结构厂房广泛应用于需要大跨度生产空间、设备集成和行车配套结构设计的工业领域。</p>
      </div>
      <div class="app-grid">
        <div class="app-card reveal reveal-delay-1">
          <h3>制造工厂</h3>
          <p>需要开阔平面布局、设备基础和物料搬运集成的生产设施。</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h3>加工车间</h3>
          <p>具有特定工艺流程布局、通风和生产线配套的加工装配设施。</p>
        </div>
        <div class="app-card reveal reveal-delay-3">
          <h3>机械加工厂</h3>
          <p>重型机械制造，需要行车配套、高荷载能力和设备进出通道。</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h3>汽车相关厂房</h3>
          <p>汽车生产装配设施，大跨度、生产线布局和车辆进出通道。</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h3>重工业设施</h3>
          <p>需要高檐口、重级吊车荷载和稳固结构设计的重型工业应用。</p>
        </div>
        <div class="app-card reveal reveal-delay-3">
          <h3>带行车厂房</h3>
          <p>配备桥式吊车系统的厂房，加固柱和吊车梁一体化设计。</p>
        </div>
        <div class="app-card reveal reveal-delay-1">
          <h3>装配厂房</h3>
          <p>装配生产大厅，灵活柱网、自然采光和通风系统。</p>
        </div>
        <div class="app-card reveal reveal-delay-2">
          <h3>生产车间</h3>
          <p>可适应不断变化的制造工艺和设备布局的多功能生产大厅。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 典型工程参数 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">02 / 工程参数</p>
        <h2>典型工程参数参考</h2>
        <p>工业厂房的结构配置因生产工艺、设备布局和当地建筑规范而异。以下参数为项目参考值，实际设计值必须根据项目图纸、荷载计算和适用的当地标准确定。</p>
      </div>
      <div class="params-table-wrapper">
        <table class="params-table">
          <thead>
            <tr>
              <th>参数项</th>
              <th>典型 / 按项目确定</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>建筑类型</strong></td>
              <td>工业厂房 / 工厂 / 加工车间</td>
            </tr>
            <tr>
              <td><strong>结构体系</strong></td>
              <td>门式刚架 / 多跨钢框架</td>
            </tr>
            <tr>
              <td><strong>跨度</strong></td>
              <td>根据项目要求确定</td>
            </tr>
            <tr>
              <td><strong>檐口高度</strong></td>
              <td>根据设备和工艺要求确定</td>
            </tr>
            <tr>
              <td><strong>柱距</strong></td>
              <td>按项目具体确定</td>
            </tr>
            <tr>
              <td><strong>行车</strong></td>
              <td>可选，根据吊装要求确定</td>
            </tr>
            <tr>
              <td><strong>主材牌号</strong></td>
              <td>Q355B或项目指定等效牌号</td>
            </tr>
            <tr>
              <td><strong>连接方式</strong></td>
              <td>螺栓连接 / 焊接</td>
            </tr>
            <tr>
              <td><strong>屋面系统</strong></td>
              <td>金属压型板 / 夹芯板</td>
            </tr>
            <tr>
              <td><strong>墙面系统</strong></td>
              <td>金属压型板 / 夹芯板</td>
            </tr>
            <tr>
              <td><strong>表面处理</strong></td>
              <td>涂装 / 镀锌，根据环境确定</td>
            </tr>
            <tr>
              <td><strong>设计标准</strong></td>
              <td>根据项目所在地和客户要求确定</td>
            </tr>
            <tr>
              <td><strong>出口方式</strong></td>
              <td>集装箱运输</td>
            </tr>
            <tr>
              <td><strong>安装支持</strong></td>
              <td>可提供技术指导</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="params-note"><strong>说明：</strong>以上所有参数仅为项目参考值。实际跨度、高度、荷载、钢材牌号和连接细节必须由具备资质的结构工程师根据项目具体图纸、荷载计算和适用的当地建筑规范确定。中赛根据经审批的项目图纸提供钢结构制作和出口供货服务。</p>
    </div>
  </section>

  <!-- 03 带行车钢结构厂房 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">03 / 行车厂房</p>
        <h2>带行车钢结构厂房</h2>
        <p>许多工业制造设施需要桥式吊车系统进行物料搬运、设备维护和生产作业。行车需求对结构设计有显著影响，应在项目最早阶段确认。</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/company/factory-steel-beam-fabrication.jpg" alt="带行车钢结构厂房构件加工" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>带行车厂房关键设计要点</h3>
          <ul>
            <li><strong>行车吨位确认</strong> — 起重量、工作制和运行频率需在结构设计前明确</li>
            <li><strong>柱子加固</strong> — 行车荷载需要加固柱截面和增加支撑系统</li>
            <li><strong>吊车梁（牛腿）设计</strong> — 牛腿或吊车梁需在正确标高与柱子一体化设计</li>
            <li><strong>基础反力</strong> — 行车荷载向基础传递附加的竖向和水平力</li>
            <li><strong>跨度与柱距</strong> — 吊车轨道对齐影响柱网布局</li>
            <li><strong>轨顶高度</strong> — 决定所需檐口高度和结构净空</li>
            <li><strong>用钢量影响</strong> — 不同吊车吨位显著影响整体结构用钢量</li>
          </ul>
          <p style="margin-top: 16px; color: #666; font-size: 0.92rem;">不提供统一的行车吨位范围作为通用标准 — 每个项目需根据实际吊装需求、建筑尺寸和适用设计规范进行结构分析。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 结构与生产空间规划 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">04 / 结构与空间规划</p>
        <h2>围绕生产动线的结构与空间规划</h2>
        <p>工业厂房的核心是生产效率。结构规划需要配合设备布置、生产流程和物料运输，而不是单纯追求大跨度。</p>
      </div>
      <div class="image-text-block">
        <div class="itb-image">
          <img src="/images/company/factory-interior-production.jpg" alt="中赛钢构工业厂房生产空间" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>柱网与生产空间协调</h3>
          <p>柱网布局根据设备尺寸、生产通道和物料运输路线确定，在结构经济性和生产空间可用性之间取得平衡。</p>
          <ul>
            <li>柱网间距配合设备布置与生产动线</li>
            <li>净工作高度满足设备运行与操作空间</li>
            <li>行车需求在结构设计阶段确认并预留</li>
            <li>屋面墙面系统与结构框架协调设计</li>
            <li>具体跨度、高度和荷载根据项目图纸与要求确定</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 报价需要提供什么资料 -->
  <section class="detail-section" id="quote-info">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">05 / 报价资料</p>
        <h2>获取厂房报价需要提供什么资料</h2>
        <p>提供越完整的项目信息，报价越准确。仅凭长宽高无法给出准确报价，需要结合用途、设备和技术要求综合评估。</p>
      </div>
      <div class="quote-info-grid">
        <div class="quote-info-card drawing">
          <h4>已有图纸 / BOQ</h4>
          <ul>
            <li>项目所在国家 / 城市</li>
            <li>建筑图纸 / 结构图纸</li>
            <li>工程量清单（BOQ）</li>
            <li>项目技术规格书</li>
            <li>行车 / 设备特殊要求</li>
            <li>当地设计规范（如有指定）</li>
          </ul>
        </div>
        <div class="quote-info-card no-drawing">
          <h4>暂无完整图纸</h4>
          <ul>
            <li>项目所在国家 / 城市</li>
            <li>建筑长度（参考尺寸）</li>
            <li>建筑宽度（参考尺寸）</li>
            <li>檐口高度（参考尺寸）</li>
            <li>行车需求（吨位 / 数量）</li>
            <li>厂房用途（生产 / 加工 / 设备）</li>
            <li>屋面墙面要求</li>
            <li>已有图纸或草图</li>
          </ul>
        </div>
      </div>
      <div style="margin-top: 24px; text-align: center;">
        <a href="#quote" class="btn btn-primary">上传图纸 / 提交项目需求</a>
      </div>
      <p class="quote-note">* 初步方案与报价需基于项目用途和基本参数进行需求评估，最终方案与价格以图纸和技术要求确认为准。</p>
    </div>
  </section>

  <!-- 06 从图纸到交付流程 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">06 / 流程</p>
        <h2>从项目图纸到出口交付的完整流程</h2>
        <p>中赛钢构提供从设计深化到出口交付的钢结构供应服务，当地施工由客户或当地施工团队完成。</p>
      </div>
      <div class="process-flow">
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">01</div>
          <h4>项目信息审核</h4>
          <p>图纸、BOQ与技术要求审核</p>
          <a href="/zh/products/custom-engineering/" class="process-link">工程支持 →</a>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">02</div>
          <h4>结构设计 / 深化</h4>
          <p>深化设计与构件加工图编制</p>
          <a href="/zh/products/custom-engineering/" class="process-link">深化设计 →</a>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">03</div>
          <h4>材料准备</h4>
          <p>钢材采购与材料可追溯性验证</p>
          <a href="/zh/manufacturing-quality/" class="process-link">制造能力 →</a>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">04</div>
          <h4>制造与质量检验</h4>
          <p>切割、组立、焊接与尺寸检验</p>
          <a href="/zh/manufacturing-quality/" class="process-link">质量控制 →</a>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>标识、包装与装柜</h4>
          <p>构件标识，按装柜要求组织包装</p>
          <a href="/zh/export-delivery/" class="process-link">出口交付 →</a>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">06</div>
          <h4>出口交付与安装指导</h4>
          <p>出口单证、海运与海外安装技术指导</p>
          <a href="/zh/export-delivery/" class="process-link">安装指导 →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 钢结构制造 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">07 / 钢结构制造</p>
        <h2>从图纸到构件的制造加工</h2>
        <p>中赛钢构拥有自有生产基地，覆盖切割、组立、焊接、矫正、钻孔、表面处理和质量检验等关键制造环节，按项目图纸组织钢结构构件加工。</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/company/factory-steel-beam-fabrication.jpg');"></div>
          <div class="feature-body">
            <h3>钢梁钢柱加工</h3>
            <p>按深化图进行H型钢、箱型构件等主结构构件的切割、组立与焊接加工，尺寸精度按项目要求控制。</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/manufacturing/real/workshop-overview-wide-9815.jpg');"></div>
          <div class="feature-body">
            <h3>制造与质量控制</h3>
            <p>制造过程按项目图纸和技术规范组织，关键环节进行尺寸、焊接与外观检查，具体检验要求按项目约定执行。</p>
          </div>
        </div>
      </div>
      <div style="margin-top: 28px; display: flex; gap: 16px; flex-wrap: wrap;">
        <a href="/zh/manufacturing-quality/" class="btn btn-outline">查看制造能力</a>
        <a href="/zh/components/fabricated-steel-beams-columns/" class="btn btn-outline">钢梁钢柱构件</a>
      </div>
    </div>
  </section>

  <!-- 08 屋面墙面围护系统 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">08 / 围护系统</p>
        <h2>屋面与墙面围护系统</h2>
        <p>工业厂房的围护系统直接影响使用环境和运营成本。中赛钢构可根据项目要求提供屋面板、墙面板及配套围护材料，与钢结构主体协调供应。</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/detail-cladding-system.jpg" alt="钢结构屋面墙面围护系统" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>围护配置按项目要求确定</h3>
          <p>屋面墙面材料、保温隔热、防水等级和通风采光配置，根据厂房用途、当地气候和项目技术要求确定。</p>
          <ul>
            <li>屋面板与墙面板系统可随主体结构一并供应</li>
            <li>保温隔热层按使用环境和项目要求配置</li>
            <li>屋面排水与防水构造按项目技术要求设计</li>
            <li>通风采光开口与围护系统协调布置</li>
          </ul>
          <div style="margin-top: 20px;">
            <a href="/zh/components/roof-wall-cladding-systems/" class="btn btn-outline">查看围护系统</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 相关项目案例 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">09 / 相关项目</p>
        <h2>工业制造项目案例参考</h2>
        <p>精选工业制造和生产设施项目，展示中赛钢构钢结构制作与供货能力。</p>
      </div>
      <div class="project-grid">
        <a href="/zh/projects/xiegang-aviation-manufacturing/" class="project-card reveal reveal-delay-1">
          <div class="project-img" style="background-image: url('/images/projects/shanghai-baoye-xiegang-aviation-manufacturing-aerial-rendering.jpg');"></div>
          <div class="project-body">
            <span class="project-type">工业制造</span>
            <h3>谢岗通用航空制造项目</h3>
            <div class="project-meta">
              <span>📍 广东东莞</span>
            </div>
            <p class="project-scope">通用航空制造及供应链项目钢结构制作与供货。</p>
          </div>
        </a>
        <a href="/zh/projects/guangzhou-high-end-equipment-base/" class="project-card reveal reveal-delay-2">
          <div class="project-img" style="background-image: url('/images/projects/guangzhou-gongkong-high-end-equipment-base-aerial-rendering.jpg');"></div>
          <div class="project-body">
            <span class="project-type">工业制造</span>
            <h3>广州高端装备研发生产基地</h3>
            <div class="project-meta">
              <span>📍 广东广州</span>
            </div>
