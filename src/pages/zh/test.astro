---
// /zh/test - 中文测试页
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import QuoteForm from '../../components/QuoteForm.astro';

const faqItems = [
  {
    question: '中赛钢构可以根据我们的图纸加工吗？',
    answer: '可以。中赛钢构支持根据客户提供的结构图纸、施工图纸、BOQ/BOM进行工程审核和加工报价。客户可以通过询价表单上传图纸或联系我们的工程团队进行详细沟通。'
  },
  {
    question: '询价需要提供哪些资料？',
    answer: '为了提供准确的报价，建议您提供：项目所在国家、建筑用途、基本尺寸（长×宽×高）、是否有吊车需求、图纸或BOQ（如有）、表面处理要求、交付目的地等信息。即使没有完整图纸，也可以先提交项目需求，我们会提供初步方案建议。'
  },
  {
    question: '中赛是否负责海外当地施工？',
    answer: '中赛钢构提供海外安装技术指导，包括安装图纸、编号说明、远程技术支持等。当地的施工和安装由客户或客户指定的当地施工团队完成。我们可以提供详细的安装手册和技术指导，确保项目顺利进行。'
  }
];
---

<BaseLayout 
  title="组件测试页 | 中赛钢构" 
  description="ZhongSai Website V2 组件测试页面，用于验证Header、导航、语言切换、FAQ、表单等公共组件。"
  lang="zh"
  noindex={true}
>
  <Breadcrumb items={[
    { label: '首页', href: '/zh/' },
    { label: '测试页' }
  ]} lang="zh" />

  <Hero 
    title="ZhongSai Website V2 组件测试"
    subtitle="本页面用于验证所有公共组件的功能、样式和响应式表现。"
    lang="zh"
    primaryCta={{ label: '获取报价', href: '#quote-form' }}
    secondaryCta={{ label: '查看英文页', href: '/en/test/' }}
  />

  <section class="section">
    <div class="container">
      <h2 class="section-title">常见问题</h2>
      <p class="section-subtitle">测试FAQ组件的展开/收起功能、无障碍属性和键盘导航。</p>
      <FAQ items={faqItems} idPrefix="test-zh" lang="zh" />
    </div>
  </section>

  <CTA 
    title="准备好开始您的项目了吗？"
    description="联系中赛钢构，获取专业的钢结构解决方案和报价。"
    lang="zh"
    primaryCta={{ label: '提交项目需求', href: '#quote-form' }}
    secondaryCta={{ label: '了解制造能力', href: '/zh/manufacturing-quality/' }}
  />

  <QuoteForm lang="zh" id="quote-form" />
</BaseLayout>
