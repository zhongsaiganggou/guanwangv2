---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const title = '交通与基础设施钢结构 | 桥梁、机场、港口钢结构加工 | 中赛钢构';
const description = '中赛钢构提供交通与基础设施项目的钢结构加工，覆盖钢桥梁、人行天桥、飞机库、地铁高铁钢结构、港口码头结构，支持精密制造与工程协调。';
const lang = 'zh';
const canonical = 'https://zhongsai-steelstructure.com/zh/transportation-infrastructure-steel/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/products/app-transport-infrastructure.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">交通 · 基础设施钢结构</span>
      <h1>交通与基础设施钢结构</h1>
      <p class="lead">中赛钢构为交通与基础设施项目提供钢结构加工和构件供应——包括钢桥梁、人行天桥、飞机库、地铁高铁钢结构、港口码头结构及高速公路龙门架。从设计深化到精密制造和出口，支持工程协调、质量控制制造和集装箱化交付，服务全球基础设施项目。</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">获取项目报价</a>
        <a href="/zh/products/" class="btn btn-outline">查看全部产品</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/zh/">首页</a>
      <span class="sep">/</span>
      <a href="/zh/products/">产品</a>
      <span class="sep">/</span>
      <span class="current">交通与基础设施</span>
    </div>
  </nav>

  <!-- 01 / 基础设施项目需求 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">01 / 基础设施项目需求</p>
        <h2>基础设施钢结构项目需要确认哪些信息</h2>
        <p>交通与基础设施钢结构项目需要高精度、严格质量控制和工程协调。以下信息直接影响制造计划、检验要求和交付组织。</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>项目类型</h3>
          <p>钢桥梁、人行天桥、飞机库、地铁结构、港口码头或高速公路龙门架——不同项目类型有不同的制造和检验要求。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>工程图纸</h3>
          <p>结构图、制造图、连接节点和材料规格是精密制造的基础。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>材料要求</h3>
          <p>钢材牌号、厚度、焊接工艺和检验等级根据项目规范和适用标准确定。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>质量与检验</h3>
          <p>无损检测要求、尺寸公差、焊接检验和第三方检验需求影响制造计划和质量控制。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>交付方式</h3>
          <p>集装箱运输、散货或项目特定交付方式影响构件尺寸、包装和标记组织。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>项目进度</h3>
          <p>制造周期、分批交付要求和现场安装顺序影响生产计划和交付协调。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / 桥梁与天桥结构 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">02 / 桥梁与天桥结构</p>
        <h2>钢桥梁与人行天桥制造</h2>
        <p>钢桥梁和人行天桥需要高精度制造、严格的焊接质量控制和准确的尺寸控制，以确保现场安装时的正确装配。</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/app-transport-infrastructure.jpg" alt="钢桥梁交通基础设施" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>桥梁结构的精密制造</h3>
          <ul>
            <li>桥梁主梁、横梁和桥面支撑结构按工程图纸制造</li>
            <li>焊接工艺按项目规范和适用标准评定</li>
            <li>尺寸控制和装配验证确保现场安装精度</li>
            <li>无损检测按项目质量要求安排</li>
            <li>构件标记和包装按现场安装顺序组织</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / 轨交、航空与港口结构 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">03 / 轨交、航空与港口结构</p>
        <h2>轨交、航空与港口基础设施钢结构</h2>
        <p>地铁站、铁路站台、飞机库和港口码头结构需要专业的钢结构制造，关注荷载要求、耐久性和精密连接。</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/products/02-mining-energy.jpg');"></div>
          <div class="feature-body">
            <h3>飞机库</h3>
            <p>用于飞机维修和存储的大跨度钢机库结构，支持净跨度框架和重型机库门。</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/01-industrial.jpg');"></div>
          <div class="feature-body">
            <h3>港口码头结构</h3>
            <p>港口码头、仓储结构和设备支撑框架的钢结构制造，设计用于重载和沿海环境。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 / 质量控制与工程协调 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">04 / 质量控制与工程协调</p>
        <h2>质量控制与工程协调</h2>
        <p>基础设施项目要求严格的质量控制和密切的工程协调。中赛保持文件化的质量流程，并与项目工程师密切合作，确保制造符合规范。</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/manufacturing/real/workshop-overwide-9815.jpg" alt="基础设施钢结构制造质量控制" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>基础设施项目的文件化质量</h3>
          <ul>
            <li>材料可追溯性和材质证明书验证按项目要求</li>
            <li>焊接工艺评定和焊工资格文件化</li>
            <li>关键制造阶段的尺寸检验</li>
            <li>无损检测（UT、MT、PT）按项目规范安排</li>
            <li>工程协调处理图纸澄清和技术问题</li>
          </ul>
          <div style="margin-top: 20px;">
            <a href="/zh/manufacturing-quality/" class="btn btn-outline">查看制造质量</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 / 制造与出口交付 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">05 / 制造与出口交付</p>
        <h2>从图纸到集装箱化交付的基础设施流程</h2>
        <p>中赛拥有自有生产基地，按项目图纸制造基础设施钢结构构件，并有组织地进行包装、标记和集装箱装柜，用于国际交付。</p>
      </div>
      <div class="process-flow">
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">01</div>
          <h4>图纸确认</h4>
          <p>工程图纸、规范和技术要求确认</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">02</div>
          <h4>深化与计划</h4>
          <p>制造深化、生产计划和检验计划</p>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">03</div>
          <h4>精密制造</h4>
          <p>按图纸进行切割、装配、焊接和表面处理</p>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">04</div>
          <h4>质量检验</h4>
          <p>按要求进行尺寸检查、焊接检验和无损检测</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>标记包装</h4>
          <p>构件标记、包装和装柜计划组织</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">06</div>
          <h4>集装箱装柜</h4>
          <p>集装箱装柜协调和出口资料支持</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">06 / 相关能力</p>
        <h2>相关能力</h2>
        <p>探索中赛为您项目提供的相关能力和服务。</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3><a href="/zh/products/custom-engineering/" style="color: inherit; text-decoration: none;">定制工程</a></h3>
            <p>定制钢结构加工</p>
            <a href="/zh/products/custom-engineering/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3><a href="/zh/manufacturing-quality/" style="color: inherit; text-decoration: none;">制造质量</a></h3>
            <p>质量控制制造</p>
            <a href="/zh/manufacturing-quality/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3><a href="/zh/engineering-design/" style="color: inherit; text-decoration: none;">工程设计</a></h3>
            <p>设计与深化支持</p>
            <a href="/zh/engineering-design/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-4">
          <div class="feature-body">
            <h3><a href="/zh/export-delivery/" style="color: inherit; text-decoration: none;">出口交付</a></h3>
            <p>包装、装柜与出口协调</p>
            <a href="/zh/export-delivery/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote Form -->
  <section id="quote" class="detail-section">
    <div class="container">
      <QuoteForm />
    </div>
  </section>
</BaseLayout>
