---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const title = '特种与定制钢结构 | 按图纸定制加工 | 中赛钢构';
const description = '中赛钢构提供特种与定制钢结构加工，覆盖异形双扭曲结构、旋转楼梯、LED显示屏支撑钢架、雨棚、夹层、钢平台及幕墙支撑框架，按确认图纸和BOQ定制制造。';
const lang = 'zh';
const canonical = 'https://zhongsai-steelstructure.com/zh/special-custom-steel-structures/';
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/products/app-special-custom.jpg');"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <span class="eyebrow">特种 · 定制钢结构</span>
      <h1>特种与定制钢结构</h1>
      <p class="lead">中赛钢构为非标和复杂项目提供特种与定制钢结构加工——包括异形双扭曲结构、旋转楼梯、LED显示屏支撑钢架、雨棚结构、夹层、钢平台及幕墙支撑框架。按您确认的图纸和BOQ定制制造，支持精密加工、构件编号和集装箱化出口交付。</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">提交特殊钢结构需求</a>
        <a href="/zh/products/" class="btn btn-outline">查看全部产品</a>
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="detail-breadcrumb">
    <div class="container">
      <a href="/zh/">首页</a>
      <span class="sep">/</span>
      <a href="/zh/products/">产品</a>
      <span class="sep">/</span>
      <span class="current">特种与定制钢结构</span>
    </div>
  </nav>

  <!-- 01 / 定制项目需求 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">定制项目需求</p>
        <h2>定制钢结构项目需要确认哪些信息</h2>
        <p>定制和特种钢结构需要详细的工程信息以进行精密制造。以下信息直接影响制造可行性、生产计划和质量控制。</p>
      </div>
      <div class="requirement-grid">
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">01</div>
          <h3>结构类型</h3>
          <p>异形结构、旋转楼梯、LED支撑框架、雨棚、夹层、钢平台或幕墙支撑——不同类型需要不同的制造方法。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">02</div>
          <h3>工程图纸</h3>
          <p>结构图、制造图、3D模型和连接节点是定制制造的基础。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">03</div>
          <h3>材料规格</h3>
          <p>钢材牌号、截面类型、厚度和特殊材料要求根据项目设计确定。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-1">
          <div class="req-icon">04</div>
          <h3>表面处理</h3>
          <p>涂装、镀锌、粉末喷涂或特殊表面处理要求根据项目和环境条件指定。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-2">
          <div class="req-icon">05</div>
          <h3>公差与精度</h3>
          <p>尺寸公差、装配要求和检验等级根据项目规范确定。</p>
        </div>
        <div class="requirement-card reveal reveal-delay-3">
          <div class="req-icon">06</div>
          <h3>交付要求</h3>
          <p>构件分组、包装方式和交付顺序根据现场安装计划确定。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 / 复杂与异形结构 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">复杂与异形结构</p>
        <h2>复杂与异形钢结构制造</h2>
        <p>异形、双扭曲和建筑复杂钢结构需要先进的制造能力、精确的样板工作和熟练的焊接。中赛以文件化的质量控制处理这些特殊结构。</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/app-special-custom.jpg" alt="特种定制钢结构异形" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>复杂形态的精密制造</h3>
          <ul>
            <li>异形和双扭曲钢构件按工程图纸和3D模型制造</li>
            <li>复杂连接节点和定制托架按设计制造</li>
            <li>样板和胎架工作确保复杂几何形状的精确装配</li>
            <li>焊接工艺针对特殊节点形式评定</li>
            <li>关键制造阶段的尺寸验证</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 / 常见定制应用 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">常见定制应用</p>
        <h2>常见定制钢结构应用</h2>
        <p>定制钢结构涵盖广泛的非标应用，从建筑特色到功能性支撑结构。</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-img" style="background-image: url('/images/products/detail-spiral-staircase.jpg');"></div>
          <div class="feature-body">
            <h3>旋转楼梯与雨棚</h3>
            <p>定制制造的旋转楼梯、雨棚结构和建筑钢结构特色，按设计图纸制造。</p>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-img" style="background-image: url('/images/products/06-custom-engineering.jpg');"></div>
          <div class="feature-body">
            <h3>平台与夹层</h3>
            <p>钢平台、夹层楼板和设备支撑结构，按特定荷载要求和空间约束设计。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 / LED显示与幕墙支撑 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">LED显示与幕墙支撑</p>
        <h2>LED显示屏支撑与幕墙钢框架</h2>
        <p>LED显示屏和现代幕墙系统需要精确制造的钢支撑框架，以适应面板安装、维护通道和结构荷载。</p>
      </div>
      <div class="image-text-block reverse">
        <div class="itb-image">
          <img src="/images/products/03-commercial-public.jpg" alt="LED显示屏支撑钢框架幕墙" loading="lazy">
        </div>
        <div class="itb-content">
          <h3>显示与幕墙系统的精密框架</h3>
          <ul>
            <li>LED显示屏支撑框架制造，精确定位安装孔位</li>
            <li>幕墙和外立面支撑框架按建筑图纸制造</li>
            <li>维护通道和结构荷载要求纳入框架设计</li>
            <li>连接节点与面板系统供应商协调</li>
            <li>表面处理按户外暴露和耐久性要求指定</li>
          </ul>
          <div style="margin-top: 20px;">
            <a href="/zh/products/custom-engineering/" class="btn btn-outline">查看定制工程</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 / 制造与出口交付 -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">制造与出口交付</p>
        <h2>从图纸到集装箱化交付的定制项目流程</h2>
        <p>中赛拥有自有生产基地，按确认图纸和BOQ制造定制钢结构，并有组织地进行构件标记、包装和集装箱装柜，用于国际交付。</p>
      </div>
      <div class="process-flow">
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">01</div>
          <h4>图纸确认</h4>
          <p>确认图纸、BOQ和技术要求审核</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">02</div>
          <h4>深化与计划</h4>
          <p>制造深化、生产计划和检验计划</p>
        </div>
        <div class="process-step reveal reveal-delay-3">
          <div class="step-num">03</div>
          <h4>定制制造</h4>
          <p>按图纸进行切割、成型、装配、焊接和表面处理</p>
        </div>
        <div class="process-step reveal reveal-delay-4">
          <div class="step-num">04</div>
          <h4>质量检验</h4>
          <p>尺寸检查、焊接检验和装配验证</p>
        </div>
        <div class="process-step reveal reveal-delay-1">
          <div class="step-num">05</div>
          <h4>标记包装</h4>
          <p>构件标记、包装和装柜计划组织</p>
        </div>
        <div class="process-step reveal reveal-delay-2">
          <div class="step-num">06</div>
          <h4>集装箱装柜</h4>
          <p>集装箱装柜协调和出口资料支持</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading reveal">
        <p class="section-index">相关能力</p>
        <h2>相关能力</h2>
        <p>探索中赛为您项目提供的相关能力和服务。</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card reveal reveal-delay-1">
          <div class="feature-body">
            <h3><a href="/zh/products/custom-engineering/" style="color: inherit; text-decoration: none;">定制工程</a></h3>
            <p>按图纸定制钢结构加工</p>
            <a href="/zh/products/custom-engineering/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-2">
          <div class="feature-body">
            <h3><a href="/zh/agricultural-steel-buildings/" style="color: inherit; text-decoration: none;">农业与养殖建筑</a></h3>
            <p>钢结构构件与围护系统</p>
            <a href="/zh/agricultural-steel-buildings/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-3">
          <div class="feature-body">
            <h3><a href="/zh/manufacturing-quality/" style="color: inherit; text-decoration: none;">制造质量</a></h3>
            <p>质量控制制造</p>
            <a href="/zh/manufacturing-quality/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
        <div class="feature-card reveal reveal-delay-4">
          <div class="feature-body">
            <h3><a href="/zh/export-delivery/" style="color: inherit; text-decoration: none;">出口交付</a></h3>
            <p>包装、装柜与出口协调</p>
            <a href="/zh/export-delivery/" style="color: #2563eb; font-size: 14px; font-weight: 600;">了解更多 →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote Form -->
  <section id="quote" class="detail-section">
    <div class="container">
      <QuoteForm />
    </div>
  </section>
</BaseLayout>
