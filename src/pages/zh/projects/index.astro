---
// ZhongSai V2 - Chinese Projects Hub (12 Domestic Projects)
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import ExportDeliveryCTA from '../../../components/ExportDeliveryCTA.astro';
import { projects } from '../../../data/projects-data';

const lang = 'zh';
const title = '精选钢结构项目案例 | 中赛钢构制造参考';
const description = '查看中赛钢构精选的物流仓储、工业制造、商业公共、石化能源等钢结构项目案例，展示制造加工与工程配合能力。';
---

<BaseLayout title={title} description={description} lang={lang}>
  <section class="projects-hero">
    <div class="container">
      <div class="hub-breadcrumb">
        <a href="/zh/">首页</a><span>/</span><span>项目案例</span>
      </div>
      <p class="eyebrow">项目案例</p>
      <h1>精选钢结构项目案例</h1>
      <p class="projects-subtitle">
        精选钢结构项目案例，展示中赛在钢结构制造、加工、工程配合及项目交付方面的实际能力，覆盖物流仓储、工业制造、商业公共及石化能源等应用。
      </p>
    </div>
  </section>

  <section class="projects-grid-section">
    <div class="container">
      <div class="country-filter">
        <span class="filter-label">按地区:</span>
        <a href="/zh/projects/singapore/" class="filter-link">新加坡项目</a>
        <span class="filter-current">全部项目</span>
      </div>
      <div class="category-filter" id="categoryFilter">
        <span class="filter-label">按应用:</span>
        <button class="filter-btn active" data-category="all">全部</button>
        <button class="filter-btn" data-category="物流仓储">物流仓储</button>
        <button class="filter-btn" data-category="工业制造">工业制造</button>
        <button class="filter-btn" data-category="商业公共">商业公共</button>
        <button class="filter-btn" data-category="石化能源">石化能源</button>
        <button class="filter-btn" data-category="海外项目">海外项目</button>
      </div>
      <div class="projects-grid" id="projectsGrid">
        {projects.map(project => (
          <div class="project-card-wrapper" data-category={project.category.zh}>
            <ProjectCard project={project} lang={lang} />
          </div>
        ))}
      </div>
      <div class="no-projects" id="noProjects" style="display:none;">
        <p>该分类下暂无项目</p>
      </div>
    </div>
  </section>

  <section class="projects-disclaimer">
    <div class="container">
      <p>网站展示的项目资料依据现有项目记录整理，具体合作范围及技术信息以项目实际资料为准。</p>
    </div>
  </section>

  <section class="projects-quote">
    <div class="container">
      <ExportDeliveryCTA lang="zh" />

      <div class="quote-intro">
        <p class="eyebrow">项目报价</p>
        <h2>有类似项目需求？</h2>
        <p>提交图纸或项目资料，我们将基于类似项目经验，为您的项目提供制造与供应方案。</p>
      </div>
      <QuoteForm lang={lang} />
    </div>
  </section>
<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  const filterBtns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.project-card-wrapper');
  const noProjects = document.getElementById('noProjects');
  
  filterBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      filterBtns.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      
      const category = this.getAttribute('data-category');
      let visibleCount = 0;
      
      cards.forEach(card => {
        if (category === 'all' || card.getAttribute('data-category') === category) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });
      
      if (noProjects) {
        noProjects.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  });
});
</script>
</BaseLayout>

<style>
.projects-hero {
  padding: 64px 0 48px;
  background: #fff;
}
.projects-hero h1 { font-size: 2.4rem; margin: 12px 0 16px; color: #111; max-width: 800px; }
.projects-subtitle { font-size: 1.05rem; color: #555; max-width: 700px; line-height: 1.7; }
.country-filter {
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}
.filter-label {
  font-size: 0.9rem;
  color: #666;
  font-weight: 600;
}
.filter-link {
  padding: 6px 16px;
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 20px;
  text-decoration: none;
  color: #0a3d62;
  font-size: 0.88rem;
  transition: all 0.2s;
}
.filter-link:hover {
  background: #0a3d62;
  color: #fff;
  border-color: #0a3d62;
}
.filter-current {
  padding: 6px 16px;
  background: #0a3d62;
  color: #fff;
  border-radius: 20px;
  font-size: 0.88rem;
}
.projects-grid-section {
  padding: 40px 0 32px;
  background: #f8f9fa;
}
.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28px;
}
.projects-disclaimer {
  padding: 16px 0;
  background: #fff;
  border-top: 1px solid rgba(0,0,0,0.06);
}
.projects-disclaimer p {
  color: #888;
  font-size: 0.88rem;
  text-align: center;
  margin: 0;
}
.projects-quote {
  padding: 32px 0 48px;
  background: #f8f9fa;
}
.quote-intro {
  text-align: center;
  margin-bottom: 24px;
}
.quote-intro h2 {
  font-size: 1.8rem;
  color: #0a3d62;
  margin: 8px 0 12px;
}
.quote-intro p {
  color: #555;
  max-width: 600px;
  margin: 0 auto;
}
@media (max-width: 1024px) {
  .projects-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 640px) {
  .projects-hero h1 {
    font-size: 1.6rem;
  }
  .projects-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .quote-intro h2 {
    font-size: 1.4rem;
  }
}

.category-filter {
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}
.filter-btn {
  padding: 6px 16px;
  background: #fff;
  border: 1px solid #ddd;
  border-radius: 20px;
  font-size: 0.85rem;
  color: #555;
  cursor: pointer;
  transition: all 0.2s;
  font-family: inherit;
}
.filter-btn:hover {
  border-color: #0a3d62;
  color: #0a3d62;
}
.filter-btn.active {
  background: #0a3d62;
  color: #fff;
  border-color: #0a3d62;
}
.project-card-wrapper {
  display: block;
}
.no-projects {
  text-align: center;
  padding: 60px 20px;
  color: #999;
  font-size: 1rem;
}
@media (max-width: 640px) {
  .category-filter {
    gap: 8px;
  }
  .filter-btn {
    padding: 5px 12px;
    font-size: 0.8rem;
  }
}
</style>
