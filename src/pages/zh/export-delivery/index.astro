---
// ZhongSai V2 - 中文 出口交付页面（detail 体系重构版）
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import '../../../styles/detail.css';

const lang = 'zh';
const title = '钢结构出口交付、科学装柜与海外运输协调｜中赛钢构';
const description = '从设计和制造规划到构件编号、包装、科学装柜和海外交付协调，中赛自有设计团队和交付团队协同支持钢结构项目从工厂到目的地的完整链路。';
const canonical = 'https://zhongsai-steelstructure.com/zh/export-delivery/';

// 交付链（7 步）
const deliveryChain = [
  { num: '01', title: '交付规划', desc: '按项目要求、图纸、交付地点和时间计划确定交付方案。' },
  { num: '02', title: '构件分段', desc: '按集装箱尺寸与运输限制规划构件分段与拼接位置。' },
  { num: '03', title: '构件编号', desc: '为每个构件分配项目专属编号，对应图纸、装箱单与安装顺序。' },
  { num: '04', title: '包装', desc: '按安装顺序分组构件、保护表面，并对配件分类标识。' },
  { num: '05', title: '装柜', desc: '优化集装箱空间利用、重量分布与现场卸货顺序。' },
  { num: '06', title: '出口资料协调', desc: '准备商业发票、装箱单、出口报关与运输文件。' },
  { num: '07', title: '到货衔接与安装支持', desc: '协调运输状态与文件交接，提供安装图纸与技术指导。' }
];

// 设计阶段即考虑运输（6 点）
const shipDesignItems = [
  { title: '构件尺寸与集装箱匹配', desc: '协调构件长度和截面与标准集装箱内部尺寸匹配。' },
  { title: '运输分段规划', desc: '在结构适当位置设计螺栓拼接节点，便于集装箱运输。' },
  { title: '拼接位置协调', desc: '拼接位置避开高弯矩区域，便于现场螺栓拼装。' },
  { title: '构件编号体系', desc: '开发编号系统，将构件与图纸、装箱单和吊装顺序关联。' },
  { title: '安装接口设计', desc: '设计连接接口，实现高效准确的现场螺栓拼装。' },
  { title: '包装与吊装顺序', desc: '协调包装和装柜顺序与现场逻辑吊装顺序一致。' }
];

// 装柜优化因素
const loadingFactors = [
  { title: '构件尺寸', desc: '协调构件长度和截面与集装箱内部尺寸匹配。' },
  { title: '集装箱尺寸', desc: '根据40GP、40HQ、45HQ或项目特定集装箱类型规划。' },
  { title: '重量分布', desc: '在集装箱内均匀分布重量，确保安全运输和装卸。' },
  { title: '装柜顺序', desc: '组织装柜顺序，支持现场逻辑卸货和吊装顺序。' },
  { title: '防移动保护', desc: '用适当支撑固定构件，防止海运期间移动。' },
  { title: '卸货便利性', desc: '规划装柜使构件可按逻辑顺序卸货，无需重复搬运。' }
];

// 出口文件
const exportDocs = [
  { title: '商业发票', desc: '准备出口报关和目的地海关所需的商业文件。' },
  { title: '装箱单', desc: '详细装箱单，关联构件、包装、集装箱和重量信息。' },
  { title: '出口报关文件', desc: '根据中国出口法规支持出口报关文件准备。' },
  { title: '证书相关文件', desc: '根据项目要求协调证书文件（如适用）。' },
  { title: '提单协调', desc: '与货代和船公司协调提单信息。' },
  { title: '项目 / 产品文件', desc: '按要求提供安装图纸、材料证书和检验记录。' }
];

// 支持的项目类型
const projectTypes = [
  { name: '工业厂房', href: '/zh/steel-workshop/', desc: '制造工厂、加工车间和带行车工业建筑。' },
  { name: '钢结构仓库', href: '/zh/steel-warehouse/', desc: '物流中心、配送枢纽和工业仓储建筑。' },
  { name: '矿业钢结构', href: '/zh/steel-mining-factory/', desc: '加工厂、输送廊道、设备平台和重型钢结构。' },
  { name: '农业养殖建筑', href: '/zh/agricultural-steel-buildings/', desc: '家禽舍、牛舍、畜牧设施和农业仓储。' },
  { name: '商业公共建筑', href: '/zh/commercial-public-steel-buildings/', desc: '展馆、体育建筑、商业设施和公共建筑。' },
  { name: '交通基础设施', href: '/zh/transportation-infrastructure-steel/', desc: '人行天桥、站房结构、雨棚和基础设施构件。' },
  { name: '夹层 / 二层平台 / 特种钢结构', href: '/zh/special-custom-steel-structures/', desc: '厂房夹层、二层平台、设备平台及定制特殊用途钢结构。' }
];

// FAQ
const faqs = [
  {
    q: '钢结构如何从中国运输出口？',
    a: '钢结构在中赛工厂制造完成后，构件进行编号、包装并装入海运集装箱。装柜过程优化空间利用和构件保护。出口文件准备完成后，集装箱运至港口，通过海运发运至目的地国家。'
  },
  {
    q: '大型钢构件能装进海运集装箱吗？',
    a: '大多数标准钢构件设计为可装入标准海运集装箱（通常40GP或40HQ）。对于超过标准集装箱长度的构件，中赛设计团队可以规划螺栓拼接位置，将长构件分段以便集装箱运输。在特殊情况下，可根据构件尺寸、港口条件和物流方案考虑开顶柜、框架柜或项目特定物流方式。'
  },
  {
    q: '如何识别构件以便现场安装？',
    a: '每个钢构件都有项目专属识别编号，与批准的加工图对应。装箱单将每个构件编号与其包装、集装箱和安装顺序参考关联。该系统帮助当地安装团队在项目现场正确识别和组装构件，减少错误，提高吊装效率。'
  },
  {
    q: '构件如何包装？',
    a: '构件按结构系统和安装顺序分组包装，保护油漆与涂层表面；螺栓、螺母、垫圈和连接板按装配分组标识，防止丢失。防潮保护根据构件类型和航程时间按需应用。详细装箱单将每个构件与其包装、集装箱和安装参考关联。'
  },
  {
    q: '中赛可以提供哪些出口文件？',
    a: '中赛支持准备商业发票、详细装箱单、出口报关文件，并协调提单信息。材料证书、检验记录和安装图纸按项目要求提供。目的地国家清关通常由客户或其指定的报关行处理，中赛提供所需文件和信息支持客户的清关流程，但不担任进口商或目的地报关行。'
  },
  {
    q: '到货以后谁负责安装？',
    a: '中赛提供安装技术指导，包括安装图纸、构件识别参考、吊装顺序信息和远程技术答疑。当地卸货、吊装、现场施工和劳务通常由客户或其指定的当地施工团队完成。在特定项目中可根据约定范围安排现场技术指导，但中赛不担任当地施工承包商或EPC总承包商。'
  }
];

// 相关链接
const relatedLinks = [
  { name: '工程设计与深化', href: '/zh/engineering-design/', desc: '结构设计、深化和工程技术支持' },
  { name: '制造与质量控制', href: '/zh/manufacturing-quality/', desc: '工厂制造、质量控制和生产证据' },
  { name: '项目案例', href: '/zh/projects/', desc: '真实项目案例，含交付和范围证据' },
  { name: '钢结构厂房', href: '/zh/steel-workshop/', desc: '工业厂房和制造工厂钢结构' },
  { name: '钢结构仓库', href: '/zh/steel-warehouse/', desc: '物流和仓储建筑钢结构' },
  { name: '矿业与重工业', href: '/zh/steel-mining-factory/', desc: '矿业、能源和重型工业钢结构' },
  { name: '夹层 / 二层平台 / 特种钢结构', href: '/zh/special-custom-steel-structures/', desc: '厂房夹层、二层平台与定制钢结构' },
  { name: '联系与报价', href: '/zh/contact/', desc: '提交项目需求进行交付规划和报价' }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="detail-hero">
    <div class="detail-hero-bg" style="background-image: url('/images/export/loading-truck_web.jpg')"></div>
    <div class="detail-hero-overlay"></div>
    <div class="detail-hero-content">
      <div class="detail-breadcrumb">
        <a href="/zh/">首页</a><span>/</span><span>出口交付</span>
      </div>
      <p class="eyebrow">出口交付 · 从工厂到目的地</p>
      <h1>钢结构出口<br>与海外项目交付</h1>
      <p class="lead">从设计和制造规划到构件编号、包装、科学装柜和海外交付协调，中赛自有设计团队和交付团队协同支持钢结构项目从工厂到目的地的完整链路。</p>
      <div class="detail-hero-actions">
        <a href="#quote" class="btn btn-primary">提交图纸进行交付评估</a>
        <a href="/zh/manufacturing-quality/" class="btn btn-outline">查看制造与质量控制</a>
      </div>
      <div class="hero-strip">
        <span>设计即考虑运输</span>
        <span>构件分段</span>
        <span>科学装柜</span>
        <span>构件编号与包装</span>
        <span>出口资料协调</span>
        <span>安装技术衔接</span>
      </div>
    </div>
  </section>

  <!-- Overview: 制造完成 → 出口交付 -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">出口交付</p>
        <h2>从制造完成到项目目的地的完整衔接</h2>
        <p>中赛不仅制造钢结构构件，还负责从制造完成到出口交付之间的构件编号、包装、装柜、出口资料协调、运输衔接与安装技术支持。交付规划在设计阶段即可开始，而不是等制造完成后才开始。</p>
      </div>
      <div class="export-chain">
        <span class="chain-step"><span class="chain-num">M</span>制造完成</span>
        <span class="chain-arrow">→</span>
        <span class="chain-step"><span class="chain-num">1</span>构件编号</span>
        <span class="chain-arrow">→</span>
        <span class="chain-step"><span class="chain-num">2</span>包装</span>
        <span class="chain-arrow">→</span>
        <span class="chain-step"><span class="chain-num">3</span>装柜</span>
        <span class="chain-arrow">→</span>
        <span class="chain-step"><span class="chain-num">4</span>出口资料协调</span>
        <span class="chain-arrow">→</span>
        <span class="chain-step"><span class="chain-num">5</span>海运发运</span>
        <span class="chain-arrow">→</span>
        <span class="chain-step"><span class="chain-num">6</span>到货衔接与安装支持</span>
      </div>
      <p class="params-note">制造、检查、表面处理、编号、包装与出口交付准备在中赛东莞和惠州制造基地完成；当地卸货、吊装与现场施工由客户或其指定的当地施工团队负责。</p>
    </div>
  </section>

  <!-- Design for Shipping -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">01 · 设计即考虑运输</p>
        <h2>Design for Shipping：钢结构不是生产完成后才考虑运输</h2>
        <p>中赛自有设计团队在结构设计和深化阶段就考虑制造、集装箱运输和现场安装要求。通过设计与交付的协同，减少不必要的运输空间浪费，提高现场吊装效率——这正是拥有既懂结构工程又懂出口交付的自有设计团队的价值所在。</p>
      </div>
      <div class="ship-design-grid">
        {shipDesignItems.map((item, i) => (
          <div class="ship-design-card">
            <span class="sd-num">{String(i + 1).padStart(2, '0')}</span>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
      <div class="blue-note">
        <strong>两类项目入口：</strong>
        如果您已有完整结构图，中赛设计团队审核图纸的制造可行性、集装箱运输兼容性和现场安装效率，识别需要分段的构件并规划运输用螺栓拼接位置；如果您只有建筑图或项目需求，中赛可以在结构方案开发阶段就考虑构件分段、运输限制和现场安装要求。提交现有资料即可开始技术评审。
      </div>
    </div>
  </section>

  <!-- Delivery Chain -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">02 · 交付流程</p>
        <h2>从制造完成到目的地的交付链路</h2>
        <p>中赛项目交付团队协调从制造完成到海外发运和目的地交付的过渡。以下为钢结构出口交付的主要环节。</p>
      </div>
      <div class="mfg-grid">
        {deliveryChain.map((step) => (
          <div class="mfg-card">
            <div class="mfg-body">
              <span class="mfg-num">{step.num}</span>
              <h4>{step.title}</h4>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Real Packing & Loading Evidence -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">03 · 第一方证据</p>
        <h2>包装、编号与装柜现场</h2>
        <p>构件在出厂前完成编号、分类和包装，按项目装载计划装入集装箱。以下为中赛制造与出口交付现场的真实记录。</p>
      </div>
      <div class="evidence-strip">
        <div class="evidence-item">
          <img src="/images/manufacturing/real/component-marking.jpg" alt="钢构件编号标识现场" loading="lazy">
          <h4>构件编号标识</h4>
          <p>每根构件标注唯一编号，与加工图和安装图对应，便于现场识别和吊装顺序。</p>
        </div>
        <div class="evidence-item">
          <img src="/images/export/container-loading-310_web.jpg" alt="带识别编号的钢构件装入海运集装箱" loading="lazy">
          <h4>集装箱装柜</h4>
          <p>按装载计划将构件有序装入标准集装箱，合理利用空间并保护涂层和构件端部。</p>
        </div>
        <div class="evidence-item">
          <img src="/images/export/loading-truck_web.jpg" alt="钢结构构件装车发运现场" loading="lazy">
          <h4>装车与发运</h4>
          <p>超长或超重构件采用专用车辆运输至港口，配合出口文件和装箱单完成发运。</p>
        </div>
        <div class="evidence-item">
          <img src="/images/container-loading.jpg" alt="大型钢结构构件装柜作业" loading="lazy">
          <h4>大型构件装柜作业</h4>
          <p>门式刚架、吊车梁等大型构件按重量和尺寸规划装载顺序，确保运输安全和卸货便利。</p>
        </div>
        <div class="evidence-item">
          <img src="/images/export/container-loading-256_web.jpg" alt="已装柜集装箱准备出口发运" loading="lazy">
          <h4>出口集装箱装载</h4>
          <p>配套装箱单和出口文件，支持目的港清关资料核对，并便于现场接收时对构件进行追溯与核对。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Container Loading Strategy -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">04 · 科学装柜</p>
        <h2>集装箱装载规划</h2>
        <p>装柜规划优化空间利用、重量分布和卸货便利性。通过合理的构件分段、排柜和科学装载，在适合的项目中可以降低运输成本。</p>
      </div>
      <div class="params-table-wrapper">
        <table class="params-table">
          <thead>
            <tr><th>装柜考虑因素</th><th>说明</th></tr>
          </thead>
          <tbody>
            {loadingFactors.map((f) => (
              <tr><td>{f.title}</td><td>{f.desc}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="blue-note">
        <strong>运费成本优化：</strong>
        通过合理的构件分段、排柜规划和科学装载，在适合的项目中可实现约 <strong>20%的运费成本节省</strong>。实际节省比例取决于项目构件尺寸、重量、运输路线和装柜条件。这不是每个项目都能保证的固定节省比例。
      </div>
    </div>
  </section>

  <!-- Oversized Members -->
  <section class="detail-section">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">05 · 超长构件</p>
        <h2>长构件和超大型钢构件处理</h2>
        <p>部分钢构件可能超过标准海运集装箱尺寸。中赛设计团队在设计阶段规划分段和运输方案，解决超长构件的挑战。</p>
      </div>
      <div class="plan-grid">
        <div class="plan-col">
          <h4>标准集装箱方案</h4>
          <ul>
            <li>大多数构件设计为适配40GP/40HQ集装箱</li>
            <li>长构件用螺栓拼接节点分段</li>
            <li>拼接位置规划在结构适当位置</li>
            <li>分段构件在现场用螺栓连接组装</li>
            <li>构件编号确保正确的现场组装</li>
          </ul>
        </div>
        <div class="plan-col">
          <h4>特殊物流考虑</h4>
          <ul>
            <li>高度受限构件可考虑开顶柜</li>
            <li>超宽或超重构件可用框架柜</li>
            <li>非标准超大构件的项目特定物流</li>
            <li>运输方式根据构件尺寸和港口条件确定</li>
            <li>评估目的地国家公路运输限制</li>
          </ul>
        </div>
      </div>
      <p class="params-note">超长构件的具体运输方式根据项目构件尺寸、重量、港口条件、目的地国家公路法规和物流安排逐项目确定。中赛设计团队可以在设计阶段提供分段方案建议。</p>
    </div>
  </section>

  <!-- Export Documents -->
  <section class="detail-section alt">
    <div class="container">
      <div class="section-heading">
        <p class="section-index">06 · 出口资料</p>
        <h2>出口文件与协调</h2>
