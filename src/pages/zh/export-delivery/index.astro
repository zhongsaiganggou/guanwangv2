---
// ZhongSai V2 - 中文 出口交付页面（升级版）
import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuoteForm from '../../../components/QuoteForm.astro';
import ExportDeliveryCTA from '../../../components/ExportDeliveryCTA.astro';
import '../../../styles/hub.css';
import '../../../styles/manufacturing.css';

const lang = 'zh';
const title = '钢结构出口交付、科学装柜与海外运输协调｜中赛钢构';
const description = '从设计和制造规划到构件编号、包装、科学装柜和海外交付协调，中赛自有设计团队和交付团队协同支持钢结构项目从工厂到目的地的完整链路。';
const canonical = 'https://zhongsai-steelstructure.com/zh/export-delivery/';

// 完整设计到交付流程（13步）
const fullProcess = [
  { num: '01', title: '项目评审', desc: '审核项目要求、图纸、交付地点和时间计划。' },
  { num: '02', title: '结构设计', desc: '协调结构设计，同时考虑制造、运输和现场安装。' },
  { num: '03', title: '深化与加工图', desc: '编制可直接用于制造的加工图，含构件编号和连接节点。' },
  { num: '04', title: '制造规划', desc: '规划生产顺序、材料准备和制造进度。' },
  { num: '05', title: '工厂制造', desc: '按批准图纸和项目规格制造钢结构构件。' },
  { num: '06', title: '质量检验', desc: '检验尺寸、焊接、表面处理和装配精度。' },
  { num: '07', title: '构件编号', desc: '为每个构件分配项目专属编号，对应图纸和装箱单。' },
  { num: '08', title: '包装', desc: '按安装顺序分组构件，保护表面，包装配件。' },
  { num: '09', title: '科学装柜', desc: '优化集装箱空间利用、重量分布和卸货顺序。' },
  { num: '10', title: '出口资料', desc: '准备商业发票、装箱单、出口报关和运输文件。' },
  { num: '11', title: '海运发运', desc: '协调订舱、港口交货和海运安排。' },
  { num: '12', title: '交付协调', desc: '协调运输状态、文件交接和目的地交付。' },
  { num: '13', title: '安装技术支持', desc: '提供安装图纸、构件识别和远程技术指导。' }
];

// 设计团队职责
const designTeamItems = [
  { title: '构件尺寸优化', desc: '协调构件尺寸，同时考虑制造和运输限制。' },
  { title: '运输限制规划', desc: '根据集装箱尺寸和运输约束规划构件分段。' },
  { title: '集装箱尺寸协调', desc: '确保构件长度适配标准集装箱，或规划适当分段。' },
  { title: '构件分段设计', desc: '在结构适当位置设计螺栓拼接节点，便于运输。' },
  { title: '螺栓拼接位置', desc: '协调拼接位置避开高弯矩区域，便于现场拼装。' },
  { title: '现场安装接口', desc: '设计连接接口，实现高效准确的现场螺栓拼装。' },
  { title: '构件编号体系', desc: '开发编号系统，将构件与图纸、装箱单和吊装顺序关联。' },
  { title: '安装顺序规划', desc: '协调包装和装柜顺序与逻辑现场吊装顺序一致。' }
];

// 交付团队职责
const deliveryTeamItems = [
  { title: '生产进度跟踪', desc: '监控制造进度，协调生产完成状态。' },
  { title: '包装方案制定', desc: '根据构件类型和安装顺序制定项目专属包装方案。' },
  { title: '装柜方案规划', desc: '规划集装箱装柜，优化空间、重量分布和卸货便利性。' },
  { title: '装箱单编制', desc: '编制详细装箱单，关联构件、包装和集装箱信息。' },
  { title: '构件识别协调', desc: '确保编号系统正确应用并与文档一致。' },
  { title: '运输进度协调', desc: '协调生产完成与订舱和装柜日期的衔接。' },
  { title: '出口文件准备', desc: '准备和协调商业发票、装箱单、出口报关和证书。' },
  { title: '港口与发运', desc: '协调港口交货、集装箱装柜和海运安排。' },
  { title: '客户与承包商交接', desc: '协调文件交接、运输状态沟通和目的地交付支持。' }
];

// 装柜优化因素
const loadingFactors = [
  { title: '构件尺寸', desc: '协调构件长度和截面与集装箱内部尺寸匹配。' },
  { title: '集装箱尺寸', desc: '根据40GP、40HQ、45HQ或项目特定集装箱类型规划。' },
  { title: '重量分布', desc: '在集装箱内均匀分布重量，确保安全运输和装卸。' },
  { title: '装柜顺序', desc: '组织装柜顺序，支持现场逻辑卸货和吊装顺序。' },
  { title: '空间利用', desc: '优化包装减少集装箱空间浪费，同时保持构件保护。' },
  { title: '防移动保护', desc: '用适当支撑固定构件，防止海运期间移动。' },
  { title: '卸货便利性', desc: '规划装柜使构件可按逻辑顺序卸货，无需重复搬运。' }
];

// 出口文件
const exportDocs = [
  { title: '商业发票', desc: '准备出口报关和目的地海关所需的商业文件。' },
  { title: '装箱单', desc: '详细装箱单，关联构件、包装、集装箱和重量信息。' },
  { title: '出口报关文件', desc: '根据中国出口法规支持出口报关文件准备。' },
  { title: '证书相关文件', desc: '根据项目要求协调证书文件（如适用）。' },
  { title: '提单协调', desc: '与货代和船公司协调提单信息。' },
  { title: '项目/产品文件', desc: '按要求提供安装图纸、材料证书和检验记录。' }
];

// 支持的项目类型
const projectTypes = [
  { name: '工业厂房', href: '/zh/steel-workshop/', desc: '制造工厂、加工车间和带行车工业建筑。' },
  { name: '钢结构仓库', href: '/zh/steel-warehouse/', desc: '物流中心、配送枢纽和工业仓储建筑。' },
  { name: '矿业钢结构', href: '/zh/steel-mining-factory/', desc: '加工厂、输送廊道、设备平台和重型钢结构。' },
  { name: '农业养殖建筑', href: '/zh/agricultural-steel-buildings/', desc: '家禽舍、牛舍、畜牧设施和农业仓储。' },
  { name: '商业公共建筑', href: '/zh/commercial-public-steel-buildings/', desc: '展馆、体育建筑、商业设施和公共建筑。' },
  { name: '交通基础设施', href: '/zh/transportation-infrastructure-steel/', desc: '人行天桥、站房结构、雨棚和基础设施构件。' },
  { name: '特种钢结构', href: '/zh/special-custom-steel-structures/', desc: '定制和特殊用途钢结构，满足独特项目需求。' }
];

// FAQ
const faqs = [
  {
    q: '钢结构如何从中国运输出口？',
    a: '钢结构在中赛工厂制造完成后，构件进行编号、包装并装入海运集装箱。装柜过程优化空间利用和构件保护。出口文件准备完成后，集装箱运至港口，通过海运发运至目的地国家。'
  },
  {
    q: '大型钢构件能装进海运集装箱吗？',
    a: '大多数标准钢构件设计为可装入标准海运集装箱（通常40GP或40HQ）。对于超过标准集装箱长度的构件，中赛自有设计团队可以规划螺栓拼接位置，将长构件分段以便集装箱运输。在特殊情况下，可根据构件尺寸、港口条件和物流方案考虑开顶柜、框架柜或项目特定物流方式。'
  },
  {
    q: '如何识别构件以便现场安装？',
    a: '每个钢构件都有项目专属识别编号，与批准的加工图对应。装箱单将每个构件编号与其包装、集装箱和安装顺序参考关联。该系统帮助当地安装团队在项目现场正确识别和组装构件，减少错误，提高吊装效率。'
  },
  {
    q: '中赛可以为集装箱运输优化结构吗？',
    a: '可以。中赛自有设计团队在结构设计和深化阶段就考虑集装箱尺寸、运输限制和现场安装要求。这包括规划构件分段、螺栓拼接位置、构件编号和包装顺序。通过设计与交付的协同，可以优化集装箱空间利用，在适合的项目中通过高效装柜安排帮助降低运输成本。'
  },
  {
    q: '可以支持哪些出口文件？',
    a: '中赛可以支持准备商业发票、详细装箱单、出口报关文件，并协调提单信息。材料证书、检验记录和安装图纸按项目要求提供。具体证书文件可根据目的地国家要求协调。我们不替代客户或其指定的报关行进行目的地国家清关。'
  },
  {
    q: '可以协调运送到项目所在国吗？',
    a: '可以。中赛自有项目交付团队协调生产完成、包装方案、集装箱装柜、出口文件、订舱和港口交货。我们与货代和船公司合作安排至目的港的海运。在整个交付过程中，向客户沟通运输状态和文件交接。'
  },
  {
    q: '提供清关服务吗？',
    a: '中赛准备和协调中国出口文件，支持出口报关。对于目的地国家清关，通常由客户或其指定的报关行处理进口申报和海关手续。我们可以提供所需文件和信息支持客户目的地清关流程，但我们不担任进口商或目的地国家的报关行。'
  },
  {
    q: '交付后提供安装服务吗？',
    a: '中赛提供安装技术指导，包括安装图纸、构件识别参考、吊装顺序信息和远程技术答疑。当地土建、基础施工、现场人工和实际吊装通常由客户或其指定的当地施工团队完成。在特定项目中，可根据约定的项目范围安排现场技术指导，但中赛不担任当地施工承包商或EPC总承包商。'
  }
];

// 相关链接
const relatedLinks = [
  { name: '工程设计与深化', href: '/zh/engineering-design/', desc: '结构设计、深化和工程技术支持' },
  { name: '制造与质量控制', href: '/zh/manufacturing-quality/', desc: '工厂制造、质量控制和生产证据' },
  { name: '项目案例', href: '/zh/projects/', desc: '真实项目案例，含交付和范围证据' },
  { name: '钢结构厂房', href: '/zh/steel-workshop/', desc: '工业厂房和制造工厂钢结构' },
  { name: '钢结构仓库', href: '/zh/steel-warehouse/', desc: '物流和仓储建筑钢结构' },
  { name: '矿业与重工业', href: '/zh/steel-mining-factory/', desc: '矿业、能源和重型工业钢结构' },
  { name: '特种钢结构', href: '/zh/special-custom-steel-structures/', desc: '定制和特殊用途钢结构' },
  { name: '联系与报价', href: '/zh/contact/', desc: '提交项目图纸进行交付规划和报价' }
];
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- Hero -->
  <section class="hub-hero">
    <div class="hub-hero-bg" style="background-image: url('/images/export/loading-truck_web.jpg')"></div>
    <div class="hub-hero-overlay"></div>
    <div class="container hub-hero-content">
      <div class="hub-breadcrumb">
        <a href="/zh/">首页</a><span>/</span><span>出口交付</span>
      </div>
      <p class="eyebrow">出口交付 · 从工厂到目的地</p>
      <h1>钢结构出口<br>与海外项目交付</h1>
      <p class="lead">从设计和制造规划到构件编号、包装、科学装柜和海外交付协调，中赛自有设计团队和交付团队协同支持钢结构项目从工厂到目的地的完整链路。</p>
      <div class="hero-capabilities">
        <div class="cap-item">
          <span class="cap-icon">◆</span>
          <div>
            <span class="cap-title">自有设计团队</span>
            <span class="cap-desc">面向制造、运输和现场安装的设计</span>
          </div>
        </div>
        <div class="cap-item">
          <span class="cap-icon">◆</span>
          <div>
            <span class="cap-title">自有交付团队</span>
            <span class="cap-desc">包装、装柜、文件和发运协调</span>
          </div>
        </div>
        <div class="cap-item">
          <span class="cap-icon">◆</span>
          <div>
            <span class="cap-title">项目专属包装</span>
            <span class="cap-desc">构件编号与安装顺序包装</span>
          </div>
        </div>
        <div class="cap-item">
          <span class="cap-icon">◆</span>
          <div>
            <span class="cap-title">出口文件支持</span>
            <span class="cap-desc">商业发票、装箱单和出口支持</span>
          </div>
        </div>
      </div>
      <div class="hero-cta-group">
        <a href="#quote" class="btn btn-primary">提交项目图纸</a>
        <a href="#delivery-process" class="btn btn-secondary">沟通交付需求</a>
      </div>
    </div>
  </section>

  <!-- 01: 从设计到交付 -->
  <section class="section" id="delivery-process" style="padding: 70px 0;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">完整流程</p>
          <h2>从设计到海外交付</h2>
        </div>
        <div>
          <p>中赛自有设计团队和交付团队在整个项目中协同工作。设计不是图纸发布就结束，交付也不是制造完成才开始。两个团队从项目早期阶段就围绕制造、运输和现场安装进行协调。</p>
        </div>
      </div>
      <div class="process-timeline">
        {fullProcess.map((step, i) => (
          <div class={`timeline-item reveal reveal-delay-${(i % 4) + 1}`}>
            <div class="timeline-num">{step.num}</div>
            <div class="timeline-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 02: 自有设计团队 -->
  <section class="section" style="padding: 70px 0; background: #f8fafc;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">设计团队</p>
          <h2>面向制造、运输和现场安装的设计</h2>
        </div>
        <div>
          <p>钢结构设计不仅要考虑结构受力性能，还要考虑构件能否制造、能否装柜、能否海运运输、能否在现场高效拼装。中赛自有设计团队从结构设计阶段就整合这些考虑因素。</p>
        </div>
      </div>
      <div class="quality-grid" style="margin-top: 40px;">
        {designTeamItems.map((item, i) => (
          <div class={`quality-item reveal reveal-delay-${(i % 4) + 1}`}>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
      <div style="margin-top: 24px; padding: 20px; background: #eff6ff; border-left: 4px solid #1e40af; border-radius: 0 8px 8px 0;" class="reveal">
        <p style="margin: 0; color: #1e3a5f; font-size: 14px; line-height: 1.7;"><strong>核心优势：</strong>通过将结构设计与集装箱尺寸、运输限制和现场安装要求协调，中赛可以减少不必要的运输空间浪费，提高现场吊装效率。这正是拥有既懂结构工程又懂出口交付的自有设计团队的价值所在。</p>
      </div>
    </div>
  </section>

  <!-- 03: 自有交付团队 -->
  <section class="section" style="padding: 70px 0;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">交付团队</p>
          <h2>自有项目交付团队</h2>
        </div>
        <div>
          <p>中赛项目交付团队协调从制造完成到海外发运和目的地交付的过渡。这不是第三方货代服务，而是内部项目协调职能，确保包装、装柜、文件和发运按照项目要求组织。</p>
        </div>
      </div>
      <div class="quality-grid" style="margin-top: 40px;">
        {deliveryTeamItems.map((item, i) => (
          <div class={`quality-item reveal reveal-delay-${(i % 4) + 1}`}>
            <h4>{item.title}</h4>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 04: 早期交付规划 -->
  <section class="section" style="padding: 70px 0; background: #f8fafc;">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="section-index">早期规划</p>
          <h2>早期交付规划从设计开始</h2>
        </div>
        <div>
          <p>中赛"自有设计团队 + 自有交付团队"的优势在于，交付规划可以在设计阶段就开始，而不是等制造完成后才开始。</p>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 40px;" class="planning-grid">
        <div class="reveal reveal-delay-1" style="padding: 32px; background: white; border-radius: 12px; border: 1px solid #e2e8f0;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 40px; height: 40px; background: #1e40af; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700;">A</div>
            <h3 style="font-size: 18px; margin: 0; color: #0f172a;">如果您已有完整结构图</h3>
          </div>
          <p style="color: #475569; font-size: 14px; line-height: 1.8; margin: 0 0 16px;">中赛自有设计团队审核图纸的制造可行性、集装箱运输兼容性和现场安装效率。</p>
          <ul style="margin: 0; padding-left: 20px; color: #475569; font-size: 14px; line-height: 2;">
            <li>审核构件尺寸与集装箱限制匹配</li>
            <li>识别需要分段的构件</li>
            <li>规划运输用螺栓拼接位置</li>
            <li>协调包装和装柜顺序</li>
            <li>开发构件编号体系</li>
          </ul>
        </div>
        <div class="reveal reveal-delay-2" style="padding: 32px; background: white; border-radius: 12px; border: 1px solid #e2e8f0;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 40px; height: 40px; background: #f59e0b; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700;">B</div>
            <h3 style="font-size: 18px; margin: 0; color: #0f172a;">如果您只有建筑图或项目需求</h3>
          </div>
