---
// BaseLayout.astro - 统一页面布局
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import MobileCTA from '../components/MobileCTA.astro';
import { buildOrganizationJsonLd, buildBreadcrumbJsonLd } from '../data/seo-structure';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: 'zh' | 'en';
  noindex?: boolean;
  singleLanguage?: boolean;
}

const { title, description, lang, noindex = false, singleLanguage = false } = Astro.props;
const currentPath = Astro.url.pathname;

// 首页输出 Organization（每页至多 1 个）；正式内容页输出 BreadcrumbList；占位页不输出
const isHome = currentPath === `/${lang}/` || currentPath === `/${lang}`;
const orgLd = isHome && !noindex ? buildOrganizationJsonLd() : null;
const crumbLd = !isHome && !noindex ? buildBreadcrumbJsonLd(currentPath) : null;
---

<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
<head>
  <SEOHead title={title} description={description} lang={lang} noindex={noindex} singleLanguage={singleLanguage} />
  <Analytics />
  {orgLd && <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />}
  {crumbLd && <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />}
</head>
<body>
  <Header lang={lang} currentPath={currentPath} singleLanguage={singleLanguage} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} />
  <FloatingButtons />
  <MobileCTA lang={lang} />
</body>
</html>
