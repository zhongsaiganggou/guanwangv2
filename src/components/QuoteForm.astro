<script define:vars={{ COUNTRIES }}>
  // QuoteForm V2 - 双路径切换、前端验证、真实后端提交、UTM跨页面保持
  const MAX_FILE_SIZE = 25 * 1024 * 1024;
  const API_ENDPOINT = '/api/project-inquiry';

  // UTM + click ID storage. Use a first-party cookie (30 days) so ad click
  // IDs survive across sessions (a user may click an ad today and submit an
  // inquiry tomorrow on a new visit).
  const UTM_STORAGE_KEY = 'zs_utm_data';
  const UTM_FIELDS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  const CLICK_ID_FIELDS = ['gclid', 'gbraid', 'wbraid', 'fbclid'];
  const ALL_PERSIST_FIELDS = UTM_FIELDS.concat(CLICK_ID_FIELDS);
  const COOKIE_MAX_AGE = 30 * 24 * 60 * 60; // 30 days

  function readStoredUtm() {
    try {
      const m = document.cookie.match(/(?:^|;\s*)zs_utm_data=([^;]+)/);
      if (!m) return {};
      return JSON.parse(decodeURIComponent(m[1]));
    } catch { return {}; }
  }

  function writeStoredUtm(data) {
    try {
      const v = encodeURIComponent(JSON.stringify(data));
      // Host-only cookie, same-site lax, secure; readable by this JS only. No sensitive
      // personal data — only ad click IDs and UTM parameters.
      document.cookie = `zs_utm_data=${v}; path=/; max-age=${COOKIE_MAX_AGE}; SameSite=Lax; Secure`;
    } catch { /* ignore */ }
  }

  function saveUtmFromUrl() {
    try {
      const params = new URLSearchParams(window.location.search);
      const utmData = readStoredUtm();
      let hasNew = false;
      ALL_PERSIST_FIELDS.forEach(field => {
        const val = params.get(field);
        if (val) { utmData[field] = val; hasNew = true; }
      });
      if (hasNew) {
        utmData._landing = window.location.pathname;
        utmData._referrer = document.referrer || '';
        utmData._timestamp = Date.now();
        writeStoredUtm(utmData);
      }
    } catch (e) { /* ignore */ }
  }

  saveUtmFromUrl();

  document.addEventListener('DOMContentLoaded', function() {
    const forms = document.querySelectorAll('.quote-form-v2');
    if (!forms.length) return;

    const storedUtm = readStoredUtm();

    forms.forEach(form => {
      const lang = form.dataset.lang === 'zh' ? 'zh' : 'en';
      const isZh = lang === 'zh';

      // Fill UTM + click IDs from stored cookie
      ALL_PERSIST_FIELDS.forEach(field => {
        const input = form.querySelector(`input[name="${field}"]`);
        if (input && storedUtm[field]) input.value = storedUtm[field];
      });
      const landingInput = form.querySelector('input[name="landing_page"]');
      if (landingInput) landingInput.value = storedUtm._landing || window.location.pathname;
      const referrerInput = form.querySelector('input[name="referrer"]');
      if (referrerInput) referrerInput.value = storedUtm._referrer || document.referrer || '';
      const sourceInput = form.querySelector('input[name="source_page"]');
      if (sourceInput) sourceInput.value = window.location.pathname;

      // ---- Country / calling code searchable selector ----
      const countrySelect = form.querySelector('[data-country-select]');
      if (countrySelect) {
        const hiddenInput = countrySelect.querySelector('[data-country-value]');
        const trigger = countrySelect.querySelector('[data-country-trigger]');
        const label = countrySelect.querySelector('[data-country-label]');
        const dropdown = countrySelect.querySelector('[data-country-dropdown]');
        const search = countrySelect.querySelector('[data-country-search]');
        const list = countrySelect.querySelector('[data-country-list]');
        const placeholder = lang === 'zh' ? '请选择国家区号' : 'Select country code';

        const COUNTRIES_DATA = COUNTRIES; // available in page scope
        let activeIdx = 0;

        function renderList(filter) {
          const q = (filter || '').trim().toLowerCase();
          const items = COUNTRIES_DATA.filter(c => {
            if (!q) return true;
            return c.name_en.toLowerCase().includes(q) ||
                   c.name_zh.toLowerCase().includes(q) ||
                   c.calling_code.toLowerCase().includes(q) ||
                   c.iso2.toLowerCase().includes(q);
          });
          list.innerHTML = '';
          items.forEach((c, i) => {
            const li = document.createElement('li');
            li.className = 'country-select-option';
            li.setAttribute('role', 'option');
            li.setAttribute('data-value', c.calling_code);
            li.setAttribute('data-name', lang === 'zh' ? c.name_zh : c.name_en);
            li.tabIndex = -1;
            li.innerHTML = `<span class="cs-name"></span><span class="cs-code">${c.calling_code}</span>`;
            li.querySelector('.cs-name').textContent = (lang === 'zh' ? c.name_zh : c.name_en);
            li.addEventListener('mousedown', (e) => {
              e.preventDefault();
              selectCountry(c);
            });
            list.appendChild(li);
          });
          activeIdx = 0;
          highlightActive();
        }

        function highlightActive() {
          const opts = list.querySelectorAll('.country-select-option');
          opts.forEach((o, i) => o.classList.toggle('active', i === activeIdx));
          if (opts[activeIdx]) opts[activeIdx].scrollIntoView({ block: 'nearest' });
        }

        function selectCountry(c) {
          hiddenInput.value = c.calling_code;
          label.textContent = (lang === 'zh' ? c.name_zh : c.name_en) + ' ' + c.calling_code;
          trigger.classList.remove('open');
          dropdown.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
          // Clear the phone_code error when a valid country is chosen.
          const errSpan = form.querySelector('[data-error-for="phone_code"]');
          if (errSpan) { errSpan.textContent = ''; errSpan.classList.remove('show'); }
          const fieldWrap = countrySelect.closest('.form-field');
          if (fieldWrap) fieldWrap.classList.remove('error');
        }

        function openDropdown() {
          renderList(search.value);
          dropdown.hidden = false;
          trigger.classList.add('open');
          trigger.setAttribute('aria-expanded', 'true');
          setTimeout(() => search.focus(), 0);
        }
        function closeDropdown() {
          dropdown.hidden = true;
          trigger.classList.remove('open');
          trigger.setAttribute('aria-expanded', 'false');
        }

        trigger.addEventListener('click', () => {
          if (dropdown.hidden) openDropdown(); else closeDropdown();
        });
        search.addEventListener('input', () => renderList(search.value));
        search.addEventListener('keydown', (e) => {
          const opts = list.querySelectorAll('.country-select-option');
          if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, opts.length - 1); highlightActive(); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); highlightActive(); }
          else if (e.key === 'Enter') { e.preventDefault(); if (opts[activeIdx]) opts[activeIdx].dispatchEvent(new Event('mousedown')); }
          else if (e.key === 'Escape') { e.preventDefault(); closeDropdown(); trigger.focus(); }
          else if (e.key === 'Tab') { closeDropdown(); }
        });
        document.addEventListener('click', (e) => {
          if (!countrySelect.contains(e.target)) closeDropdown();
        });

        // Auto-select visitor's country from Cloudflare edge detection
        const visitorCountry = window.__VISITOR_COUNTRY__ || '';
        if (visitorCountry) {
          const matched = COUNTRIES_DATA.find(c => c.iso2 === visitorCountry);
          if (matched) {
            selectCountry(matched);
          }
        }
      }

      // Path switch
      const pathBtns = form.querySelectorAll('.form-path-btn');
      const panels = form.querySelectorAll('.form-path-panel');
      const submitBtn = form.querySelector('.btn-submit-full');
      let fileInput = form.querySelector('input[type=file]');
      const successEl = form.querySelector('.form-success');
      const errorEl = form.querySelector('.form-error');

      pathBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const path = this.dataset.path;
          pathBtns.forEach(b => {
            b.classList.toggle('active', b === this);
            b.setAttribute('aria-selected', b === this ? 'true' : 'false');
          });
          panels.forEach(p => p.classList.toggle('active', p.dataset.panel === path));
          form.querySelector('input[name="active_path"]').value = path;
          if (submitBtn) {
            submitBtn.textContent = path === 'drawings'
              ? submitBtn.dataset.submitText
              : submitBtn.dataset.submitTextNodrawings;
          }
          // Clear errors
          form.querySelectorAll('.field-error').forEach(e => e.textContent = '');
          form.querySelectorAll('.form-field.error').forEach(f => f.classList.remove('error'));
          if (errorEl) { errorEl.textContent = ''; errorEl.classList.remove('show'); }

          // Track form start when user actively switches path
          if (!form._formStartTracked) {
            form._formStartTracked = true;
            if (typeof window.trackEvent === 'function') {
              window.trackEvent('project_form_start', {
                form_variant: path === 'drawings' ? 'have_drawings' : 'no_drawings',
                page_path: window.location.pathname,
              });
            }
          }
        });
      });

      // Deep-link: honor ?path=nodrawings (or #...nodrawings) so "暂无图纸" entry opens on the no-drawings tab
      (function initDeepLinkedPath() {
        let desired = new URLSearchParams(window.location.search).get('path');
        if (!desired && location.hash && location.hash.indexOf('nodrawings') !== -1) desired = 'nodrawings';
        if (desired === 'nodrawings') {
          const ndBtn = form.querySelector('.form-path-btn[data-path="nodrawings"]');
          if (ndBtn) ndBtn.click();
        }
      })();

      // Also track first input/focus on form fields
      let formStartFired = false;
      function fireFormStart() {
        if (formStartFired) return;
        formStartFired = true;
        if (typeof window.trackEvent === 'function') {
          const ap = form.querySelector('input[name="active_path"]');
          window.trackEvent('project_form_start', {
            form_variant: ap && ap.value === 'drawings' ? 'have_drawings' : 'no_drawings',
            page_path: window.location.pathname,
          });
        }
      }
      form.querySelectorAll('input, select, textarea').forEach(function(el) {
        el.addEventListener('focus', fireFormStart, { once: true });
        el.addEventListener('input', fireFormStart, { once: true });
      });

      // File upload
      const uploadAreas = form.querySelectorAll('.upload-area');
      uploadAreas.forEach((uploadArea) => {
        const fileInput = uploadArea.querySelector('input[type="file"]');
        if (!fileInput) return;
        uploadArea.addEventListener('dragover', (e) => { e.preventDefault(); uploadArea.classList.add('dragover'); });
        uploadArea.addEventListener('dragleave', () => uploadArea.classList.remove('dragover'));
        uploadArea.addEventListener('drop', (e) => {
          e.preventDefault();
          uploadArea.classList.remove('dragover');
          if (e.dataTransfer.files.length) {
            fileInput.files = e.dataTransfer.files;
            updateUploadText();
          }
        });
        fileInput.addEventListener('change', updateUploadText);

        function updateUploadText() {
          const placeholder = uploadArea.querySelector('.upload-text');
          if (!placeholder) return;
          if (fileInput.files.length) {
            const names = Array.from(fileInput.files).map(f => f.name).join(', ');
            placeholder.textContent = names.length > 60 ? names.substring(0, 60) + '...' : names;
            uploadArea.classList.add('has-files');
          } else {
            placeholder.textContent = uploadArea.dataset.defaultText || '';
            uploadArea.classList.remove('has-files');
          }
        }
        // Store default text
        const ph = uploadArea.querySelector('.upload-text');
        if (ph) uploadArea.dataset.defaultText = ph.textContent;
      });

      // Validate
      function validate() {
        let isValid = true;

        form.querySelectorAll('.field-error').forEach(e => e.textContent = '');
        form.querySelectorAll('.form-field').forEach(f => f.classList.remove('error'));

        function markField(fieldName, msg) {
          const input = form.querySelector(`[name="${fieldName}"]`);
          const errSpan = form.querySelector(`[data-error-for="${fieldName}"]`);
          if (errSpan) errSpan.textContent = msg;
          input?.closest('.form-field')?.classList.add('error');
        }

        // Unconditional required: name + project country
        if (!form.querySelector('[name="name"]').value.trim()) {
          isValid = false;
          markField('name', isZh ? '请输入姓名' : 'Please enter your name');
        }
        if (!form.querySelector('[name="country"]').value.trim()) {
          isValid = false;
          markField('country', isZh ? '请输入项目所在国家' : 'Please enter the project country');
        }

        // Contact rule: WeChat is REQUIRED. Phone/WhatsApp is optional.
        const wechatVal = form.querySelector('[name="wechat"]').value.trim();
        const phoneVal = form.querySelector('[name="phone"]').value.trim();
        const codeVal = form.querySelector('[name="phone_code"]').value.trim();

        if (!wechatVal) {
          isValid = false;
          markField('wechat', isZh
            ? '请填写微信号，方便我们联系您。'
            : 'Please provide your WeChat ID so we can contact you.');
        }

        // Phone provided without a country / calling code
        if (phoneVal && !codeVal) {
          isValid = false;
          markField('phone_code', isZh ? '填写电话时请选择国家/地区区号。' : 'Please select a country/region code when entering a phone number.');
        }

        // Email optional — validate format only if filled
        const emailInput = form.querySelector('[name="email"]');
        if (emailInput.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)) {
          isValid = false;
          markField('email', isZh ? '请输入有效邮箱' : 'Please enter a valid email');
        }

        if (!isValid) {
          const firstError = form.querySelector('.form-field.error');
          if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return isValid;
      }

      // Show error
      function showError(msg) {
        if (errorEl) {
          errorEl.textContent = msg;
          errorEl.classList.add('show');
          errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

      // Show success
      function showSuccess(title, msg) {
        if (successEl) {
          successEl.innerHTML = `<strong>${title}</strong><br>${msg}`;
          successEl.classList.add('show');
          successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        // Hide form fields
        form.querySelectorAll('.form-path-switch, .form-grid, .form-field, .form-path-panel, .turnstile-wrapper, .btn-submit-full, .form-privacy, .hp-field').forEach(el => {
          el.style.display = 'none';
        });
      }

      // Submit
      form.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Prevent duplicate submissions from rapid clicks, Enter key, or repeated callbacks.
        if (form.dataset.submitting === 'true') return;

        // Clear previous messages
        if (errorEl) { errorEl.textContent = ''; errorEl.classList.remove('show'); }
        if (successEl) { successEl.textContent = ''; successEl.classList.remove('show'); }

        if (!validate()) {
          // Client-side validation blocked the submit. Emit form_error so we
          // can measure how often users hit required-field errors before
          // reaching the network. No PII — only stage/reason.
          if (typeof window.trackEvent === 'function') {
            try {
              window.trackEvent('form_error', {
                stage: 'validation',
                reason: 'client_side_required',
                language: lang,
                form_variant: form.querySelector('input[name="active_path"]')?.value || 'unknown',
                page_path: window.location.pathname,
              });
            } catch { /* ignore */ }
          }
          return;
        }

        // Check file sizes
        if (fileInput && fileInput.files.length) {
          for (const file of fileInput.files) {
            if (file.size > MAX_FILE_SIZE) {
              showError(isZh ? '文件过大，单文件最大25MB。' : 'File too large. Max 25MB per file.');
              return;
            }
          }
        }

        // Get Turnstile token
        const turnstileWidget = form.querySelector('.cf-turnstile');
        let turnstileToken = '';
        if (turnstileWidget) {
          turnstileToken = turnstileWidget.dataset.token || '';
          // Also try window.turnstile.getResponse
          if (!turnstileToken && window.turnstile && turnstileWidget.dataset.widgetId) {
            try {
              turnstileToken = window.turnstile.getResponse(turnstileWidget.dataset.widgetId);
            } catch { /* ignore */ }
          }
        }
        if (!turnstileToken) {
          showError(isZh ? '请完成安全验证' : 'Please complete the security verification.');
          return;
        }

        // Build FormData
        const formData = new FormData(form);
        formData.append('cf-turnstile-response', turnstileToken);
        formData.append('referrer', document.referrer || '');

        // Submitting state
        const originalText = submitBtn.textContent;
        form.dataset.submitting = 'true';
        submitBtn.disabled = true;
        submitBtn.textContent = isZh ? '提交中...' : 'Submitting...';
        submitBtn.classList.add('submitting');

        try {
          const response = await fetch(API_ENDPOINT, {
            method: 'POST',
            body: formData,
          });

          const result = await response.json();

          if (result.success && result.lead_id && result.lead_id !== 'filtered') {
            // Success
            const activePath = form.querySelector('input[name="active_path"]').value;

            // QA / test isolation: submissions the server marked as test_record=1
            // must NOT fire formal conversion events (generate_lead / project_form_submit
            // / drawing_upload / Meta Lead). They emit a separate qa_form_submit event
            // so QA work stays visible without polluting real lead data.
            const isQa = result.test_record === true;
            if (isQa) {
              if (typeof window.trackEvent === 'function') {
                window.trackEvent('qa_form_submit', {
                  lead_id: result.lead_id,
                  language: lang,
                  form_variant: activePath === 'drawings' ? 'have_drawings' : 'no_drawings',
                  page_path: window.location.pathname,
                });
              }
            } else if (typeof window.trackLeadConversion === 'function') {
              window.trackLeadConversion({
                lead_id: result.lead_id,
                language: lang,
                form_variant: activePath === 'drawings' ? 'have_drawings' : 'no_drawings',
                source_page: window.location.pathname,
                utm_source: form.querySelector('[name="utm_source"]')?.value || '',
                utm_medium: form.querySelector('[name="utm_medium"]')?.value || '',
                utm_campaign: form.querySelector('[name="utm_campaign"]')?.value || '',
                has_file: fileInput && fileInput.files.length > 0,
              });
            }

            showSuccess(
              isZh ? '项目需求已提交' : 'Project inquiry received',
              result.message || (isZh
                ? '感谢您的提交。中赛钢构将根据您提供的项目资料进行审核，并通过您填写的联系方式进行后续沟通。如需补充资料，工程团队会通过微信或邮件与您联系确认。'
                : 'Thank you. ZhongSai will review the project information and follow up using the contact details you provided. We will reach out via WeChat or email if any further details are needed.')
            );
          } else if (result.success && result.lead_id === 'filtered') {
            // Honeypot filtered - silently show success (don't reveal it's a filter)
            showSuccess(
              isZh ? '项目需求已提交' : 'Project inquiry received',
              isZh ? '感谢您的提交。' : 'Thank you.'
            );
          } else {
            // Failure. Emit a non-conversion GA4 event so we can measure form
            // drop-off. Never include PII (name/wechat/email/phone).
            const reportFormError = (stage, reason) => {
              if (typeof window.trackEvent !== 'function') return;
              try {
                window.trackEvent('form_error', {
                  stage: stage,           // validation | turnstile | server | network
                  reason: reason,         // short code, not user-entered text
                  language: lang,
                  form_variant: form.querySelector('input[name="active_path"]')?.value || 'unknown',
                  page_path: window.location.pathname,
                });
              } catch { /* never break submission flow */ }
            };

            let msg = isZh ? '提交失败，请稍后重试。' : 'Submission failed. Please try again.';
            if (result.code === 'TURNSTILE_FAILED') {
              msg = isZh ? '验证失败，请重新提交。' : 'Verification failed. Please try again.';
              showError(msg);
              reportFormError('turnstile', result.code || 'turnstile_failed');
            } else if (result.code === 'VALIDATION_ERROR') {
              // Map server-side field errors onto the correct fields (localized)
              const serverFieldText = {
                name: isZh ? '请输入姓名' : 'Please enter your name',
                project_country: isZh ? '请输入项目所在国家' : 'Please enter the project country',
                wechat: isZh ? '请填写微信号，方便我们联系您。' : 'Please provide your WeChat ID so we can contact you.',
                calling_code: isZh ? '填写电话时请选择国家/地区区号。' : 'Please select a country/region code when entering a phone number.',
                email: isZh ? '请输入有效邮箱' : 'Please enter a valid email',
              };
              const fieldToInput = { name: 'name', project_country: 'country', wechat: 'wechat', calling_code: 'phone_code', email: 'email' };

              function markServerField(inputName, text) {
                const errSpan = form.querySelector(`[data-error-for="${inputName}"]`);
                if (errSpan) errSpan.textContent = text;
                const inp = form.querySelector(`[name="${inputName}"]`);
                inp?.closest('.form-field')?.classList.add('error');
              }

              let hasFieldError = false;
              Object.keys(result.errors || {}).forEach(k => {
                if (serverFieldText[k]) {
                  markServerField(fieldToInput[k], serverFieldText[k]);
                  hasFieldError = true;
                }
              });

              if (hasFieldError) {
                form.querySelector('.form-field.error')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                reportFormError('validation', 'field_error');
              } else {
                showError(isZh ? '请检查必填字段。' : 'Please check required fields.');
                reportFormError('validation', 'required_fields');
              }
            } else if (result.message) {
              showError(result.message);
              reportFormError('server', result.code || 'unknown');
            } else {
              showError(msg);
              reportFormError('server', result.code || 'unknown');
            }

            // Reset Turnstile
            if (window.turnstile && turnstileWidget?.dataset.widgetId) {
              try { window.turnstile.reset(turnstileWidget.dataset.widgetId); } catch { /* ignore */ }
            }
          }
        } catch (err) {
          showError(isZh ? '网络错误，请稍后重试。' : 'Network error. Please try again.');
          if (typeof window.trackEvent === 'function') {
            try {
              window.trackEvent('form_error', {
                stage: 'network',
                reason: err && err.name ? err.name : 'network_error',
                language: lang,
                form_variant: form.querySelector('input[name="active_path"]')?.value || 'unknown',
                page_path: window.location.pathname,
              });
            } catch { /* ignore */ }
          }
        } finally {
          delete form.dataset.submitting;
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
          submitBtn.classList.remove('submitting');
        }
      });
    });
  });
</script>

