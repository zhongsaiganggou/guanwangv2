---
// QuoteForm.astro - 统一询价表单组件（双路径：有图纸/无图纸，前端验证，不连接CRM）
interface Props {
  lang?: 'zh' | 'en';
  id?: string;
  embed?: boolean;
}

const { lang = 'zh', id = 'quote-form', embed = false } = Astro.props;

const texts = lang === 'zh' ? {
  title: '获取项目方案与报价',
  subtitle: '已有图纸可直接上传；暂无完整图纸，也可以提交项目基本需求。',
  tabDrawings: '已有图纸 / BOQ',
  tabNoDrawings: '暂无完整图纸',
  name: '姓名 / 称呼',
  email: '邮箱（可选）',
  phone: 'WhatsApp / 电话',
  phoneCode: '国家区号',
  wechat: '微信',
  wechatPlaceholder: '微信号',
  country: '项目所在国家',
  drawingUpload: '上传图纸 / BOQ',
  drawingHint: '支持 PDF、DWG、DXF、JPG、PNG、XLS、XLSX，可多选',
  buildingType: '项目类型',
  buildingTypeOptions: ['请选择', '工业厂房与车间', '仓库与物流', '矿业与能源设施', '商业与公共建筑', '农业与特种设施', '定制钢结构工程', '其他'],
  length: '长度 (m)',
  width: '宽度 (m)',
  height: '高度 (m)',
  intendedUse: '项目用途',
  intendedUsePlaceholder: '例如：生产车间、仓储、办公等',
  crane: '是否需要行车 / 吊车',
  craneOptions: ['请选择', '是 (Yes)', '否 (No)', '不确定 (Not Sure)'],
  message: '项目说明 / 特殊要求',
  messagePlaceholder: '请描述您的项目需求、特殊要求或问题',
  submitDrawings: '提交图纸，获取报价',
  submitNoDrawings: '提交项目需求',
  submitting: '提交中...',
  successPreview: '测试环境：表单验证成功，当前不会真实发送。',
  requiredName: '请输入姓名',
  requiredEmail: '请输入有效邮箱',
  requiredPhone: '请输入WhatsApp或电话',
  requiredCountry: '请输入项目所在国家',
  requiredBuildingType: '请选择项目类型',
  requiredIntendedUse: '请输入项目用途',
  requiredWeChat: '请输入微信号',
  requiredPhoneCode: '请选择国家区号',
  privacyNote: '提交即表示您同意我们的隐私政策，我们不会分享您的信息。',
} : {
  title: 'Get Project Solution & Quote',
  subtitle: 'Upload drawings if you have them; or submit basic project requirements if not.',
  tabDrawings: 'Have Drawings / BOQ',
  tabNoDrawings: 'No Complete Drawings Yet',
  name: 'Name',
  email: 'Email (Optional)',
  phone: 'WhatsApp / Phone',
  phoneCode: 'Country / Calling Code',
  wechat: 'WeChat ID',
  wechatPlaceholder: 'WeChat ID',
  country: 'Project Country',
  drawingUpload: 'Upload Drawings / BOQ',
  drawingHint: 'PDF, DWG, DXF, JPG, PNG, XLS, XLSX — multiple files allowed',
  buildingType: 'Project Type',
  buildingTypeOptions: ['Please select', 'Industrial Factory & Workshop', 'Warehouse & Logistics', 'Mining & Energy', 'Commercial & Public', 'Agriculture & Special', 'Custom Steel Structure', 'Other'],
  length: 'Length (m)',
  width: 'Width (m)',
  height: 'Height (m)',
  intendedUse: 'Intended Use',
  intendedUsePlaceholder: 'e.g. production, warehousing, office',
  crane: 'Crane Requirement',
  craneOptions: ['Please select', 'Yes', 'No', 'Not Sure'],
  message: 'Project Description / Special Requirements',
  messagePlaceholder: 'Describe your project needs, special requirements or questions',
  submitDrawings: 'Submit Drawings for Quote',
  submitNoDrawings: 'Submit Project Requirements',
  submitting: 'Submitting...',
  successPreview: 'Preview mode: Form validation successful. No inquiry was sent.',
  requiredName: 'Please enter your name',
  requiredEmail: 'Please enter a valid email',
  requiredPhone: 'Please enter WhatsApp or phone number',
  requiredCountry: 'Please enter the project country',
  requiredBuildingType: 'Please select project type',
  requiredIntendedUse: 'Please enter intended use',
  requiredWeChat: 'Please enter WeChat ID',
  requiredPhoneCode: 'Please select country / calling code',
  privacyNote: 'By submitting, you agree to our privacy policy. We will not share your information.',
};

const phoneCodes = [
  { code: '', name: lang === 'zh' ? '请选择国家区号' : 'Select country code' },
  { code: '+86', name: 'China +86' },
  { code: '+1', name: 'USA/Canada +1' },
  { code: '+44', name: 'UK +44' },
  { code: '+61', name: 'Australia +61' },
  { code: '+65', name: 'Singapore +65' },
  { code: '+60', name: 'Malaysia +60' },
  { code: '+62', name: 'Indonesia +62' },
  { code: '+66', name: 'Thailand +66' },
  { code: '+84', name: 'Vietnam +84' },
  { code: '+91', name: 'India +91' },
  { code: '+971', name: 'UAE +971' },
  { code: '+966', name: 'Saudi Arabia +966' },
  { code: '+234', name: 'Nigeria +234' },
  { code: '+254', name: 'Kenya +254' },
  { code: '+52', name: 'Mexico +52' },
  { code: '+55', name: 'Brazil +55' },
  { code: '+49', name: 'Germany +49' },
  { code: '+33', name: 'France +33' },
  { code: '+81', name: 'Japan +81' },
  { code: '+82', name: 'South Korea +82' },
  { code: '+7', name: 'Russia +7' },
  { code: '+27', name: 'South Africa +27' },
  { code: '+20', name: 'Egypt +20' },
  { code: '+90', name: 'Turkey +90' },
  { code: '+92', name: 'Pakistan +92' },
  { code: '+63', name: 'Philippines +63' },
  { code: '+855', name: 'Cambodia +855' },
  { code: '+95', name: 'Myanmar +95' },
  { code: '+other', name: 'Other' },
];
---

{embed ? (
  <div class="quote-form-wrapper" id={id}>
    <h3>{texts.title}</h3>
    <p class="form-subtitle">{texts.subtitle}</p>
    <form class="quote-form quote-form-v2" id={`${id}-form`} novalidate data-lang={lang}>
      <div class="form-success" id={`${id}-success`} role="alert"></div>

      <!-- 路径切换按钮 -->
      <div class="form-path-switch" role="tablist">
        <button type="button" class="form-path-btn active" data-path="drawings" role="tab" aria-selected="true">
          <span class="path-icon">01</span>
          <span class="path-text">{texts.tabDrawings}</span>
        </button>
        <button type="button" class="form-path-btn" data-path="nodrawings" role="tab" aria-selected="false">
          <span class="path-icon">02</span>
          <span class="path-text">{texts.tabNoDrawings}</span>
        </button>
      </div>

      <!-- 通用字段：姓名 + 邮箱 -->
      <div class="form-grid form-grid-2">
        <div class="form-field">
          <label for={`${id}-name`}>{texts.name} <span class="req">*</span></label>
          <input type="text" id={`${id}-name`} name="name" required autocomplete="name" />
          <span class="field-error" data-error-for="name"></span>
        </div>
        <div class="form-field">
          <label for={`${id}-email`}>{texts.email}</label>
          <input type="email" id={`${id}-email`} name="email" autocomplete="email" />
          <span class="field-error" data-error-for="email"></span>
        </div>
      </div>

      <!-- 通用字段：国家区号 + WhatsApp/电话 + 微信 -->
      <div class="form-grid form-grid-3">
        <div class="form-field">
          <label for={`${id}-phone-code`}>{texts.phoneCode} <span class="req">*</span></label>
          <select id={`${id}-phone-code`} name="phone_code" required>
            {phoneCodes.map(c => <option value={c.code}>{c.name}</option>)}
          </select>
          <span class="field-error" data-error-for="phone_code"></span>
        </div>
        <div class="form-field">
          <label for={`${id}-phone`}>{texts.phone} <span class="req">*</span></label>
          <input type="tel" id={`${id}-phone`} name="phone" required autocomplete="tel" />
          <span class="field-error" data-error-for="phone"></span>
        </div>
        <div class="form-field">
          <label for={`${id}-wechat`}>{texts.wechat} <span class="req">*</span></label>
          <input type="text" id={`${id}-wechat`} name="wechat" required placeholder={texts.wechatPlaceholder} />
          <span class="field-error" data-error-for="wechat"></span>
        </div>
      </div>

      <!-- 通用字段：项目所在国家 -->
      <div class="form-field">
        <label for={`${id}-country`}>{texts.country} <span class="req">*</span></label>
        <input type="text" id={`${id}-country`} name="country" required />
        <span class="field-error" data-error-for="country"></span>
      </div>

      <!-- 路径A：有图纸 -->
      <div class="form-path-panel active" data-panel="drawings">
        <div class="form-field form-upload">
          <label for={`${id}-drawing`}>{texts.drawingUpload}</label>
          <div class="upload-area">
            <input type="file" id={`${id}-drawing`} name="drawings" accept=".pdf,.dwg,.dxf,.jpg,.jpeg,.png,.xls,.xlsx" multiple />
            <div class="upload-placeholder">
              <svg class="upload-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4"/><path d="m7 9 5-5 5 5"/><path d="M5 16v3a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3"/></svg>
              <span class="upload-text">{lang === 'zh' ? '点击或拖拽文件到此处' : 'Click or drag files here'}</span>
            </div>
          </div>
          <small class="form-hint">{texts.drawingHint}</small>
        </div>
      </div>

      <!-- 路径B：无图纸 -->
      <div class="form-path-panel" data-panel="nodrawings">
        <div class="form-field">
          <label for={`${id}-building-type`}>{texts.buildingType} <span class="req">*</span></label>
          <select id={`${id}-building-type`} name="projectType" required>
            {texts.buildingTypeOptions.map((opt, i) => <option value={i === 0 ? '' : opt}>{opt}</option>)}
          </select>
          <span class="field-error" data-error-for="projectType"></span>
        </div>
        <div class="form-grid form-grid-3">
          <div class="form-field">
            <label for={`${id}-length`}>{texts.length}</label>
            <input type="number" id={`${id}-length`} name="length" min="0" step="0.1" />
          </div>
          <div class="form-field">
            <label for={`${id}-width`}>{texts.width}</label>
            <input type="number" id={`${id}-width`} name="width" min="0" step="0.1" />
          </div>
          <div class="form-field">
            <label for={`${id}-height`}>{texts.height}</label>
            <input type="number" id={`${id}-height`} name="height" min="0" step="0.1" />
          </div>
        </div>
        <div class="form-grid form-grid-2">
          <div class="form-field">
            <label for={`${id}-intended-use`}>{texts.intendedUse} <span class="req">*</span></label>
            <input type="text" id={`${id}-intended-use`} name="intendedUse" required placeholder={texts.intendedUsePlaceholder} />
            <span class="field-error" data-error-for="intendedUse"></span>
          </div>
          <div class="form-field">
            <label for={`${id}-crane`}>{texts.crane}</label>
            <select id={`${id}-crane`} name="hasCrane">
              {texts.craneOptions.map((opt, i) => <option value={i === 0 ? '' : opt}>{opt}</option>)}
            </select>
          </div>
        </div>
      </div>

      <!-- 通用：项目说明 -->
      <div class="form-field">
        <label for={`${id}-message`}>{texts.message}</label>
        <textarea id={`${id}-message`} name="message" rows="4" placeholder={texts.messagePlaceholder}></textarea>
      </div>

      <!-- UTM隐藏字段 -->
      <input type="hidden" name="utm_source" />
      <input type="hidden" name="utm_medium" />
      <input type="hidden" name="utm_campaign" />
      <input type="hidden" name="utm_content" />
      <input type="hidden" name="utm_term" />
      <input type="hidden" name="landing_page" />
      <input type="hidden" name="gclid" />
      <input type="hidden" name="gbraid" />
      <input type="hidden" name="wbraid" />
      <input type="hidden" name="fbclid" />

      <button type="submit" class="btn btn-primary btn-submit-full" data-submit-text={texts.submitDrawings} data-submit-text-nodrawings={texts.submitNoDrawings}>
        {texts.submitDrawings}
      </button>
      <p class="form-privacy">{texts.privacyNote}</p>
    </form>
  </div>
) : (
<section class="quote-form-section" id={id}>
  <div class="container">
    <form class="quote-form quote-form-v2" id={`${id}-form`} novalidate data-lang={lang}>
      <h2>{texts.title}</h2>
      <p class="form-subtitle">{texts.subtitle}</p>

      <div class="form-success" id={`${id}-success`} role="alert"></div>

      <div class="form-path-switch" role="tablist">
        <button type="button" class="form-path-btn active" data-path="drawings" role="tab" aria-selected="true">
          <span class="path-icon">01</span>
          <span class="path-text">{texts.tabDrawings}</span>
        </button>
        <button type="button" class="form-path-btn" data-path="nodrawings" role="tab" aria-selected="false">
          <span class="path-icon">02</span>
          <span class="path-text">{texts.tabNoDrawings}</span>
        </button>
      </div>

      <div class="form-grid form-grid-2">
        <div class="form-field">
          <label for={`${id}-name`}>{texts.name} <span class="req">*</span></label>
          <input type="text" id={`${id}-name`} name="name" required autocomplete="name" />
          <span class="field-error" data-error-for="name"></span>
        </div>
        <div class="form-field">
          <label for={`${id}-email`}>{texts.email}</label>
          <input type="email" id={`${id}-email`} name="email" autocomplete="email" />
          <span class="field-error" data-error-for="email"></span>
        </div>
      </div>

      <div class="form-grid form-grid-3">
        <div class="form-field">
          <label for={`${id}-phone-code`}>{texts.phoneCode} <span class="req">*</span></label>
          <select id={`${id}-phone-code`} name="phone_code" required>
            {phoneCodes.map(c => <option value={c.code}>{c.name}</option>)}
          </select>
          <span class="field-error" data-error-for="phone_code"></span>
        </div>
        <div class="form-field">
          <label for={`${id}-phone`}>{texts.phone} <span class="req">*</span></label>
          <input type="tel" id={`${id}-phone`} name="phone" required autocomplete="tel" />
          <span class="field-error" data-error-for="phone"></span>
        </div>
        <div class="form-field">
          <label for={`${id}-wechat`}>{texts.wechat} <span class="req">*</span></label>
          <input type="text" id={`${id}-wechat`} name="wechat" required placeholder={texts.wechatPlaceholder} />
          <span class="field-error" data-error-for="wechat"></span>
        </div>
      </div>

      <div class="form-field">
        <label for={`${id}-country`}>{texts.country} <span class="req">*</span></label>
        <input type="text" id={`${id}-country`} name="country" required />
        <span class="field-error" data-error-for="country"></span>
      </div>

      <div class="form-path-panel active" data-panel="drawings">
        <div class="form-field form-upload">
          <label for={`${id}-drawing`}>{texts.drawingUpload}</label>
          <div class="upload-area">
            <input type="file" id={`${id}-drawing`} name="drawings" accept=".pdf,.dwg,.dxf,.jpg,.jpeg,.png,.xls,.xlsx" multiple />
            <div class="upload-placeholder">
              <svg class="upload-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4"/><path d="m7 9 5-5 5 5"/><path d="M5 16v3a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3"/></svg>
              <span class="upload-text">{lang === 'zh' ? '点击或拖拽文件到此处' : 'Click or drag files here'}</span>
            </div>
          </div>
          <small class="form-hint">{texts.drawingHint}</small>
        </div>
      </div>

      <div class="form-path-panel" data-panel="nodrawings">
        <div class="form-field">
          <label for={`${id}-building-type`}>{texts.buildingType} <span class="req">*</span></label>
          <select id={`${id}-building-type`} name="projectType" required>
            {texts.buildingTypeOptions.map((opt, i) => <option value={i === 0 ? '' : opt}>{opt}</option>)}
          </select>
          <span class="field-error" data-error-for="projectType"></span>
        </div>
        <div class="form-grid form-grid-3">
          <div class="form-field">
            <label for={`${id}-length`}>{texts.length}</label>
            <input type="number" id={`${id}-length`} name="length" min="0" step="0.1" />
          </div>
          <div class="form-field">
            <label for={`${id}-width`}>{texts.width}</label>
            <input type="number" id={`${id}-width`} name="width" min="0" step="0.1" />
          </div>
          <div class="form-field">
            <label for={`${id}-height`}>{texts.height}</label>
            <input type="number" id={`${id}-height`} name="height" min="0" step="0.1" />
