            <span class="field-error" data-error-for="intendedUse"></span>
          </div>
          <div class="form-field">
            <label for={`${id}-crane`}>{texts.crane}</label>
            <select id={`${id}-crane`} name="hasCrane">
              {texts.craneOptions.map((opt, i) => <option value={i === 0 ? '' : opt}>{opt}</option>)}
            </select>
          </div>
        </div>
      </div>

      <div class="form-field">
        <label for={`${id}-message`}>{texts.message}</label>
        <textarea id={`${id}-message`} name="message" rows="4" placeholder={texts.messagePlaceholder}></textarea>
