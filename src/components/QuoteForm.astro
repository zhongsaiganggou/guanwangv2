    box-shadow: 0 0 0 3px rgba(26, 86, 219, 0.1);
  }
  .form-field textarea { min-height: 100px; resize: vertical; }
  .form-field.error input, .form-field.error select, .form-field.error textarea { border-color: #dc2626; }
  .field-error { font-size: 0.8rem; color: #dc2626; min-height: 1em; }
  .form-hint { font-size: 0.8rem; color: var(--color-gray-500); }
  .form-upload .upload-area {
    position: relative;
    border: 2px dashed var(--color-gray-300);
    border-radius: 10px;
    padding: 28px 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
    background: var(--color-gray-50);
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .form-upload .upload-area:hover, .form-upload .upload-area.dragover {
    border-color: var(--color-primary);
    background: rgba(26, 86, 219, 0.03);
  }
  .form-upload .upload-area input[type="file"] {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;
  }
  .form-upload .upload-placeholder {
    display: flex; flex-direction: column; align-items: center; gap: 8px; pointer-events: none;
  }
  .form-upload .upload-icon { font-size: 2rem; }
  .form-upload .upload-text { font-size: 0.9rem; color: var(--color-gray-500); max-width: 100%; word-break: break-all; }
  .form-path-panel { display: none; flex-direction: column; gap: 16px; }
  .form-path-panel.active { display: flex; animation: panelFadeIn 0.3s ease; }
  @keyframes panelFadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  .btn-submit-full {
    width: 100%; padding: 16px 24px; font-size: 1rem; font-weight: 600;
    border-radius: 10px; margin-top: 8px; min-height: 52px;
  }
