          <span class="path-icon">01</span>
          <span class="path-text">{texts.tabDrawings}</span>
        </button>
        <button type="button" class="form-path-btn" data-path="nodrawings" role="tab" aria-selected="false">
          <span class="path-icon">02</span>
          <span class="path-text">{texts.tabNoDrawings}</span>
        </button>
      </div>

      <div class="form-grid form-grid-2">
        <div class="form-field">
          <label for={`${id}-name`}>{texts.name} <span class="req">*</span></label>
