  .form-success {
    display: none; padding: 18px 20px; background: #dcfce7; border: 1px solid #86efac;
    border-radius: 10px; color: #166534; font-size: 0.95rem; line-height: 1.6;
  }
  .form-success.show { display: block; animation: panelFadeIn 0.3s ease; }
