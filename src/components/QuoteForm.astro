<script>
  // QuoteForm V2 - 双路径切换、前端验证、真实后端提交、UTM跨页面保持
  const MAX_FILE_SIZE = 25 * 1024 * 1024;
  const API_ENDPOINT = '/api/project-inquiry';

  // UTM storage keys
  const UTM_STORAGE_KEY = 'zs_utm_data';
  const UTM_FIELDS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];

  // Save UTM from URL to sessionStorage (cross-page persistence)
  function saveUtmFromUrl() {
    try {
      const params = new URLSearchParams(window.location.search);
      const utmData = {};
      let hasUtm = false;
      UTM_FIELDS.forEach(field => {
        const val = params.get(field);
        if (val) { utmData[field] = val; hasUtm = true; }
      });
      // Also save click IDs
      ['gclid', 'gbraid', 'wbraid', 'fbclid'].forEach(field => {
        const val = params.get(field);
        if (val) { utmData[field] = val; hasUtm = true; }
      });
      if (hasUtm) {
        utmData._landing = window.location.pathname;
        utmData._referrer = document.referrer || '';
        utmData._timestamp = Date.now();
        sessionStorage.setItem(UTM_STORAGE_KEY, JSON.stringify(utmData));
      }
    } catch (e) { /* ignore */ }
  }

  function getStoredUtm() {
    try {
      const raw = sessionStorage.getItem(UTM_STORAGE_KEY);
      return raw ? JSON.parse(raw) : {};
    } catch { return {}; }
  }

  saveUtmFromUrl();

  document.addEventListener('DOMContentLoaded', function() {
    const forms = document.querySelectorAll('.quote-form-v2');
    if (!forms.length) return;

    const storedUtm = getStoredUtm();

    forms.forEach(form => {
      const lang = form.dataset.lang === 'zh' ? 'zh' : 'en';
      const isZh = lang === 'zh';

      // Fill UTM from stored data
      UTM_FIELDS.forEach(field => {
        const input = form.querySelector(`input[name="${field}"]`);
        if (input && storedUtm[field]) input.value = storedUtm[field];
      });
      const landingInput = form.querySelector('input[name="landing_page"]');
      if (landingInput) landingInput.value = storedUtm._landing || window.location.pathname;
      const referrerInput = form.querySelector('input[name="referrer"]');
      if (referrerInput) referrerInput.value = storedUtm._referrer || document.referrer || '';
      const sourceInput = form.querySelector('input[name="source_page"]');
      if (sourceInput) sourceInput.value = window.location.pathname;

      // Path switch
      const pathBtns = form.querySelectorAll('.form-path-btn');
      const panels = form.querySelectorAll('.form-path-panel');
      const submitBtn = form.querySelector('.btn-submit-full');
      const successEl = form.querySelector('.form-success');
      const errorEl = form.querySelector('.form-error');

      pathBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const path = this.dataset.path;
          pathBtns.forEach(b => {
            b.classList.toggle('active', b === this);
            b.setAttribute('aria-selected', b === this ? 'true' : 'false');
          });
          panels.forEach(p => p.classList.toggle('active', p.dataset.panel === path));
          form.querySelector('input[name="active_path"]').value = path;
          if (submitBtn) {
            submitBtn.textContent = path === 'drawings'
              ? submitBtn.dataset.submitText
              : submitBtn.dataset.submitTextNodrawings;
          }
          // Clear errors
          form.querySelectorAll('.field-error').forEach(e => e.textContent = '');
          form.querySelectorAll('.form-field.error').forEach(f => f.classList.remove('error'));
          if (errorEl) { errorEl.textContent = ''; errorEl.classList.remove('show'); }
        });
      });

      // File upload
      const uploadArea = form.querySelector('.upload-area');
      const fileInput = form.querySelector('input[type="file"]');
      if (uploadArea && fileInput) {
        uploadArea.addEventListener('click', () => fileInput.click());
        uploadArea.addEventListener('dragover', (e) => { e.preventDefault(); uploadArea.classList.add('dragover'); });
        uploadArea.addEventListener('dragleave', () => uploadArea.classList.remove('dragover'));
        uploadArea.addEventListener('drop', (e) => {
          e.preventDefault();
          uploadArea.classList.remove('dragover');
          if (e.dataTransfer.files.length) {
            fileInput.files = e.dataTransfer.files;
            updateUploadText();
          }
        });
        fileInput.addEventListener('change', updateUploadText);

        function updateUploadText() {
          const placeholder = uploadArea.querySelector('.upload-text');
          if (placeholder && fileInput.files.length) {
            const names = Array.from(fileInput.files).map(f => f.name).join(', ');
            placeholder.textContent = names.length > 60 ? names.substring(0, 60) + '...' : names;
          }
        }
      }

      // Validate
      function validate() {
        let isValid = true;
        const activePath = form.querySelector('.form-path-panel.active').dataset.panel;

        form.querySelectorAll('.field-error').forEach(e => e.textContent = '');
        form.querySelectorAll('.form-field').forEach(f => f.classList.remove('error'));

        const requiredFields = [
          { name: 'name', msg: isZh ? '请输入姓名' : 'Please enter your name' },
          { name: 'phone_code', msg: isZh ? '请选择国家区号' : 'Please select country / calling code' },
          { name: 'phone', msg: isZh ? '请输入WhatsApp或电话' : 'Please enter WhatsApp or phone' },
          { name: 'wechat', msg: isZh ? '请输入微信号' : 'Please enter WeChat ID' },
          { name: 'country', msg: isZh ? '请输入项目所在国家' : 'Please enter the project country' },
        ];

        requiredFields.forEach(field => {
          const input = form.querySelector(`[name="${field.name}"]`);
          if (!input) return;
          if (!input.value.trim()) {
            isValid = false;
            const errorEl = form.querySelector(`[data-error-for="${field.name}"]`);
            if (errorEl) errorEl.textContent = field.msg;
            input.closest('.form-field')?.classList.add('error');
          }
        });

        const emailInput = form.querySelector('[name="email"]');
        if (emailInput && emailInput.value.trim()) {
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)) {
            isValid = false;
            const errorEl = form.querySelector('[data-error-for="email"]');
            if (errorEl) errorEl.textContent = isZh ? '请输入有效邮箱' : 'Please enter a valid email';
            emailInput.closest('.form-field')?.classList.add('error');
          }
        }

        if (activePath === 'nodrawings') {
          const buildingType = form.querySelector('[name="projectType"]');
          if (buildingType && !buildingType.value) {
            isValid = false;
            const errorEl = form.querySelector('[data-error-for="projectType"]');
            if (errorEl) errorEl.textContent = isZh ? '请选择项目类型' : 'Please select project type';
            buildingType.closest('.form-field')?.classList.add('error');
          }
          const intendedUse = form.querySelector('[name="intendedUse"]');
          if (intendedUse && !intendedUse.value.trim()) {
            isValid = false;
            const errorEl = form.querySelector('[data-error-for="intendedUse"]');
            if (errorEl) errorEl.textContent = isZh ? '请输入项目用途' : 'Please enter intended use';
            intendedUse.closest('.form-field')?.classList.add('error');
          }
        }

        if (!isValid) {
          const firstError = form.querySelector('.form-field.error');
          if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return isValid;
      }

      // Show error
      function showError(msg) {
        if (errorEl) {
          errorEl.textContent = msg;
          errorEl.classList.add('show');
          errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

      // Show success
      function showSuccess(title, msg) {
        if (successEl) {
          successEl.innerHTML = `<strong>${title}</strong><br>${msg}`;
          successEl.classList.add('show');
          successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        // Hide form fields
        form.querySelectorAll('.form-path-switch, .form-grid, .form-field, .form-path-panel, .turnstile-wrapper, .btn-submit-full, .form-privacy, .hp-field').forEach(el => {
          el.style.display = 'none';
        });
      }

      // Submit
      form.addEventListener('submit', async function(e) {
        e.preventDefault();

        // Prevent duplicate submissions from rapid clicks, Enter key, or repeated callbacks.
        if (form.dataset.submitting === 'true') return;

        // Clear previous messages
        if (errorEl) { errorEl.textContent = ''; errorEl.classList.remove('show'); }
        if (successEl) { successEl.textContent = ''; successEl.classList.remove('show'); }

        if (!validate()) return;

        // Check file sizes
        if (fileInput && fileInput.files.length) {
          for (const file of fileInput.files) {
            if (file.size > MAX_FILE_SIZE) {
              showError(isZh ? '文件过大，单文件最大25MB。' : 'File too large. Max 25MB per file.');
              return;
            }
          }
        }

        // Get Turnstile token
        const turnstileWidget = form.querySelector('.cf-turnstile');
        let turnstileToken = '';
        if (turnstileWidget) {
          turnstileToken = turnstileWidget.dataset.token || '';
          // Also try window.turnstile.getResponse
          if (!turnstileToken && window.turnstile && turnstileWidget.dataset.widgetId) {
            try {
              turnstileToken = window.turnstile.getResponse(turnstileWidget.dataset.widgetId);
            } catch { /* ignore */ }
          }
        }
        if (!turnstileToken) {
          showError(isZh ? '请完成安全验证' : 'Please complete the security verification.');
          return;
        }

        // Build FormData
        const formData = new FormData(form);
        formData.append('cf-turnstile-response', turnstileToken);
        formData.append('referrer', document.referrer || '');

        // Submitting state
        const originalText = submitBtn.textContent;
        form.dataset.submitting = 'true';
        submitBtn.disabled = true;
        submitBtn.textContent = isZh ? '提交中...' : 'Submitting...';
        submitBtn.classList.add('submitting');

        try {
          const response = await fetch(API_ENDPOINT, {
            method: 'POST',
            body: formData,
          });

          const result = await response.json();

          if (result.success && result.lead_id && result.lead_id !== 'filtered') {
            // Success - trigger GA4 generate_lead (NO PII)
            const activePath = form.querySelector('input[name="active_path"]').value;
            if (typeof window.trackLeadConversion === 'function') {
              window.trackLeadConversion({
                lead_id: result.lead_id,
                language: lang,
                form_variant: activePath === 'drawings' ? 'have_drawings' : 'no_drawings',
                source_page: window.location.pathname,
                utm_source: form.querySelector('[name="utm_source"]')?.value || '',
                utm_medium: form.querySelector('[name="utm_medium"]')?.value || '',
                utm_campaign: form.querySelector('[name="utm_campaign"]')?.value || '',
                has_file: fileInput && fileInput.files.length > 0,
              });
            }

            showSuccess(
              isZh ? '项目需求已提交' : 'Project inquiry received',
              result.message || (isZh
                ? '感谢您的提交。中赛钢构将根据您提供的项目资料进行审核，并通过您填写的联系方式进行后续沟通。'
                : 'Thank you. ZhongSai will review the project information and follow up using the contact details you provided.')
            );
          } else if (result.success && result.lead_id === 'filtered') {
            // Honeypot filtered - silently show success (don't reveal it's a filter)
            showSuccess(
              isZh ? '项目需求已提交' : 'Project inquiry received',
              isZh ? '感谢您的提交。' : 'Thank you.'
            );
          } else {
            // Failure
            let msg = isZh ? '提交失败，请稍后重试。' : 'Submission failed. Please try again.';
            if (result.code === 'TURNSTILE_FAILED') msg = isZh ? '验证失败，请重新提交。' : 'Verification failed. Please try again.';
            else if (result.code === 'VALIDATION_ERROR') msg = isZh ? '请检查必填字段。' : 'Please check required fields.';
            else if (result.message) msg = result.message;
            showError(msg);

            // Reset Turnstile
            if (window.turnstile && turnstileWidget?.dataset.widgetId) {
              try { window.turnstile.reset(turnstileWidget.dataset.widgetId); } catch { /* ignore */ }
            }
          }
        } catch (err) {
          showError(isZh ? '网络错误，请稍后重试。' : 'Network error. Please try again.');
        } finally {
          delete form.dataset.submitting;
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
          submitBtn.classList.remove('submitting');
        }
      });
    });
  });
</script>

