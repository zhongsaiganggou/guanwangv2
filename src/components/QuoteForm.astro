const COUNTRIES = COUNTRY_CODES.filter(([iso]) => {
  if (_seenIso.has(iso)) return false;
  _seenIso.add(iso); return true;
}).map(([iso2, name_en, name_zh, calling_code]) => ({ iso2, name_en, name_zh, calling_code }));
---

{embed ? (
  <div class="quote-form-wrapper" id={id}>
    <h3>{texts.title}</h3>
    <p class="form-subtitle">{texts.subtitle}</p>
    <form class="quote-form quote-form-v2" id={`${id}-form`} novalidate data-lang={lang}>
      <div class="form-success" id={`${id}-success`} role="alert" aria-live="polite"></div>
      <div class="form-error" id={`${id}-error`} role="alert" aria-live="polite"></div>

      <div class="form-field">
        <label for={`${id}-building-type`}>{texts.buildingType}</label>
        <select id={`${id}-building-type`} name="projectType">
          {texts.buildingTypeOptions.map((opt, i) => {
            const val = typeof opt === 'string' ? opt : opt.value;
            const lab = typeof opt === 'string' ? opt : opt.label;
            return <option value={i === 0 ? '' : val}>{lab}</option>;
          })}
        </select>
        <span class="field-error" data-error-for="projectType"></span>
      </div>

      <div class="form-path-switch" role="tablist">
        <button type="button" class="form-path-btn active" data-path="drawings" role="tab" aria-selected="true">
          <span class="path-icon">01</span>
          <span class="path-text">{texts.tabDrawings}</span>
        </button>
        <button type="button" class="form-path-btn" data-path="nodrawings" role="tab" aria-selected="false">
          <span class="path-icon">02</span>
          <span class="path-text">{texts.tabNoDrawings}</span>
        </button>
      </div>

      <div class="form-grid form-grid-2">
        <div class="form-field">
          <label for={`${id}-name`}>{texts.name} <span class="req">*</span></label>
          <input type="text" id={`${id}-name`} name="name" required autocomplete="name" />
          <span class="field-error" data-error-for="name"></span>
        </div>
        <div class="form-field">
          <label for={`${id}-email`}>{texts.email}</label>
          <input type="email" id={`${id}-email`} name="email" autocomplete="email" />
          <span class="field-error" data-error-for="email"></span>
        </div>
      </div>

      <div class="form-grid form-grid-3">
        <div class="form-field">
          <label for={`${id}-phone-code`}>{texts.phoneCode} <span class="cond-hint">{texts.hintCode}</span></label>
          <div class="country-select" data-country-select>
            <input type="hidden" name="phone_code" value="" data-country-value />
            <button type="button" class="country-select-trigger" data-country-trigger aria-haspopup="listbox" aria-expanded="false">
              <span class="country-select-label" data-country-label>{lang === 'zh' ? '请选择国家区号' : 'Select country code'}</span>
              <svg class="country-select-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="country-select-dropdown" data-country-dropdown hidden>
              <input type="text" class="country-select-search" data-country-search placeholder={lang === 'zh' ? '搜索国家或区号' : 'Search country or code'} aria-label="Search" />
              <ul class="country-select-list" data-country-list role="listbox"></ul>
            </div>
          </div>
          <span class="field-error" data-error-for="phone_code"></span>
        </div>
        <div class="form-field">
          <label for={`${id}-phone`}>{texts.phone} <span class="cond-hint">{texts.hintPhone}</span></label>
          <input type="tel" id={`${id}-phone`} name="phone" autocomplete="tel" />
          <span class="field-error" data-error-for="phone"></span>
        </div>
        <div class="form-field">
          <label for={`${id}-wechat`}>{texts.wechat} <span class="req">*</span> <span class="cond-hint">{texts.hintWechat}</span></label>
          <input type="text" id={`${id}-wechat`} name="wechat" required placeholder={texts.wechatPlaceholder} />
          <span class="field-error" data-error-for="wechat"></span>
        </div>
      </div>

      <div class="form-field">
        <label for={`${id}-country`}>{texts.country} <span class="req">*</span></label>
        <input type="text" id={`${id}-country`} name="country" required />
        <span class="field-error" data-error-for="country"></span>
      </div>

      <div class="form-grid form-grid-2">
        <div class="form-field">
          <label for={`${id}-customer-type`}>{texts.customerType}</label>
          <select id={`${id}-customer-type`} name="customerType">
            {texts.customerTypeOptions.map((opt, i) => <option value={i === 0 ? '' : opt}>{opt}</option>)}
          </select>
        </div>
        <div class="form-field">
          <label for={`${id}-project-stage`}>{texts.projectStage}</label>
          <select id={`${id}-project-stage`} name="projectStage">
            {texts.projectStageOptions.map((opt, i) => <option value={i === 0 ? '' : opt}>{opt}</option>)}
          </select>
        </div>
      </div>

      <div class="form-path-panel active" data-panel="drawings">
        <div class="form-field form-upload">
          <label for={`${id}-drawing`}>{texts.drawingUpload}</label>
          <div class="upload-area">
