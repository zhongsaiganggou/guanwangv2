---
// MobileCTA.astro - Mobile bottom fixed CTA bar
const lang = Astro.props.lang || 'en';
const wecomUrl = 'https://work.weixin.qq.com/ca/cawcdecda02ad29b5c';

const texts = {
  en: {
    sendDrawings: 'Start Project',
    wechat: 'Contact Us',
  },
  zh: {
    sendDrawings: '提交项目需求',
    wechat: '立刻咨询',
  },
};

const t = texts[lang] || texts.en;
---

<div class="mobile-cta-bar" aria-label="快速联系">
  <a href={`/${lang}/contact/#quote-form`} class="mobile-cta-btn mobile-cta-primary">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
      <polyline points="17 8 12 3 7 8"/>
      <line x1="12" y1="3" x2="12" y2="15"/>
    </svg>
    <span>{t.sendDrawings}</span>
  </a>
  <a href={wecomUrl} target="_blank" rel="noopener noreferrer" class="mobile-cta-btn mobile-cta-secondary">
    <img src="/images/wecom-logo.png" alt="" width="20" height="20" aria-hidden="true" />
    <span>{t.wechat}</span>
  </a>
</div>

<style>
.mobile-cta-bar {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 89;
  padding: 10px 16px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(10px);
  border-top: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
  gap: 10px;
}

.mobile-cta-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 16px;
  border-radius: 10px;
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
  min-height: 44px;
  border: none;
  cursor: pointer;
  font-family: inherit;
}

.mobile-cta-primary {
  background: var(--primary, #0a3d62);
  color: #fff;
}

.mobile-cta-primary:active {
  background: var(--primary-dark, #082d4a);
  transform: scale(0.98);
}

.mobile-cta-secondary {
  background: rgba(10, 61, 98, 0.08);
  color: var(--primary, #0a3d62);
  border: 1px solid rgba(10, 61, 98, 0.15);
}

.mobile-cta-secondary:active {
  background: rgba(10, 61, 98, 0.12);
  transform: scale(0.98);
}

@media (max-width: 768px) {
  .mobile-cta-bar {
    display: flex;
  }
  body {
    padding-bottom: 70px;
  }
}

@media (min-width: 769px) {
  .mobile-cta-bar {
    display: none !important;
  }
}
</style>
