---
// MobileCTA.astro - Mobile bottom fixed CTA bar
// Two side-by-side buttons: WhatsApp (left) + WeCom (right).
const lang = Astro.props.lang || 'en';
const wecomUrl = 'https://work.weixin.qq.com/ca/cawcdecda02ad29b5c';
const whatsappUrl = lang === 'zh'
  ? 'https://wa.me/8613113270408?text=%E6%82%A8%E5%A5%BD%E4%B8%AD%E8%B5%9B%E9%92%A2%E6%9E%84%EF%BC%8C%E6%88%91%E6%9C%89%E4%B8%80%E4%B8%AA%E9%92%A2%E7%BB%93%E6%9E%84%E9%A1%B9%E7%9B%AE%EF%BC%8C%E6%83%B3%E6%B2%9F%E9%80%9A%E9%A1%B9%E7%9B%AE%E9%9C%80%E6%B1%82%E3%80%82'
  : 'https://wa.me/8613113270408?text=Hi%20ZhongSai%2C%20I%20have%20a%20steel%20structure%20project%20and%20would%20like%20to%20discuss%20the%20requirements.';

const texts = {
  en: { whatsapp: 'WhatsApp', wechat: 'WeChat' },
  zh: { whatsapp: 'WhatsApp', wechat: '微信' },
};

const t = texts[lang] || texts.en;
---

<div class="mobile-cta-bar" aria-label="快速联系">
  <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="mobile-cta-btn mobile-cta-whatsapp">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    <span>{t.whatsapp}</span>
  </a>
  <a href={wecomUrl} target="_blank" rel="noopener noreferrer" class="mobile-cta-btn mobile-cta-wechat">
    <img src="/images/wecom-logo.png" alt="" width="20" height="20" aria-hidden="true" />
    <span>{t.wechat}</span>
  </a>
</div>

<style>
.mobile-cta-bar {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 89;
  padding: 10px 16px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(10px);
  border-top: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
  gap: 10px;
}

.mobile-cta-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 16px;
  border-radius: 10px;
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
  min-height: 44px;
  border: none;
  cursor: pointer;
  font-family: inherit;
}

.mobile-cta-whatsapp {
  background: #25D366;
  color: #fff;
}

.mobile-cta-whatsapp:active {
  background: #128C7E;
  transform: scale(0.98);
}

.mobile-cta-wechat {
  background: #ffffff;
  color: #1f2937;
  border: 1px solid rgba(0, 0, 0, 0.12);
}

.mobile-cta-wechat:active {
  background: #f5f9ff;
  transform: scale(0.98);
}

@media (max-width: 768px) {
  .mobile-cta-bar {
    display: flex;
  }
  body {
    padding-bottom: 70px;
  }
}

@media (min-width: 769px) {
  .mobile-cta-bar {
    display: none !important;
  }
}
</style>
