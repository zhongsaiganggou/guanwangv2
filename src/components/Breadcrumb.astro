---
// Breadcrumb.astro - 统一面包屑导航组件（含Schema）
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  lang?: 'zh' | 'en';
}

const { items, lang = 'zh' } = Astro.props;
const siteUrl = 'https://zhongsai-steelstructure.com';
---

<nav class="breadcrumb" aria-label={lang === 'zh' ? '面包屑导航' : 'Breadcrumb'}>
  <div class="container">
    <ol itemscope itemtype="https://schema.org/BreadcrumbList">
      {items.map((item, index) => {
        const position = index + 1;
        return (
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            {item.href ? (
              <a href={item.href} itemprop="item">
                <span itemprop="name">{item.label}</span>
              </a>
            ) : (
              <span itemprop="name" aria-current="page">{item.label}</span>
            )}
            <meta itemprop="position" content={position} />
          </li>
        );
      })}
    </ol>
  </div>
</nav>
