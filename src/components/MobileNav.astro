---
// MobileNav.astro V3
interface Props {
  lang: 'zh' | 'en';
  currentPath: string;
  singleLanguage?: boolean;
}
const { lang, currentPath, singleLanguage = false } = Astro.props;

const solutions = lang === 'zh' ? [
  { label: '工业与制造建筑', href: '/zh/steel-workshop/' },
  { label: '仓储与物流建筑', href: '/zh/steel-warehouse/' },
  { label: '矿业能源与重工业', href: '/zh/steel-mining-factory/' },
  { label: '农业与养殖建筑', href: '/zh/agricultural-steel-buildings/' },
  { label: '商业与公共建筑', href: '/zh/commercial-public-steel-buildings/' },
  { label: '交通与基础设施', href: '/zh/transportation-infrastructure-steel/' },
  { label: '特种钢结构', href: '/zh/special-custom-steel-structures/' },
  { label: '构件与围护系统', href: '/zh/components/' },
] : [
  { label: 'Industrial & Manufacturing', href: '/en/steel-workshop/' },
  { label: 'Warehousing & Logistics', href: '/en/steel-warehouse/' },
  { label: 'Mining, Energy & Heavy Industry', href: '/en/steel-mining-factory/' },
  { label: 'Agriculture & Livestock', href: '/en/agricultural-steel-buildings/' },
  { label: 'Commercial & Public', href: '/en/commercial-public-steel-buildings/' },
  { label: 'Transportation & Infrastructure', href: '/en/transportation-infrastructure-steel/' },
  { label: 'Special Steel Structures', href: '/en/special-custom-steel-structures/' },
  { label: 'Components & Envelope', href: '/en/components/' },
];

const capabilities = lang === 'zh' ? [
  { label: '工程设计与深化', href: '/zh/engineering-design/' },
  { label: '制造与质量控制', href: '/zh/manufacturing-quality/' },
  { label: '出口交付', href: '/zh/export-delivery/' },
  { label: '安装技术支持', href: '/zh/installation-guidance/' },
] : [
  { label: 'Engineering & Detailing', href: '/en/engineering-design/' },
  { label: 'Manufacturing & Quality', href: '/en/manufacturing-quality/' },
  { label: 'Export Delivery', href: '/en/export-delivery/' },
  { label: 'Installation Technical Support', href: '/en/installation-guidance/' },
];

const simpleItems = lang === 'zh' ? [
  { label: '项目案例', href: '/zh/projects/' },
  { label: '资源中心', href: '/zh/resources/' },
  { label: '关于中赛', href: '/zh/about/' },
  { label: '联系我们', href: '/zh/contact/' },
] : [
  { label: 'Projects', href: '/en/projects/' },
  { label: 'Resources', href: '/en/resources/' },
  { label: 'About', href: '/en/about/' },
  { label: 'Contact', href: '/en/contact/' },
];

const otherLang = lang === 'zh' ? 'en' : 'zh';
const otherLangPath = currentPath.replace(`/${lang}/`, `/${otherLang}/`);
---

<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile" aria-hidden="true" inert>
  {/* Solutions expandable */}
  <div class="mobile-nav-expandable" data-expandable>
    <button class="mobile-nav-expand-trigger" type="button" aria-expanded="false">
      <span>{lang === 'zh' ? '解决方案' : 'Solutions'}</span>
      <svg class="expand-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>
    <div class="mobile-nav-submenu">
      {solutions.map(c => <a href={c.href} data-mobile-link>{c.label}</a>)}
    </div>
  </div>

  {simpleItems.map(item => <a href={item.href} data-mobile-link>{item.label}</a>)}

  {/* Capabilities expandable */}
  <div class="mobile-nav-expandable" data-expandable>
    <button class="mobile-nav-expand-trigger" type="button" aria-expanded="false">
      <span>{lang === 'zh' ? '能力' : 'Capabilities'}</span>
      <svg class="expand-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>
    <div class="mobile-nav-submenu">
      {capabilities.map(c => <a href={c.href} data-mobile-link>{c.label}</a>)}
    </div>
  </div>

  {!singleLanguage && <a href={otherLangPath} class="mobile-lang-switch" data-mobile-link>{lang === 'zh' ? 'English' : '中文'}</a>}
  <div class="mobile-cta">
    <a href={`/${lang}/contact/#quote-form`} class="btn btn-primary" data-mobile-link>
      {lang === 'zh' ? '提交项目图纸' : 'Send Project Drawings'}
    </a>
  </div>
</nav>

<script>
const toggle = document.getElementById('mobile-menu-toggle');
const mobileNav = document.getElementById('mobile-nav');
const body = document.body;
const isZH = document.documentElement.lang.startsWith('zh');
function closeMenu() {
  if (toggle) { toggle.setAttribute('aria-expanded','false'); toggle.setAttribute('aria-label', isZH?'打开菜单':'Open menu'); }
  if (mobileNav) { mobileNav.classList.remove('is-open'); mobileNav.setAttribute('aria-hidden','true'); mobileNav.setAttribute('inert',''); }
  body.classList.remove('menu-open');
  mobileNav?.querySelectorAll('[data-expandable]').forEach(item => {
    item.classList.remove('is-expanded');
    item.querySelector('.mobile-nav-expand-trigger')?.setAttribute('aria-expanded','false');
  });
}
function openMenu() {
  if (toggle) { toggle.setAttribute('aria-expanded','true'); toggle.setAttribute('aria-label', isZH?'关闭菜单':'Close menu'); }
  if (mobileNav) { mobileNav.classList.add('is-open'); mobileNav.removeAttribute('aria-hidden'); mobileNav.removeAttribute('inert'); }
  body.classList.add('menu-open');
}
if (toggle && mobileNav) {
  toggle.addEventListener('click', () => { toggle.getAttribute('aria-expanded')==='true' ? closeMenu() : openMenu(); });
  mobileNav.querySelectorAll('[data-expandable]').forEach(item => {
    item.querySelector('.mobile-nav-expand-trigger')?.addEventListener('click', e => {
      e.preventDefault(); e.stopPropagation();
      const isExp = item.classList.contains('is-expanded');
      mobileNav.querySelectorAll('[data-expandable]').forEach(o => {
        if (o!==item) { o.classList.remove('is-expanded'); o.querySelector('.mobile-nav-expand-trigger')?.setAttribute('aria-expanded','false'); }
      });
      item.classList.toggle('is-expanded');
      item.querySelector('.mobile-nav-expand-trigger')?.setAttribute('aria-expanded', !isExp);
    });
  });
  mobileNav.querySelectorAll('a[data-mobile-link]').forEach(l => l.addEventListener('click', closeMenu));
  document.addEventListener('keydown', e => { if(e.key==='Escape') closeMenu(); });
}
</script>

<style>
.mobile-nav-expandable { border-bottom: 1px solid var(--color-gray-100); }
.mobile-nav-expand-trigger {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; padding: 16px; font-size: 16px; font-weight: 500;
  color: var(--color-gray-700); background: transparent; border: none; cursor: pointer; text-align: left;
}
.expand-arrow { transition: transform .25s; flex-shrink: 0; opacity: .6; }
.mobile-nav-expandable.is-expanded .expand-arrow { transform: rotate(180deg); }
.mobile-nav-submenu { max-height: 0; overflow: hidden; transition: max-height .3s ease; background: var(--color-gray-50); }
.mobile-nav-expandable.is-expanded .mobile-nav-submenu { max-height: 800px; }
.mobile-nav-submenu a {
  display: block; padding: 12px 16px 12px 32px; font-size: 14.5px;
  color: var(--color-gray-600); text-decoration: none; border-left: 3px solid transparent;
}
.mobile-nav-submenu a:hover { color: var(--color-primary); background: var(--color-gray-100); border-left-color: var(--color-primary); }
.mobile-cta .btn-primary { color: #fff !important; }
@media (min-width: 1025px) { .mobile-nav { display: none !important; } }
</style>
