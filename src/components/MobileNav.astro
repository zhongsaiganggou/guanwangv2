---
// MobileNav.astro - 移动端导航组件（含二级展开菜单）
interface Props {
  lang: 'zh' | 'en';
  currentPath: string;
  singleLanguage?: boolean;
}

const { lang, currentPath, singleLanguage = false } = Astro.props;

const dropdownItems = lang === 'zh' ? {
  products: {
    label: '产品',
    href: '/zh/products/',
    children: [
      { label: '工业厂房与生产建筑', href: '/zh/steel-workshop/' },
      { label: '仓储与物流建筑', href: '/zh/steel-warehouse/' },
      { label: '农业与养殖建筑', href: '/zh/agricultural-steel-buildings/' },
      { label: '商业与公共建筑', href: '/zh/commercial-public-steel-buildings/' },
      { label: '交通与基础设施', href: '/zh/transportation-infrastructure-steel/' },
      { label: '矿业能源与重工业', href: '/zh/steel-mining-factory/' },
      { label: '特种钢结构', href: '/zh/special-custom-steel-structures/' },
    ]
  },
  components: {
    label: '构件与材料',
    href: '/zh/components/',
    children: [
      { label: '钢梁钢柱构件', href: '/zh/components/fabricated-steel-beams-columns/' },
      { label: '钢桁架', href: '/zh/components/steel-trusses/' },
      { label: '钢檩条', href: '/zh/components/steel-purlins/' },
      { label: '屋面墙面围护系统', href: '/zh/components/roof-wall-cladding-systems/' },
    ]
  },
  capabilities: {
    label: '服务能力',
    href: '/zh/manufacturing-quality/',
    children: [
      { label: '制造与质量控制', href: '/zh/manufacturing-quality/' },
      { label: '工程设计', href: '/zh/engineering-design/' },
      { label: '深化设计', href: '/zh/services/structural-steel-detailing/' },
      { label: '出口交付', href: '/zh/export-delivery/' },
      { label: '定制工程与按图加工', href: '/zh/products/custom-engineering/' },
    ]
  },
} : {
  products: {
    label: 'Products',
    href: '/en/products/',
    children: [
      { label: 'Industrial & Manufacturing', href: '/en/steel-workshop/' },
      { label: 'Warehousing & Logistics', href: '/en/steel-warehouse/' },
      { label: 'Agriculture & Livestock', href: '/en/agricultural-steel-buildings/' },
      { label: 'Commercial & Public', href: '/en/commercial-public-steel-buildings/' },
      { label: 'Transportation & Infrastructure', href: '/en/transportation-infrastructure-steel/' },
      { label: 'Mining, Energy & Heavy Industry', href: '/en/steel-mining-factory/' },
      { label: 'Special Steel Structures', href: '/en/special-custom-steel-structures/' },
    ]
  },
  components: {
    label: 'Components',
    href: '/en/components/',
    children: [
      { label: 'Fabricated Beams & Columns', href: '/en/components/fabricated-steel-beams-columns/' },
      { label: 'Steel Trusses', href: '/en/components/steel-trusses/' },
      { label: 'Steel Purlins', href: '/en/components/steel-purlins/' },
      { label: 'Roof & Wall Cladding', href: '/en/components/roof-wall-cladding-systems/' },
    ]
  },
  capabilities: {
    label: 'Capabilities',
    href: '/en/manufacturing-quality/',
    children: [
      { label: 'Manufacturing & Quality', href: '/en/manufacturing-quality/' },
      { label: 'Engineering Design', href: '/en/engineering-design/' },
      { label: 'Structural Steel Detailing', href: '/en/services/structural-steel-detailing/' },
      { label: 'Export Delivery', href: '/en/export-delivery/' },
      { label: 'Custom Engineering & Fabrication', href: '/en/products/custom-engineering/' },
    ]
  },
};

const simpleItems = lang === 'zh' ? [
  { label: '首页', href: '/zh/' },
  { label: '项目案例', href: '/zh/projects/' },
  { label: '技术资源', href: '/zh/resources/' },
  { label: '关于中赛', href: '/zh/about/' },
  { label: '联系我们', href: '/zh/contact/' },
] : [
  { label: 'Home', href: '/en/' },
  { label: 'Projects', href: '/en/projects/' },
  { label: 'Resources', href: '/en/resources/' },
  { label: 'About', href: '/en/about/' },
  { label: 'Contact', href: '/en/contact/' },
];

const otherLang = lang === 'zh' ? 'en' : 'zh';
const otherLangPath = currentPath.replace(`/${lang}/`, `/${otherLang}/`);
---

<nav class="mobile-nav" id="mobile-nav" aria-label={lang === 'zh' ? '移动端导航' : 'Mobile navigation'} aria-hidden="true" inert>
  {simpleItems.map(item => (
    <a href={item.href} data-mobile-link>{item.label}</a>
  ))}

  {/* Products expandable */}
  <div class="mobile-nav-expandable" data-expandable>
    <button class="mobile-nav-expand-trigger" type="button" aria-expanded="false">
      <span>{dropdownItems.products.label}</span>
      <svg class="expand-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>
    <div class="mobile-nav-submenu">
      <a href={dropdownItems.products.href} data-mobile-link class="mobile-nav-submenu-all">
        {lang === 'zh' ? '全部产品' : 'All Products'}
      </a>
      {dropdownItems.products.children.map(child => (
        <a href={child.href} data-mobile-link>{child.label}</a>
      ))}
    </div>
  </div>

  {/* Components expandable */}
  <div class="mobile-nav-expandable" data-expandable>
    <button class="mobile-nav-expand-trigger" type="button" aria-expanded="false">
      <span>{dropdownItems.components.label}</span>
      <svg class="expand-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>
    <div class="mobile-nav-submenu">
      <a href={dropdownItems.components.href} data-mobile-link class="mobile-nav-submenu-all">
        {lang === 'zh' ? '全部构件' : 'All Components'}
      </a>
      {dropdownItems.components.children.map(child => (
        <a href={child.href} data-mobile-link>{child.label}</a>
      ))}
    </div>
  </div>

  {/* Capabilities expandable */}
  <div class="mobile-nav-expandable" data-expandable>
    <button class="mobile-nav-expand-trigger" type="button" aria-expanded="false">
      <span>{dropdownItems.capabilities.label}</span>
      <svg class="expand-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>
    <div class="mobile-nav-submenu">
      {dropdownItems.capabilities.children.map(child => (
        <a href={child.href} data-mobile-link>{child.label}</a>
      ))}
    </div>
  </div>

  {!singleLanguage && (
    <a href={otherLangPath} class="mobile-lang-switch" data-mobile-link>
      {lang === 'zh' ? 'English' : '中文'}
    </a>
  )}
  <div class="mobile-cta">
    <a href={`/${lang}/contact/#quote-form`} class="btn btn-primary" data-mobile-link>
      {lang === 'zh' ? '获取报价' : 'Get a Quote'}
    </a>
  </div>
</nav>

<script>
  // 移动端菜单切换逻辑
  const toggle = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const body = document.body;
  const isZH = document.documentElement.lang.startsWith('zh');

  function closeMenu() {
    if (toggle) {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', isZH ? '打开菜单' : 'Open menu');
    }
    if (mobileNav) {
      mobileNav.classList.remove('is-open');
      mobileNav.setAttribute('aria-hidden', 'true');
      mobileNav.setAttribute('inert', '');
    }
    body.classList.remove('menu-open');
    // Close all expandable submenus
    mobileNav?.querySelectorAll('[data-expandable]').forEach(item => {
      item.classList.remove('is-expanded');
      const trigger = item.querySelector('.mobile-nav-expand-trigger');
      trigger?.setAttribute('aria-expanded', 'false');
    });
  }

  function openMenu() {
    if (toggle) {
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', isZH ? '关闭菜单' : 'Close menu');
    }
    if (mobileNav) {
      mobileNav.classList.add('is-open');
      mobileNav.removeAttribute('aria-hidden');
      mobileNav.removeAttribute('inert');
    }
    body.classList.add('menu-open');
  }

  if (toggle && mobileNav) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // 二级展开菜单切换
    mobileNav.querySelectorAll('[data-expandable]').forEach(item => {
      const trigger = item.querySelector('.mobile-nav-expand-trigger');
      trigger?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isExpanded = item.classList.contains('is-expanded');
        // Close all other expandable
        mobileNav.querySelectorAll('[data-expandable]').forEach(other => {
          if (other !== item) {
            other.classList.remove('is-expanded');
            other.querySelector('.mobile-nav-expand-trigger')?.setAttribute('aria-expanded', 'false');
          }
        });
        if (isExpanded) {
          item.classList.remove('is-expanded');
          trigger.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-expanded');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // 点击导航链接后关闭菜单
    mobileNav.querySelectorAll('a[data-mobile-link]').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // ESC键关闭菜单
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  }
</script>

<style>
.mobile-nav-expandable {
  border-bottom: 1px solid var(--color-gray-100);
}

.mobile-nav-expand-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 16px 16px;
  font-size: 16px;
  font-weight: 500;
  color: var(--color-gray-700);
  background: transparent;
  border: none;
  cursor: pointer;
  text-align: left;
}

.mobile-nav-expand-trigger:hover {
  color: var(--color-primary);
  background: var(--color-gray-50);
}

.expand-arrow {
  transition: transform 0.25s;
  flex-shrink: 0;
  opacity: 0.6;
}

.mobile-nav-expandable.is-expanded .expand-arrow {
  transform: rotate(180deg);
}

.mobile-nav-submenu {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background: var(--color-gray-50);
}

.mobile-nav-expandable.is-expanded .mobile-nav-submenu {
  max-height: 600px;
}

.mobile-nav-submenu a {
  display: block;
  padding: 12px 16px 12px 32px;
  font-size: 14.5px;
  font-weight: 400;
  color: var(--color-gray-600);
  text-decoration: none;
  border-left: 3px solid transparent;
  border-bottom: none;
}

.mobile-nav-submenu a:hover {
  color: var(--color-primary);
  background: var(--color-gray-100);
  border-left-color: var(--color-primary);
}

.mobile-nav-submenu-all {
  font-weight: 600 !important;
  color: var(--color-gray-800) !important;
  padding-top: 14px !important;
}

/* Ensure CTA button text is white on blue background */
.mobile-cta .btn-primary {
  color: #ffffff !important;
}

/* Responsive: hide mobile nav above 1024px (match global.css breakpoint) */
@media (min-width: 1025px) {
  .mobile-nav {
    display: none !important;
  }
}
</style>
