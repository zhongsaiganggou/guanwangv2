---
// Analytics.astro - GA4 only
// Meta Pixel (browser-side) removed 2026-11-12 by request: website events are no
// longer wanted in the Meta dataset. Website form leads are still reported server
// side via Conversions API in functions/api/project-inquiry.js.
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || '';

// 第一层：构建环境识别（构建期静态确定）
const isDev = import.meta.env.DEV === true;
const buildPreview = import.meta.env.PUBLIC_IS_PREVIEW === 'true';
// CF_PAGES_BRANCH 无 PUBLIC_ 前缀，Vite 不会暴露给前端，故在 Node 构建期经 process.env 读取
const cfBranch = process.env.CF_PAGES_BRANCH || '';
---

{/* 构建期配置：由同步内联脚本最早写入，供后续模块读取（不依赖 gtag） */}
<script is:inline define:vars={{ measurementId, isDev, buildPreview, cfBranch }}>
  window.__GA_BUILD__ = {
    measurementId: measurementId,
    isDev: isDev === true,
    isPreview: buildPreview === true,
    cfBranch: cfBranch || '',
  };
</script>

<script>
  // 第二层：运行时判定。单一权威逻辑来自 ga4-env.js（与 Node 回归测试共用）。
  import { shouldLoadGa4 } from '../scripts/ga4-env.js';

  const build = window.__GA_BUILD__ || { measurementId: '', isDev: false, isPreview: false, cfBranch: '' };
  const hostname = window.location.hostname;

  // DEFAULT DENY：仅当构建期无任何非生产信号、且 hostname 精确命中生产允许列表时才放行
  const allow = shouldLoadGa4({
    hostname: hostname,
    isDev: build.isDev,
    isPreview: build.isPreview,
    cfBranch: build.cfBranch,
  }) === true;

  // 暴露标志，保持与历史 __IS_PREVIEW__ 语义兼容（非生产即为 true）
  window.__GA4_ALLOWED__ = allow;
  window.__IS_PREVIEW__ = !allow;

  if (allow && build.measurementId) {
    // 仅在确认生产环境后才初始化 gtag；非生产环境永远不会加载 gtag.js
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };

    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + build.measurementId;
    document.head.appendChild(s);

    gtag('js', new Date());
    gtag('config', build.measurementId, {
      anonymize_ip: true,
      send_page_view: true,
    });
  }

  // Unified GA4 event helper — no PII. 非生产或 gtag 不存在时安全 no-op，不抛错。
  window.trackEvent = function (name, params) {
    if (!window.__GA4_ALLOWED__) return;
    if (typeof window.gtag !== 'function') return;
    const p = params || {};
    p.page_path = p.page_path || location.pathname;
    window.gtag('event', name, p);
  };

  // GA4 generate_lead conversion helper. 非生产安全 no-op。
  window.trackLeadConversion = function (params) {
    if (!window.__GA4_ALLOWED__) return;
    if (typeof window.gtag !== 'function') return;
    if (!params || !params.lead_id) return;

    if (window._trackedLeadIds && window._trackedLeadIds.has(params.lead_id)) return;
    window._trackedLeadIds = window._trackedLeadIds || new Set();
    window._trackedLeadIds.add(params.lead_id);

    const baseParams = {
      language: params.language || 'en',
      form_variant: params.form_variant || 'unknown',
      page_path: params.source_page || location.pathname,
      has_drawing: params.has_file === true,
    };

    // Standard GA4 recommended event (maps to Lead conversion)
    window.gtag('event', 'generate_lead', Object.assign({
      currency: 'USD',
      value: 0,
    }, baseParams));

    // Custom business event for funnel analysis
    window.gtag('event', 'project_form_submit', baseParams);

    // Drawing upload tracked as secondary event
    if (params.has_file === true) {
      window.gtag('event', 'drawing_upload', baseParams);
    }
  };

  // Global outbound click tracking — 仅生产环境注册，no PII。
  if (window.__GA4_ALLOWED__) {
    document.addEventListener('click', function (e) {
      const link = e.target.closest('a');
      if (!link || !link.href) return;
      const href = link.href;

      const isWA = href.indexOf('wa.me/') !== -1 || href.indexOf('whatsapp:') === 0 || href.indexOf('api.whatsapp.com') !== -1;
      const isWX = href.indexOf('weixin.qq.com') !== -1 || href.indexOf('weixin://') === 0 || href.indexOf('wechat') !== -1;

      // Resolve where the click happened from actual DOM context.
      let ctaLocation = 'other';
      if (link.closest('footer')) ctaLocation = 'footer';
      else if (link.closest('.floating-social') || link.closest('.floating-buttons') || link.closest('[class*="floating"]')) ctaLocation = 'floating';
      else if (link.closest('.mobile-cta-bar')) ctaLocation = 'mobile_cta';
      else if (link.closest('.contact-card')) ctaLocation = 'contact_card';
      else if (link.closest('.hero') || link.closest('.hub-hero') || link.closest('.page-hero')) ctaLocation = 'hero';
      else if (link.closest('.related-card') || link.closest('.related-grid') || link.closest('.legacy-related')) ctaLocation = 'related';
      else if (link.closest('.trust-item') || link.closest('.contact-method')) ctaLocation = 'trust';
      else if (location.pathname.indexOf('thank-you') !== -1) ctaLocation = 'thank_you';
      else if (link.closest('.contact-cards') || link.closest('.contact-page')) ctaLocation = 'contact_page';

      const base = {
        cta_location: ctaLocation,
        page_language: document.documentElement.lang || 'en',
        page_location: location.href,
      };

      // Explicit per-link event override (e.g. footer phone / Facebook):
      // fire the named event once and stop, so the link is not double-counted
      // by the automatic channel classification below.
      const explicitEvent = link.getAttribute('data-ga-event');
      if (explicitEvent) {
        window.trackEvent(explicitEvent, Object.assign({}, base, {
          cta_text: (link.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 80) || link.hostname,
          destination: link.hostname,
        }));
        return;
      }

      if (isWA) {
        window.trackEvent('contact_whatsapp_click', Object.assign({}, base, {
          cta_text: (link.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 80) || 'WhatsApp',
          destination: href.indexOf('api.whatsapp.com') !== -1 ? 'api.whatsapp.com' : 'wa.me',
        }));
      } else if (isWX) {
        window.trackEvent('contact_wechat_click', Object.assign({}, base, {
          cta_text: (link.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 80) || 'WeChat',
          destination: 'weixin',
        }));
      } else if (href.indexOf('mailto:') === 0) {
        window.trackEvent('contact_email_click', Object.assign({}, base, {
          cta_text: (link.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 80) || 'Email',
          destination: 'mailto',
        }));
      } else if (href.indexOf('tel:') === 0) {
        window.trackEvent('phone_click', Object.assign({}, base, {
          cta_text: (link.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 80) || 'Phone',
          destination: 'tel',
        }));
      }
    }, true);
  }
</script>
