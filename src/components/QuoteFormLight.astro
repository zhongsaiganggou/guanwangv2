---

<form id={id} class="quote-form-light" novalidate>
  <h2 class="form-title">{texts.title}</h2>
  <p class="form-subtitle">{texts.subtitle}</p>

  <div class="form-group">
    <label for={`${id}-phone`}>{texts.phone}</label>
    <input
      type="tel"
      id={`${id}-phone`}
      name="phone"
      placeholder={texts.phonePlaceholder}
    />
  </div>

  <div class="form-group">
    <label for={`${id}-buildingType`}>{texts.buildingType}</label>
    <select
      id={`${id}-buildingType`}
      name="building_type"
      required
    >
      {texts.buildingTypeOptions.map(opt => {
        if (typeof opt === 'string') {
          return <option value={opt === '请选择' || opt === 'Please select' ? '' : opt}>{opt}</option>;
        }
        return <option value={opt.value}>{opt.label}</option>;
      })}
    </select>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for={`${id}-name`}>{texts.name}</label>
      <input
        type="text"
        id={`${id}-name`}
        name="name"
        placeholder={texts.namePlaceholder}
      />
    </div>

    <div class="form-group">
      <label for={`${id}-email`}>{texts.email}</label>
      <input
        type="email"
        id={`${id}-email`}
        name="email"
        placeholder={texts.emailPlaceholder}
      />
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for={`${id}-wechat`}>{texts.wechat}</label>
      <input
        type="text"
        id={`${id}-wechat`}
        name="wechat"
        placeholder={texts.wechatPlaceholder}
      />
    </div>

    <div class="form-group">
      <label for={`${id}-country`}>{texts.country}</label>
      <select
        id={`${id}-country`}
        name="country"
      >
        <option value="">{texts.countryPlaceholder}</option>
        {(lang === 'zh' ? COUNTRIES_ZH : COUNTRIES).map(c => (
          <option value={c}>{c}</option>
        ))}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label for={`${id}-message`}>{texts.message}</label>
    <textarea
      id={`${id}-message`}
      name="message"
      rows="3"
      placeholder={texts.messagePlaceholder}
    ></textarea>
  </div>

  <TurnstileWidget id={`${id}-turnstile`} lang={lang} />

  <div class="form-error" id={`${id}-error`} style="display: none;"></div>

  <button type="submit" class="btn btn-primary btn-large btn-submit" id={`${id}-submit`}>
    {texts.submit}
  </button>

  <p class="form-privacy">{texts.privacyNote}</p>
</form>

<div class="form-success" id={`${id}-success`} style="display: none;">
  <div class="success-icon">✓</div>
  <h3>{texts.successTitle}</h3>
  <p>{texts.successMsg}</p>
</div>

<script>
  const form = document.getElementById('{id}') as HTMLFormElement;
  const successDiv = document.getElementById('{id}-success') as HTMLElement;
  const errorDiv = document.getElementById('{id}-error') as HTMLElement;
  const submitBtn = document.getElementById('{id}-submit') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorDiv.style.display = 'none';

      // At least one contact channel is required: WhatsApp/phone, WeChat, or email.
      const phoneVal = (form.querySelector('[name="phone"]') as HTMLInputElement).value.trim();
      const wechatVal = (form.querySelector('[name="wechat"]') as HTMLInputElement).value.trim();
      const emailVal = (form.querySelector('[name="email"]') as HTMLInputElement).value.trim();
      if (!phoneVal && !wechatVal && !emailVal) {
        errorDiv.textContent = '{texts.requiredContact}';
        errorDiv.style.display = 'block';
        errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = '{texts.submitting}';

      const formData = new FormData(form);
      const data: Record<string, string> = {};
      formData.forEach((value, key) => {
        data[key] = value.toString();
      });

      // Add language
      data.language = '{lang}';

      // Get Turnstile token
      const turnstileResponse = form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement;
      if (turnstileResponse) {
        data['cf-turnstile-response'] = turnstileResponse.value;
      }

      try {
        const response = await fetch('/api/project-inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (result.success) {
          form.style.display = 'none';
          successDiv.style.display = 'block';
        } else {
          errorDiv.textContent = result.message || '{texts.errorServer}';
          errorDiv.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.textContent = '{texts.submit}';
        }
      } catch (err) {
        errorDiv.textContent = '{texts.errorNetwork}';
        errorDiv.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.textContent = '{texts.submit}';
      }
    });
  }
</script>

<style>
  .quote-form-light {
    max-width: 500px;
    margin: 0 auto;
    padding: 32px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }
  .form-title {
    font-size: 1.5rem;
    margin: 0 0 8px;
    text-align: center;
  }
  .form-subtitle {
    font-size: 0.95rem;
    color: #666;
    text-align: center;
    margin: 0 0 24px;
  }
  .form-group {
    margin-bottom: 16px;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .form-group label {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 6px;
    color: #333;
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 0.95rem;
    box-sizing: border-box;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }
  .form-error {
    background: #fee;
    color: #c00;
    padding: 12px;
    border-radius: 6px;
    margin: 16px 0;
    font-size: 0.9rem;
  }
  .btn-submit {
    width: 100%;
    margin-top: 8px;
  }
  .form-privacy {
    font-size: 0.8rem;
    color: #999;
    text-align: center;
    margin: 16px 0 0;
  }
  .form-success {
    max-width: 500px;
    margin: 0 auto;
    padding: 48px 32px;
    background: #fff;
    border-radius: 12px;
    text-align: center;
  }
  .success-icon {
    width: 64px;
    height: 64px;
    background: #d4edda;
    color: #28a745;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    margin: 0 auto 16px;
  }
  @media (max-width: 768px) {
    .quote-form-light {
      padding: 24px 20px;
    }
    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
