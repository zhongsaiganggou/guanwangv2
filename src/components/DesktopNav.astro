---
// DesktopNav.astro V3
interface Props {
  lang: 'zh' | 'en';
  currentPath: string;
}
const { lang, currentPath } = Astro.props;

const solutions = lang === 'zh' ? [
  { label: '工业与制造建筑', href: '/zh/steel-workshop/' },
  { label: '仓储与物流建筑', href: '/zh/steel-warehouse/' },
  { label: '矿业能源与重工业', href: '/zh/steel-mining-factory/' },
  { label: '农业与养殖建筑', href: '/zh/agricultural-steel-buildings/' },
  { label: '商业与公共建筑', href: '/zh/commercial-public-steel-buildings/' },
  { label: '交通与基础设施', href: '/zh/transportation-infrastructure-steel/' },
  { label: '特种钢结构', href: '/zh/special-custom-steel-structures/' },
] : [
  { label: 'Industrial & Manufacturing', href: '/en/steel-workshop/' },
  { label: 'Warehousing & Logistics', href: '/en/steel-warehouse/' },
  { label: 'Mining, Energy & Heavy Industry', href: '/en/steel-mining-factory/' },
  { label: 'Agriculture & Livestock', href: '/en/agricultural-steel-buildings/' },
  { label: 'Commercial & Public', href: '/en/commercial-public-steel-buildings/' },
  { label: 'Transportation & Infrastructure', href: '/en/transportation-infrastructure-steel/' },
  { label: 'Special Steel Structures', href: '/en/special-custom-steel-structures/' },
];

const components = lang === 'zh' ? [
  { label: '钢梁钢柱构件', href: '/zh/components/fabricated-steel-beams-columns/' },
  { label: '钢桁架', href: '/zh/components/steel-trusses/' },
  { label: '钢檩条', href: '/zh/components/steel-purlins/' },
  { label: '屋面墙面围护系统', href: '/zh/components/roof-wall-cladding-systems/' },
] : [
  { label: 'Fabricated Beams & Columns', href: '/en/components/fabricated-steel-beams-columns/' },
  { label: 'Steel Trusses', href: '/en/components/steel-trusses/' },
  { label: 'Steel Purlins', href: '/en/components/steel-purlins/' },
  { label: 'Roof & Wall Cladding', href: '/en/components/roof-wall-cladding-systems/' },
];

const capabilities = lang === 'zh' ? [
  { label: '工程设计与深化', href: '/zh/engineering-design/' },
  { label: '制造与质量控制', href: '/zh/manufacturing-quality/' },
  { label: '出口交付', href: '/zh/export-delivery/' },
  { label: '安装技术支持', href: '/zh/installation-guidance/' },
] : [
  { label: 'Engineering & Detailing', href: '/en/engineering-design/' },
  { label: 'Manufacturing & Quality', href: '/en/manufacturing-quality/' },
  { label: 'Export Delivery', href: '/en/export-delivery/' },
  { label: 'Installation Technical Support', href: '/en/installation-guidance/' },
];

const simpleItems = lang === 'zh' ? [
  { label: '项目案例', href: '/zh/projects/' },
  { label: '资源中心', href: '/zh/resources/' },
  { label: '关于中赛', href: '/zh/about/' },
  { label: '联系我们', href: '/zh/contact/' },
] : [
  { label: 'Projects', href: '/en/projects/' },
  { label: 'Resources', href: '/en/resources/' },
  { label: 'About', href: '/en/about/' },
  { label: 'Contact', href: '/en/contact/' },
];

function isActive(href: string, currentPath: string): boolean {
  if (href.endsWith('/')) return currentPath === href || currentPath.startsWith(href) && href !== `/${lang}/`;
  return currentPath === href || currentPath.startsWith(href + '/');
}
function isDropdownActive(children: {href: string}[], currentPath: string): boolean {
  return children.some(c => isActive(c.href, currentPath));
}
---

<nav class="desktop-nav" aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}>
  {/* Solutions dropdown */}
  <div class:list={['nav-dropdown', { active: isDropdownActive(solutions, currentPath) || isDropdownActive(components, currentPath) }]}>
    <a href="#" class="nav-dropdown-trigger">{lang === 'zh' ? '解决方案' : 'Solutions'}</a>
    <div class="nav-dropdown-menu nav-dropdown-wide">
      <div class="dropdown-col">
        {solutions.map(c => <a href={c.href} class:list={{active: isActive(c.href, currentPath)}}>{c.label}</a>)}
      </div>
      <div class="dropdown-divider"></div>
      <div class="dropdown-col">
        <div class="dropdown-section-label">{lang === 'zh' ? '构件与围护系统' : 'Components & Envelope'}</div>
        {components.map(c => <a href={c.href} class:list={{active: isActive(c.href, currentPath)}}>{c.label}</a>)}
      </div>
    </div>
  </div>

  {/* Simple items */}
  {simpleItems.map(item => (
    <a href={item.href} class:list={{active: isActive(item.href, currentPath)}}>{item.label}</a>
  ))}

  {/* Capabilities dropdown */}
  <div class:list={['nav-dropdown', { active: isDropdownActive(capabilities, currentPath) }]}>
    <a href="#" class="nav-dropdown-trigger">{lang === 'zh' ? '能力' : 'Capabilities'}</a>
    <div class="nav-dropdown-menu">
      {capabilities.map(c => <a href={c.href} class:list={{active: isActive(c.href, currentPath)}}>{c.label}</a>)}
    </div>
  </div>
</nav>

<style>
.desktop-nav { display: flex; align-items: center; gap: 2px; }
.desktop-nav > a, .nav-dropdown-trigger {
  display: flex; align-items: center; gap: 4px;
  padding: 8px 14px; font-size: 14px; font-weight: 500;
  color: #1f2937; text-decoration: none; border-radius: 4px;
  transition: color .2s; white-space: nowrap;
}
.desktop-nav > a:hover, .nav-dropdown-trigger:hover { color: #1a56db; }
.desktop-nav > a.active, .nav-dropdown.active > .nav-dropdown-trigger { color: #1a56db; font-weight: 600; }
.nav-dropdown { position: relative; }
.nav-dropdown-menu {
  position: absolute; top: 100%; left: 0;
  background: #fff; border: 1px solid rgba(0,0,0,.08);
  box-shadow: 0 10px 40px rgba(0,0,0,.12);
  padding: 12px; opacity: 0; visibility: hidden;
  transform: translateY(8px);
  transition: opacity .18s, transform .18s, visibility .18s;
  z-index: 100; min-width: 200px;
}
.nav-dropdown-wide { min-width: 480px; }
.nav-dropdown:hover .nav-dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }
.dropdown-col { display: flex; flex-direction: column; }
.dropdown-divider { width: 1px; background: rgba(0,0,0,.08); margin: 0 12px; }
.nav-dropdown-wide .dropdown-col { min-width: 200px; }
.nav-dropdown-wide .nav-dropdown-menu { display: flex; }
.dropdown-section-label { font-size: 11px; text-transform: uppercase; letter-spacing: .5px; color: #9ca3af; padding: 4px 14px 8px; }
.nav-dropdown-menu a {
  display: block; padding: 9px 14px; font-size: 13.5px;
  color: #374151; text-decoration: none; border-radius: 4px;
  transition: color .15s, background .15s;
}
.nav-dropdown-menu a:hover { color: #1a56db; background: rgba(26,86,219,.06); }
.nav-dropdown-menu a.active { color: #1a56db; font-weight: 500; }
@media (max-width: 1024px) { .desktop-nav { display: none !important; } }
</style>
