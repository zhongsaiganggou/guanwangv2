---
// ProjectDetailLayout.astro - Project detail page layout with multi-image gallery
import type { ProjectData, EvidenceLevel } from '../data/projects-data';
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects-data';

interface Props {
  project: ProjectData;
  lang: 'zh' | 'en';
}

const { project, lang } = Astro.props;
const t = (obj: { zh: string; en: string }) => obj[lang];
const projectsBase = `/${lang}/projects/`;
const heroTypeLabel = project.heroImageType === 'rendering'
  ? (lang === 'zh' ? '项目效果图' : 'Project Rendering')
  : project.heroImageType === 'site'
  ? (lang === 'zh' ? '项目现场' : 'Project Site')
  : project.heroImageType === 'component'
  ? (lang === 'zh' ? '钢结构细节' : 'Steel Structure Detail')
  : (lang === 'zh' ? '安装阶段' : 'Installation Stage');

const evidenceLabel = (level?: EvidenceLevel): string => {
  if (level === 'cr') return lang === 'zh' ? '公司记录' : 'Company record';
  if (level === 'pending') return lang === 'zh' ? '待补' : 'Pending';
  if (level === 'confirmed') return lang === 'zh' ? '已核实' : 'Verified';
  return '';
};

const relatedProjects = (project.relatedProjectSlugs || [])
  .map(slug => projects.find(p => p.slug === slug))
  .filter((p): p is ProjectData => Boolean(p));

// 项目型 JSON-LD：仅含定性、可证事实（名称、分类、地点、用途、语言），不写入未证实吨位数字
const canonicalUrl = `https://zhongsai-steelstructure.com/${lang}/projects/${project.slug}/`;
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: t(project.name),
  about: t(project.category),
  locationCreated: {
    '@type': 'Place',
    address: { '@type': 'PostalAddress', addressCountry: project.location.en },
  },
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  description: lang === 'zh'
    ? '为新加坡机场扩建工程制造并供应的钢结构连接构件。'
    : 'Steel connection components fabricated and supplied for an airport expansion project in Singapore.',
  publisher: { '@id': 'https://zhongsai-steelstructure.com/#organization' },
  mainEntityOfPage: canonicalUrl,
};
---

<article class="project-detail">
  <script type="application/ld+json" set:html={JSON.stringify(projectSchema)}></script>
  {/* Breadcrumb */}
  <div class="container">
    <div class="hub-breadcrumb project-breadcrumb">
      <a href={`/${lang}/`}>{lang === 'zh' ? '首页' : 'Home'}</a>
      <span>/</span>
      <a href={projectsBase}>{lang === 'zh' ? '项目案例' : 'Projects'}</a>
      <span>/</span>
      <span>{t(project.name)}</span>
    </div>
  </div>

  {/* Project Hero */}
  <section class="project-detail-hero-light">
    <div class="project-hero-image">
      <img src={project.image} alt={`${t(project.name)} ${heroTypeLabel}`} width="1920" height="800">
      <div class="project-hero-overlay"></div>
    </div>
    <div class="container">
      <div class="project-hero-content">
        <span class="project-category-tag">{t(project.category)}</span>
        <h1>{t(project.name)}</h1>
        <p class="project-location">{t(project.location)}</p>
        <span class="hero-image-type">{heroTypeLabel}</span>
      </div>
    </div>
  </section>

  {/* ZhongSai Scope Banner - prominent display */}
  <section class="project-scope-banner">
    <div class="container">
      <div class="scope-banner-inner">
        <div class="scope-label">
          <span class="scope-icon">{lang === 'zh' ? '中赛参与范围' : 'ZhongSai Scope'}</span>
        </div>
        <div class="scope-content">
          <h2>{project.zhongSaiScope ? t(project.zhongSaiScope) : (lang === 'zh' ? '钢结构制造与加工供应' : 'Steel Structure Fabrication & Supply')}</h2>
          <p>{lang === 'zh'
            ? '本项目中赛钢构的具体参与范围以上述标注为准，项目实际供货及技术服务范围以双方确认的合同和技术文件为准。'
            : 'ZhongSai\'s participation scope for this project is as indicated above. Actual supply and technical service scope is subject to the mutually confirmed contract and technical documentation.'}</p>
        </div>
      </div>
    </div>
  </section>

  {/* Project Overview */}
  <section class="project-section">
    <div class="container project-two-col">
      <div class="project-main">
        <h2>{lang === 'zh' ? '项目概述' : 'Project Overview'}</h2>
        <p>{t(project.overview)}</p>

        {/* Scope Details */}
        <div class="manufacturing-participation">
          <h3>{lang === 'zh' ? '中赛参与范围说明' : 'ZhongSai Scope Details'}</h3>
          <p>
            {project.zhongSaiScope
              ? t(project.zhongSaiScope)
              : (lang === 'zh' ? '中赛钢构参与该项目钢结构制造与加工供应。' : 'ZhongSai Steel Structure participated in structural steel fabrication and supply for this project.')}
          </p>
          <p class="scope-note">
            {lang === 'zh'
              ? '注：中赛钢构提供设计深化、制造、供应及安装技术指导；海外项目另含出口运输与交付协调。当地土建和实际施工通常由当地承包商完成。'
              : 'Note: ZhongSai provides detailing, fabrication, supply and technical installation guidance; export shipping and delivery coordination for overseas projects. Local civil works and physical construction are normally handled by local contractors.'}
          </p>
        </div>

        {/* Capability Demonstrated */}
        {project.capabilities && project.capabilities.length > 0 && (
          <div class="capability-demonstrated">
            <h3>{lang === 'zh' ? '项目能力体现' : 'Capability Demonstrated'}</h3>
            <p style="color: var(--color-gray-600); margin-bottom: 16px;">
              {lang === 'zh'
                ? '基于该项目已确认的结构类型和参数，中赛可体现以下加工制造能力：'
                : 'Based on the confirmed structural type and parameters of this project, ZhongSai demonstrates the following fabrication capabilities:'}
            </p>
            <div class="capability-tags">
              {project.capabilities.map(cap => (
                <span class="capability-tag">{t(cap)}</span>
              ))}
            </div>
          </div>
        )}
      </div>

      {/* Confirmed Project Data */}
      <aside class="project-sidebar">
        <div class="project-data-card">
          <h3>{lang === 'zh' ? '已确认项目数据' : 'Confirmed Project Data'}</h3>
          <dl class="project-data-list">
            {project.params.map(param => (
              <div class="data-row">
                <dt>{t(param.label)}</dt>
                <dd>
                  <span class="data-value">{t(param.value)}</span>
                  {param.evidence && (
                    <span class={`evidence-tag evidence-${param.evidence}`}>{evidenceLabel(param.evidence)}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </aside>
    </div>
  </section>

  {/* Engineering Highlights - Challenge / Approach / Outcome */}
  {project.engineeringHighlights && project.engineeringHighlights.length > 0 && (
    <section class="project-section highlights-section">
      <div class="container">
        <h2>{lang === 'zh' ? '工程亮点' : 'Engineering Highlights'}</h2>
        <p class="section-intro">
          {lang === 'zh'
            ? '基于该项目的实际构件与工艺，说明中赛在制造过程中面对的难点、应对方式与结果。'
            : 'Based on the actual components and processes, the challenges ZhongSai addressed, the approach taken and the outcome.'}
        </p>
        <div class="highlights-grid">
          {project.engineeringHighlights.map(h => (
            <div class="highlight-card">
              <h3>{t(h.title)}</h3>
              <div class="highlight-row">
                <span class="highlight-key">{lang === 'zh' ? '难点' : 'Challenge'}</span>
                <p>{t(h.challenge)}</p>
              </div>
              <div class="highlight-row">
                <span class="highlight-key">{lang === 'zh' ? '应对' : 'Approach'}</span>
                <p>{t(h.approach)}</p>
              </div>
              <div class="highlight-row">
                <span class="highlight-key">{lang === 'zh' ? '结果' : 'Outcome'}</span>
                <p>{t(h.outcome)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Project Evidence Gallery - Grouped by evidence type */}
  <section class="project-section project-gallery-section">
    <div class="container">
      <h2>{lang === 'zh' ? '项目证据' : 'Project Evidence'}</h2>
      <p style="color: var(--color-gray-600); margin-bottom: 24px; max-width: 700px;">
        {lang === 'zh'
          ? '以下图片展示该项目的效果图、现场实景及钢结构构件细节，用于说明中赛钢构在本项目中的制造与供货范围。'
          : 'The following images show project renderings, site views and steel component details, illustrating ZhongSai\'s fabrication and supply scope for this project.'}
      </p>

      {(() => {
        const groups = {
          rendering: {
            title: lang === 'zh' ? '工程效果图与结构资料' : 'Engineering Renderings & Structural Drawings',
            images: []
          },
          site: {
            title: lang === 'zh' ? '项目现场与完工实景' : 'Project Site & Completed Views',
            images: []
          },
          component: {
            title: lang === 'zh' ? '钢结构构件与制造细节' : 'Steel Components & Fabrication Details',
            images: []
          }
        };
        project.galleryImages.forEach((img, idx) => {
          const g = groups[img.type] || groups.rendering;
          g.images.push({ ...img, idx });
        });
        return Object.entries(groups).map(([key, group]) =>
          group.images.length > 0 ? (
            <div class="evidence-group">
              <h3 class="evidence-group-title">{group.title}</h3>
              <div class={`project-gallery-grid gallery-count-${Math.min(group.images.length, 3)}`}>
                {group.images.map((img) => (
                  <figure class={`gallery-item ${img.idx === 0 ? 'gallery-first' : ''}`}>
                    <div class="gallery-image-wrap">
                      <img
                        src={img.src}
                        alt={`${t(project.name)} - ${t(img.label)}`}
                        width="800"
                        height="600"
                        loading={img.idx === 0 ? 'eager' : 'lazy'}
                      />
                      <span class="gallery-type-tag">{t(img.label)}</span>
                    </div>
                  </figure>
                ))}
              </div>
            </div>
          ) : null
        );
      })()}
    </div>
  </section>

  {/* Related Capabilities */}
  <section class="project-section related-section">
    <div class="container">
      <h2>{lang === 'zh' ? '相关能力' : 'Related Capabilities'}</h2>
      <div class="related-links-grid">
        {project.relatedLinks.map(link => (
          <a href={`/${lang}/${link.href}`} class="related-link-card">
            <span>{t(link.label)}</span>
            <span class="related-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Related Projects - only real, existing pages */}
  {relatedProjects.length > 0 && (
    <section class="project-section related-projects-section">
      <div class="container">
        <h2>{lang === 'zh' ? '相关项目' : 'Related Projects'}</h2>
        <p class="section-intro">
          {lang === 'zh' ? '同地区、同类型的真实项目案例。' : 'Real projects in the same region and category.'}
        </p>
        <div class="related-projects-grid">
          {relatedProjects.map(rp => (
            <ProjectCard project={rp} lang={lang} />
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Quote CTA */}
  <section class="project-quote-cta">
    <div class="container">
      <div class="quote-cta-content">
        <h2>{lang === 'zh' ? '有类似项目需求？' : 'Have a Similar Project?'}</h2>
        <p>{lang === 'zh' ? '提交图纸或项目资料，获取初步评估与报价所需信息。' : 'Send drawings or project requirements for initial project review and quotation discussion.'}</p>
        <a href={`/${lang}/contact/#quote-form`} class="btn btn-primary btn-large">
          {lang === 'zh' ? '提交项目需求' : 'Send Project Requirements'}
        </a>
      </div>
    </div>
  </section>
</article>

<style>
.project-detail {
  padding-bottom: 0;
}
/* Scope Banner */
.project-scope-banner {
  background: linear-gradient(135deg, #0a3d62 0%, #0d4f7a 100%);
  padding: 28px 0;
  margin-top: -1px;
}
.scope-banner-inner {
  display: flex;
  align-items: center;
  gap: 32px;
}
.scope-label {
  flex-shrink: 0;
}
.scope-icon {
  display: inline-block;
  background: rgba(255,255,255,0.15);
  color: #fff;
  padding: 10px 20px;
  border-radius: 6px;
  font-size: 0.9rem;
  font-weight: 600;
  border: 1px solid rgba(255,255,255,0.25);
  white-space: nowrap;
}
.scope-content {
  flex: 1;
}
.scope-content h2 {
  color: #fff;
  font-size: 1.35rem;
  margin: 0 0 6px;
  line-height: 1.4;
}
.scope-content p {
  color: rgba(255,255,255,0.75);
  font-size: 0.82rem;
  margin: 0;
  line-height: 1.6;
}
.scope-note {
  font-size: 0.82rem !important;
  color: #666 !important;
  margin-top: 10px !important;
  padding-top: 10px;
  border-top: 1px dashed rgba(0,0,0,0.1);
}
.project-breadcrumb {
  padding: 20px 0;
}
.project-detail-hero {
  position: relative;
  margin-bottom: 48px;
}
.project-hero-image {
  position: relative;
  height: 480px;
  overflow: hidden;
}
.project-hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.project-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(7,18,38,0.85) 0%, rgba(7,18,38,0.3) 50%, transparent 100%);
}
.project-hero-content {
  position: absolute;
  bottom: 40px;
  left: 0;
  right: 0;
  color: #fff;
}
.project-category-tag {
  display: inline-block;
  background: rgba(255,255,255,0.15);
  color: #fff;
  padding: 6px 16px;
  border-radius: 4px;
  font-size: 0.85rem;
  margin-bottom: 16px;
  backdrop-filter: blur(4px);
}
.project-hero-content h1 {
  font-size: 2rem;
  color: #fff;
  margin: 0 0 8px;
  max-width: 800px;
  line-height: 1.3;
}
.project-location {
  font-size: 1.05rem;
  color: rgba(255,255,255,0.85);
  margin: 0 0 12px;
}
.hero-image-type {
  display: inline-block;
  font-size: 0.78rem;
  color: rgba(255,255,255,0.7);
  border: 1px solid rgba(255,255,255,0.3);
  padding: 3px 10px;
  border-radius: 3px;
}
.project-section {
  padding: 40px 0;
}
.project-two-col {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 48px;
  align-items: start;
}
.project-main h2 {
  font-size: 1.5rem;
  color: #0a3d62;
  margin: 0 0 16px;
}
.project-main p {
  line-height: 1.8;
  color: #444;
  margin-bottom: 24px;
}
.manufacturing-participation {
  background: #f0f5f9;
  padding: 24px;
  border-radius: 10px;
  border-left: 4px solid #0a3d62;
  margin-top: 24px;
}
.manufacturing-participation h3 {
  font-size: 1.1rem;
  color: #0a3d62;
  margin: 0 0 12px;
}
.manufacturing-participation p {
  margin: 0;
  color: #444;
  line-height: 1.7;
}
.project-sidebar {
  position: sticky;
  top: 24px;
}
.project-data-card {
  background: #fff;
  border: 1px solid rgba(0,0,0,0.08);
  border-radius: 12px;
  padding: 24px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.04);
}
.project-data-card h3 {
  font-size: 1.1rem;
  color: #0a3d62;
  margin: 0 0 20px;
  padding-bottom: 12px;
  border-bottom: 2px solid #0a3d62;
}
.project-data-list {
  margin: 0;
}
.data-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 10px 0;
  border-bottom: 1px solid rgba(0,0,0,0.05);
}
.data-row:last-child {
  border-bottom: none;
}
.data-row dt {
  font-size: 0.85rem;
  color: #888;
  flex: 1;
}
.data-row dd {
  font-size: 0.95rem;
  color: #333;
  font-weight: 600;
  margin: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
}
.data-value {
  text-align: right;
}
.evidence-tag {
  font-size: 0.66rem;
  font-weight: 500;
  padding: 2px 7px;
  border-radius: 10px;
  letter-spacing: 0.02em;
  white-space: nowrap;
}
.evidence-cr { background: #fdf0d9; color: #9a6a1c; border: 1px solid #f0d9b0; }
.evidence-pending { background: #eef0f3; color: #6b7280; border: 1px solid #e0e4e9; }
.evidence-confirmed { background: #e3f2ea; color: #1f7a4d; border: 1px solid #c2e3d2; }
.section-intro {
  color: var(--color-gray-600);
  max-width: 720px;
  margin: 0 0 28px;
  line-height: 1.7;
}
/* Engineering Highlights */
.highlights-section { background: #f8f9fa; }
.highlights-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}
.highlight-card {
  background: #fff;
  border: 1px solid rgba(0,0,0,0.07);
  border-radius: 12px;
  padding: 24px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.04);
  border-top: 3px solid #0a3d62;
}
.highlight-card h3 {
  font-size: 1.08rem;
  color: #0a3d62;
  margin: 0 0 16px;
}
.highlight-row { margin-bottom: 12px; }
.highlight-row:last-child { margin-bottom: 0; }
.highlight-key {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #0a3d62;
  background: #eef4f9;
  padding: 2px 8px;
  border-radius: 4px;
  margin-bottom: 6px;
}
.highlight-row p {
  margin: 0;
  font-size: 0.88rem;
  color: #555;
  line-height: 1.6;
}
/* Related Projects */
.related-projects-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

/* Multi-image Gallery */
.project-gallery-section h2 {
  font-size: 1.5rem;
  color: #0a3d62;
  margin: 0 0 24px;
}
.project-gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.gallery-item {
  margin: 0;
  position: relative;
}
.gallery-image-wrap {
  position: relative;
  border-radius: 10px;
  overflow: hidden;
  aspect-ratio: 4/3;
  background: #f0f0f0;
}
.gallery-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;
}
.gallery-item:hover .gallery-image-wrap img {
  transform: scale(1.03);
}
.gallery-type-tag {
  position: absolute;
  bottom: 10px;
  left: 10px;
  background: rgba(7,18,38,0.75);
  color: #fff;
  font-size: 0.72rem;
  padding: 4px 10px;
  border-radius: 4px;
  backdrop-filter: blur(4px);
  letter-spacing: 0.02em;
}
/* First image larger when gallery has 4-6 images */
.gallery-count-4 .gallery-first,
.gallery-count-5 .gallery-first,
.gallery-count-6 .gallery-first {
  grid-column: span 2;
  grid-row: span 1;
}
.gallery-count-4 .gallery-first .gallery-image-wrap,
.gallery-count-5 .gallery-first .gallery-image-wrap,
.gallery-count-6 .gallery-first .gallery-image-wrap {
  aspect-ratio: 16/9;
}
/* 2-3 images: use 2 columns */
.gallery-count-1 .project-gallery-grid,
.gallery-count-2 .project-gallery-grid,
.gallery-count-3 .project-gallery-grid {
  grid-template-columns: repeat(2, 1fr);
}
.gallery-count-1 .gallery-first {
  grid-column: span 2;
}
.gallery-count-1 .gallery-first .gallery-image-wrap {
  aspect-ratio: 16/9;
}

.related-section {
  background: #f8f9fa;
}
.related-section h2 {
  font-size: 1.5rem;
  color: #0a3d62;
  margin: 0 0 24px;
}
.related-links-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
}
.related-link-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 20px 24px;
  border-radius: 10px;
  text-decoration: none;
  color: #0a3d62;
  font-weight: 600;
  border: 1px solid rgba(0,0,0,0.06);
  transition: transform 0.2s, box-shadow 0.2s;
}
.related-link-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
}
.related-arrow {
  color: #0a3d62;
  font-size: 1.2rem;
}
.project-quote-cta {
  background: linear-gradient(135deg, #0a3d62 0%, #0d4f7a 100%);
  padding: 64px 0;
  color: #fff;
  text-align: center;
}
.quote-cta-content h2 {
  font-size: 1.8rem;
  color: #fff;
  margin: 0 0 12px;
}
.quote-cta-content p {
  color: rgba(255,255,255,0.85);
  max-width: 600px;
  margin: 0 auto 28px;
  line-height: 1.7;
}
@media (max-width: 900px) {
  .project-two-col {
    grid-template-columns: 1fr;
  }
  .project-sidebar {
    position: static;
  }
  .project-hero-image {
    height: 360px;
  }
  .project-hero-content h1 {
    font-size: 1.5rem;
  }
  .project-gallery-grid {
    grid-template-columns: repeat(2, 1fr) !important;
  }
  .gallery-count-4 .gallery-first,
  .gallery-count-5 .gallery-first,
  .gallery-count-6 .gallery-first {
