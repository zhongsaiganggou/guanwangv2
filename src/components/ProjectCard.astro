---
// ProjectCard.astro V3 - Portfolio style
import type { ProjectData } from '../data/projects-data';

interface Props {
  project: ProjectData;
  lang: 'zh' | 'en';
}
const { project, lang } = Astro.props;
const t = (obj: { zh: string; en: string }) => obj[lang];
---

<a href={`/${lang}/projects/${project.slug}/`} class="project-card">
  <div class="project-card-image">
    <img src={project.image} alt={t(project.name)} loading="lazy">
  </div>
  <div class="project-card-info">
    <h3>{t(project.name)}</h3>
    <p class="project-loc">{t(project.location)}</p>
    {project.zhongSaiScope && <p class="project-scope">{t(project.zhongSaiScope)}</p>}
  </div>
</a>

<style>
.project-card {
  display: block; text-decoration: none; color: #111;
}
.project-card-image {
  aspect-ratio: 4/3; overflow: hidden; background: #f0f0f0; margin-bottom: 14px;
}
.project-card-image img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform .4s;
}
.project-card:hover .project-card-image img { transform: scale(1.03); }
.project-card-info h3 { font-size: 17px; margin-bottom: 4px; }
.project-loc { font-size: 13px; color: #888; margin-bottom: 6px; }
.project-scope { font-size: 13px; color: #555; }
</style>
