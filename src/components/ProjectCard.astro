---
// ProjectCard.astro - Project card component for Projects Hub
import type { ProjectData } from '../data/projects-data';

interface Props {
  project: ProjectData;
  lang: 'zh' | 'en';
}

const { project, lang } = Astro.props;
const t = (obj: { zh: string; en: string }) => obj[lang];
---

<a href={`/${lang}/projects/${project.slug}/`} class="project-card">
  <div class="project-card-image">
    <img src={project.image} alt={t(project.name)} width="800" height="500" loading="lazy">
    <span class="project-card-category">{t(project.category)}</span>
  </div>
  <div class="project-card-content">
    <h3>{t(project.name)}</h3>
    <p class="project-card-location">{t(project.location)}</p>
    {project.zhongSaiScope && (
      <span class="project-card-scope">{t(project.zhongSaiScope)}</span>
    )}
    <div class="project-card-params">
      {project.params.slice(0, 3).map(param => (
        <div class="project-card-param">
          <span class="param-label">{t(param.label)}</span>
          <span class="param-value">{t(param.value)}</span>
        </div>
      ))}
    </div>
    <span class="project-card-link">
      {lang === 'zh' ? '查看项目' : 'View Project'} →
    </span>
  </div>
</a>

<style>
.project-card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: transform 0.25s, box-shadow 0.25s;
  border: 1px solid rgba(0,0,0,0.06);
}
.project-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(0,0,0,0.1);
}
.project-card-image {
  position: relative;
  aspect-ratio: 16/10;
  overflow: hidden;
  background: #f0f0f0;
}
.project-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.project-card-category {
  position: absolute;
  top: 12px;
  left: 12px;
  background: rgba(10,61,98,0.9);
  color: #fff;
  padding: 4px 12px;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 500;
}
.project-card-content {
  padding: 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.project-card-content h3 {
  font-size: 1.05rem;
  margin: 0 0 6px;
  color: #0a3d62;
  line-height: 1.4;
}
.project-card-location {
  color: #888;
  font-size: 0.82rem;
  margin: 0 0 10px;
}
.project-card-scope {
  display: inline-block;
  background: #e8f0f7;
  color: #0a3d62;
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 500;
  margin-bottom: 12px;
  line-height: 1.4;
}
.project-card-params {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 16px;
  margin-bottom: 14px;
}
.project-card-param {
  display: flex;
  flex-direction: column;
}
.param-label {
  font-size: 0.7rem;
  color: #999;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.param-value {
  font-size: 0.85rem;
  color: #333;
  font-weight: 500;
}
.project-card-link {
  margin-top: auto;
  color: #0a3d62;
  font-size: 0.88rem;
  font-weight: 600;
}
@media (max-width: 768px) {
  .project-card-content h3 {
    font-size: 1rem;
  }
}
</style>
